[] a owl:Axiom ;
    alignment:confidence 0.7493 ;
    alignment:decidedBy "regla"@es ;
    rdfs:comment "Aceptada automáticamente por la regla (confianza alta de la IA y puntaje >= 0.5; clases: exactMatch, closeMatch, broadMatch o narrowMatch; propiedades: nunca automáticas). Justificación de la IA: El concepto requiere explícitamente registrar las transferencias transfronterizas, lo cual coincide exactamente con la definición de un registro de actividades de transferencia de datos."@es ;
    owl:annotatedProperty skos:exactMatch ;
    owl:annotatedSource <http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#RecordCrossBorderDataTransfer> ;
    owl:annotatedTarget dpv:DataTransferRecord ;
    owl:versionInfo "1" .

[] a owl:Axiom ;
    alignment:confidence 0.6372 ;
    alignment:decidedBy "regla"@es ;
    rdfs:comment "Aceptada automáticamente por la regla (confianza alta de la IA y puntaje >= 0.5; clases: exactMatch, closeMatch, broadMatch o narrowMatch; propiedades: nunca automáticas). Justificación de la IA: La implementación de medidas técnicas para el cumplimiento es una acción que se enmarca dentro del concepto general de medidas técnicas del DPV."@es ;
    owl:annotatedProperty skos:broadMatch ;
    owl:annotatedSource <http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#ImplementTechnicalMeasuresForCompliance> ;
    owl:annotatedTarget dpv:TechnicalMeasure ;
    owl:versionInfo "1" .

