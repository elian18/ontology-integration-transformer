    owl:annotatedProperty skos:exactMatch ;
    owl:annotatedSource <http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#LargeScaleProcessing> ;
    owl:annotatedTarget dpv:LargeScaleProcessing ;
    owl:versionInfo "1" .

[] a owl:Axiom ;
    alignment:confidence 0.7574 ;
    alignment:decidedBy "regla"@es ;
    rdfs:comment "Aceptada automáticamente por la regla (confianza alta de la IA y puntaje >= 0.5; clases: exactMatch, closeMatch, broadMatch o narrowMatch; propiedades: nunca automáticas). Justificación de la IA: La definición de consentimiento dado por el interesado coincide exactamente con el concepto de consentimiento como base legal para el tratamiento de datos."@es ;
    owl:annotatedProperty skos:exactMatch ;
    owl:annotatedSource <http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#GivenConsent> ;
    owl:annotatedTarget dpv:Consent ;
