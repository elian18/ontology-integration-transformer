<http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT-dpv-alignment> a owl:Ontology ;
    rdfs:label "Alineación de gdprtext-ontology.ttl con el DPV"@es ;
    dct:created "2026-11-07T16:54:12+00:00"^^xsd:dateTime ;
    rdfs:comment "Correspondencias heredadas de la base del sistema (OntoPriv + LOPDP, decididas por una persona en el Sprint 5) y aceptadas automáticamente por la regla del decisor (S7-T05). Las sugeridas no se escriben. El DPV se referencia por IRI, no se importa."@es ;
    owl:imports <http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT>,
        <http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT-labels> ;
    owl:versionInfo "1" .

alignment:confidence a owl:AnnotationProperty ;
    rdfs:label "puntaje del candidato"@es ;
    rdfs:comment "Puntaje de 0 a 1 del término del DPV (0.4 léxico + 0.6 embeddings) cuando lo aceptó la regla."@es .

alignment:decidedBy a owl:AnnotationProperty ;
    rdfs:label "decidido por"@es ;
    rdfs:comment "Quién decidió la correspondencia: base (una persona, Sprint 5), regla (el decisor con IA y la regla calibrada) o regla sin IA."@es .

