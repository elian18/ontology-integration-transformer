      "owl:imports": {
        "@id": "http://www.semanticweb.org/profiles/ecuador-lopdp"
      },
      "rdfs:comment": {
        "@language": "es",
        "@value": "Correspondencias SKOS aprobadas por revisión humana entre OntoPriv (núcleo + perfil) y el Data Privacy Vocabulary (DPV 2.3), más los conceptos nuevos extraídos de la ley y aprobados por una persona. El DPV se referencia por IRI; no se importa."
      },
      "rdfs:label": {
        "@language": "es",
        "@value": "Alineación con el DPV del perfil Ecuador (LOPDP)"
      }
    },
