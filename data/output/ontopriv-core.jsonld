    {
      "@id": "ley-organica-proteccion-datos-personales:pseudonymization",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Pseudonymization"
      ],
      "ley-organica-proteccion-datos-personales:description": "The process of processing personal data in such a way that it cannot be directly attributed to a data subject without the use of additional information. This additional information is kept separately and is subject to technical and organizational measures designed to ensure that personal data cannot be linked to an identified or identifiable natural person."
    },
    {
      "@id": "ley-organica-proteccion-datos-personales:Members_of_the_personal_data_protection_system",
      "@type": [
