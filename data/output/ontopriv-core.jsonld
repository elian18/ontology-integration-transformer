      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Data_or_database_of_criminal_infractions"
      ],
      "ley-organica-proteccion-datos-personales:explanation_of_concept_of_inapplicability": "Data or databases established for the prevention, investigation, detection or prosecution of criminal offenses or execution of criminal sanctions, carried out by the competent state agencies in compliance with their legal functions. In any of these cases, international human rights standards and the principles of this Law must be complied with, and at least the criteria of legality, proportionality and necessity must be met."
    },
