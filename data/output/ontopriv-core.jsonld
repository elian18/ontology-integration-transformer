      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Anonymization"
      ],
      "ley-organica-proteccion-datos-personales:description": "The implementation of measures to prevent the identification or re-identification of a natural person shall be carried out without incurring disproportionate efforts. This implies that privacy-preserving actions shall be taken without requiring excessive resources, time or effort that are not justified by the benefits or purpose pursued."
    },
