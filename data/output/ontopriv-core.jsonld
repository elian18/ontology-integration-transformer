    {
      "@id": "ley-organica-proteccion-datos-personales:right_of_opposition",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Right_of_opposition"
      ],
      "ley-organica-proteccion-datos-personales:deadline_in_days_for_the_right_to_oppose_opposition": {
        "@type": "xsd:decimal",
        "@value": "15"
      },
      "ley-organica-proteccion-datos-personales:description": "The owner has the right to oppose or refuse the processing of his/her personal data under certain scenarios",
      "ley-organica-proteccion-datos-personales:in_direct_marketing_cases": "The data subject can always object to the processing of his personal data for direct marketing, including profiling, in which case the personal data will no longer be processed for this purpose.",
      "ley-organica-proteccion-datos-personales:right_account_encumbered": {
        "@id": "ley-organica-proteccion-datos-personales:responsible_for_treatment"
      },
      "ley-organica-proteccion-datos-personales:when_it_can_be_opposed_to_treatment": [
        "If the Organic Law on Personal Data Protection explicitly permits the type of processing in progress or proposed",
        "If the data are not publicly available and are not related to matters of public interest required by other Ecuadorian laws",
        "If the processing of personal data is for the purpose of direct marketing",
        "If the treatment does not affect the rights of others",
        "When the consent of the data subject is not necessary for the processing as a consequence of the concurrence of a legitimate interest."
      ]
    },
