    {
      "@id": "ley-organica-proteccion-datos-personales:personal_data_protection_authority",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Personal_data_protection_authority"
      ],
      "ley-organica-proteccion-datos-personales:actions_regarding_health_data_processing": "For when dealing with anonymized health data",
      "ley-organica-proteccion-datos-personales:actions_regarding_independence_of_control": [
        "Investigation action, which involves carrying out investigations into possible violations of data protection legislation in an independent and partial manner.",
        "Prevention action, which consists of promoting good practices and providing guidance and advice to organizations and citizens on how to protect personal data and comply with privacy regulations.",
        "Sanction action, which arises once violations of data protection legislation are identified, whereby the Data Protection Authority has the power to impose appropriate and proportionate sanctions."
      ],
      "ley-organica-proteccion-datos-personales:authorization_for_treatment_of_anonymized_health_data": [
        "A favorable report from the Health Authority, which confirms that the technical protocol complies with the standards and regulations established by the Organic Law on Personal Data Protection and other related laws.",
        "Provide technical protocol containing the necessary details to ensure the protection of health data."
      ],
      "ley-organica-proteccion-datos-personales:control_functions": "It is the control and oversight body responsible for guaranteeing all citizens the protection of their personal data, and for taking all necessary actions to ensure that the principles, rights, guarantees and procedures set forth in the Organic Law on Personal Data Protection and its implementing regulations are respected.",
      "ley-organica-proteccion-datos-personales:designation": [
        "The Personal Data Protection Authority shall be appointed in accordance with the provisions of the Constitution of the Republic.",
        "The appointment is made from a list of three candidates provided by the President of the Republic",
        "The selection is based on criteria of specialization and merit, and the process is public, allowing for citizen challenges."
      ],
      "ley-organica-proteccion-datos-personales:duration_of_charge": "The Personal Data Protection Authority will exercise its functions for a period of 5 years.",
      "ley-organica-proteccion-datos-personales:functions": [
        "Apply sanctions to those responsible, delegates, persons in charge and third parties, in accordance with the provisions of the Organic Law on Personal Data Protection.",
        "Attending to consultations on personal data protection matters",
        "Control and supervise the exercise of the right to personal data protection within the data processing carried out through the National System of Public Registries.",
        "Create, manage and administer the National Registry of Personal Data Protection, and collaborate with public and private entities to ensure its correct operation.",
        "Establish guidelines for the analysis, evaluation and selection of personal data security measures.",
        "Exercise the supervision, control and evaluation of the activities carried out by the person responsible for and in charge of the processing of personal data.",
        "Investigate, analyze and resolve complaints filed by data subjects, as well as those initiated by the Personal Data Protection Authority, in addition to imposing appropriate sanctions",
        "Issue guidelines for the design and content of the personal data processing policy.",
        "Keep a statistical record of personal data security breaches and identify possible security measures for each of them.",
        "Perform or delegate technical audits to the processing of personal data.",
        "Periodically publish a guide to personal data protection regulations.",
        "Promote adequate and effective coordination with accountability officers and participate in international and regional initiatives for the protection of personal data protection.",
        "Promote and encourage the exercise of the right to the protection of personal data, as well as the awareness and understanding of the risks, rules, guarantees and rights of individuals in relation to the processing and use of their personal data, with special emphasis on activities aimed at priority groups such as children and adolescents.",
        "To dictate standard data protection clauses and verify the content of additional or specific clauses or guarantees.",
        "To issue general or technical regulations, criteria and other acts necessary for the exercise of its powers and the guarantee of the exercise of the right to the protection of personal data.",
        "To represent internationally the interests related to the protection of personal data."
      ],
      "ley-organica-proteccion-datos-personales:known_as": "Data Protection Superintendent",
      "ley-organica-proteccion-datos-personales:requirements_that_must_be_met": [
        "Must have at least a fourth level degree and a minimum of 10 years of experience in areas related to the regulation of the Organic Law for the Protection of Personal Data.",
        "The Personal Data Protection Authority must be a professional in law, information systems, communication or technology."
      ],
      "ley-organica-proteccion-datos-personales:revocation": [
        "His mandate can only be revoked by impeachment after an impeachment trial conducted by the National Assembly.",
        "Its mandate can only be revoked in accordance with the grounds established in the Ecuadorian laws regulating public service."
      ],
      "ley-organica-proteccion-datos-personales:type_authority": "Public"
    },
