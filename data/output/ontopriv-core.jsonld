    {
      "@id": "ley-organica-proteccion-datos-personales:recall_mechanisms",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Recall_mechanisms"
      ],
      "ley-organica-proteccion-datos-personales:description": "Means that must be available for an individual to revoke his consent to the processing of his personal data",
      "ley-organica-proteccion-datos-personales:must_be": "Simple procedure, similar to the procedure by which consent was obtained",
      "ley-organica-proteccion-datos-personales:must_guarantee": [
        "Effectiveness, i.e., achieving revocation of consent",
        "Efficiency, i.e. that the revocation of consent does not take too much time or effort, both on the part of the data subject and the data controller.",
        "Expeditiousness, i.e., the speed or promptness with which the consent revocation process is conducted",
        "Free of charge, which implies that the consent revocation process should not generate additional costs for the data subject."
      ],
      "ley-organica-proteccion-datos-personales:son_establecidos_por": {
        "@id": "ley-organica-proteccion-datos-personales:responsible_for_treatment"
