    {
      "@id": "ley-organica-proteccion-datos-personales:data_processing",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Data_processing"
      ],
      "ley-organica-proteccion-datos-personales:before_the_revocation_of_consent_is_considered_to_be_considered": "It is considered lawful, i.e. even if the data subject decides to revoke his/her consent to data processing, this does not invalidate or invalidate the data processing that was lawfully carried out prior to the revocation of consent.",
      "ley-organica-proteccion-datos-personales:conditions_for_legitimate_treatment": [
        "For processing of personal data contained in publicly accessible databases",
        "Personal data involved in data processing may be used prior to entering into a contract if requested by the data subject, or during the performance of a contract to fulfill the obligations of the data controller, a person designated to handle the data, or another legally authorized party.",
        "Processing personal data to satisfy a legitimate interest of the data controller or a third party. However, this legitimate interest cannot prevail over the fundamental rights of the data subjects.",
        "That it is carried out by the data controller in compliance with a legal obligation.",
        "That the collection, storage, use or any other operation carried out with personal data is justified in the performance of a task in the public interest or in the exercise of public powers vested in the data controller.",
        "To be carried out by the data controller, by court order",
        "To protect the vital interests of the data subject or of another natural person, such as life, health or integrity"
      ],
      "ley-organica-proteccion-datos-personales:description": "Any action or set of actions performed on personal data, whether by means of fully automated, partially automated or non-automated technical processes. These actions include, but are not limited to: collecting, compiling, obtaining, recording, organizing, structuring, preserving, safeguarding, adapting, modifying, deleting, indexing, extracting, consulting, processing, using, possessing, exploiting, distributing, assigning, communicating, transferring or otherwise providing access to, collating, interconnecting, limiting, deleting, destroying and, in general, any use of personal data.",
      "ley-organica-proteccion-datos-personales:determine_the_compatibility": [
        "Consideration should be given to the logical expectations that the data subject might have about the future use of his or her data, based on his or her relationship with the data controller",
        "It should be verified that there are sufficient safeguards both in the original processing and in the proposed new processing to protect the rights and privacy of data subjects.",
        "The environment and circumstances in which the data were first obtained should be analyzed.",
        "The information provided to the data subject during the initial collection process should be taken into account.",
        "The potential impact of further processing of the data on data subjects should be analyzed",
        "The type of personal data collected and its sensitivity must be evaluated."
      ],
      "ley-organica-proteccion-datos-personales:for_different_purpose": "If they are compatible with the purposes for which they were collected.",
      "ley-organica-proteccion-datos-personales:has_as_the_basis_of": {
        "@id": "ley-organica-proteccion-datos-personales:legal_interest"
      },
      "ley-organica-proteccion-datos-personales:is_based_on": {
        "@id": "ley-organica-proteccion-datos-personales:principios"
      },
      "ley-organica-proteccion-datos-personales:low_legitimate_interest": [
        "Only data that is strictly necessary to fulfill the purposes established in relation to the consent given and the intended processing may be processed.",
        "The Data Protection Authority has the power to request a risk report from the data controller to assess possible threats to the legitimate expectations of data subjects and their fundamental rights.",
        "The data controller must ensure that the data processing is transparent to the data subject."
      ],
      "ley-organica-proteccion-datos-personales:territorial_application_scenario": "The processing of personal data is carried out in any part of the national territory."
    },
