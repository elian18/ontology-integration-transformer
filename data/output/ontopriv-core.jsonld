    {
      "@id": "ley-organica-proteccion-datos-personales:conservation",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Conservation"
      ],
      "ley-organica-proteccion-datos-personales:description": "The conservation of personal data implies keeping them for a period that does not exceed the time necessary to fulfill the purpose for which they were initially collected and processed.",
      "ley-organica-proteccion-datos-personales:extended_preservation_of_personal_data_processing": [
        "Archival purposes in the public interest, i.e., preservation of data for archival purposes that benefit the public interest, such as preserving the historical or administrative memory of a society.",
        "Historical research purposes for the purpose of studying events, periods or aspects of the past to better understand history, the evolution of society, cultures or institutions over time.",
        "Scientific research purposes, that is, when the processing of personal data is used for scientific studies that seek to generate knowledge, understand natural or social phenomena, validate theories or contribute to the advancement of a particular discipline.",
        "Statistical research purposes with the objective of performing quantitative and qualitative analyses to understand patterns, trends and relationships in a specific population or phenomenon."
      ],
      "ley-organica-proteccion-datos-personales:responsible_for_establishing_the_deadlines_for_suspension_or_periodic_review_within_data_processing_is": {
        "@id": "ley-organica-proteccion-datos-personales:responsible_for_treatment"
      }
