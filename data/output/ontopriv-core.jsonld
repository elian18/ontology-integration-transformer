      ],
      "ley-organica-proteccion-datos-personales:description": "They are all those persons who participate in the Personal Data Protection Law.",
      "rdfs:subClassOf": {
        "@id": "ley-organica-proteccion-datos-personales:Organic_Law_on_Personal_Data_Protection"
      },
      "rdfs:subPropertyOf": {
