        "ley-organica-proteccion-datos-personales:Personal_data_protection_seals"
      ],
      "ley-organica-proteccion-datos-personales:description": "Recognition awarded for having implemented best practices in the processes, thus contributing to promote the holder's confidence.",
      "ley-organica-proteccion-datos-personales:is_given_by": [
