    {
      "@id": "ley-organica-proteccion-datos-personales:data_processor",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Data_Processor"
      ],
      "ley-organica-proteccion-datos-personales:control_functions": "Processor of personal data on behalf of and for the account of a controller of personal data",
      "ley-organica-proteccion-datos-personales:delegate_comments": [
        "Ensure that the involvement of the personal data protection officer, in all matters relating to personal data protection, is appropriate and timely.",
        "Ensure that the personal data protection officer establishes direct communication with the highest executive and decision-making levels of the data processor.",
        "Facilitate access to the personal data of the processing operations, as well as all the resources and elements necessary to guarantee the correct and free performance of its functions.",
        "They may not dismiss or sanction the personal data protection officer for the proper performance of his or her duties.",
        "Train and update the personal data protection officer on the subject, in accordance with the technical regulations issued by the Personal Data Protection Authority."
      ],
      "ley-organica-proteccion-datos-personales:is_related_to": {
        "@id": "ley-organica-proteccion-datos-personales:delegate"
      },
      "ley-organica-proteccion-datos-personales:minor_infractions": [
        "Failure to allow or cooperate with audits or inspections carried out by the data controller or other auditor authorized by the Personal Data Protection Authority",
        "Failure to comply with the corrective measures ordered by the Personal Data Protection Authority.",
        "Failure to cooperate with the data controller to enable the data controller to respond adequately to requests from data subjects",
        "Failure to provide the data controller with all the information necessary to comply with the obligations established by the Organic Law on Personal Data Protection and the corresponding regulations."
      ],
      "ley-organica-proteccion-datos-personales:nature_of_the_entity": "Public or Private",
      "ley-organica-proteccion-datos-personales:obligations": [
        "Allowing audits and inspections by accredited auditors",
        "Comply with any other obligation established by applicable regulations or other Ecuadorian laws.",
        "Conduct security adequacy assessments prior to the processing of personal data.",
        "Designate a Data Protection Officer when necessary.",
        "Develop customized data protection policies",
        "Ensure that data processors comply with regulations and best practices.",
        "Establish confidentiality agreements with personnel and data controllers.",
        "Implement administrative, technical and legal measures to guarantee the proper treatment of data",
        "Maintain the National Registry of Personal Data Protection up to date.",
        "Notifying the Personal Data Protection Authority and the data owner of violations of the security measures implemented for the processing of personal data in accordance with the procedure established for this purpose.",
        "Periodically evaluate the effectiveness of the administrative, technical and legal measures adopted.",
        "Take the necessary technological, physical, administrative, organizational and legal measures to prevent, deter, reduce, mitigate and control identified risks and breaches.",
        "Treat personal data in accordance with the Organic Law on Personal Data Protection and relevant regulations.",
        "Use risk analysis and management methodologies adapted to the particularities of data processing and the parties involved."
      ],
      "ley-organica-proteccion-datos-personales:serious_infractions": [
        "Failure to comply with corrective measures or partial or defective compliance with them, provided that a sanction for a minor infraction has been applied beforehand for this reason.",
        "Failure to implement mechanisms designed to maintain the confidentiality, integrity, availability and resilience of personal data",
        "Failure to implement preventive and corrective measures in the security of personal data in order to avoid violations.",
        "Failure to notify the data controller of any breach of security of personal data in accordance with the Organic Law on Personal Data Protection or with unjustified delay.",
        "Failure to process personal data in accordance with the provisions of the contract with the data controller",
        "Failure to sign contracts containing confidentiality and appropriate treatment of personal data clauses with the personnel in charge of the treatment of personal data or whoever has knowledge of the personal data.",
        "Not to delete the personal data transferred or communicated to the person in charge of the processing of personal data, once its assignment has been completed.",
        "Processing personal data without respecting the principles and rights established in the Organic Law for the Protection of Personal Data, its regulations and the rules issued by the Authority for the Protection of Personal Data."
      ],
      "ley-organica-proteccion-datos-personales:type_authority": "Public",
      "ley-organica-proteccion-datos-personales:type_of_organism_participation": "Alone or together with others",
      "ley-organica-proteccion-datos-personales:type_of_person": "Natural or Legal"
    },
