      "@type": [
        "owl:ObjectProperty",
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "ley-organica-proteccion-datos-personales:Members_of_the_personal_data_protection_system"
      },
      "rdfs:subPropertyOf": {
        "@id": "ley-organica-proteccion-datos-personales:Members_of_the_personal_data_protection_system"
      }
    },
    {
      "@id": "ley-organica-proteccion-datos-personales:organic_law_on_personal_data_protection",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Organic_Law_on_Personal_Data_Protection"
      ],
      "ley-organica-proteccion-datos-personales:target": "The fundamental purpose of the Organic Law on Personal Data Protection is to ensure the effective application of the right to the protection of personal data. This right covers both access to and decision-making on information and data of a personal nature and the guarantee of their due protection. To this end, the law regulates, foresees and develops principles, rights, obligations and protection mechanisms necessary to comprehensively safeguard the privacy and security of personal data."
    },
    {
      "@id": "ley-organica-proteccion-datos-personales:Holder_over_17_years_old",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "ley-organica-proteccion-datos-personales:Data_Owner"
      }
    },
    {
      "@id": "ley-organica-proteccion-datos-personales:application_favorable_to_the_owner",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Application_favorable_to_the_owner"
      ],
      "ley-organica-proteccion-datos-personales:description": "In situations where there is uncertainty as to how to interpret and apply the legal or contractual provisions related to the protection of personal data, judicial and administrative officials must opt for the interpretation that benefits the owner of such data, i.e., the owner must be favored in terms of protection and safeguarding of his personal data in case of ambiguity or doubt in the application of the Organic Law for the Protection of Personal Data."
    },
    {
      "@id": "ley-organica-proteccion-datos-personales:right_to_information",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Right_to_information"
      ],
      "ley-organica-proteccion-datos-personales:know_in_the_right_to_information": [
        "Any other purpose or additional treatment",
        "How to exercise your rights of access, deletion, rectification, updating, opposition, cancellation, limitation of processing and not to be subject to automatic decisions.",
        "Identity and contact details of the personal data protection officer, if applicable",
        "The different types of treatment",
        "The existence of a database containing your personal data",
        "The existence of automated evaluations and decisions, including profiling",
        "The identity and contact details of the person responsible for processing personal data, including address, telephone number and e-mail address",
        "The impact of providing incorrect or inaccurate personal data",
        "The legal basis for the treatment",
        "The option to revoke consent at any time",
        "The origin of the personal data if it was not obtained directly from the data subject.",
        "The period during which the data will be kept",
        "The possible consequences for the holder if he/she provides or refuses to provide his/her personal data",
        "Treatment purposes",
        "Where and how to file complaints with the data controller and the Personal Data Protection Authority"
      ],
      "ley-organica-proteccion-datos-personales:must_be_aware_of_the_possibility_of_realizing": {
        "@id": "ley-organica-proteccion-datos-personales:revocation_of_consent"
      },
      "ley-organica-proteccion-datos-personales:must_comply_with_the_principles_of": [
        {
          "@id": "ley-organica-proteccion-datos-personales:loyalty"
        },
        {
          "@id": "ley-organica-proteccion-datos-personales:transparency"
        }
      ]
    },
    {
