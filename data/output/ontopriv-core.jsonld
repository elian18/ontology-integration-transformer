      "ley-organica-proteccion-datos-personales:data_not_subject_to_processing_according_to_the_right_to_not_be_the_object_of_automated_decisions": [
        "Sensitive data of children and adolescents may not be processed unless expressly authorized by the legal representative.",
        "Sensitive data of the data subject may not be processed without his/her express authorization."
      ],
      "ley-organica-proteccion-datos-personales:data_related_to": [
        "Cultural identity",
        "Datos biométricos",
        "Ethnicity",
        "Gender Identity",
        "Genetic data",
