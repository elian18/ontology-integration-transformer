      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Turnover"
      ],
      "ley-organica-proteccion-datos-personales:description": "This refers to the total income generated by the sale of products and the rendering of services carried out by commercial entities during the last fiscal year corresponding to their activities, which is calculated by deducting Value Added Tax (VAT) and other taxes directly related to economic operations."
    },
    {
      "@id": "ley-organica-proteccion-datos-personales:Profile_making",
      "@type": [
        "owl:DatatypeProperty",
        "owl:Class"
      ],
      "rdfs:subClassOf": {
