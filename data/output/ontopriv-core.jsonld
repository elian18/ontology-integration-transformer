    {
      "@id": "ley-organica-proteccion-datos-personales:specialized_subject_data",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Specialized_subject_data"
      ],
      "ley-organica-proteccion-datos-personales:description": "Data subject to specific regulations established by other Ecuadorian or foreign laws.",
      "ley-organica-proteccion-datos-personales:regulated_treatment_in_specialized_regulations_regarding": [
        "Datos en materia de desastres naturales, es decir, eventos catastróficos causados por fenómenos naturales como terremotos, huracanes, inundaciones, incendios forestales, entre otros, que pueden causar daños significativos a la vida, la propiedad y el medio ambiente",
        "Datos en materia de sectores regulados, es decir, áreas de actividad que están sujetas a regulaciones detalladas y específicas establecidas por leyes o normativas sectoriales ecuatoriana",
        "Freedom of expression data, i.e. the fundamental right of individuals to express their opinions, ideas and thoughts without censorship or repression by the State or other entities",
        "National security and state defense data, i.e. activities and policies aimed at protecting the territorial integrity, sovereignty and national interests of a country against internal and external threats, including acts of terrorism, espionage and military aggression.",
        "Personal data provided to administrative or judicial authorities, i.e. personal data that must be provided to government authorities, whether administrative (e.g. government agencies) or judicial (e.g. courts), in compliance with lawful requests supported by law and in the exercise of their lawful powers.",
        "Risk management data, i.e., processes and practices used to identify, assess and mitigate potential risks faced by organizations in their business activities or service delivery."
      ],
      "ley-organica-proteccion-datos-personales:shall_at_least_comply_with_the_minimum_with": {
        "@id": "ley-organica-proteccion-datos-personales:minimum_criteria"
      },
      "ley-organica-proteccion-datos-personales:will_be_subject_to": [
        "If necessary, compliance with international human rights standards shall be ensured.",
        "Principles established in specialized regulations",
        "Principles of the Organic Law for the Protection of Personal Data"
      ]
    },
