    {
      "@id": "ley-organica-proteccion-datos-personales:legal_representative_owner",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Legal_representative_owner"
      ],
      "ley-organica-proteccion-datos-personales:activity_of_the_legal_representative_owner": [
        "Ensure that the rights and privacy of the owner he/she represents are respected at all times.",
        "Make informed decisions about the processing of the personal data of the owner he/she represents.",
        "Provide consent for the processing of data on behalf of the data subject he/she represents."
      ],
      "ley-organica-proteccion-datos-personales:description": "The legal representative of an owner who is unable to give consent acts on behalf of and in the interest of the owner in situations where the owner is unable to give consent due to incapacity, minority or other similar circumstances."
    },
