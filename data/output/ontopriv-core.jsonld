    {
      "@id": "ley-organica-proteccion-datos-personales:deceased_persons_data",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Deceased_persons_data"
      ],
      "ley-organica-proteccion-datos-personales:explanation_of_concept_of_inapplicability": "This exemption establishes that the law does not apply to data related to deceased individuals, recognizing the special nature of post mortem information. The exemption allows the processing of data relating to individuals who are deceased, without being subject to the general provisions of this law."
    },
    {
      "@id": "ley-organica-proteccion-datos-personales:delegate",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Delegate"
      ],
      "ley-organica-proteccion-datos-personales:a_data_protection_delegate_will_be_assigned": [
        "When it refers to the large-scale processing of special categories of data, in accordance with the provisions of the regulations of the Organic Law on Personal Data Protection.",
        "When the activities of the person responsible for or in charge of the processing of personal data require a permanent and systematized control due to the volume, nature, scope or purposes of the processing, as established in the Organic Law for the Protection of Personal Data or in the regulations issued by the Authority for the Protection of Personal Data.",
        "When the data processing is not related to national security or defense of the State, and does not involve classified or confidential information as stipulated in the specialized laws in this area.",
        "When the treatment is carried out by those who make up the public sector in accordance with Article 225 of the Constitution of the Republic."
      ],
      "ley-organica-proteccion-datos-personales:contact_data": [
        "E-mail address",
        "Home address",
        "Names and surnames",
        "Telephone number"
      ],
      "ley-organica-proteccion-datos-personales:control_functions": [
        "Advise on risk analysis, impact assessment and evaluation of security measures, and supervise their implementation.",
        "Advise the responsible party, the personnel of the responsible party and the person in charge of the processing of personal data, on the provisions contained in the Organic Law for the Protection of Personal Data, the regulations, directives, guidelines and other regulations issued by the Authority for the Protection of Personal Data.",
        "Cooperate with the Personal Data Protection Authority and act as a point of contact with such entity, in relation to issues concerning the processing of personal data.",
        "Perform such other functions as the Personal Data Protection Authority may assign, especially in the case of special categories of personal data.",
        "Supervise compliance with the provisions contained in the Personal Data Protection Law and the regulations, directives, guidelines and other regulations issued by the Personal Data Protection Authority."
      ],
      "ley-organica-proteccion-datos-personales:is_related_to": {
