      }
    },
    {
      "@id": "ley-organica-proteccion-datos-personales:proportionality",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Proportionality"
      ],
      "ley-organica-proteccion-datos-personales:description": "It involves ensuring that the way in which personal data is handled is balanced and appropriate in relation to the purposes for which the data was collected and the nature of the information involved"
    },
    {
      "@id": "ley-organica-proteccion-datos-personales:territorial_application",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Territorial"
      ],
      "ley-organica-proteccion-datos-personales:scope_of_legislation": "The Organic Law on Personal Data Protection will apply in certain scenarios, notwithstanding the existence of other international rules or regulations, i.e., the Organic Law on Personal Data Protection will apply regardless of any other international regulations that may exist.",
      "ley-organica-proteccion-datos-personales:the_law_applies_in": [
        {
          "@id": "ley-organica-proteccion-datos-personales:data_processing"
        },
        {
          "@id": "ley-organica-proteccion-datos-personales:location_of_the_personal_data_protection_system_members"
        }
      ]
    },
    {
      "@id": "ley-organica-proteccion-datos-personales:exceptions_to_rights_for_rectification_update_deletion_and_opposition",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Exceptions_of_rights"
      ],
      "ley-organica-proteccion-datos-personales:for": [
        {
          "@id": "ley-organica-proteccion-datos-personales:right_of_deletion"
        },
        {
          "@id": "ley-organica-proteccion-datos-personales:right_of_opposition"
        },
        {
          "@id": "ley-organica-proteccion-datos-personales:right_to_correction_and_update"
        }
      ],
      "ley-organica-proteccion-datos-personales:rights_to_correct_update_update_delete_and_oppose": [
        "If the applicant is not the owner of the personal data or his legal representative is not duly accredited.",
        "In situations where the public interest is involved, the processing of personal data will be allowed, as long as international human rights standards are respected, the principles of the Organic Law for the Protection of Personal Data are complied with and the minimum criteria established by this law are followed.",
        "In the processing of personal data that are necessary for the filing of information that is part of the State's patrimony, for scientific, historical or statistical research.",
        "When it may cause damage to rights or affect the legitimate interests of third parties and this is accredited by the database controller at the time of responding to the data subject's request to exercise the respective right, i.e., if the database controller can demonstrate that complying with the data subject's request could damage the rights or legitimate interests of other persons, then it may refuse to comply with the request.",
        "When it may hinder judicial or administrative proceedings in progress, duly notified.",
        "When the data are necessary for the formulation, exercise or defense of claims or appeals.",
        "When the data are necessary to comply with a court order, resolution or reasoned mandate from a competent public authority.",
        "When the data are necessary to exercise the right to freedom of expression and opinion.",
        "When the data is necessary for the fulfillment of a legal or contractual obligation.",
        "When the data is necessary to protect the vital interest of the data subject or another natural person."
      ]
    },
