    {
      "@id": "ley-organica-proteccion-datos-personales:relevance_of_personal_data",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Relevance"
      ],
      "ley-organica-proteccion-datos-personales:description": "That the data collected must be relevant and directly related to the specific purpose for which it is collected."
    },
    {
      "@id": "ley-organica-proteccion-datos-personales:deceased_owner",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Deceased_owner"
      ],
      "ley-organica-proteccion-datos-personales:account_with_a": {
        "@id": "ley-organica-proteccion-datos-personales:successor_right_holder"
      },
      "ley-organica-proteccion-datos-personales:description": "An individual who, in life, was the owner of personal data and has died."
    },
    {
      "@id": "ley-organica-proteccion-datos-personales:Purpose",
      "@type": [
        "owl:ObjectProperty",
        "owl:Class",
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Purpose"
      ],
      "ley-organica-proteccion-datos-personales:description": "Personal data may not be processed for purposes other than those established at the time of collection, unless the conditions permitting further processing as set forth in the Organic Law on the Protection of Personal Data are met.",
      "ley-organica-proteccion-datos-personales:is_distinct_from_data_collection_in_the": {
        "@id": "ley-organica-proteccion-datos-personales:data_processing"
      },
      "ley-organica-proteccion-datos-personales:shall_be": [
        "Communicated to the owner of the data, therefore, the owner of the data must be informed in a clear and understandable manner about the purposes of the processing, so that he/she can make informed decisions about the use of his/her personal data.",
        "Determined, i.e., they must be specific and well defined, without ambiguity, so that it is clear what will be done with the data collected.",
        "Explicit, i.e. they must be transparent and easily understandable for the data subject, without leaving room for confusing interpretations.",
        "Legitimate, which means that they must be based on valid legal grounds and comply with data protection regulations."
      ],
      "rdfs:subClassOf": {
        "@id": "ley-organica-proteccion-datos-personales:Principles"
      },
      "rdfs:subPropertyOf": {
        "@id": "ley-organica-proteccion-datos-personales:Principles"
      }
    },
    {
      "@id": "ley-organica-proteccion-datos-personales:security",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Security"
      ],
      "ley-organica-proteccion-datos-personales:description": "Implementation of adequate and necessary measures to protect personal data against risks, threats and vulnerabilities, considering the current state of technology",
      "ley-organica-proteccion-datos-personales:responsible_for_implementing_safety_measures": [
        {
          "@id": "ley-organica-proteccion-datos-personales:data_processor"
        },
        {
          "@id": "ley-organica-proteccion-datos-personales:responsible_for_treatment"
        }
      ],
      "ley-organica-proteccion-datos-personales:types_of_safety_measures": [
        "Organizational measures, i.e. measures that refer to the internal policies, procedures and structures that an organization implements to protect personal data.",
        "Technical measures, i.e. measures that involve the use of technology to protect personal data, these may include the use of firewalls, data encryption, intrusion detection software, biometric access controls, among others.",
        "Type of measures covering aspects such as physical security of equipment and data centers, risk management, business continuity and security incident response."
      ]
    },
    {
      "@id": "ley-organica-proteccion-datos-personales:personal_data",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Personal_data"
      ],
      "ley-organica-proteccion-datos-personales:description": "Data that identifies or makes identifiable a natural person, directly or indirectly.",
      "ley-organica-proteccion-datos-personales:it_is_not_imputable_to_be_inaccurate_when": [
        "If the inaccurate data was obtained directly by the controller from the data subject",
        "If the inaccurate data were obtained by the data controller from a public record",
        "If the inaccurate data were obtained by the data controller through an intermediary, following the regulations applicable in the sector that allow the intervention of an intermediary to collect and transmit the data to the data controller"
      ],
      "ley-organica-proteccion-datos-personales:must_comply_with": {
        "@id": "ley-organica-proteccion-datos-personales:principios"
      },
      "ley-organica-proteccion-datos-personales:personal_data_are_composed_of": [
        {
          "@id": "ley-organica-proteccion-datos-personales:biometric_data"
        },
        {
          "@id": "ley-organica-proteccion-datos-personales:credit_data"
        },
        {
          "@id": "ley-organica-proteccion-datos-personales:deceased_persons_data"
        },
        {
          "@id": "ley-organica-proteccion-datos-personales:genetic_data"
        },
        {
          "@id": "ley-organica-proteccion-datos-personales:health_related_data"
        },
        {
          "@id": "ley-organica-proteccion-datos-personales:sensitive_data"
        },
        {
          "@id": "ley-organica-proteccion-datos-personales:specialized_subject_data"
        }
      ],
      "ley-organica-proteccion-datos-personales:to_comply_with_quality_you_must": [
        "Accurate, i.e. the personal data must be precise and faithfully reflect the reality or situation they represent, without errors, contradictions or inaccuracies.",
        "Accurate, that personal data must be correct and accurately reflect reality without errors or inaccuracies.",
        "Clear, i.e. personal data must be understandable and not give rise to ambiguous or confusing interpretations.",
        "Complete, i.e. the personal data must include all relevant and necessary details for the purpose of processing, without omitting important information.",
        "Integral, that is to say, the personal data must not have been altered, modified or corrupted in any way that affects its veracity.",
        "Updated, i.e. personal data must reflect the most recent situation of the person or object to which it refers, and be modified or updated when necessary to maintain its validity.",
        "Verifiable, i.e. personal data must be verifiable and capable of being checked against reliable sources or evidence to confirm its authenticity and validity."
      ]
    },
    {
      "@id": "ley-organica-proteccion-datos-personales:must_provide_training_and_information",
