    {
      "@id": "ley-organica-proteccion-datos-personales:location_of_the_personal_data_protection_system_members",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Location_of_the_personal_data_protection_system_integrants"
      ],
      "ley-organica-proteccion-datos-personales:territorial_application_scenario": [
        "If the controller or processor of personal data is not domiciled in the national territory, the Organic Law on Personal Data Protection may apply due to a specific contract or public international law regulations. In other words, even if the controller or processor does not reside in Ecuador, they may be subject to comply with the country's data protection law due to contractual agreements or international regulations.",
        "If the data subject resides in Ecuador and the controller or processor has no establishment in the country, and the data processing is linked to activities that include the offer of goods or services to data subjects, whether or not it involves payment, or is intended to monitor their behavior, provided that such monitoring is carried out within Ecuadorian territory.",
        "If the person in charge of or responsible for the processing of personal data is domiciled in any part of national territory"
      ]
    },
    {
      "@id": "ley-organica-proteccion-datos-personales:obtaining_personal_data_directly_by_the_owner",
