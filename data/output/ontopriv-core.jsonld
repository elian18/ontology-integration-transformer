      ],
      "ley-organica-proteccion-datos-personales:data_processing_is_intended_for_individuals": "Natural",
      "ley-organica-proteccion-datos-personales:description": "Refers to any personal data processing process that aims to evaluate, analyze or predict various aspects of a natural person.",
      "ley-organica-proteccion-datos-personales:to_determine_behaviors_or_standards_relative_to": [
        "Economic situation",
        "Health",
        "Intereses",
        "Location",
        "Other similar aspects",
        "Personal preferences",
        "Physical movement",
        "Professional performance",
        "Skills"
      ]
