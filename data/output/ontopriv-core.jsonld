    {
      "@id": "ley-organica-proteccion-datos-personales:sensitive_data_processing",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Sensitive_data_processing"
      ],
      "ley-organica-proteccion-datos-personales:description": "The processing of sensitive personal data is prohibited, except in specific situations where it is justified.",
      "ley-organica-proteccion-datos-personales:sensitive_data_processing_scenarios": [
        "The owner has given his/her explicit consent for the processing of his/her personal data, clearly specifying the purposes for which the data is to be processed.",
        "The processing is necessary for archiving purposes in the public interest, scientific or historical research purposes or statistical purposes.",
        "The processing is necessary for the performance of obligations and exercise of rights specific to the controller or the data subject in the field of labor law, social security and social protection.",
        "The processing is necessary to protect the vital interests of the data subject or of another natural person, in the event that the data subject is physically or legally incapable of giving consent.",
        "The processing relates to personal data that the data subject has manifestly made public",
        "Treatment is performed by order of a judicial authority."
      ]
    },
