      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Successor_right_holder"
      ],
      "ley-organica-proteccion-datos-personales:description": "Person or entity legally appointed to represent and exercise the rights and obligations related to the personal data of a deceased individual.",
      "ley-organica-proteccion-datos-personales:exercise_of_rights_by_the_deceased_owner": "To contact the person responsible for the processing of personal data in order to request access, rectification and updating or deletion of the personal data of the deceased person he/she represents."
    },
    {
      "@id": "ley-organica-proteccion-datos-personales:proactive_and_demonstrated_accountability",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Proactive_and_demonstrated_accountability"
      ],
      "ley-organica-proteccion-datos-personales:description": "The person or entity responsible for handling personal data must take measures in advance to protect that information and personal data, which implies demonstrating that mechanisms and actions have been implemented to ensure that the data are handled securely and in accordance with the Organic Law on Personal Data Protection.",
      "ley-organica-proteccion-datos-personales:is_implemented_by": {
        "@id": "ley-organica-proteccion-datos-personales:responsible_for_treatment"
      }
    },
