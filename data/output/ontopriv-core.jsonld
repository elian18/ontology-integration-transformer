    {
      "@id": "ley-organica-proteccion-datos-personales:responsible_for_treatment",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Data_Controller"
      ],
      "ley-organica-proteccion-datos-personales:accrediting_compliance_with_the_mechanisms": [
        "Implementation of certification systems, which are formal processes through which an independent entity evaluates and verifies compliance with the requirements established in standards, regulations or norms related to data protection.",
        "Make use of self- and co-regulatory schemes, i.e. programs or frameworks in which organizations voluntarily commit to comply with certain data protection standards and principles.",
        "Use of best practices, i.e. recommended methods and processes that have proven to be effective in the protection of personal data.",
        "Use of protection codes, which are associated with a set of principles, guidelines and specific rules established by data protection authorities to regulate the handling of personal data in certain sectors or contexts.",
        "Use of standards, i.e., follow guidelines and criteria established by internationally recognized organizations for the handling and protection of personal data."
      ],
      "ley-organica-proteccion-datos-personales:activity_in_respect_to_proactive_and_demonstrated_responsibility": [
        "Implementation of mechanisms for the protection of personal data, which implies guaranteeing compliance with the principles, rights and obligations established in the Organic Law for the Protection of Personal Data.",
        "To demonstrate compliance with these mechanisms and applicable regulations, that is, to have evidence and documents that demonstrate that the mechanisms and applicable regulations are being followed."
      ],
      "ley-organica-proteccion-datos-personales:activity_within_opposition_law": "The controller shall cease processing the personal data, unless it can demonstrate compelling legitimate grounds justifying the processing which outweigh the interests, rights and freedoms of the data subject, or for the purposes of the lodging, exercise or defense of claims.",
      "ley-organica-proteccion-datos-personales:activity_within_right_of_access": {
        "@type": "rdf:langString",
        "@value": "The person responsible for the processing of personal data must implement adequate means to facilitate the exercise of the right of access by the data subject"
      },
      "ley-organica-proteccion-datos-personales:activity_within_the_right_of_correction_and_update": "The data controller must respond to requests for rectification and updating, and if necessary, inform the recipient of the data so that he/she can also carry out the corresponding update.",
      "ley-organica-proteccion-datos-personales:activity_within_the_right_of_deletion": "The controller shall implement methods and techniques aimed at deleting, rendering unreadable, or rendering unrecognizable in a definitive and secure manner personal data.",
      "ley-organica-proteccion-datos-personales:contact_data": [
        "Address of legal domicile",
        "E-mail address",
        "Names and surnames",
        "Telephone number"
      ],
      "ley-organica-proteccion-datos-personales:control_functions": "Responsible for deciding on the purpose and processing of personal data",
      "ley-organica-proteccion-datos-personales:deadline_in_days_for_the_right_of_access": {
        "@type": "xsd:integer",
        "@value": "15"
      },
      "ley-organica-proteccion-datos-personales:deadline_in_days_for_the_right_to_oppose_opposition": {
        "@type": "xsd:integer",
        "@value": "15"
      },
      "ley-organica-proteccion-datos-personales:delegate_comments": [
        "Ensure that the involvement of the personal data protection officer, in all matters relating to personal data protection, is appropriate and timely.",
        "Ensure that the personal data protection officer establishes direct communication with the highest executive and decision-making levels of the data controller.",
        "Facilitate access to the personal data of the processing operations, as well as all the resources and elements necessary to guarantee the correct and free performance of its functions.",
        "They may not dismiss or sanction the personal data protection officer for the proper performance of his or her duties.",
        "Train and update the personal data protection officer on the subject, in accordance with the technical regulations issued by the Personal Data Protection Authority."
      ],
      "ley-organica-proteccion-datos-personales:in_the_event_of_a_challenge_of_data_exaccuracy": "The accuracy of the personal data must be verified, so it must be placed in the database, where the challenged information is contained, that it has been the subject of disagreement by the data owner.",
      "ley-organica-proteccion-datos-personales:is_related_to": [
        {
          "@id": "ley-organica-proteccion-datos-personales:delegate"
        },
        {
          "@id": "ley-organica-proteccion-datos-personales:personal_data_protection_authority"
        }
      ],
      "ley-organica-proteccion-datos-personales:minor_infractions": [
        "Choosing a processor of personal data that does not offer sufficient guarantees to make effective the exercise of the right to the protection of personal data.",
        "Failure to attend, late or unjustified response to requests or complaints from the holder",
        "Failure to comply with the corrective measures ordered by the Personal Data Protection Authority.",
        "Failure to implement data protection by design and by default",
        "Failure to maintain available personal data protection policies related to the processing of personal data"
      ],
      "ley-organica-proteccion-datos-personales:must_have_been_complied_with_regard_to_proactive_responsibility": [
        {
          "@id": "ley-organica-proteccion-datos-personales:principios"
        },
        {
          "@id": "ley-organica-proteccion-datos-personales:rights"
        }
      ],
      "ley-organica-proteccion-datos-personales:must_render_accounts_regarding_the_treatment_with": [
        {
          "@id": "ley-organica-proteccion-datos-personales:data_owner"
        },
        {
          "@id": "ley-organica-proteccion-datos-personales:personal_data_protection_authority"
        }
      ],
      "ley-organica-proteccion-datos-personales:nature_of_the_entity": "Public or Private",
      "ley-organica-proteccion-datos-personales:obligations": [
        "Allowing audits and inspections by accredited auditors",
        "Comply with any other obligation established by applicable regulations or other Ecuadorian laws.",
        "Conduct security adequacy assessments prior to the processing of personal data.",
        "Designate a Data Protection Officer when necessary.",
        "Develop customized data protection policies",
        "Ensuring that data controllers comply with regulations and best practices",
        "Establish confidentiality agreements with personnel and processors.",
        "Implement administrative, technical and legal measures to guarantee the proper treatment of data",
        "Integrate data protection from system design onwards",
        "Maintain the National Registry of Personal Data Protection up to date.",
        "Notifying the Personal Data Protection Authority and the data owner of violations of the security measures implemented for the processing of personal data in accordance with the procedure established for this purpose.",
        "Periodically evaluate the effectiveness of the administrative, technical and legal measures adopted.",
        "Take the necessary technological, physical, administrative, organizational and legal measures to prevent, deter, reduce, mitigate and control identified risks and breaches.",
        "Treat personal data in accordance with the Organic Law on Personal Data Protection and relevant regulations.",
        "Use risk analysis and management methodologies adapted to the particularities of data processing and the parties involved."
      ],
      "ley-organica-proteccion-datos-personales:serious_infractions": [
        "Do not sign contracts that include confidentiality clauses with those who handle personal data.",
        "Failure to allow or cooperate with audits or inspections by an accredited auditor",
        "Failure to comply with corrective measures or insufficient compliance, especially if previous sanctions have been imposed for minor infractions and there is a recidivism.",
        "Failure to conduct impact assessments when necessary",
        "Failure to designate a data protection officer when necessary",
        "Failure to implement measures to prevent and control data security risks",
        "Failure to inform the Data Protection Authority and the Data Controller about security breaches affecting individual rights.",
        "Failure to keep the National Data Protection Registry up to date as required.",
        "Failure to notify the holder of security breaches affecting his rights",
        "Failure to put in place adequate measures to protect personal data as required by law and relevant regulations",
        "Failure to register the required information in the National Data Protection Registry.",
        "Failure to use appropriate methodologies to analyze and manage the risks associated with personal data",
        "Sharing of personal data without following legal requirements and established procedures",
        "Using information or data for purposes other than those initially stated"
      ],
      "ley-organica-proteccion-datos-personales:time_of_attention_in_days_for_the_right_of_removal": {
        "@type": "xsd:decimal",
        "@value": "15"
      },
      "ley-organica-proteccion-datos-personales:time_of_attention_within_days_for_the_right_of_correction_and_update": {
        "@type": "xsd:integer",
        "@value": "15"
      },
      "ley-organica-proteccion-datos-personales:type_authority": "Public",
      "ley-organica-proteccion-datos-personales:type_of_organism_participation": "Alone or together with others",
      "ley-organica-proteccion-datos-personales:type_of_person": "Natural or Legal"
    },
