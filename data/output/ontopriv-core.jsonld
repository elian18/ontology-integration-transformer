      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Consent"
      ],
      "ley-organica-proteccion-datos-personales:characteristics_that_the_information_transferred_to_the_owner_must_have": [
        "Clear, simple and easy to understand language",
        "Preferably, the information should be available in the language chosen by the owner."
      ],
      "ley-organica-proteccion-datos-personales:conditions_for_legitimate_treatment": "By consent of the owner for the processing of his personal data for one or more specific purposes.",
      "ley-organica-proteccion-datos-personales:description": "Expression by which the owner of the personal data grants his/her authorization to the data controller to process such data.",
      "ley-organica-proteccion-datos-personales:for_health-related_data_without_consent": "The consent of the owner shall not be required for the processing of health data.",
      "ley-organica-proteccion-datos-personales:for_plurality_of_purposes": "It is necessary to specify that such consent is given for all the purposes for which consent is being requested.",
      "ley-organica-proteccion-datos-personales:how_the_information_may_be_transmitted_to_the_owner": "Within any testable mode",
      "ley-organica-proteccion-datos-personales:in_cases_of_direct_data_gathering_by_the": {
        "@id": "ley-organica-proteccion-datos-personales:data_owner"
      },
      "ley-organica-proteccion-datos-personales:in_the_case_of_no_direct_data_collection_by_the": {
        "@id": "ley-organica-proteccion-datos-personales:data_owner"
      },
      "ley-organica-proteccion-datos-personales:is_related_to": [
        {
          "@id": "ley-organica-proteccion-datos-personales:consent_defects"
        },
        {
          "@id": "ley-organica-proteccion-datos-personales:revocation_of_consent"
        }
      ],
      "ley-organica-proteccion-datos-personales:to_deal_with_and_communicate_personal_data_must": "The manifestation of the holder's will to do so must be counted, i.e., when the data subject has given his/her consent for the processing or communication of personal data to occur.",
      "ley-organica-proteccion-datos-personales:valid": [
        "Free from defects of consent",
        "Informed to ensure transparency and the right to information",
        "Specific with respect to the means and purposes of processing",
        "Unequivocal, no doubt about the authorization granted by the holder"
      ]
    },
