        },
        {
          "@id": "ley-organica-proteccion-datos-personales:transparency"
        }
      ],
      "ley-organica-proteccion-datos-personales:description": "La Ley Orgnánica de Protección de Datos Personale se regirá por un conjunto de principios, sin perjuicio de otros principios establecidos en la Constitución de la República, los instrumentos internacionales ratificados por el Estado u otras normas jurídicas"
    },
