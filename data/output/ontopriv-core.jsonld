    {
      "@id": "ley-organica-proteccion-datos-personales:exceptions_from_rights_for_the_right_to_automated_assessments",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Exceptions_of_rights"
      ],
      "ley-organica-proteccion-datos-personales:for": {
        "@id": "ley-organica-proteccion-datos-personales:right_not_to_be_object_to_automated_evaluations"
      },
      "ley-organica-proteccion-datos-personales:rights_to_not_be_the_object_of_automated_assessments": [
        "Is based on the explicit consent of the owner",
        "It is authorized by the applicable regulations, court order, resolution or reasoned mandate of the competent technical authority, for which adequate measures must be established to safeguard the fundamental rights and freedoms of the holder.",
        "The automated decision does not entail serious impacts or verifiable risks for the owner",
        "The automated decision is necessary for the conclusion or performance of a contract between the data subject and the controller or processor of personal data."
      ],
      "ley-organica-proteccion-datos-personales:the_right_to_not_be_object_to_automated_assessments_may_not_be_revocable": [
        "A data subject cannot be made to waive the right not to be subject to automated valuations in advance by means of contracts",
        "When a decision is made based only on automated assessments, the data subject must be clearly informed of his or her right not to be subjected to these automated assessments"
      ]
    },
    {
      "@id": "ley-organica-proteccion-datos-personales:health_related_data_processing",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Health_related_data_processing"
      ],
      "ley-organica-proteccion-datos-personales:application_scenarios_for_processing_of_data_without_consent": [
        "Treatment is necessary for reasons of public interest in the field of public health, such as in situations of serious health threats that transcend borders.",
        "Treatment is necessary to ensure high standards of quality and safety in medical care, medicines or medical devices.",
        "When the data processing is related to preventive medicine, the assessment of work capacity, medical diagnosis, the provision of medical or social assistance, or the management of health and social services.",
        "When treatment is vital to protect the patient's life and the patient is unable to give consent due to physical or legal status"
      ],
      "ley-organica-proteccion-datos-personales:health-related_data_collection_and_processing": "The institutions that make up the National Health System and health professionals may collect and process data related to the health of their patients who are or have been under treatment by those institutions.",
      "ley-organica-proteccion-datos-personales:in_respect_to_the": {
        "@id": "ley-organica-proteccion-datos-personales:consent"
      },
      "ley-organica-proteccion-datos-personales:purposes_of_the_processing_of_data_by_private_and_public_entities": "Scientific research purposes",
      "ley-organica-proteccion-datos-personales:scenarios_for_treatment_by_private_and_public_entities": [
        "Provided that the data processing is authorized by the Personal Data Protection Authority.",
        "Provided that the data used for the research are anonymized."
      ],
      "ley-organica-proteccion-datos-personales:shall_be_authorized_by": {
        "@id": "ley-organica-proteccion-datos-personales:personal_data_protection_authority"
      },
      "ley-organica-proteccion-datos-personales:supervise_treatment_in_health_service_management_activities": "Data processing in activities related to the management of health and social services may only be carried out by professionals subject to the duty of professional secrecy or under their supervision."
    },
    {
      "@id": "ley-organica-proteccion-datos-personales:the_right_to_not_be_object_to_automated_assessments_may_not_be_revocable",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": {
        "@id": "ley-organica-proteccion-datos-personales:Exceptions_of_rights"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "rdfs:subPropertyOf": {
        "@id": "ley-organica-proteccion-datos-personales:Exceptions_of_right"
      }
    },
    {
      "@id": "ley-organica-proteccion-datos-personales:rights_of_credit_data_owners",
      "@type": [
        "owl:NamedIndividual",
        "ley-organica-proteccion-datos-personales:Rights_of_credit_data_owners"
      ],
      "ley-organica-proteccion-datos-personales:mechanisms_to_secure_the_right_of_access_of_the_credit_data_holder": [
        "Delivery of printouts of the reports so that the owner of the credit data can verify the veracity and accuracy of its content, without being able to use it for credit or commercial purposes.",
        "Direct observation through screens that the credit reference service providers will make available on the holder of credit data"
      ],
      "ley-organica-proteccion-datos-personales:right_to_access_by_credit_data_holders": [
        "As often as requested by the credit data subject with respect to the information that credit reference service providers have about him/her.",
        "It shall be free of charge"
      ],
      "ley-organica-proteccion-datos-personales:right_to_update_correction_or_deletion_of_the_credit_data_holder": "The owner of the credit data may demand the right to update, rectify or delete the credit data before the sources of information through a written request.",
      "ley-organica-proteccion-datos-personales:rights_of_credit_data_holders": [
        "Personal access to the information of which it is the owner of credit data.",
        "That the credit report allows to know clearly and accurately the condition of your credit history.",
        "That the sources of information update, rectify or eliminate, as the case may be, information that is unlawful, false, inaccurate, erroneous, incomplete or outdated."
      ],
      "ley-organica-proteccion-datos-personales:source_of_information_activity_on_the_application": [
        "If the credit data review process is initiated, it is necessary to clearly indicate in the reports issued that the information that is the subject of the request is being reviewed at the request of the holder.",
        "The sources of information must resolve the request within a maximum period of 15 days from its submission, either admitting it or rejecting it with a detailed explanation of the reasons"
      ]
    },
