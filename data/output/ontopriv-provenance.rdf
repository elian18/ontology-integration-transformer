  <rdf:Description rdf:about="http://www.semanticweb.org/ontopriv-provenance#bridge-review-b475453f1f190906">
    <rdf:type rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="es">IA revisora: ImpactAssessment ↔ ImpactAssessment, coherente</rdfs:label>
    <rdfs:comment xml:lang="es">Dijo «coherente» (exactMatch): Ambos conceptos definen la actividad de evaluación realizada por el responsable para determinar el impacto de las operaciones de tratamiento sobre la protección de datos. Solo explica: no cambia el par ni entra a la ontología.</rdfs:comment>
    <prov:wasGeneratedBy rdf:resource="http://www.semanticweb.org/ontopriv-provenance#activity-bridge-review"/>
    <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/ontopriv-provenance#agent-llm-gemini-3-1-flash-lite"/>
    <prov:generatedAtTime rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-08T18:24:17+00:00</prov:generatedAtTime>
    <dct:subject rdf:resource="http://www.semanticweb.org/ontopriv-provenance#bridge-pair-b475453f1f190906"/>
  </rdf:Description>
