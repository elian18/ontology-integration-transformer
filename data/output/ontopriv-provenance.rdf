    <dct:subject rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#are_made_of"/>
    <prov:wasDerivedFrom rdf:resource="http://www.semanticweb.org/ontopriv-provenance#file-ontopriv"/>
    <dct:isPartOf rdf:resource="http://www.semanticweb.org/ontopriv-provenance#module-profile"/>
