  <rdf:Description rdf:about="http://www.semanticweb.org/ontopriv-provenance#agent-embeddings-sentence-transformers-paraphrase-multilingual-minilm-l12-v2">
    <rdf:type rdf:resource="http://www.w3.org/ns/prov#SoftwareAgent"/>
    <rdfs:label xml:lang="es">sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2</rdfs:label>
    <rdfs:comment xml:lang="es">Modelo de embeddings (sentence-transformers) que mide el parecido de significado entre un concepto y los términos del DPV.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontopriv-provenance#mapping-e8f1eed2e24f344c">
