    <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/ontopriv-provenance#agent-llm-gemini-3-1-flash-lite"/>
    <prov:hadPrimarySource rdf:resource="http://www.semanticweb.org/ontopriv-provenance#lopdp-art-12"/>
    <dct:isPartOf rdf:resource="http://www.semanticweb.org/ontopriv-provenance#file-proposed"/>
    <dct:subject rdf:resource="http://www.semanticweb.org/profiles/ecuador-lopdp#RightToInformation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontopriv-provenance#law-concept-5a81bd6a9abc65b4">
    <rdf:type rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="es">Derecho a no ser objeto de una decisión basada única o parcialmente en valoraciones automatizadas (AutomatedDecisionRight)</rdfs:label>
    <rdfs:comment xml:lang="es">Propuesto por la IA con base en el art. 20 de la LOPDP, como clase: Derecho del titular a no ser sometido a decisiones basadas en valoraciones producto de procesos automatizados, incluida la elaboración de perfiles, que produzcan efectos jurídicos o atenten contra sus derechos.</rdfs:comment>
    <prov:wasGeneratedBy rdf:resource="http://www.semanticweb.org/ontopriv-provenance#activity-law-extraction"/>
