  <rdf:Description rdf:about="http://www.semanticweb.org/ontopriv-provenance#bridge-review-99130ce962e71f9b">
    <rdf:type rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="es">IA revisora: Processing ↔ AutomatedProcessing, coherente</rdfs:label>
    <rdfs:comment xml:lang="es">Dijo «coherente» (narrowMatch): El concepto de la ley ecuatoriana es general sobre el procesamiento, mientras que el del GDPR se limita específicamente al procesamiento automatizado. Solo explica: no cambia el par ni entra a la ontología.</rdfs:comment>
    <prov:wasGeneratedBy rdf:resource="http://www.semanticweb.org/ontopriv-provenance#activity-bridge-review"/>
    <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/ontopriv-provenance#agent-llm-gemini-3-1-flash-lite"/>
