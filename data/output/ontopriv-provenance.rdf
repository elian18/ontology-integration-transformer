  <rdf:Description rdf:about="http://www.semanticweb.org/ontopriv-provenance#repair-134a708d1cb9f666">
    <rdf:type rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="es">R1 · are_composed_of</rdfs:label>
    <rdfs:comment xml:lang="es">R1 en el perfil: tenía 35 rangos (Application_favorable_to_the_owner, Certifying_entity, Confidentiality, Consent, Conservation, Data_Controller, Data_Owner, Data_Processor, Data_base, Data_processing, Data_types, Delegate, Independence_of_control, Juridicity, Legal_interest, Legality, Loyalty, Minimization, Minor_infractions_penalties, Need, Penalties_for_Serious_Infringements, Personal_data_protection_authority, Personal_data_protection_seals, Personal_data_security_vulnerability, Proactive_and_demonstrated_accountability, Profile_making, Proportionality, Pseudonymization, Purpose, Quality, Recipient, Relevance, Security, Source_accessible_to_the_public, Transparency); ahora tiene uno, la unión de esas clases (owl:unionOf), como pide P19 de OOPS!.</rdfs:comment>
    <prov:wasGeneratedBy rdf:resource="http://www.semanticweb.org/ontopriv-provenance#activity-repair-r1"/>
    <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/ontopriv-provenance#agent-system"/>
    <dct:subject rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#are_composed_of"/>
    <prov:wasDerivedFrom rdf:resource="http://www.semanticweb.org/ontopriv-provenance#file-ontopriv"/>
    <dct:isPartOf rdf:resource="http://www.semanticweb.org/ontopriv-provenance#module-profile"/>
  </rdf:Description>
