  <rdf:Description rdf:about="http://www.semanticweb.org/ontopriv-provenance#bridge-review-f7fb104ab359421d">
    <rdf:type rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="es">IA revisora: Processing ↔ Processing, coherente</rdfs:label>
    <rdfs:comment xml:lang="es">Dijo «coherente» (exactMatch): Ambos conceptos definen el procesamiento como cualquier actividad u operación realizada sobre los datos personales del titular. Solo explica: no cambia el par ni entra a la ontología.</rdfs:comment>
    <prov:wasGeneratedBy rdf:resource="http://www.semanticweb.org/ontopriv-provenance#activity-bridge-review"/>
    <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/ontopriv-provenance#agent-llm-gemini-3-1-flash-lite"/>
    <prov:generatedAtTime rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-08T18:24:10+00:00</prov:generatedAtTime>
    <dct:subject rdf:resource="http://www.semanticweb.org/ontopriv-provenance#bridge-pair-f7fb104ab359421d"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontopriv-provenance#bridge-review-e2a235ef000ce066">
    <rdf:type rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="es">IA revisora: ImpactAssessment ↔ FactorsForImpactAssessment, coherente</rdfs:label>
    <rdfs:comment xml:lang="es">Dijo «coherente» (exactMatch): Ambos conceptos describen el proceso obligatorio de evaluación para identificar riesgos o impactos en el tratamiento de datos personales. Solo explica: no cambia el par ni entra a la ontología.</rdfs:comment>
    <prov:wasGeneratedBy rdf:resource="http://www.semanticweb.org/ontopriv-provenance#activity-bridge-review"/>
    <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/ontopriv-provenance#agent-llm-gemini-3-1-flash-lite"/>
