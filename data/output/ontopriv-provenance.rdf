    <dct:isPartOf rdf:resource="http://www.semanticweb.org/ontopriv-provenance#file-proposed"/>
    <dct:subject rdf:resource="http://www.semanticweb.org/profiles/ecuador-lopdp#PortabilityRight"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontopriv-provenance#repair-508dddef4de8b21b">
    <rdf:type rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="es">R2 · are_destined_to</rdfs:label>
    <rdfs:comment xml:lang="es">R2 en el perfil: estaba declarada como propiedad de objeto y de datos a la vez; queda como propiedad de objeto y deja de ser propiedad de datos (es de datos solo si todos sus valores son textos). Uso: 1 valor recurso, 0 textos, 0 subpropiedades. Se quitaron los rangos que ya no le sirven: string.</rdfs:comment>
    <prov:wasGeneratedBy rdf:resource="http://www.semanticweb.org/ontopriv-provenance#activity-repair-r2"/>
