  <rdf:Description rdf:about="http://www.semanticweb.org/ontopriv-provenance#decidedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="es">decidido por</rdfs:label>
    <rdfs:label xml:lang="en">decided by</rdfs:label>
    <rdfs:comment xml:lang="es">Quién decidió la correspondencia, con los valores que usa el sistema en cada subida. En la base siempre es «base»: la decidió una persona en el Sprint 5 (quién y cuándo lo dicen prov:wasAttributedTo y prov:generatedAtTime).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontopriv-provenance#repair-31af70c7cb1e5317">
    <rdf:type rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="es">R1 · that_are_divided_into</rdfs:label>
    <rdfs:comment xml:lang="es">R1 en el perfil: tenía 4 rangos (Confidentiality_principles, Conservation_principles, Safety_principles, Transparency_principles); ahora tiene uno, la unión de esas clases (owl:unionOf), como pide P19 de OOPS!.</rdfs:comment>
    <prov:wasGeneratedBy rdf:resource="http://www.semanticweb.org/ontopriv-provenance#activity-repair-r1"/>
    <prov:wasAttributedTo rdf:resource="http://www.semanticweb.org/ontopriv-provenance#agent-system"/>
    <dct:subject rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#that_are_divided_into"/>
    <prov:wasDerivedFrom rdf:resource="http://www.semanticweb.org/ontopriv-provenance#file-ontopriv"/>
    <dct:isPartOf rdf:resource="http://www.semanticweb.org/ontopriv-provenance#module-profile"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontopriv-provenance#agent-llm-gemini-3-1-flash-lite">
    <rdf:type rdf:resource="http://www.w3.org/ns/prov#SoftwareAgent"/>
    <rdfs:label xml:lang="es">gemini-3.1-flash-lite</rdfs:label>
    <rdfs:comment xml:lang="es">Modelo de lenguaje que usa el sistema: propone o explica; nada de lo que dice entra a la base sin una persona o una regla.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontopriv-provenance#repair-07a6a95332d2126c">
    <rdf:type rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="es">R1 · Slight</rdfs:label>
    <rdfs:comment xml:lang="es">R1 en el perfil: tenía 3 dominios (Personal_Data_Protection_Authority_in_verification, Responsible_for_treatment_in_verification, Treatment_Manager_in_verification); ahora tiene uno, la unión de esas clases (owl:unionOf), como pide P19 de OOPS!.</rdfs:comment>
