    bridge:chainedBy dpv:CertificationSeal ;
    rdfs:comment "Encadenado por el DPV: OntoPriv Personal_data_protection_seals closeMatch dpv:CertificationSeal y GDPRtEXT SealsAndCertification exactMatch dpv:CertificationSeal."@es ;
