    rdfs:comment "Encadenado por el DPV: OntoPriv Processing exactMatch dpv:Processing y GDPRtEXT Processing exactMatch dpv:Processing."@es ;
    owl:annotatedProperty skos:closeMatch ;
    owl:annotatedSource <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Processing> ;
