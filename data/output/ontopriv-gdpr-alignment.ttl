[] a owl:Axiom ;
    bridge:chainedBy dpv:DataSecurityManagement ;
    rdfs:comment "Encadenado por el DPV: OntoPriv Personal_data_security closeMatch dpv:DataSecurityManagement y GDPRtEXT SecurityOfPersonalData closeMatch dpv:DataSecurityManagement."@es ;
