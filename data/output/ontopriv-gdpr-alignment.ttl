    rdfs:comment "Encadenado por el DPV: OntoPriv ImpactAssessment exactMatch dpv:ImpactAssessment y GDPRtEXT FactorsForImpactAssessment exactMatch dpv:ImpactAssessment."@es ;
    owl:annotatedProperty skos:closeMatch ;
