[] a owl:Axiom ;
    bridge:chainedBy dpv:PrivacyByDesign ;
    rdfs:comment "Encadenado por el DPV: OntoPriv Follow-up_from_design closeMatch dpv:PrivacyByDesign y GDPRtEXT DataProtectionByDesignAndByDefault exactMatch dpv:PrivacyByDesign."@es ;
    owl:annotatedProperty skos:closeMatch ;
    owl:annotatedSource <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Follow-up_from_design> ;
