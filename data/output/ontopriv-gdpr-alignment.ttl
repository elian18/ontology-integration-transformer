    rdfs:comment "Encadenado por el DPV: OntoPriv Exercise_of_rights closeMatch dpv:RightExerciseActivity y GDPRtEXT ExerciseRights closeMatch dpv:RightExerciseActivity."@es ;
    owl:annotatedProperty skos:closeMatch ;
    owl:annotatedSource <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Exercise_of_rights> ;
