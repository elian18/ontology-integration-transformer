    bridge:chainedBy dpv:DataSubject ;
    rdfs:comment "Encadenado por el DPV: OntoPriv Data_Owner exactMatch dpv:DataSubject y GDPRtEXT DataSubject exactMatch dpv:DataSubject."@es ;
