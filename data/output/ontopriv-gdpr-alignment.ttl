    bridge:chainedBy dpv:WithdrawConsent ;
    rdfs:comment "Encadenado por el DPV: OntoPriv Revocation_of_consent closeMatch dpv:WithdrawConsent y GDPRtEXT WithdrawingConsent closeMatch dpv:WithdrawConsent."@es ;
    owl:annotatedProperty skos:closeMatch ;
