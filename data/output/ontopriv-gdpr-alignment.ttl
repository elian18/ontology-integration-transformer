[] a owl:Axiom ;
    bridge:chainedBy dpv:Data ;
    rdfs:comment "Encadenado por el DPV: OntoPriv Data_types closeMatch dpv:Data y GDPRtEXT Data exactMatch dpv:Data."@es ;
