    rdfs:comment "Encadenado por el DPV: OntoPriv Public_interest closeMatch dpv:PublicInterest y GDPRtEXT PublicInterest closeMatch dpv:PublicInterest."@es ;
    owl:annotatedProperty skos:closeMatch ;
