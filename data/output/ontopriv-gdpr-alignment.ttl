    bridge:chainedBy dpv:Consent ;
    rdfs:comment "Encadenado por el DPV: OntoPriv Consent exactMatch dpv:Consent y GDPRtEXT ConsentActivity exactMatch dpv:Consent."@es ;
    owl:annotatedProperty skos:closeMatch ;
    owl:annotatedSource <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Consent> ;
    owl:annotatedTarget gdprtext:ConsentActivity ;
    owl:versionInfo "1" .

