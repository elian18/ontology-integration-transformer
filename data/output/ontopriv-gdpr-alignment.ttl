@prefix bridge: <http://www.semanticweb.org/profiles/ontopriv-gdpr-alignment#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix gdprtext: <http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://www.semanticweb.org/profiles/ontopriv-gdpr-alignment> a owl:Ontology ;
    rdfs:label "Puente de la base con el GDPR: OntoPriv y GDPRtEXT encadenados por el DPV"@es ;
    dct:references <http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT>,
        <https://w3id.org/dpv> ;
    rdfs:comment "Pares de un concepto de la base (OntoPriv + LOPDP) y uno de GDPRtEXT que se corresponden con el mismo término del DPV con exactMatch o closeMatch en los dos lados. Cada par se escribe con skos:closeMatch y su anotación dice el término del DPV por el que pasa. GDPRtEXT y el DPV se referencian por IRI; no se importan. La explicación de la IA revisora va aparte (ontopriv-gdpr-bridge.csv), no en la ontología."@es ;
    owl:imports <http://www.semanticweb.org/profiles/ecuador-lopdp-dpv-alignment> ;
    owl:versionInfo "1" .

bridge:chainedBy a owl:AnnotationProperty ;
    rdfs:label "encadenado por el DPV"@es ;
    rdfs:comment "Término del DPV con el que se corresponden los dos conceptos del par."@es .

<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_data_security> skos:closeMatch gdprtext:SecurityOfPersonalData .

<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Public_interest> skos:closeMatch gdprtext:PublicInterest .

<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Sources_accessible_to_the_public> skos:closeMatch gdprtext:MadePublicByDataSubject .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Anonymized_data> skos:closeMatch gdprtext:AnonymousData .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Controller> skos:closeMatch gdprtext:Controller .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Owner> skos:closeMatch gdprtext:DataSubject .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Processor> skos:closeMatch gdprtext:Processor .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_types> skos:closeMatch gdprtext:Data .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Exercise_of_rights> skos:closeMatch gdprtext:ExerciseRights .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Legal_interest> skos:closeMatch gdprtext:LegitimateInterest .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data> skos:closeMatch gdprtext:PersonalData .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_protection_authority> skos:closeMatch gdprtext:RegulatoryAuthority .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_protection_seals> skos:closeMatch gdprtext:SealsAndCertification .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights> skos:closeMatch gdprtext:Rights .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Sensitive_data> skos:closeMatch gdprtext:SensitivePersonalData .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Source_accessible_to_the_public> skos:closeMatch gdprtext:MadePublicByDataSubject .

<http://www.semanticweb.org/profiles/ecuador-lopdp#CodesOfConduct> skos:closeMatch gdprtext:CodeOfConduct .

<http://www.semanticweb.org/profiles/ecuador-lopdp#ConfidentialityAgreement> skos:closeMatch gdprtext:ImposeConfidentialityObligationOnPersonnel .

<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Follow-up_from_design> skos:closeMatch gdprtext:DataProtectionByDesignAndByDefault,
        gdprtext:PrivacyByDesign .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_processing> skos:closeMatch gdprtext:AutomatedProcessing,
        gdprtext:Processing .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Processing> skos:closeMatch gdprtext:AutomatedProcessing,
        gdprtext:Processing .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Revocation_of_consent> skos:closeMatch gdprtext:CanBeWithdrawnEasilyConsentObligation,
        gdprtext:WithdrawingConsent .

<http://www.semanticweb.org/profiles/ecuador-lopdp#ImpactAssessment> skos:closeMatch gdprtext:FactorsForImpactAssessment,
        gdprtext:ImpactAssessment .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Consent> skos:closeMatch gdprtext:Consent,
        gdprtext:ConsentActivity,
        gdprtext:GivenConsent .

[] a owl:Axiom ;
    bridge:chainedBy dpv:DataProcessor ;
    rdfs:comment "Encadenado por el DPV: OntoPriv Data_Processor exactMatch dpv:DataProcessor y GDPRtEXT Processor exactMatch dpv:DataProcessor."@es ;
    owl:annotatedProperty skos:closeMatch ;
    owl:annotatedSource <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Processor> ;
    owl:annotatedTarget gdprtext:Processor ;
    owl:versionInfo "1" .

[] a owl:Axiom ;
    bridge:chainedBy dpv:SensitivePersonalData ;
    rdfs:comment "Encadenado por el DPV: OntoPriv Sensitive_data closeMatch dpv:SensitivePersonalData y GDPRtEXT SensitivePersonalData exactMatch dpv:SensitivePersonalData."@es ;
    owl:annotatedProperty skos:closeMatch ;
    owl:annotatedSource <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Sensitive_data> ;
    owl:annotatedTarget gdprtext:SensitivePersonalData ;
    owl:versionInfo "1" .

[] a owl:Axiom ;
    bridge:chainedBy dpv:AnonymisedData ;
    rdfs:comment "Encadenado por el DPV: OntoPriv Anonymized_data closeMatch dpv:AnonymisedData y GDPRtEXT AnonymousData exactMatch dpv:AnonymisedData."@es ;
    owl:annotatedProperty skos:closeMatch ;
    owl:annotatedSource <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Anonymized_data> ;
    owl:annotatedTarget gdprtext:AnonymousData ;
    owl:versionInfo "1" .

[] a owl:Axiom ;
    bridge:chainedBy dpv:PublicDataSource ;
    rdfs:comment "Encadenado por el DPV: OntoPriv Sources_accessible_to_the_public exactMatch dpv:PublicDataSource y GDPRtEXT MadePublicByDataSubject exactMatch dpv:PublicDataSource."@es ;
    owl:annotatedProperty skos:closeMatch ;
    owl:annotatedSource <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Sources_accessible_to_the_public> ;
    owl:annotatedTarget gdprtext:MadePublicByDataSubject ;
    owl:versionInfo "1" .

[] a owl:Axiom ;
    bridge:chainedBy dpv:Processing ;
    rdfs:comment "Encadenado por el DPV: OntoPriv Data_processing exactMatch dpv:Processing y GDPRtEXT AutomatedProcessing exactMatch dpv:Processing."@es ;
    owl:annotatedProperty skos:closeMatch ;
    owl:annotatedSource <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_processing> ;
