    owl:versionInfo "1" .

[] a owl:Axiom ;
    bridge:chainedBy dpv:WithdrawConsent ;
    rdfs:comment "Encadenado por el DPV: OntoPriv Revocation_of_consent closeMatch dpv:WithdrawConsent y GDPRtEXT CanBeWithdrawnEasilyConsentObligation closeMatch dpv:WithdrawConsent."@es ;
    owl:annotatedProperty skos:closeMatch ;
    owl:annotatedSource <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Revocation_of_consent> ;
