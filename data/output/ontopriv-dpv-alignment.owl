  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#Recidivism">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="es">reincidencia</rdfs:label>
    <skos:definition xml:lang="es">Circunstancia donde la infracción precedente es de la misma naturaleza que la que se pretende sancionar.</skos:definition>
    <dcterms:source xml:lang="es">LOPDP, art. 71</dcterms:source>
    <skos:relatedMatch rdf:resource="https://w3id.org/dpv#RuleViolated"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Authorization_for_international_transfer">
