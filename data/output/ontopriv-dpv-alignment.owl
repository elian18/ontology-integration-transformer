    <skos:closeMatch rdf:resource="https://w3id.org/dpv#hasDataVolume"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#scope_of_legislation">
    <skos:relatedMatch rdf:resource="https://w3id.org/dpv#hasScope"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#DataBreachException">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="es">excepciones a la notificación de vulneración</rdfs:label>
    <skos:definition xml:lang="es">Casos específicos donde no es necesario notificar al titular sobre una vulneración de seguridad bajo condiciones demostrables.</skos:definition>
    <dcterms:source xml:lang="es">LOPDP, art. 46</dcterms:source>
    <skos:narrowMatch rdf:resource="https://w3id.org/dpv#DataBreachNotice"/>
  </rdf:Description>
