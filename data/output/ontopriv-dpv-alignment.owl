  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Deceased_persons_data">
    <skos:broadMatch rdf:resource="https://w3id.org/dpv#PersonalData"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Follow-up_from_design">
    <dcterms:source xml:lang="es">LOPDP, art. 39</dcterms:source>
    <dcterms:source xml:lang="es">LOPDP, art. 47</dcterms:source>
    <skos:closeMatch rdf:resource="https://w3id.org/dpv#PrivacyByDesign"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Protection_policies">
    <skos:broadMatch rdf:resource="https://w3id.org/dpv#hasPolicy"/>
