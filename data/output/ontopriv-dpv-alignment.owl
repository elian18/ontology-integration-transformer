  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Public_interest">
    <skos:closeMatch rdf:resource="https://w3id.org/dpv#PublicInterest"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Organic_Law_on_Personal_Data_Protection">
    <skos:broadMatch rdf:resource="https://w3id.org/dpv#Law"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Juridicity">
    <dcterms:source xml:lang="es">LOPDP, art. 10</dcterms:source>
    <skos:relatedMatch rdf:resource="https://w3id.org/dpv#Lawfulness"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#BindingCorporateRules">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="es">normas corporativas vinculantes</rdfs:label>
    <skos:definition xml:lang="es">Reglas de obligatorio cumplimiento para el grupo empresarial que regulan la transferencia internacional de datos.</skos:definition>
    <dcterms:source xml:lang="es">LOPDP, art. 58</dcterms:source>
    <skos:narrowMatch rdf:resource="https://w3id.org/dpv#ContractualTerms"/>
    <skos:broadMatch rdf:resource="https://w3id.org/dpv#LegalCompliance"/>
    <skos:relatedMatch rdf:resource="https://w3id.org/dpv#FulfilmentOfContractualObligation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Claims_defense">
    <skos:relatedMatch rdf:resource="https://w3id.org/dpv#DisputeManagement"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Need">
    <skos:relatedMatch rdf:resource="https://w3id.org/dpv#Necessity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#DataDeletionMethods">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="es">Métodos de eliminación</rdfs:label>
    <skos:definition xml:lang="es">Técnicas para hacer ilegibles o irreconocibles los datos de forma definitiva y segura.</skos:definition>
    <dcterms:source xml:lang="es">LOPDP, art. 15</dcterms:source>
    <skos:relatedMatch rdf:resource="https://w3id.org/dpv#DataDeletionPolicy"/>
    <skos:exactMatch rdf:resource="https://w3id.org/dpv#DataSanitisationTechnique"/>
    <skos:narrowMatch rdf:resource="https://w3id.org/dpv#DataRedaction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#duration_of_charge">
    <skos:broadMatch rdf:resource="https://w3id.org/dpv#hasDuration"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#ConfidentialityAgreement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="es">contratos de confidencialidad</rdfs:label>
    <skos:definition xml:lang="es">Instrumento legal para garantizar el manejo adecuado de datos personales por parte del personal y encargados.</skos:definition>
    <dcterms:source xml:lang="es">LOPDP, art. 47</dcterms:source>
    <skos:exactMatch rdf:resource="https://w3id.org/dpv#ConfidentialityAgreement"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Principles">
    <dcterms:source xml:lang="es">LOPDP, art. 57</dcterms:source>
    <skos:broadMatch rdf:resource="https://w3id.org/dpv#Principle"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp-dpv-alignment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:imports rdf:resource="http://www.semanticweb.org/profiles/ecuador-lopdp"/>
    <rdfs:label xml:lang="es">Alineación con el DPV del perfil Ecuador (LOPDP)</rdfs:label>
    <rdfs:comment xml:lang="es">Correspondencias SKOS aprobadas por revisión humana entre OntoPriv (núcleo + perfil) y el Data Privacy Vocabulary (DPV 2.3), más los conceptos nuevos extraídos de la ley y aprobados por una persona. El DPV se referencia por IRI; no se importa.</rdfs:comment>
    <dcterms:references rdf:resource="https://w3id.org/dpv"/>
    <dcterms:created>2026-11-25T02:46:47+00:00</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Special_personal_data_categories">
    <dcterms:source xml:lang="es">LOPDP, art. 25</dcterms:source>
    <skos:closeMatch rdf:resource="https://w3id.org/dpv#SpecialCategoryPersonalData"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Serious">
    <skos:relatedMatch rdf:resource="https://w3id.org/dpv#hasSeverity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#for_different_purpose">
    <skos:relatedMatch rdf:resource="https://w3id.org/dpv#hasPurpose"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Right_to_portability">
