  <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Anonymization">
    <dcterms:source xml:lang="es">LOPDP, art. 31</dcterms:source>
    <dcterms:source xml:lang="es">LOPDP, art. 4</dcterms:source>
    <skos:exactMatch rdf:resource="https://w3id.org/dpv#Anonymisation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#DataSecurityBreach">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="es">Vulneración de la seguridad de los datos personales</rdfs:label>
    <skos:definition xml:lang="es">Incidente de seguridad que afecta la confidencialidad, disponibilidad o integridad de los datos personales.</skos:definition>
    <dcterms:source xml:lang="es">LOPDP, art. 4</dcterms:source>
    <skos:relatedMatch rdf:resource="https://w3id.org/dpv#DataBreachRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Notification">
    <dcterms:source xml:lang="es">LOPDP, art. 43</dcterms:source>
    <skos:broadMatch rdf:resource="https://w3id.org/dpv#Notification"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Perform_evaluations">
    <skos:relatedMatch rdf:resource="https://w3id.org/dpv#hasAssessment"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Confidentiality">
    <dcterms:source xml:lang="es">LOPDP, art. 10</dcterms:source>
    <dcterms:source xml:lang="es">LOPDP, art. 50</dcterms:source>
    <skos:relatedMatch rdf:resource="https://w3id.org/dpv#ConfidentialData"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Data_protection_mechanisms">
    <skos:relatedMatch rdf:resource="https://w3id.org/dpv#DataSecurityManagement"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#contact_data">
    <skos:closeMatch rdf:resource="https://w3id.org/dpv#hasContact"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Authorized_consent">
    <skos:broadMatch rdf:resource="https://w3id.org/dpv#Consent"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#PrivacyByDefault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="es">protección de datos por defecto</rdfs:label>
    <skos:definition xml:lang="es">Obligación de tratar únicamente los datos personales estrictamente necesarios para cada fin específico.</skos:definition>
    <dcterms:source xml:lang="es">LOPDP, art. 39</dcterms:source>
    <skos:exactMatch rdf:resource="https://w3id.org/dpv#PrivacyByDefault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Pseudonymization">
    <skos:exactMatch rdf:resource="https://w3id.org/dpv#Pseudonymisation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Scope_of_application">
    <skos:closeMatch rdf:resource="https://w3id.org/dpv#hasScope"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Exercise_of_rights">
    <dcterms:source xml:lang="es">LOPDP, art. 24</dcterms:source>
    <skos:closeMatch rdf:resource="https://w3id.org/dpv#RightExerciseActivity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#SelfRegulation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="es">Autorregulación</rdfs:label>
    <skos:definition xml:lang="es">Facultad voluntaria de adherirse a códigos de conducta y certificaciones sin eximir la responsabilidad legal.</skos:definition>
    <dcterms:source xml:lang="es">LOPDP, art. 52</dcterms:source>
    <skos:broadMatch rdf:resource="https://w3id.org/dpv#CertificationSeal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#can_be_rights_of">
    <skos:relatedMatch rdf:resource="https://w3id.org/dpv#hasRight"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#DataDeletion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="es">eliminación de los datos</rdfs:label>
    <skos:definition xml:lang="es">Medida correctiva que consiste en suprimir los datos personales objeto de la infracción.</skos:definition>
    <dcterms:source xml:lang="es">LOPDP, art. 65</dcterms:source>
    <skos:relatedMatch rdf:resource="https://w3id.org/dpv#DataDeletionPolicy"/>
    <skos:exactMatch rdf:resource="https://w3id.org/dpv#Delete"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#MinorAutomatedDecisionRight">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="es">Derecho de niñas, niños y adolescentes a no ser objeto de una decisión basada única o parcialmente en valoraciones automatizadas</rdfs:label>
    <skos:definition xml:lang="es">Prohibición de tratar datos sensibles o de menores de edad mediante valoraciones automatizadas, salvo autorización expresa o interés público esencial.</skos:definition>
    <dcterms:source xml:lang="es">LOPDP, art. 21</dcterms:source>
    <skos:relatedMatch rdf:resource="https://w3id.org/dpv#AutomatedDecisionMaking"/>
    <skos:broadMatch rdf:resource="https://w3id.org/dpv#DataSubjectRight"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_digital_education">
    <dcterms:source xml:lang="es">LOPDP, art. 23</dcterms:source>
    <skos:broadMatch rdf:resource="https://w3id.org/dpv#DataSubjectRight"/>
    <skos:relatedMatch rdf:resource="https://w3id.org/dpv#DigitalLiteracy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#ImpactAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="es">evaluación de impacto del tratamiento de datos personales</rdfs:label>
    <skos:definition xml:lang="es">Proceso obligatorio realizado por el responsable para identificar riesgos altos en el tratamiento de datos personales.</skos:definition>
    <dcterms:source xml:lang="es">LOPDP, art. 42</dcterms:source>
    <skos:exactMatch rdf:resource="https://w3id.org/dpv#ImpactAssessment"/>
  </rdf:Description>
