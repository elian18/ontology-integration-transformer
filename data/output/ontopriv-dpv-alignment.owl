    <skos:closeMatch rdf:resource="https://w3id.org/dpv#hasImpactAssessment"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Obligations_of_the_responsible_person_and_manager">
    <skos:broadMatch rdf:resource="https://w3id.org/dpv#hasObligation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Legal_representative_owner">
    <skos:closeMatch rdf:resource="https://w3id.org/dpv#GuardianOfDataSubject"/>
  </rdf:Description>
