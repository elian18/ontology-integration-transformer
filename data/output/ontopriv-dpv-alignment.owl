>
  <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#justification_for_revocation">
    <skos:broadMatch rdf:resource="https://w3id.org/dpv#hasJustification"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#AdministrativeProcedure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="es">procedimiento administrativo</rdfs:label>
    <skos:definition xml:lang="es">Proceso formal ante la Autoridad de Protección de Datos cuando un requerimiento previo es negado o no contestado.</skos:definition>
    <dcterms:source xml:lang="es">LOPDP, art. 64</dcterms:source>
    <skos:relatedMatch rdf:resource="https://w3id.org/dpv#ApprovalProcedure"/>
    <skos:closeMatch rdf:resource="https://w3id.org/dpv#AuthorisationProcedure"/>
    <skos:broadMatch rdf:resource="https://w3id.org/dpv#GovernanceProcedures"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#CessationOfTreatment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="es">cese del tratamiento</rdfs:label>
    <skos:definition xml:lang="es">Medida correctiva que consiste en detener el tratamiento de datos bajo condiciones o plazos determinados.</skos:definition>
    <dcterms:source xml:lang="es">LOPDP, art. 65</dcterms:source>
    <skos:narrowMatch rdf:resource="https://w3id.org/dpv#UntilTimeDuration"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#RiskReport">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="es">Informe de riesgo</rdfs:label>
    <skos:definition xml:lang="es">Documento requerido por la Autoridad para verificar amenazas a los derechos de los titulares.</skos:definition>
    <dcterms:source xml:lang="es">LOPDP, art. 9</dcterms:source>
    <skos:closeMatch rdf:resource="https://w3id.org/dpv#RiskAssessment"/>
    <skos:broadMatch rdf:resource="https://w3id.org/dpv#RiskConcept"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Biometric_data">
    <dcterms:source xml:lang="es">LOPDP, art. 4</dcterms:source>
    <skos:broadMatch rdf:resource="https://w3id.org/dpv#SensitivePersonalData"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#types_of_safety_measures">
    <skos:relatedMatch rdf:resource="https://w3id.org/dpv#hasTechnicalOrganisationalMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#for_plurality_of_purposes">
    <skos:relatedMatch rdf:resource="https://w3id.org/dpv#hasPurpose"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#DirectRequirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="es">requerimiento directo</rdfs:label>
    <skos:definition xml:lang="es">Acción gratuita que puede ejercer el titular ante el responsable del tratamiento sobre sus derechos.</skos:definition>
    <dcterms:source xml:lang="es">LOPDP, art. 62</dcterms:source>
    <skos:closeMatch rdf:resource="https://w3id.org/dpv#RequestRequiresAction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Controller">
    <dcterms:source xml:lang="es">LOPDP, art. 17</dcterms:source>
    <dcterms:source xml:lang="es">LOPDP, art. 4</dcterms:source>
    <dcterms:source xml:lang="es">LOPDP, art. 9</dcterms:source>
    <dcterms:source xml:lang="es">LOPDP, art. 33</dcterms:source>
    <dcterms:source xml:lang="es">LOPDP, art. 57</dcterms:source>
    <dcterms:source xml:lang="es">LOPDP, art. 67</dcterms:source>
    <dcterms:source xml:lang="es">LOPDP, art. 41</dcterms:source>
    <dcterms:source xml:lang="es">LOPDP, art. 49</dcterms:source>
    <skos:exactMatch rdf:resource="https://w3id.org/dpv#DataController"/>
  </rdf:Description>
