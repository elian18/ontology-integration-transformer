<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Turnover> dcterms:source "LOPDP, art. 73"@es .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Violations> skos:relatedMatch dpv:RuleViolated .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#a_data_protection_delegate_will_be_assigned> skos:relatedMatch dpv:hasDataProtectionOfficer .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#affects_to> skos:closeMatch dpv:hasImpactOn .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#contact_data> skos:closeMatch dpv:hasContact .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#deadline_in_days_for_the_right_of_access> skos:broadMatch dpv:hasDuration .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#deadline_in_days_for_the_right_to_oppose_opposition> skos:broadMatch dpv:hasDuration .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#duration_of_charge> skos:broadMatch dpv:hasDuration .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#for_different_purpose> skos:relatedMatch dpv:hasPurpose .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#for_plurality_of_purposes> skos:relatedMatch dpv:hasPurpose .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#has_as_the_basis_of> skos:closeMatch dpv:hasLegalBasis .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_authorized_by> skos:relatedMatch dpv:hasAuthority .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_implemented_by> skos:closeMatch dpv:isImplementedByEntity .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#justification_for_revocation> skos:broadMatch dpv:hasJustification .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minor_infractions> skos:relatedMatch dpv:hasSeverity .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#need_of> skos:closeMatch dpv:hasNecessity .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#obligations> skos:closeMatch dpv:hasObligation .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#scope_of_legislation> skos:relatedMatch dpv:hasScope .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#serious_infractions> skos:relatedMatch dpv:hasSeverity .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#sources_from_whence_the_credit_data_was_obtained> skos:broadMatch dpv:hasDataSource .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#territorial_application_scenario> skos:relatedMatch dpv:hasJurisdiction .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#the_law_applies_in> skos:relatedMatch dpv:hasApplicableLaw .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#time_of_attention_in_days_for_the_right_of_removal> skos:broadMatch dpv:hasDuration .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#time_of_attention_within_days_for_the_right_of_correction_and_update> skos:broadMatch dpv:hasDuration .

<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#types_of_safety_measures> skos:relatedMatch dpv:hasTechnicalOrganisationalMeasure .

<http://www.semanticweb.org/profiles/ecuador-lopdp#AdequateProtectionLevel> a owl:Class ;
    rdfs:label "nivel adecuado de protección"@es ;
    dcterms:source "LOPDP, art. 56"@es ;
    skos:definition "Estándar requerido para que países u organizaciones puedan recibir datos personales de forma segura."@es ;
    skos:relatedMatch dpv:DataProtectionAuthority .

<http://www.semanticweb.org/profiles/ecuador-lopdp#AdministrativeProcedure> a owl:Class ;
    rdfs:label "procedimiento administrativo"@es ;
    dcterms:source "LOPDP, art. 64"@es ;
    skos:broadMatch dpv:GovernanceProcedures ;
    skos:closeMatch dpv:AuthorisationProcedure ;
    skos:definition "Proceso formal ante la Autoridad de Protección de Datos cuando un requerimiento previo es negado o no contestado."@es ;
    skos:relatedMatch dpv:ApprovalProcedure .

<http://www.semanticweb.org/profiles/ecuador-lopdp#BindingCorporateRules> a owl:Class ;
    rdfs:label "normas corporativas vinculantes"@es ;
    dcterms:source "LOPDP, art. 58"@es ;
    skos:broadMatch dpv:LegalCompliance ;
    skos:definition "Reglas de obligatorio cumplimiento para el grupo empresarial que regulan la transferencia internacional de datos."@es ;
    skos:narrowMatch dpv:ContractualTerms ;
    skos:relatedMatch dpv:FulfilmentOfContractualObligation .

<http://www.semanticweb.org/profiles/ecuador-lopdp#CessationOfTreatment> a owl:Class ;
    rdfs:label "cese del tratamiento"@es ;
    dcterms:source "LOPDP, art. 65"@es ;
    skos:definition "Medida correctiva que consiste en detener el tratamiento de datos bajo condiciones o plazos determinados."@es ;
    skos:narrowMatch dpv:UntilTimeDuration .

<http://www.semanticweb.org/profiles/ecuador-lopdp#CodesOfConduct> a owl:Class ;
    rdfs:label "códigos de conducta"@es ;
    dcterms:source "LOPDP, art. 53"@es ;
    skos:definition "Instrumentos sectoriales promovidos para el cumplimiento de la normativa de protección de datos."@es ;
    skos:exactMatch dpv:CodeOfConduct .

<http://www.semanticweb.org/profiles/ecuador-lopdp#ConfidentialityAgreement> a owl:Class ;
    rdfs:label "contratos de confidencialidad"@es ;
    dcterms:source "LOPDP, art. 47"@es ;
    skos:definition "Instrumento legal para garantizar el manejo adecuado de datos personales por parte del personal y encargados."@es ;
    skos:exactMatch dpv:ConfidentialityAgreement .

<http://www.semanticweb.org/profiles/ecuador-lopdp#DataBreachException> a owl:Class ;
    rdfs:label "excepciones a la notificación de vulneración"@es ;
    dcterms:source "LOPDP, art. 46"@es ;
    skos:definition "Casos específicos donde no es necesario notificar al titular sobre una vulneración de seguridad bajo condiciones demostrables."@es ;
    skos:narrowMatch dpv:DataBreachNotice .

<http://www.semanticweb.org/profiles/ecuador-lopdp#DataDeletion> a owl:Class ;
    rdfs:label "eliminación de los datos"@es ;
    dcterms:source "LOPDP, art. 65"@es ;
    skos:definition "Medida correctiva que consiste en suprimir los datos personales objeto de la infracción."@es ;
    skos:exactMatch dpv:Delete ;
    skos:relatedMatch dpv:DataDeletionPolicy .

<http://www.semanticweb.org/profiles/ecuador-lopdp#DataDeletionMethods> a owl:Class ;
    rdfs:label "Métodos de eliminación"@es ;
    dcterms:source "LOPDP, art. 15"@es ;
    skos:definition "Técnicas para hacer ilegibles o irreconocibles los datos de forma definitiva y segura."@es ;
    skos:exactMatch dpv:DataSanitisationTechnique ;
    skos:narrowMatch dpv:DataRedaction ;
    skos:relatedMatch dpv:DataDeletionPolicy .

<http://www.semanticweb.org/profiles/ecuador-lopdp#DataProtectionAudit> a owl:Class ;
    rdfs:label "auditorías de protección de datos"@es ;
    dcterms:source "LOPDP, art. 58"@es ;
    skos:definition "Mecanismo de verificación sobre el cumplimiento de las normas corporativas vinculantes."@es ;
    skos:exactMatch dpv:PersonalDataAudit .

<http://www.semanticweb.org/profiles/ecuador-lopdp#DataSecurityBreach> a owl:Class ;
    rdfs:label "Vulneración de la seguridad de los datos personales"@es ;
    dcterms:source "LOPDP, art. 4"@es ;
    skos:definition "Incidente de seguridad que afecta la confidencialidad, disponibilidad o integridad de los datos personales."@es ;
    skos:relatedMatch dpv:DataBreachRecord .

<http://www.semanticweb.org/profiles/ecuador-lopdp#DirectRequirement> a owl:Class ;
    rdfs:label "requerimiento directo"@es ;
    dcterms:source "LOPDP, art. 62"@es ;
    skos:closeMatch dpv:RequestRequiresAction ;
    skos:definition "Acción gratuita que puede ejercer el titular ante el responsable del tratamiento sobre sus derechos."@es .

<http://www.semanticweb.org/profiles/ecuador-lopdp#DutyOfConfidentiality> a owl:Class ;
    rdfs:label "Deber de confidencialidad"@es ;
    dcterms:source "LOPDP, art. 30"@es ;
    skos:definition "Obligación de responsables, encargados y terceras personas en el tratamiento de datos de salud para garantizar su seguridad y complementar el secreto profesional."@es ;
    skos:relatedMatch dpv:ContractConfidentialityClause .

<http://www.semanticweb.org/profiles/ecuador-lopdp#ImpactAssessment> a owl:Class ;
    rdfs:label "evaluación de impacto del tratamiento de datos personales"@es ;
    dcterms:source "LOPDP, art. 42"@es ;
    skos:definition "Proceso obligatorio realizado por el responsable para identificar riesgos altos en el tratamiento de datos personales."@es ;
    skos:exactMatch dpv:ImpactAssessment .

<http://www.semanticweb.org/profiles/ecuador-lopdp#MinorAutomatedDecisionRight> a owl:Class ;
    rdfs:label "Derecho de niñas, niños y adolescentes a no ser objeto de una decisión basada única o parcialmente en valoraciones automatizadas"@es ;
    dcterms:source "LOPDP, art. 21"@es ;
    skos:broadMatch dpv:DataSubjectRight ;
    skos:definition "Prohibición de tratar datos sensibles o de menores de edad mediante valoraciones automatizadas, salvo autorización expresa o interés público esencial."@es ;
    skos:relatedMatch dpv:AutomatedDecisionMaking .

<http://www.semanticweb.org/profiles/ecuador-lopdp#NationalDataProtectionRegistry> a owl:Class ;
    rdfs:label "Registro Nacional de protección de datos personales"@es ;
    dcterms:source "LOPDP, art. 51"@es ;
    skos:broadMatch dpv:PublicRegisterOfEntities ;
    skos:definition "Sistema donde el responsable debe reportar y mantener actualizada la información sobre el tratamiento de datos."@es .

<http://www.semanticweb.org/profiles/ecuador-lopdp#PersonalDataProtection> a owl:Class ;
    rdfs:label "protección de datos personales"@es ;
    dcterms:source "LOPDP, art. 1"@es ;
    skos:definition "Derecho que incluye el acceso y decisión sobre información y datos de carácter personal."@es ;
    skos:relatedMatch dpv:SensitivePersonalData .

<http://www.semanticweb.org/profiles/ecuador-lopdp#PrivacyByDefault> a owl:Class ;
    rdfs:label "protección de datos por defecto"@es ;
    dcterms:source "LOPDP, art. 39"@es ;
    skos:definition "Obligación de tratar únicamente los datos personales estrictamente necesarios para cada fin específico."@es ;
    skos:exactMatch dpv:PrivacyByDefault .

<http://www.semanticweb.org/profiles/ecuador-lopdp#ProportionalityPrinciple> a owl:Class ;
    rdfs:label "principio de proporcionalidad"@es ;
    dcterms:source "LOPDP, art. 71"@es ;
    skos:broadMatch dpv:Principle ;
    skos:definition "Criterio utilizado para establecer la cuantía de la multa basado en la intencionalidad, reiteración, perjuicio y reincidencia."@es .

<http://www.semanticweb.org/profiles/ecuador-lopdp#ProvisionalMeasures> a owl:Class ;
    rdfs:label "Medidas provisionales o cautelares"@es ;
    dcterms:source "LOPDP, art. 74"@es ;
    skos:definition "Medidas de protección o cautelares aplicables por la Autoridad de Protección de Datos Personales según la norma procedimental administrativa."@es .

<http://www.semanticweb.org/profiles/ecuador-lopdp#Recidivism> a owl:Class ;
    rdfs:label "reincidencia"@es ;
    dcterms:source "LOPDP, art. 71"@es ;
    skos:definition "Circunstancia donde la infracción precedente es de la misma naturaleza que la que se pretende sancionar."@es ;
    skos:relatedMatch dpv:RuleViolated .

<http://www.semanticweb.org/profiles/ecuador-lopdp#RiskReport> a owl:Class ;
    rdfs:label "Informe de riesgo"@es ;
    dcterms:source "LOPDP, art. 9"@es ;
    skos:broadMatch dpv:RiskConcept ;
    skos:closeMatch dpv:RiskAssessment ;
    skos:definition "Documento requerido por la Autoridad para verificar amenazas a los derechos de los titulares."@es .

<http://www.semanticweb.org/profiles/ecuador-lopdp#SelfRegulation> a owl:Class ;
    rdfs:label "Autorregulación"@es ;
    dcterms:source "LOPDP, art. 52"@es ;
    skos:broadMatch dpv:CertificationSeal ;
    skos:definition "Facultad voluntaria de adherirse a códigos de conducta y certificaciones sin eximir la responsabilidad legal."@es .

<http://www.semanticweb.org/profiles/ecuador-lopdp#TechnicalAndLegalMeasures> a owl:Class ;
    rdfs:label "medidas técnicas, jurídicas, organizativas o administrativas"@es ;
    dcterms:source "LOPDP, art. 65"@es ;
    skos:broadMatch dpv:LegalMeasure,
        dpv:TechnicalMeasure ;
    skos:definition "Imposición de medidas para garantizar un tratamiento adecuado de los datos personales."@es ;
    skos:exactMatch dpv:TechnicalOrganisationalMeasure .

<http://www.semanticweb.org/profiles/ecuador-lopdp#UnfulfilledRegistry> a owl:Class ;
    rdfs:label "Registro Único de Responsables y Encargados Incumplidos"@es ;
    skos:definition "Registro de responsables y encargados del tratamiento de datos personales que han incurrido en infracciones, con fines sociales, estadísticos, preventivos y de capacitación."@es .

<http://www.semanticweb.org/profiles/ecuador-lopdp-dpv-alignment> a owl:Ontology ;
    rdfs:label "Alineación con el DPV del perfil Ecuador (LOPDP)"@es ;
    dcterms:created "2026-11-14T15:38:35+00:00" ;
    dcterms:references <https://w3id.org/dpv> ;
    rdfs:comment "Correspondencias SKOS aprobadas por revisión humana entre OntoPriv (núcleo + perfil) y el Data Privacy Vocabulary (DPV 2.3), más los conceptos nuevos extraídos de la ley y aprobados por una persona. El DPV se referencia por IRI; no se importa."@es ;
    owl:imports <http://www.semanticweb.org/profiles/ecuador-lopdp> .

