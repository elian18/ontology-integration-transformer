ley-organica-proteccion-datos-personales:collection a ley-organica-proteccion-datos-personales:Collection,
        owl:NamedIndividual ;
    ley-organica-proteccion-datos-personales:description "Refers to the process of acquiring and obtaining data from various sources, such as sensors, databases, online forms, historical records, among others." ;
    ley-organica-proteccion-datos-personales:is_related_to ley-organica-proteccion-datos-personales:consent ;
    ley-organica-proteccion-datos-personales:need_of ley-organica-proteccion-datos-personales:consent .

ley-organica-proteccion-datos-personales:committed_by a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ley-organica-proteccion-datos-personales:Minor_infractions ley-organica-proteccion-datos-personales:Serious_infractions ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ley-organica-proteccion-datos-personales:Data_Controller ley-organica-proteccion-datos-personales:Data_Processor ) ] ;
    rdfs:subPropertyOf ley-organica-proteccion-datos-personales:Violations .

ley-organica-proteccion-datos-personales:corrective_measures a ley-organica-proteccion-datos-personales:Corrective_measures,
        owl:NamedIndividual ;
    ley-organica-proteccion-datos-personales:before_dictating_corrective_measures "To have a competent technical report that allows correcting, reversing or eliminating conducts contrary to the Organic Law for the Protection of Personal Data and the regulations issued by the Authority for the Protection of Personal Data." ;
    ley-organica-proteccion-datos-personales:cases_to_incur_in_corrective_measures "In the event that controllers, persons in charge of processing personal data and certification bodies and, if applicable, third parties, are involved in the alleged commission of a minor infringement and are included in the Unified Registry of non-compliant controllers and persons in charge of processing personal data.",
        "In the event that controllers, persons in charge of the processing of personal data and certification bodies are involved in the alleged commission of a serious infringement",
        "In the event that controllers, persons in charge of the processing of personal data and certification bodies are involved in the alleged commission of a very serious infringement" ;
    ley-organica-proteccion-datos-personales:for_minor_infractions "The Personal Data Protection Authority will directly activate the administrative sanctioning procedure, stating in the resolution both the applicable corrective measures and the sanction corresponding to the infraction committed." ;
    ley-organica-proteccion-datos-personales:for_serious_infractions "The Data Protection Authority will initially apply corrective measures. If they are not adequately complied with, sanctions for serious infringements will be imposed through the administrative sanctioning procedure." ;
    ley-organica-proteccion-datos-personales:for_very_serious_offenses "The Personal Data Protection Authority will directly activate the administrative sanctioning procedure, stating in the resolution both the applicable corrective measures and the sanction corresponding to the infraction committed." ;
    ley-organica-proteccion-datos-personales:in_the_case_of_non-compliance_of "Diposiciones prevista en la Ley Orgnánica de Protección de Datos Personales",
        "Disobedience of the directives and guidelines issued by the Authority for the Protection of Personal Data.",
        "Infringement of data owner's rights",
        "Violation of the fundamental principles related to the right to the protection of personal data.",
        "Violation of the regulations established by the Personal Data Protection Authority." ;
    ley-organica-proteccion-datos-personales:what_will_be_the_corrective_measures "Data deletion",
        "The cessation of treatment, under certain conditions or time limits",
        "The imposition of technical, legal, organizational or administrative measures to ensure proper processing of personal data" ;
    ley-organica-proteccion-datos-personales:will_be_imposed_by ley-organica-proteccion-datos-personales:personal_data_protection_authority .

