ley-organica-proteccion-datos-personales:minor_infractions_penalties a ley-organica-proteccion-datos-personales:Minor_infractions_penalties,
        owl:NamedIndividual ;
    ley-organica-proteccion-datos-personales:by ley-organica-proteccion-datos-personales:minor_infractions ;
    ley-organica-proteccion-datos-personales:destined_for "Servidores o funcionarios del sector público",
        "The Controller or Processor of personal data or, if applicable, a third party, may be a private law entity or a public company." ;
    ley-organica-proteccion-datos-personales:determination_of_the_fine_in_respect_to_penalties_for_infringement_of_the_responsible_person_or_person_in_charge_of_treatment "Intentionality, which will evaluate the offender's conduct to determine if there was intent to commit the infraction.",
        "Nature of the damage, where the negative consequences for the right to the protection of personal data will be evaluated.",
        "Recidivism, which is considered when the previous infraction is similar to the one to be sanctioned again.",
        "Reiteration of the infraction, which considers when the controller or processor of personal data has been previously sanctioned for two or more infractions of lesser gravity, or for an infraction of equal or greater gravity." ;
    ley-organica-proteccion-datos-personales:is_related_to ley-organica-proteccion-datos-personales:proportionality,
        ley-organica-proteccion-datos-personales:turnover ;
    ley-organica-proteccion-datos-personales:principle_of_attachment_with_sanction_to_the_responsible_party_or_the_treatment_manager "Proportionality" ;
    ley-organica-proteccion-datos-personales:type_of_penalty_for_infractions_to_the_responsible_party_or_the_processor "A fine ranging from 0.1% to 0.7% of the turnover for the fiscal year immediately preceding the imposition of the fine shall be imposed." ;
    ley-organica-proteccion-datos-personales:type_of_penalty_for_infractions_toward_public_servants_or_officials "Shall be sanctioned with a fine ranging from 1 to 10 basic unified salaries of the public servant or public official",
        "This sanction does not rule out the possibility of the State assuming additional liability for damages caused, which will be governed in accordance with the corresponding regulations." ;
    ley-organica-proteccion-datos-personales:will_be_imposed_by ley-organica-proteccion-datos-personales:personal_data_protection_authority .

ley-organica-proteccion-datos-personales:penalties_for_Serious_Infringements a ley-organica-proteccion-datos-personales:Penalties_for_Serious_Infringements,
        owl:NamedIndividual ;
    ley-organica-proteccion-datos-personales:by ley-organica-proteccion-datos-personales:serious_infractions ;
    ley-organica-proteccion-datos-personales:destined_for "Public sector employees or officials",
        "The Controller or Processor of personal data or, if applicable, a third party, may be a private law entity or a public company." ;
    ley-organica-proteccion-datos-personales:determination_of_the_fine_in_respect_to_penalties_for_infringement_of_the_responsible_person_or_person_in_charge_of_treatment "Intentionality, which will evaluate the offender's conduct to determine if there was intent to commit the infraction.",
        "Nature of the damage, where the negative consequences for the right to the protection of personal data will be evaluated.",
        "Recidivism, which is considered when the previous infraction is similar to the one to be sanctioned again.",
        "Reiteration of the infraction, which considers when the controller or processor of personal data has been previously sanctioned for two or more infractions of lesser gravity, or for an infraction of equal or greater gravity." ;
    ley-organica-proteccion-datos-personales:is_related_to ley-organica-proteccion-datos-personales:proportionality,
        ley-organica-proteccion-datos-personales:turnover ;
    ley-organica-proteccion-datos-personales:type_of_penalty_for_infractions_to_the_responsible_party_or_the_processor "A fine ranging from 0.7% to 1% of the turnover for the fiscal year immediately preceding the imposition of the fine shall be imposed." ;
    ley-organica-proteccion-datos-personales:type_of_penalty_for_infractions_toward_public_servants_or_officials "It shall be punished with a fine ranging from 10 to 20 unified basic salaries of the public servant or official.",
        "This sanction does not rule out the possibility of the State assuming additional liability for damages caused, which will be governed in accordance with the corresponding regulations." ;
    ley-organica-proteccion-datos-personales:will_be_imposed_by ley-organica-proteccion-datos-personales:personal_data_protection_authority .

