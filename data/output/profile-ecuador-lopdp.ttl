            owl:unionOf ( ley-organica-proteccion-datos-personales:Collection ley-organica-proteccion-datos-personales:Data_Controller ley-organica-proteccion-datos-personales:Data_Processor ley-organica-proteccion-datos-personales:Delegate ley-organica-proteccion-datos-personales:Minor_infractions_penalties ley-organica-proteccion-datos-personales:Penalties_for_Serious_Infringements ley-organica-proteccion-datos-personales:Processing ley-organica-proteccion-datos-personales:Right_not_to_be_object_to_automated_evaluations ley-organica-proteccion-datos-personales:Right_of_access ) ] ;
