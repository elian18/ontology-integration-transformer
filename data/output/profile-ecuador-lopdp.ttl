OntologiaLOPDP:Rights_in_verification a owl:Class,
        owl:DatatypeProperty ;
    rdfs:domain OntologiaLOPDP:Rights_in_verification ;
    rdfs:range xsd:string ;
    rdfs:subClassOf ley-organica-proteccion-datos-personales:Rights .

OntologiaLOPDP:Personal_data_delegate_in_verification a owl:Class ;
    rdfs:subClassOf OntologiaLOPDP:Members_of_the_protection_system_in_verification .

ley-organica-proteccion-datos-personales:Corrective_measures a owl:Class,
        owl:ObjectProperty ;
    rdfs:subClassOf ley-organica-proteccion-datos-personales:Organic_Law_on_Personal_Data_Protection ;
    rdfs:subPropertyOf ley-organica-proteccion-datos-personales:Organic_Law_on_Personal_Data_Protection .

OntologiaLOPDP:Personal_Data_Protection_Authority_in_verification a owl:Class ;
    rdfs:subClassOf OntologiaLOPDP:Members_of_the_protection_system_in_verification .

OntologiaLOPDP:Treatment_Manager_in_verification a owl:Class ;
    rdfs:subClassOf OntologiaLOPDP:Members_of_the_protection_system_in_verification .

OntologiaLOPDP:Principles_in_verification a owl:Class ;
    rdfs:subClassOf ley-organica-proteccion-datos-personales:Principles .

OntologiaLOPDP:Responsible_for_treatment_in_verification a owl:Class ;
    rdfs:subClassOf OntologiaLOPDP:Members_of_the_protection_system_in_verification .

OntologiaLOPDP:Personal_data_security a owl:Class ;
