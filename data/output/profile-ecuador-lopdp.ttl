<http://www.semanticweb.org/profiles/ecuador-lopdp> a owl:Ontology ;
    owl:imports <http://www.semanticweb.org/ontopriv-core> .

OntologiaLOPDP:Audit a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( OntologiaLOPDP:Personal_data_delegate_in_verification OntologiaLOPDP:Verification ) ] ;
    rdfs:range xsd:string .

OntologiaLOPDP:a_process_of a owl:ObjectProperty ;
    rdfs:range OntologiaLOPDP:Verification .

OntologiaLOPDP:access_right001 a OntologiaLOPDP:Right_of_access_in_verification,
        owl:NamedIndividual ;
    OntologiaLOPDP:Consent_in_verification "Must be consented to by the owner" ;
    OntologiaLOPDP:General_detail "This right states that the owner of the information has the right to access it free of charge and in detail within 15 days." ;
    OntologiaLOPDP:Informed "It can be an informed consent" ;
    OntologiaLOPDP:Not_informed "May be an uninformed consent" ;
    OntologiaLOPDP:Revoke_consent "It must be possible to revoke the consent at any time, this can be done by the owner of the data." ;
    OntologiaLOPDP:Updated "Must be updated" ;
    OntologiaLOPDP:can_be_rights_of OntologiaLOPDP:access_right001 ;
    OntologiaLOPDP:right_of_access_time "15 days" .

OntologiaLOPDP:addressee_in_verification001 a OntologiaLOPDP:Addressee_in_verification,
        owl:NamedIndividual ;
    OntologiaLOPDP:Details_of_the_law_details "Information" ;
    OntologiaLOPDP:General_detail "It is the natural or legal person to whom the holder's data will be sent." ;
    OntologiaLOPDP:Name "Pedro" ;
    OntologiaLOPDP:Personal_detail "Person receiving the information" ;
    OntologiaLOPDP:Personal_information "Recipient information" ;
    OntologiaLOPDP:is_compliant_with_the_following_roles OntologiaLOPDP:addressee_in_verification001 .

OntologiaLOPDP:administrative001 a OntologiaLOPDP:Administrative,
        owl:NamedIndividual ;
    OntologiaLOPDP:Applied "When the measure is applied" ;
    OntologiaLOPDP:Cessation_of_treatment "When the corrective action stops" ;
    OntologiaLOPDP:Exceptions "Exceptions applicable to administrative companies" ;
    OntologiaLOPDP:General_detail "Actions to be taken in administrative cases." ;
    OntologiaLOPDP:Guidelines "Administrative guidelines",
        "Guidelines to follow" ;
    OntologiaLOPDP:Not_applied "When a verification process does not apply" ;
    OntologiaLOPDP:Regulations "Administrative regulations" ;
    OntologiaLOPDP:that_can_be_of_the_type OntologiaLOPDP:administrative001 .

OntologiaLOPDP:administrative_or_judicial_authorities001 a OntologiaLOPDP:Administrative_or_judicial_authorities,
        owl:NamedIndividual ;
    OntologiaLOPDP:Exceptions "Administrative and legal exemptions are available" ;
    OntologiaLOPDP:General_detail "In an investigation process, the holder's data may be used either by a judge or an administrative entity." ;
    OntologiaLOPDP:segmented_into_the_following_national_cases OntologiaLOPDP:administrative_or_judicial_authorities001 .

OntologiaLOPDP:admitted_countries001 a OntologiaLOPDP:Admitted_Countries,
        owl:NamedIndividual ;
    OntologiaLOPDP:Availability "Information must be available" ;
    OntologiaLOPDP:Communicate "The information must be communicated" ;
    OntologiaLOPDP:Correct "The information must be corrected" ;
    OntologiaLOPDP:Data_admitted_countries_international_transfer "Admitted countries information" ;
    OntologiaLOPDP:General_detail "These are the countries that are allowed to carry out data transfer processes with Ecuador." ;
    OntologiaLOPDP:Mitigate "The information must be mitigated" ;
    OntologiaLOPDP:Prevent "Information must be prevented" ;
    OntologiaLOPDP:Transmit "The information must be transmitted" ;
    OntologiaLOPDP:where_in_in_the_international_field_you_have_to_have OntologiaLOPDP:admitted_countries001 .

OntologiaLOPDP:and_the_owner_divides_into a owl:ObjectProperty ;
    rdfs:domain OntologiaLOPDP:Holder_in_verification ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( OntologiaLOPDP:Data_Seniors_data OntologiaLOPDP:Data_persons_minors OntologiaLOPDP:Deceased_persons_data ) ] ;
    rdfs:subPropertyOf OntologiaLOPDP:has_the_following_roles .

OntologiaLOPDP:análisis_de_riesgo_amenazas_y_vulnerabilidades001 a OntologiaLOPDP:Risk_analysis_of_threats_and_vulnerabilities,
        owl:NamedIndividual ;
    OntologiaLOPDP:General_detail "Es una tarea que debe realizar el responsable y encargado del tratamiento de los datos para evitar la presencia de esta amenazas." ;
    OntologiaLOPDP:Risk "Riego presente en un análisis de datos" ;
    OntologiaLOPDP:Secrecy_of_communications "La transferencia de información debe ser secreta" ;
    OntologiaLOPDP:Threat "Amenaza a los datos" ;
    OntologiaLOPDP:Vulnerabilidad "Vulnerabildiad presente en los datos en procesos de transferencia" ;
    OntologiaLOPDP:account_with_actions_as OntologiaLOPDP:análisis_de_riesgo_amenazas_y_vulnerabilidades001 .

OntologiaLOPDP:applicable_safety_measures001 a OntologiaLOPDP:Applicable_safety_measures,
        owl:NamedIndividual ;
    OntologiaLOPDP:Check "The applicable security measures must control the risk to the data." ;
    OntologiaLOPDP:Excess_of_authorization "The applicable security measures must prevent the authorization process in the data." ;
    OntologiaLOPDP:General_detail "Concrete actions that the responsible and in charge must take into consideration at the moment of a change or mishandling of the data of the owner of the information." ;
    OntologiaLOPDP:Mitigate "The applicable security measures must mitigate the risk to the data." ;
    OntologiaLOPDP:Not_authorized "The applicable security measures must prevent unauthorized access to the data." ;
    OntologiaLOPDP:Prevent "The applicable security measures must prevent the risk to the data." ;
    OntologiaLOPDP:Reduce "The applicable security measures must reduce the risk to the data." ;
    OntologiaLOPDP:Secrecy_of_communications "The applicable security measures must be governed by the secrecy of data communications." ;
    OntologiaLOPDP:Stop "The applicable security measures must prevent data compromise" ;
    OntologiaLOPDP:account_with_actions_as OntologiaLOPDP:applicable_safety_measures001 .

OntologiaLOPDP:authority001 a OntologiaLOPDP:Personal_Data_Protection_Authority_in_verification,
        owl:NamedIndividual ;
    OntologiaLOPDP:Advise_on_risk_analysis "Gives assistance on specific issues" ;
    OntologiaLOPDP:Control_systemized_and_stabilized_control "Follows up on everything" ;
    OntologiaLOPDP:Cooperate_with_the_Personal_Data_Protection_Authority "cooperates with the authority" ;
    OntologiaLOPDP:Correct "Corrects errors generated by the responsible parties in the information transfer process." ;
    OntologiaLOPDP:Designation_of_the_authority_process "The Personal Data Authority is designated in accordance with the provisions of the Constitution of Ecuador." ;
    OntologiaLOPDP:Details_of_the_law_details "Information on the members of the law" ;
    OntologiaLOPDP:General_detail "He is in charge of supervising that everything is in order and if there is any inconsistency, he solves it." ;
    OntologiaLOPDP:Mitigate "Mitigates data risks" ;
    OntologiaLOPDP:Name "Juan" ;
    OntologiaLOPDP:Personal_detail "It is responsible for the implementation of corrective actions." ;
    OntologiaLOPDP:Personal_information "Authority data" ;
    OntologiaLOPDP:Prevent "Prevents errors" ;
    OntologiaLOPDP:Sanctioning_administrative_procedure "Performs the corresponding procedure" ;
    OntologiaLOPDP:Serious "from 10 to 20 unified basic salaries" ;
    OntologiaLOPDP:Slight "from 1 to 10 basic unified salaries." ;
    OntologiaLOPDP:Supervise "Supervises the delegate" ;
    OntologiaLOPDP:Transfer_or_international_communication "The Personal Data Authority is responsible for establishing the international transfer and communication processes." ;
    OntologiaLOPDP:Very_serious "It is not specified what sanction to take in these cases, more aspects should be considered." ;
    OntologiaLOPDP:is_compliant_with_the_following_roles OntologiaLOPDP:authority001 .

OntologiaLOPDP:authorization_for_international_transfer001 a OntologiaLOPDP:Authorization_for_international_transfer,
        owl:NamedIndividual ;
    OntologiaLOPDP:Excess_of_authorization "When in an international transfer an organization has many privileges" ;
    OntologiaLOPDP:General_detail "It is the permission you must have to perform an international data transfer." ;
    OntologiaLOPDP:where_in_in_the_international_field_you_have_to_have OntologiaLOPDP:authorization_for_international_transfer001 .

OntologiaLOPDP:bank_or_stock_bank_data001 a OntologiaLOPDP:Banking_stock_or_stock_market_data,
        owl:NamedIndividual ;
    OntologiaLOPDP:Detail_banking_data_or_stock_market_details "Details of bank or stock exchange data in an international transfer exception" ;
    OntologiaLOPDP:General_detail "In an international process involving money, the data of the owner of the information may be used." ;
    OntologiaLOPDP:segmented_into_the_following_international_cases OntologiaLOPDP:bank_or_stock_bank_data001 .

OntologiaLOPDP:banking001 a OntologiaLOPDP:Banking,
        owl:NamedIndividual ;
    OntologiaLOPDP:Access "The holder has access to his bank details" ;
    OntologiaLOPDP:Correction "Bank details must be able to be rectified" ;
    OntologiaLOPDP:Detail_banking_data_or_stock_market_details "The banking data has a banking or stock market detail." ;
    OntologiaLOPDP:Disposal "It must be possible to delete bank details" ;
    OntologiaLOPDP:General_detail "Bank type data" ;
    OntologiaLOPDP:Updated "The data must be up to date" ;
    OntologiaLOPDP:in_consideration_of_credit_data_is_held OntologiaLOPDP:banking001 .

OntologiaLOPDP:boys_and_girls001 a OntologiaLOPDP:Boys_and_girls,
        owl:NamedIndividual ;
    OntologiaLOPDP:Anonymization "It should be possible to anonymize data on children." ;
    OntologiaLOPDP:Correction "Children's data must be able to be rectified" ;
    OntologiaLOPDP:Disposal "Children's data must be able to be removed" ;
    OntologiaLOPDP:General_detail "They are a special type of owner that needs the explicit consent of their legal representative for the person in charge or owner of the information to make use of them. The age range to be considered as children's data is from 0 to 11 years old." ;
    OntologiaLOPDP:Supervision "They need the supervision of their parents or legal guardian in order to make use of this information." ;
    OntologiaLOPDP:and_as_your_age_will_have_to_be_of_your_age OntologiaLOPDP:boys_and_girls001 .

