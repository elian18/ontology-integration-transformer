            owl:unionOf ( ley-organica-proteccion-datos-personales:Claims ley-organica-proteccion-datos-personales:Minor_infractions_penalties ley-organica-proteccion-datos-personales:Penalties_for_Serious_Infringements ) ] ;
    rdfs:range ley-organica-proteccion-datos-personales:Data_Controller ;
    rdfs:subPropertyOf ley-organica-proteccion-datos-personales:Claims,
