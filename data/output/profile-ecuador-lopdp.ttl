    OntologiaLOPDP:Issue_certifications "Certification must be issued when any information transfer process is carried out." ;
    OntologiaLOPDP:Issue_stamps "Stamps should be issued" ;
    OntologiaLOPDP:account_with_a_certifying_entity OntologiaLOPDP:certifying_entity001 .

