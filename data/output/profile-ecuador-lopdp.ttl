    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ley-organica-proteccion-datos-personales:Minor_infractions_penalties ley-organica-proteccion-datos-personales:Penalties_for_Serious_Infringements ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ley-organica-proteccion-datos-personales:Sanctions .

