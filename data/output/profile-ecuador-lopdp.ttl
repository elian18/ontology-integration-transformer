    rdfs:subPropertyOf ley-organica-proteccion-datos-personales:Corrective_measures .

ley-organica-proteccion-datos-personales:for_serious_infractions a owl:DatatypeProperty ;
    rdfs:domain ley-organica-proteccion-datos-personales:Corrective_measures ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ley-organica-proteccion-datos-personales:Corrective_measures .

ley-organica-proteccion-datos-personales:for_very_serious_offenses a owl:DatatypeProperty ;
    rdfs:domain ley-organica-proteccion-datos-personales:Corrective_measures ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ley-organica-proteccion-datos-personales:Corrective_measures .

