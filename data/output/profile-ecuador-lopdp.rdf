  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#principles001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Principles_in_verification"/>
    <OntologiaLOPDP:has_the_following_principles_to_consider rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#principles001"/>
    <OntologiaLOPDP:Accurate>They are accurate</OntologiaLOPDP:Accurate>
    <OntologiaLOPDP:Clarity_and_accuracy>Fundamental properties of a principle</OntologiaLOPDP:Clarity_and_accuracy>
    <OntologiaLOPDP:Clear>The principles must be clear</OntologiaLOPDP:Clear>
    <OntologiaLOPDP:Complete>They are complete</OntologiaLOPDP:Complete>
    <OntologiaLOPDP:Confidentiality>They play a role in confidentiality</OntologiaLOPDP:Confidentiality>
    <OntologiaLOPDP:Conservation>Help in data preservation</OntologiaLOPDP:Conservation>
    <OntologiaLOPDP:Exact>They are accurate</OntologiaLOPDP:Exact>
    <OntologiaLOPDP:Explicit>Explicit purpose</OntologiaLOPDP:Explicit>
    <OntologiaLOPDP:General_detail>They are a mechanism by which the holder's information is safeguarded, they help to ensure the correct use of the information.</OntologiaLOPDP:General_detail>
    <OntologiaLOPDP:Integral>They are integral</OntologiaLOPDP:Integral>
    <OntologiaLOPDP:Legitimate>Legitimate purpose</OntologiaLOPDP:Legitimate>
    <OntologiaLOPDP:Personal_data_security_details>They fulfill a security role</OntologiaLOPDP:Personal_data_security_details>
    <OntologiaLOPDP:Purpose>They have a purpose</OntologiaLOPDP:Purpose>
    <OntologiaLOPDP:Risk>They may have a risk</OntologiaLOPDP:Risk>
    <OntologiaLOPDP:Threat>Prevent a threat</OntologiaLOPDP:Threat>
    <OntologiaLOPDP:Transparency>Verify data transparency</OntologiaLOPDP:Transparency>
    <OntologiaLOPDP:Verifiable>The principles are verifiable</OntologiaLOPDP:Verifiable>
    <OntologiaLOPDP:Vulnerabilidad>Help to avoid vulnerabilities</OntologiaLOPDP:Vulnerabilidad>
  </rdf:Description>
