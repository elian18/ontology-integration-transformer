  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#admitted_countries001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Admitted_Countries"/>
    <OntologiaLOPDP:where_in_in_the_international_field_you_have_to_have rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#admitted_countries001"/>
    <OntologiaLOPDP:Availability>Information must be available</OntologiaLOPDP:Availability>
    <OntologiaLOPDP:Communicate>The information must be communicated</OntologiaLOPDP:Communicate>
    <OntologiaLOPDP:Correct>The information must be corrected</OntologiaLOPDP:Correct>
    <OntologiaLOPDP:Data_admitted_countries_international_transfer>Admitted countries information</OntologiaLOPDP:Data_admitted_countries_international_transfer>
    <OntologiaLOPDP:General_detail>These are the countries that are allowed to carry out data transfer processes with Ecuador.</OntologiaLOPDP:General_detail>
    <OntologiaLOPDP:Mitigate>The information must be mitigated</OntologiaLOPDP:Mitigate>
    <OntologiaLOPDP:Prevent>Information must be prevented</OntologiaLOPDP:Prevent>
    <OntologiaLOPDP:Transmit>The information must be transmitted</OntologiaLOPDP:Transmit>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#corrective_actions001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Corrective_measures"/>
    <OntologiaLOPDP:the_verification_covers_aspects_such_as rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#corrective_actions001"/>
    <OntologiaLOPDP:Application>What will be done</OntologiaLOPDP:Application>
    <OntologiaLOPDP:Applied>Corrective action implemented</OntologiaLOPDP:Applied>
    <OntologiaLOPDP:Cessation_of_treatment>When the corrective action stops</OntologiaLOPDP:Cessation_of_treatment>
    <OntologiaLOPDP:Disposal>A corrective action can be eliminated</OntologiaLOPDP:Disposal>
    <OntologiaLOPDP:General_detail>These are actions to be taken in case of misuse of data or information provided by the owner of the information.</OntologiaLOPDP:General_detail>
    <OntologiaLOPDP:Guidelines>Guidelines for corrective action</OntologiaLOPDP:Guidelines>
    <OntologiaLOPDP:Guidelines>What will be followed</OntologiaLOPDP:Guidelines>
    <OntologiaLOPDP:Not_applied>When a corrective action is not implemented</OntologiaLOPDP:Not_applied>
    <OntologiaLOPDP:Regulations>Remedial action regulations</OntologiaLOPDP:Regulations>
    <OntologiaLOPDP:Technical_control>A correct telecommunications service must be provided and the Telecommunications Regulation and Control Agency must check/verify that the measures implemented to share this information are correctly implemented.</OntologiaLOPDP:Technical_control>
  </rdf:Description>
