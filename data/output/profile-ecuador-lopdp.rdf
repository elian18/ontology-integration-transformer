  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#holder001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Holder_in_verification"/>
    <OntologiaLOPDP:is_compliant_with_the_following_roles rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#holder001"/>
    <OntologiaLOPDP:Contract>The holder is entitled to a contract</OntologiaLOPDP:Contract>
    <OntologiaLOPDP:Details_of_the_law_details>General information</OntologiaLOPDP:Details_of_the_law_details>
    <OntologiaLOPDP:General_detail>It is the person or entity that owns the data.</OntologiaLOPDP:General_detail>
    <OntologiaLOPDP:Informed>The Data Subject must be informed of the status of his or her data at all times and must be informed if his or her data is being misused.</OntologiaLOPDP:Informed>
    <OntologiaLOPDP:Name>Francisco</OntologiaLOPDP:Name>
    <OntologiaLOPDP:Personal_detail>I am the owner of my information</OntologiaLOPDP:Personal_detail>
    <OntologiaLOPDP:Personal_information>Information</OntologiaLOPDP:Personal_information>
    <OntologiaLOPDP:Preservation_time>3O days</OntologiaLOPDP:Preservation_time>
    <OntologiaLOPDP:Request_information_verification>The owner of the data can request the verification of his information to the person in charge or responsible for the treatment of his information without cost and as soon as possible.</OntologiaLOPDP:Request_information_verification>
  </rdf:Description>
