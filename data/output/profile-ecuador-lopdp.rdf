  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#health_data001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Health_data_in_verification"/>
    <OntologiaLOPDP:that_can_be rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#health_data001"/>
    <OntologiaLOPDP:Access>They must have optimal access</OntologiaLOPDP:Access>
    <OntologiaLOPDP:Anonymization>Data must be anonymized</OntologiaLOPDP:Anonymization>
    <OntologiaLOPDP:Correction>It must be possible to rectify</OntologiaLOPDP:Correction>
    <OntologiaLOPDP:Disposal>It must be possible to delete data</OntologiaLOPDP:Disposal>
    <OntologiaLOPDP:General_detail>They are a type of data of the owner, but can be used by companies or public entities, this in case of an emergency involving the integrity of the owner of the information.</OntologiaLOPDP:General_detail>
    <OntologiaLOPDP:General_detail>This is data such as criminal history or history of very serious diseases or specific actions that the holder has carried out in breach of a national law or law.</OntologiaLOPDP:General_detail>
    <OntologiaLOPDP:Updated>Must be up to date</OntologiaLOPDP:Updated>
  </rdf:Description>
