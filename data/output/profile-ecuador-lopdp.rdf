  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#authority001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_Data_Protection_Authority_in_verification"/>
    <OntologiaLOPDP:is_compliant_with_the_following_roles rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#authority001"/>
    <OntologiaLOPDP:Advise_on_risk_analysis>Gives assistance on specific issues</OntologiaLOPDP:Advise_on_risk_analysis>
    <OntologiaLOPDP:Control_systemized_and_stabilized_control>Follows up on everything</OntologiaLOPDP:Control_systemized_and_stabilized_control>
    <OntologiaLOPDP:Cooperate_with_the_Personal_Data_Protection_Authority>cooperates with the authority</OntologiaLOPDP:Cooperate_with_the_Personal_Data_Protection_Authority>
    <OntologiaLOPDP:Correct>Corrects errors generated by the responsible parties in the information transfer process.</OntologiaLOPDP:Correct>
    <OntologiaLOPDP:Designation_of_the_authority_process>The Personal Data Authority is designated in accordance with the provisions of the Constitution of Ecuador.</OntologiaLOPDP:Designation_of_the_authority_process>
    <OntologiaLOPDP:Details_of_the_law_details>Information on the members of the law</OntologiaLOPDP:Details_of_the_law_details>
    <OntologiaLOPDP:General_detail>He is in charge of supervising that everything is in order and if there is any inconsistency, he solves it.</OntologiaLOPDP:General_detail>
    <OntologiaLOPDP:Mitigate>Mitigates data risks</OntologiaLOPDP:Mitigate>
    <OntologiaLOPDP:Name>Juan</OntologiaLOPDP:Name>
    <OntologiaLOPDP:Personal_detail>It is responsible for the implementation of corrective actions.</OntologiaLOPDP:Personal_detail>
    <OntologiaLOPDP:Personal_information>Authority data</OntologiaLOPDP:Personal_information>
    <OntologiaLOPDP:Prevent>Prevents errors</OntologiaLOPDP:Prevent>
    <OntologiaLOPDP:Sanctioning_administrative_procedure>Performs the corresponding procedure</OntologiaLOPDP:Sanctioning_administrative_procedure>
    <OntologiaLOPDP:Serious>from 10 to 20 unified basic salaries</OntologiaLOPDP:Serious>
    <OntologiaLOPDP:Slight>from 1 to 10 basic unified salaries.</OntologiaLOPDP:Slight>
    <OntologiaLOPDP:Supervise>Supervises the delegate</OntologiaLOPDP:Supervise>
    <OntologiaLOPDP:Transfer_or_international_communication>The Personal Data Authority is responsible for establishing the international transfer and communication processes.</OntologiaLOPDP:Transfer_or_international_communication>
    <OntologiaLOPDP:Very_serious>It is not specified what sanction to take in these cases, more aspects should be considered.</OntologiaLOPDP:Very_serious>
  </rdf:Description>
