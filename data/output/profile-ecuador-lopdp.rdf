  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#epidemiological_studies001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Epidemiological_studies"/>
    <OntologiaLOPDP:segmented_into_the_following_national_cases rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#epidemiological_studies001"/>
    <OntologiaLOPDP:Anonymization>The holder of the information must have his data anonymized so that a transfer</OntologiaLOPDP:Anonymization>
    <OntologiaLOPDP:Exceptions>Exceptions are available when an epidemiological study is conducted</OntologiaLOPDP:Exceptions>
    <OntologiaLOPDP:General_detail>In a pandemic or epidemic, the holder's information may be used without his/her consent.</OntologiaLOPDP:General_detail>
  </rdf:Description>
