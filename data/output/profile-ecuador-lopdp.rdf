    <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Administrative_or_judicial_authorities"/>
    <OntologiaLOPDP:segmented_into_the_following_national_cases rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#administrative_or_judicial_authorities001"/>
    <OntologiaLOPDP:Exceptions>Administrative and legal exemptions are available</OntologiaLOPDP:Exceptions>
    <OntologiaLOPDP:General_detail>In an investigation process, the holder's data may be used either by a judge or an administrative entity.</OntologiaLOPDP:General_detail>
  </rdf:Description>
