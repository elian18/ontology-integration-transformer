    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#certifying_entity001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Certifying_entity_in_verification"/>
    <OntologiaLOPDP:account_with_a_certifying_entity rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#certifying_entity001"/>
    <OntologiaLOPDP:Certifying_international_transfer_processes>The information transfer process must be certified.</OntologiaLOPDP:Certifying_international_transfer_processes>
    <OntologiaLOPDP:Conducting_audits>Audits must be carried out by certified entities.</OntologiaLOPDP:Conducting_audits>
    <OntologiaLOPDP:General_detail>It is responsible for accrediting the information transfer processes, it is an entity endorsed by the Authority for the Protection of Personal Data.</OntologiaLOPDP:General_detail>
    <OntologiaLOPDP:Issue_certifications>Certification must be issued when any information transfer process is carried out.</OntologiaLOPDP:Issue_certifications>
    <OntologiaLOPDP:Issue_stamps>Stamps should be issued</OntologiaLOPDP:Issue_stamps>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#principios_de_seguridad001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Safety_principles"/>
    <OntologiaLOPDP:that_are_divided_into rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#principios_de_seguridad001"/>
    <OntologiaLOPDP:Accurate>Deben ser precisos</OntologiaLOPDP:Accurate>
    <OntologiaLOPDP:Clear>Deben ser claros</OntologiaLOPDP:Clear>
    <OntologiaLOPDP:Complete>Deben ser completos</OntologiaLOPDP:Complete>
    <OntologiaLOPDP:Exact>Deben ser exactos</OntologiaLOPDP:Exact>
    <OntologiaLOPDP:General_detail>Los datos de titular de la información deben ser protegidos con las medidas de seguridad adecuadas.</OntologiaLOPDP:General_detail>
    <OntologiaLOPDP:Integral>Deben ser íntegros</OntologiaLOPDP:Integral>
    <OntologiaLOPDP:Risk>Cuentan con un riesgo</OntologiaLOPDP:Risk>
    <OntologiaLOPDP:Threat>Estan sujetos a amenazas</OntologiaLOPDP:Threat>
    <OntologiaLOPDP:Verifiable>Deben ser comprobables</OntologiaLOPDP:Verifiable>
  </rdf:Description>
