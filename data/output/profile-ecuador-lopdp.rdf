  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_to_portability001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Right_to_portability"/>
    <OntologiaLOPDP:can_be_rights_of rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_to_portability001"/>
    <OntologiaLOPDP:Compatible>Must be compatible</OntologiaLOPDP:Compatible>
    <OntologiaLOPDP:Consent_in_verification>Must be consented to by the owner</OntologiaLOPDP:Consent_in_verification>
    <OntologiaLOPDP:General_detail>This right talks about how the holder can request the transfer of his data to another person or responsible when the situation warrants it and for this right there is no established time.</OntologiaLOPDP:General_detail>
    <OntologiaLOPDP:Gratuity>Must be free of charge for the holder</OntologiaLOPDP:Gratuity>
    <OntologiaLOPDP:Informed>It can be an informed consent</OntologiaLOPDP:Informed>
    <OntologiaLOPDP:Not_informed>May be an uninformed consent</OntologiaLOPDP:Not_informed>
    <OntologiaLOPDP:Revoke_consent>It must be possible to revoke the consent at any time, this can be done by the owner of the data.</OntologiaLOPDP:Revoke_consent>
    <OntologiaLOPDP:Structured>Must be structured</OntologiaLOPDP:Structured>
    <OntologiaLOPDP:Updated>Must be updated</OntologiaLOPDP:Updated>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Data_protection_mechanisms">
