  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#personal_data_security001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_data_security"/>
    <OntologiaLOPDP:security_security_presents_itself_as rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#personal_data_security001"/>
    <OntologiaLOPDP:Accidental_or_illegal_destruction_or_communication>Destruction of information</OntologiaLOPDP:Accidental_or_illegal_destruction_or_communication>
    <OntologiaLOPDP:Alterations>Data alterations</OntologiaLOPDP:Alterations>
    <OntologiaLOPDP:Anonymization>Untraceable data</OntologiaLOPDP:Anonymization>
    <OntologiaLOPDP:Check>control the risk</OntologiaLOPDP:Check>
    <OntologiaLOPDP:Impact_assessment>Evaluation of an error or information leakage</OntologiaLOPDP:Impact_assessment>
    <OntologiaLOPDP:Large_scale_treatment>Large-scale processing of data</OntologiaLOPDP:Large_scale_treatment>
    <OntologiaLOPDP:Loss>Loss of data</OntologiaLOPDP:Loss>
    <OntologiaLOPDP:Mitigate>Mitigating threats</OntologiaLOPDP:Mitigate>
    <OntologiaLOPDP:Nature_of_the_data>What is the nature of the data</OntologiaLOPDP:Nature_of_the_data>
    <OntologiaLOPDP:Organizational>It has data that can be organizational</OntologiaLOPDP:Organizational>
    <OntologiaLOPDP:Personal_data_encryption>Encryption of personal data to prevent security leaks</OntologiaLOPDP:Personal_data_encryption>
    <OntologiaLOPDP:Personal_data_security_details>Those responsible for the security of personal data are the data processor and the data controller.</OntologiaLOPDP:Personal_data_security_details>
    <OntologiaLOPDP:Prevent>Prevent a threat or vulnerability</OntologiaLOPDP:Prevent>
    <OntologiaLOPDP:Reduce>Reducing risk</OntologiaLOPDP:Reduce>
    <OntologiaLOPDP:Risk>Risk in the event of a fault</OntologiaLOPDP:Risk>
    <OntologiaLOPDP:Secrecy_of_communications>Communications must be secret</OntologiaLOPDP:Secrecy_of_communications>
    <OntologiaLOPDP:Security_notification_of_infringement>Notification is required in the event of a security breach</OntologiaLOPDP:Security_notification_of_infringement>
    <OntologiaLOPDP:Seudonomización>Pseudonomizing data</OntologiaLOPDP:Seudonomización>
    <OntologiaLOPDP:Stop>Prevent access to data</OntologiaLOPDP:Stop>
    <OntologiaLOPDP:Systematic_evaluation>Type of risk assessment</OntologiaLOPDP:Systematic_evaluation>
    <OntologiaLOPDP:Systematic_observation>Keeping track of security</OntologiaLOPDP:Systematic_observation>
    <OntologiaLOPDP:Technical_measurements>Measures for possible failures</OntologiaLOPDP:Technical_measurements>
    <OntologiaLOPDP:Threat>Threat to data</OntologiaLOPDP:Threat>
    <OntologiaLOPDP:Vulnerabilidad>Place that can exploit a threat</OntologiaLOPDP:Vulnerabilidad>
  </rdf:Description>
