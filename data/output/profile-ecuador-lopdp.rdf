  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#principio_de_transparencia001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Transparency_principles"/>
    <OntologiaLOPDP:that_are_divided_into rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#principio_de_transparencia001"/>
    <OntologiaLOPDP:Accurate>Deben ser precisos</OntologiaLOPDP:Accurate>
    <OntologiaLOPDP:Clear>Deben ser claros</OntologiaLOPDP:Clear>
    <OntologiaLOPDP:Complete>Deben ser completos</OntologiaLOPDP:Complete>
    <OntologiaLOPDP:Exact>Deben ser exactos</OntologiaLOPDP:Exact>
    <OntologiaLOPDP:General_detail>Lo que se realice con los datos del titular debe ser claro y de fácil acceso.</OntologiaLOPDP:General_detail>
    <OntologiaLOPDP:Integral>Deben ser íntegros</OntologiaLOPDP:Integral>
    <OntologiaLOPDP:Risk>Cuentan con un riesgo</OntologiaLOPDP:Risk>
    <OntologiaLOPDP:Threat>Estan propensos a amenazas</OntologiaLOPDP:Threat>
    <OntologiaLOPDP:Verifiable>Deben ser comprobables</OntologiaLOPDP:Verifiable>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Financial">
