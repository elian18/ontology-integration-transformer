  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#análisis_de_riesgo_amenazas_y_vulnerabilidades001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Risk_analysis_of_threats_and_vulnerabilities"/>
    <OntologiaLOPDP:account_with_actions_as rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#análisis_de_riesgo_amenazas_y_vulnerabilidades001"/>
    <OntologiaLOPDP:General_detail>Es una tarea que debe realizar el responsable y encargado del tratamiento de los datos para evitar la presencia de esta amenazas.</OntologiaLOPDP:General_detail>
    <OntologiaLOPDP:Risk>Riego presente en un análisis de datos</OntologiaLOPDP:Risk>
    <OntologiaLOPDP:Secrecy_of_communications>La transferencia de información debe ser secreta</OntologiaLOPDP:Secrecy_of_communications>
    <OntologiaLOPDP:Threat>Amenaza a los datos</OntologiaLOPDP:Threat>
    <OntologiaLOPDP:Vulnerabilidad>Vulnerabildiad presente en los datos en procesos de transferencia</OntologiaLOPDP:Vulnerabilidad>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consultation_right001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Right_to_consult_in_verification"/>
    <OntologiaLOPDP:can_be_rights_of rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consultation_right001"/>
    <OntologiaLOPDP:Consent_in_verification>Must be consented to by the owner</OntologiaLOPDP:Consent_in_verification>
    <OntologiaLOPDP:General_detail>This right refers to the obligation that the law has in the event of a request for information by the owner of the information.</OntologiaLOPDP:General_detail>
    <OntologiaLOPDP:Informed>It can be an informed consent</OntologiaLOPDP:Informed>
    <OntologiaLOPDP:Not_informed>May be an uninformed consent</OntologiaLOPDP:Not_informed>
    <OntologiaLOPDP:Revoke_consent>It must be possible to revoke the consent at any time, this can be done by the owner of the data.</OntologiaLOPDP:Revoke_consent>
    <OntologiaLOPDP:Updated>Must be updated</OntologiaLOPDP:Updated>
  </rdf:Description>
