                                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Anonymization> "Untraceable data" ;
                                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Check> "control the risk" ;
                                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Impact_assessment> "Evaluation of an error or information leakage" ;
                                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Large_scale_treatment> "Large-scale processing of data" ;
                                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Loss> "Loss of data" ;
                                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Mitigate> "Mitigating threats" ;
                                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Nature_of_the_data> "What is the nature of the data" ;
