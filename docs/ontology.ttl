###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#health_data001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#health_data001> rdf:type owl:NamedIndividual ,
                                                                                            <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Health_data_in_verification> ;
                                                                                   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#that_can_be> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#health_data001> ;
                                                                                   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Access> "They must have optimal access" ;
                                                                                   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Anonymization> "Data must be anonymized" ;
                                                                                   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Correction> "It must be possible to rectify" ;
                                                                                   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Disposal> "It must be possible to delete data" ;
                                                                                   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "They are a type of data of the owner, but can be used by companies or public entities, this in case of an emergency involving the integrity of the owner of the information." ,
                                                                                                                                                                      "This is data such as criminal history or history of very serious diseases or specific actions that the holder has carried out in breach of a national law or law." ;
                                                                                   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Updated> "Must be up to date" ;
                                                                                   rdfs:label "health data001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#holder001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#holder001> rdf:type owl:NamedIndividual ,
                                                                                       <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Holder_in_verification> ;
                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#is_compliant_with_the_following_roles> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#holder001> ;
                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Contract> "The holder is entitled to a contract" ;
                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Details_of_the_law_details> "General information" ;
                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "It is the person or entity that owns the data." ;
                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Informed> "The Data Subject must be informed of the status of his or her data at all times and must be informed if his or her data is being misused." ;
                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Name> "Francisco" ;
                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_detail> "I am the owner of my information" ;
                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_information> "Information" ;
                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Preservation_time> "3O days" ;
                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Request_information_verification> "The owner of the data can request the verification of his information to the person in charge or responsible for the treatment of his information without cost and as soon as possible." ;
                                                                              rdfs:label "holder001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#informed_consent001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#informed_consent001> rdf:type owl:NamedIndividual ;
                                                                                        <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#can_be> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#informed_consent001> ;
                                                                                        <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Informed> "When the owner is informed of how his or her data will be used or transferred." ;
                                                                                        <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Not_informed> "When the owner is not informed about how his data will be used or transferred." ;
                                                                                        rdfs:label "informed consent001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#infringements001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#infringements001> rdf:type owl:NamedIndividual ,
                                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Violations_in_verification> ;
                                                                                     <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#the_verification_covers_aspects_such_as> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#infringements001> ;
                                                                                     <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Detail_of_investigation_of_infringements> "Detailed information on violations" ;
                                                                                     <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Penalties_for_mild_infractions> "In the case of the Data Authority, the range is from 1 to 10 unified basic salaries; other members of the law are not considered." ;
                                                                                     <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Penalties_for_serious_infractions> "In the case of the Data Authority, the range is 10 to 20 unified basic salaries; the other members of the law are not considered." ;
                                                                                     <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Very_serious> "Infringements that must be treated specially according to the seriousness of the infringement." ;
                                                                                     <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Violations_in_verification> "Fines for non-compliance with the law vary according to the degree of non-compliance." ;
                                                                                     rdfs:label "infringements001" .


