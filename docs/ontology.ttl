                                                                                                                                                                                                 <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_under_specialized_regulations> ;
                                                                                      <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#scope_of_legislation> "The Organic Law on Personal Data Protection will not apply in certain cases." ;
                                                                                      rdfs:label "inapplicability" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#independence_of_control
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#independence_of_control> rdf:type owl:NamedIndividual ,
                                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Independence_of_control> ;
                                                                                              <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_supervised_by> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority> ;
                                                                                              <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "Capacity of the Data Protection Authority to carry out its functions of supervision and application of the Organic Law on Data Protection in an impartial manner and without external interference." ;
                                                                                              rdfs:comment "Capacity of the Data Protection Authority to carry out its functions of supervision and application of the Organic Law on Data Protection in an impartial manner and without external interference."@en ,
                                                                                                           "Capacity of the Data Protection Authority to carry out its functions of supervision and application of the Organic Law on Data Protection in an impartial manner and without external interference."@es ;
                                                                                              rdfs:label "independence of control" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#journalistic_activities
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#journalistic_activities> rdf:type owl:NamedIndividual ,
                                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Journalistic_activities> ;
                                                                                              <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#explanation_of_concept_of_inapplicability> "Refers to the practices and processes involved in the production and dissemination of news and editorial content by journalistic professionals." ;
                                                                                              rdfs:label "journalistic activities" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#juridicity
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#juridicity> rdf:type owl:NamedIndividual ,
                                                                                          <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Juridicity> ;
                                                                                 <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "Personal data must be processed in strict compliance with the principles, rights and obligations established in the Constitution, international instruments, this Law, its Regulations and other applicable rules and jurisprudence." ;
                                                                                 rdfs:comment "Personal data must be processed in strict compliance with the principles, rights and obligations established in the Constitution, international instruments, this Law, its Regulations and other applicable rules and jurisprudence."@en ,
                                                                                              "Personal data must be processed in strict compliance with the principles, rights and obligations established in the Constitution, international instruments, this Law, its Regulations and other applicable rules and jurisprudence."@es ;
                                                                                 rdfs:label "juridicity" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legal_interest
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legal_interest> rdf:type owl:NamedIndividual ,
                                                                                              <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Legal_interest> ;
                                                                                     <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "Legal justification for the processing of personal data that is not directly related to the individual's consent, compliance with a legal obligation or the performance of a contract." ;
                                                                                     rdfs:comment "Legal justification for the processing of personal data that is not directly related to the individual's consent, compliance with a legal obligation or the performance of a contract."@en ,
                                                                                                  "Legal justification for the processing of personal data that is not directly related to the individual's consent, compliance with a legal obligation or the performance of a contract."@es ;
                                                                                     rdfs:label "legal interest" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legal_persons_data
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legal_persons_data> rdf:type owl:NamedIndividual ,
                                                                                                  <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Legal_persons_data> ;
                                                                                         <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#explanation_of_concept_of_inapplicability> "Data that identifies or makes identifiable legal entities" ;
                                                                                         <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#information_suceptible_to_treatment_is_accessible> "Public" ;
                                                                                         <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#treatment_suceptible_information> "In the case of public servants, the historical and updated information of their asset declaration and remuneration shall be submitted for processing." ,
                                                                                                                                                                                                "Personal data concerning the contact of professionals and commercial data" ,
                                                                                                                                                                                                "Representatives, partners and shareholders of legal entities, as well as public servants, may be subject to the processing of personal data in the context of their professional practice, line of business, competencies, powers, attributions or positions. This processing refers specifically to information such as names and surnames, functions or positions held, postal or e-mail addresses and professional telephone numbers." ;
                                                                                         rdfs:label "legal persons data" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legal_representative_owner
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legal_representative_owner> rdf:type owl:NamedIndividual ,
                                                                                                          <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Legal_representative_owner> ;
                                                                                                 <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#activity_of_the_legal_representative_owner> "Ensure that the rights and privacy of the owner he/she represents are respected at all times." ,
                                                                                                                                                                                                                  "Make informed decisions about the processing of the personal data of the owner he/she represents." ,
                                                                                                                                                                                                                  "Provide consent for the processing of data on behalf of the data subject he/she represents." ;
                                                                                                 <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "The legal representative of an owner who is unable to give consent acts on behalf of and in the interest of the owner in situations where the owner is unable to give consent due to incapacity, minority or other similar circumstances." ;
                                                                                                 rdfs:comment "The legal representative of an owner who is unable to give consent acts on behalf of and in the interest of the owner in situations where the owner is unable to give consent due to incapacity, minority or other similar circumstances."@en ,
                                                                                                              "The legal representative of an owner who is unable to give consent acts on behalf of and in the interest of the owner in situations where the owner is unable to give consent due to incapacity, minority or other similar circumstances."@es ;
                                                                                                 rdfs:label "legal representative owner" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legality
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legality> rdf:type owl:NamedIndividual ,
                                                                                        <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Legality> ;
                                                                               <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "Data processing must be carried out in accordance with the Organic Law on Personal Data Protection." ;
                                                                               rdfs:comment "Data processing must be carried out in accordance with the Organic Law on Personal Data Protection."@en ,
                                                                                            "Data processing must be carried out in accordance with the Organic Law on Personal Data Protection."@es ;
                                                                               rdfs:label "legality" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#location_of_the_personal_data_protection_system_members
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#location_of_the_personal_data_protection_system_members> rdf:type owl:NamedIndividual ,
                                                                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Location_of_the_personal_data_protection_system_integrants> ;
                                                                                                                              <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#territorial_application_scenario> "If the controller or processor of personal data is not domiciled in the national territory, the Organic Law on Personal Data Protection may apply due to a specific contract or public international law regulations. In other words, even if the controller or processor does not reside in Ecuador, they may be subject to comply with the country's data protection law due to contractual agreements or international regulations." ,
                                                                                                                                                                                                                                     "If the data subject resides in Ecuador and the controller or processor has no establishment in the country, and the data processing is linked to activities that include the offer of goods or services to data subjects, whether or not it involves payment, or is intended to monitor their behavior, provided that such monitoring is carried out within Ecuadorian territory." ,
                                                                                                                                                                                                                                     "If the person in charge of or responsible for the processing of personal data is domiciled in any part of national territory" ;
                                                                                                                              rdfs:label "location of the personal data protection system members" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#loyalty
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#loyalty> rdf:type owl:NamedIndividual ,
                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Loyalty> ;
                                                                              <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "The data subject should clearly know that they are collecting, using or processing your personal data, and how it will be treated." ;
                                                                              rdfs:comment "The data subject should clearly know that they are collecting, using or processing your personal data, and how it will be treated."@en ,
                                                                                           "The data subject should clearly know that they are collecting, using or processing your personal data, and how it will be treated."@es ;
                                                                              rdfs:label "loyalty" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minimization_of_personal_data
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minimization_of_personal_data> rdf:type owl:NamedIndividual ,
                                                                                                             <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Minimization> ;
                                                                                                    <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "It implies that the amount of data collected must be limited and restricted to what is strictly necessary to fulfill the purpose of the processing." ;
                                                                                                    rdfs:comment "It implies that the amount of data collected must be limited and restricted to what is strictly necessary to fulfill the purpose of the processing."@en ,
                                                                                                                 "It implies that the amount of data collected must be limited and restricted to what is strictly necessary to fulfill the purpose of the processing."@es ;
                                                                                                    rdfs:label "minimization of personal data" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minimum_criteria
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minimum_criteria> rdf:type owl:NamedIndividual ,
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Minimum_criteria> ;
                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#are_composed_of> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legality> ,
                                                                                                                                                                             <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#need> ,
                                                                                                                                                                             <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proportionality> ;
                                                                                       rdfs:label "minimum criteria" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minor_infractions
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minor_infractions> rdf:type owl:NamedIndividual ,
                                                                                                 <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Minor_infractions> ;
                                                                                        <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#committed_by> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processor> ,
                                                                                                                                                                           <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment> .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minor_infractions_penalties
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minor_infractions_penalties> rdf:type owl:NamedIndividual ,
                                                                                                           <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Minor_infractions_penalties> ;
                                                                                                  <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#by> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minor_infractions> ;
                                                                                                  <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_related_to> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proportionality> ,
                                                                                                                                                                                      <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#turnover> ;
                                                                                                  <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#will_be_imposed_by> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority> ;
                                                                                                  <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#destined_for> "Servidores o funcionarios del sector público" ,
                                                                                                                                                                                     "The Controller or Processor of personal data or, if applicable, a third party, may be a private law entity or a public company." ;
                                                                                                  <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#determination_of_the_fine_in_respect_to_penalties_for_infringement_of_the_responsible_person_or_person_in_charge_of_treatment> "Intentionality, which will evaluate the offender's conduct to determine if there was intent to commit the infraction." ,
                                                                                                                                                                                                                                                                                                      "Nature of the damage, where the negative consequences for the right to the protection of personal data will be evaluated." ,
                                                                                                                                                                                                                                                                                                      "Recidivism, which is considered when the previous infraction is similar to the one to be sanctioned again." ,
                                                                                                                                                                                                                                                                                                      "Reiteration of the infraction, which considers when the controller or processor of personal data has been previously sanctioned for two or more infractions of lesser gravity, or for an infraction of equal or greater gravity." ;
                                                                                                  <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#principle_of_attachment_with_sanction_to_the_responsible_party_or_the_treatment_manager> "Proportionality" ;
                                                                                                  <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_of_penalty_for_infractions_to_the_responsible_party_or_the_processor> "A fine ranging from 0.1% to 0.7% of the turnover for the fiscal year immediately preceding the imposition of the fine shall be imposed." ;
                                                                                                  <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_of_penalty_for_infractions_toward_public_servants_or_officials> "Shall be sanctioned with a fine ranging from 1 to 10 basic unified salaries of the public servant or public official" ,
                                                                                                                                                                                                                                            "This sanction does not rule out the possibility of the State assuming additional liability for damages caused, which will be governed in accordance with the corresponding regulations." ;
                                                                                                  rdfs:label "minor infractions penalties" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#need
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#need> rdf:type owl:NamedIndividual ,
                                                                                    <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Need> ;
                                                                           <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "Data processing must be necessary to achieve the intended purpose and no more data must be collected than is necessary for that specific purpose." ;
                                                                           rdfs:comment "Data processing must be necessary to achieve the intended purpose and no more data must be collected than is necessary for that specific purpose."@en ,
                                                                                        "Data processing must be necessary to achieve the intended purpose and no more data must be collected than is necessary for that specific purpose."@es ;
                                                                           rdfs:label "need" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#normativa_especializada
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#normativa_especializada> rdf:type owl:NamedIndividual ;
                                                                                              rdfs:label "normativa especializada" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#organic_law_on_personal_data_protection
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#organic_law_on_personal_data_protection> rdf:type owl:NamedIndividual ,
                                                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Organic_Law_on_Personal_Data_Protection> ;
                                                                                                              <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#target> "The fundamental purpose of the Organic Law on Personal Data Protection is to ensure the effective application of the right to the protection of personal data. This right covers both access to and decision-making on information and data of a personal nature and the guarantee of their due protection. To this end, the law regulates, foresees and develops principles, rights, obligations and protection mechanisms necessary to comprehensively safeguard the privacy and security of personal data." ;
                                                                                                              rdfs:label "organic law on personal data protection" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#penalties_for_Serious_Infringements
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#penalties_for_Serious_Infringements> rdf:type owl:NamedIndividual ,
                                                                                                                   <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Penalties_for_Serious_Infringements> ;
                                                                                                          <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#by> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#serious_infractions> ;
                                                                                                          <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_related_to> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proportionality> ,
                                                                                                                                                                                              <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#turnover> ;
                                                                                                          <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#will_be_imposed_by> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority> ;
                                                                                                          <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#destined_for> "Public sector employees or officials" ,
                                                                                                                                                                                             "The Controller or Processor of personal data or, if applicable, a third party, may be a private law entity or a public company." ;
                                                                                                          <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#determination_of_the_fine_in_respect_to_penalties_for_infringement_of_the_responsible_person_or_person_in_charge_of_treatment> "Intentionality, which will evaluate the offender's conduct to determine if there was intent to commit the infraction." ,
                                                                                                                                                                                                                                                                                                              "Nature of the damage, where the negative consequences for the right to the protection of personal data will be evaluated." ,
                                                                                                                                                                                                                                                                                                              "Recidivism, which is considered when the previous infraction is similar to the one to be sanctioned again." ,
                                                                                                                                                                                                                                                                                                              "Reiteration of the infraction, which considers when the controller or processor of personal data has been previously sanctioned for two or more infractions of lesser gravity, or for an infraction of equal or greater gravity." ;
                                                                                                          <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_of_penalty_for_infractions_to_the_responsible_party_or_the_processor> "A fine ranging from 0.7% to 1% of the turnover for the fiscal year immediately preceding the imposition of the fine shall be imposed." ;
                                                                                                          <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_of_penalty_for_infractions_toward_public_servants_or_officials> "It shall be punished with a fine ranging from 10 to 20 unified basic salaries of the public servant or official." ,
                                                                                                                                                                                                                                                    "This sanction does not rule out the possibility of the State assuming additional liability for damages caused, which will be governed in accordance with the corresponding regulations." ;
                                                                                                          rdfs:label "penalties for Serious Infringements" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data> rdf:type owl:NamedIndividual ,
                                                                                             <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data> ;
                                                                                    <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#must_comply_with> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#principios> ;
                                                                                    <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_are_composed_of> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#biometric_data> ,
                                                                                                                                                                                        <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#credit_data> ,
                                                                                                                                                                                        <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#deceased_persons_data> ,
                                                                                                                                                                                        <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#genetic_data> ,
                                                                                                                                                                                        <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#health_related_data> ,
                                                                                                                                                                                        <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#sensitive_data> ,
                                                                                                                                                                                        <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#specialized_subject_data> ;
                                                                                    <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "Data that identifies or makes identifiable a natural person, directly or indirectly." ;
                                                                                    <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#it_is_not_imputable_to_be_inaccurate_when> "If the inaccurate data was obtained directly by the controller from the data subject" ,
                                                                                                                                                                                                    "If the inaccurate data were obtained by the data controller from a public record" ,
                                                                                                                                                                                                    "If the inaccurate data were obtained by the data controller through an intermediary, following the regulations applicable in the sector that allow the intervention of an intermediary to collect and transmit the data to the data controller" ;
                                                                                    <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#to_comply_with_quality_you_must> "Accurate, i.e. the personal data must be precise and faithfully reflect the reality or situation they represent, without errors, contradictions or inaccuracies." ,
                                                                                                                                                                                          "Accurate, that personal data must be correct and accurately reflect reality without errors or inaccuracies." ,
                                                                                                                                                                                          "Clear, i.e. personal data must be understandable and not give rise to ambiguous or confusing interpretations." ,
                                                                                                                                                                                          "Complete, i.e. the personal data must include all relevant and necessary details for the purpose of processing, without omitting important information." ,
                                                                                                                                                                                          "Integral, that is to say, the personal data must not have been altered, modified or corrupted in any way that affects its veracity." ,
                                                                                                                                                                                          "Updated, i.e. personal data must reflect the most recent situation of the person or object to which it refers, and be modified or updated when necessary to maintain its validity." ,
                                                                                                                                                                                          "Verifiable, i.e. personal data must be verifiable and capable of being checked against reliable sources or evidence to confirm its authenticity and validity." ;
                                                                                    rdfs:comment "Data that identifies or makes identifiable a natural person, directly or indirectly."@en ,
                                                                                                 "Data that identifies or makes identifiable a natural person, directly or indirectly."@es ;
                                                                                    rdfs:label "personal data" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority> rdf:type owl:NamedIndividual ,
                                                                                                                  <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_protection_authority> ;
                                                                                                         <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#actions_regarding_health_data_processing> "For when dealing with anonymized health data" ;
                                                                                                         <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#actions_regarding_independence_of_control> "Investigation action, which involves carrying out investigations into possible violations of data protection legislation in an independent and partial manner." ,
                                                                                                                                                                                                                         "Prevention action, which consists of promoting good practices and providing guidance and advice to organizations and citizens on how to protect personal data and comply with privacy regulations." ,
                                                                                                                                                                                                                         "Sanction action, which arises once violations of data protection legislation are identified, whereby the Data Protection Authority has the power to impose appropriate and proportionate sanctions." ;
                                                                                                         <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#authorization_for_treatment_of_anonymized_health_data> "A favorable report from the Health Authority, which confirms that the technical protocol complies with the standards and regulations established by the Organic Law on Personal Data Protection and other related laws." ,
                                                                                                                                                                                                                                     "Provide technical protocol containing the necessary details to ensure the protection of health data." ;
                                                                                                         <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#control_functions> "It is the control and oversight body responsible for guaranteeing all citizens the protection of their personal data, and for taking all necessary actions to ensure that the principles, rights, guarantees and procedures set forth in the Organic Law on Personal Data Protection and its implementing regulations are respected." ;
                                                                                                         <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#designation> "The Personal Data Protection Authority shall be appointed in accordance with the provisions of the Constitution of the Republic." ,
                                                                                                                                                                                           "The appointment is made from a list of three candidates provided by the President of the Republic" ,
                                                                                                                                                                                           "The selection is based on criteria of specialization and merit, and the process is public, allowing for citizen challenges." ;
                                                                                                         <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#duration_of_charge> "The Personal Data Protection Authority will exercise its functions for a period of 5 years." ;
                                                                                                         <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#functions> "Apply sanctions to those responsible, delegates, persons in charge and third parties, in accordance with the provisions of the Organic Law on Personal Data Protection." ,
                                                                                                                                                                                         "Attending to consultations on personal data protection matters" ,
                                                                                                                                                                                         "Control and supervise the exercise of the right to personal data protection within the data processing carried out through the National System of Public Registries." ,
                                                                                                                                                                                         "Create, manage and administer the National Registry of Personal Data Protection, and collaborate with public and private entities to ensure its correct operation." ,
                                                                                                                                                                                         "Establish guidelines for the analysis, evaluation and selection of personal data security measures." ,
                                                                                                                                                                                         "Exercise the supervision, control and evaluation of the activities carried out by the person responsible for and in charge of the processing of personal data." ,
                                                                                                                                                                                         "Investigate, analyze and resolve complaints filed by data subjects, as well as those initiated by the Personal Data Protection Authority, in addition to imposing appropriate sanctions" ,
                                                                                                                                                                                         "Issue guidelines for the design and content of the personal data processing policy." ,
                                                                                                                                                                                         "Keep a statistical record of personal data security breaches and identify possible security measures for each of them." ,
                                                                                                                                                                                         "Perform or delegate technical audits to the processing of personal data." ,
                                                                                                                                                                                         "Periodically publish a guide to personal data protection regulations." ,
                                                                                                                                                                                         "Promote adequate and effective coordination with accountability officers and participate in international and regional initiatives for the protection of personal data protection." ,
                                                                                                                                                                                         "Promote and encourage the exercise of the right to the protection of personal data, as well as the awareness and understanding of the risks, rules, guarantees and rights of individuals in relation to the processing and use of their personal data, with special emphasis on activities aimed at priority groups such as children and adolescents." ,
                                                                                                                                                                                         "To dictate standard data protection clauses and verify the content of additional or specific clauses or guarantees." ,
                                                                                                                                                                                         "To issue general or technical regulations, criteria and other acts necessary for the exercise of its powers and the guarantee of the exercise of the right to the protection of personal data." ,
                                                                                                                                                                                         "To represent internationally the interests related to the protection of personal data." ;
                                                                                                         <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#known_as> "Data Protection Superintendent" ;
                                                                                                         <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#requirements_that_must_be_met> "Must have at least a fourth level degree and a minimum of 10 years of experience in areas related to the regulation of the Organic Law for the Protection of Personal Data." ,
                                                                                                                                                                                                             "The Personal Data Protection Authority must be a professional in law, information systems, communication or technology." ;
                                                                                                         <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#revocation> "His mandate can only be revoked by impeachment after an impeachment trial conducted by the National Assembly." ,
                                                                                                                                                                                          "Its mandate can only be revoked in accordance with the grounds established in the Ecuadorian laws regulating public service." ;
                                                                                                         <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_authority> "Public" ;
                                                                                                         rdfs:label "personal data protection authority" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_seals
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_seals> rdf:type owl:NamedIndividual ,
                                                                                                              <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_protection_seals> ;
                                                                                                     <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_given_by> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processor> ,
                                                                                                                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment> ;
                                                                                                     <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "Recognition awarded for having implemented best practices in the processes, thus contributing to promote the holder's confidence." ;
                                                                                                     rdfs:comment "Recognition awarded for having implemented best practices in the processes, thus contributing to promote the holder's confidence."@en ,
                                                                                                                  "Recognition awarded for having implemented best practices in the processes, thus contributing to promote the holder's confidence."@es ;
                                                                                                     rdfs:label "personal data protection seals" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_security_vulnerability
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_security_vulnerability> rdf:type owl:NamedIndividual ,
                                                                                                                    <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_security_vulnerability> ;
                                                                                                           <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#affects_to> "Availability of personal data" ,
                                                                                                                                                                                            "Confidentiality of personal data" ,
                                                                                                                                                                                            "Integrity of personal data" ;
                                                                                                           <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "Security incident" ;
                                                                                                           rdfs:comment "Security incident"@en ,
                                                                                                                        "Security incident"@es ;
                                                                                                           rdfs:label "personal data security vulnerability" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_under_specialized_regulations
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_under_specialized_regulations> rdf:type owl:NamedIndividual ,
                                                                                                                           <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_under_specialized_regulations> ;
                                                                                                                  <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#explanation_of_concept_of_inapplicability> "Personal data whose processing is regulated in specialized regulations of equal or higher hierarchy in matters of risk management for natural disasters; and, security and defense of the State, in any of these cases must comply with international standards in the field of human rights and the principles of this Law, and at least with the criteria of legality, proportionality and necessity." ;
                                                                                                                  rdfs:label "personal data under specialized regulations" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#principios
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#principios> rdf:type owl:NamedIndividual ,
                                                                                          <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Principles> ;
                                                                                 <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#are_composed_of> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Purpose> ,
                                                                                                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#application_favorable_to_the_owner> ,
                                                                                                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#confidentiality> ,
                                                                                                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#conservation> ,
                                                                                                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#independence_of_control> ,
                                                                                                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#juridicity> ,
                                                                                                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#loyalty> ,
                                                                                                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minimization_of_personal_data> ,
                                                                                                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proactive_and_demonstrated_accountability> ,
                                                                                                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proportionality> ,
                                                                                                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#quality> ,
                                                                                                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#relevance_of_personal_data> ,
                                                                                                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#security> ,
                                                                                                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#transparency> ;
                                                                                 <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "La Ley Orgnánica de Protección de Datos Personale se regirá por un conjunto de principios, sin perjuicio de otros principios establecidos en la Constitución de la República, los instrumentos internacionales ratificados por el Estado u otras normas jurídicas" ;
                                                                                 rdfs:comment "La Ley Orgnánica de Protección de Datos Personale se regirá por un conjunto de principios, sin perjuicio de otros principios establecidos en la Constitución de la República, los instrumentos internacionales ratificados por el Estado u otras normas jurídicas"@en ,
                                                                                              "La Ley Orgnánica de Protección de Datos Personale se regirá por un conjunto de principios, sin perjuicio de otros principios establecidos en la Constitución de la República, los instrumentos internacionales ratificados por el Estado u otras normas jurídicas"@es ;
                                                                                 rdfs:label "principios" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proactive_and_demonstrated_accountability
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proactive_and_demonstrated_accountability> rdf:type owl:NamedIndividual ,
                                                                                                                         <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Proactive_and_demonstrated_accountability> ;
                                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_implemented_by> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment> ;
                                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "The person or entity responsible for handling personal data must take measures in advance to protect that information and personal data, which implies demonstrating that mechanisms and actions have been implemented to ensure that the data are handled securely and in accordance with the Organic Law on Personal Data Protection." ;
                                                                                                                rdfs:comment "The person or entity responsible for handling personal data must take measures in advance to protect that information and personal data, which implies demonstrating that mechanisms and actions have been implemented to ensure that the data are handled securely and in accordance with the Organic Law on Personal Data Protection."@en ,
                                                                                                                             "The person or entity responsible for handling personal data must take measures in advance to protect that information and personal data, which implies demonstrating that mechanisms and actions have been implemented to ensure that the data are handled securely and in accordance with the Organic Law on Personal Data Protection."@es ;
                                                                                                                rdfs:label "proactive and demonstrated accountability" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#processing
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#processing> rdf:type owl:NamedIndividual ,
                                                                                          <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Processing> ;
                                                                                 <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_related_to> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processing> ,
                                                                                                                                                                     <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#scope_of_application> ;
                                                                                 <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "El conjunto de acciones o procedimientos que se aplican a los datos o información con el fin de transformarlos, analizarlos, organizarlos o manipularlos de alguna manera para obtener resultados específicos" ;
                                                                                 rdfs:comment "El conjunto de acciones o procedimientos que se aplican a los datos o información con el fin de transformarlos, analizarlos, organizarlos o manipularlos de alguna manera para obtener resultados específicos"@en ,
                                                                                              "El conjunto de acciones o procedimientos que se aplican a los datos o información con el fin de transformarlos, analizarlos, organizarlos o manipularlos de alguna manera para obtener resultados específicos"@es ;
                                                                                 rdfs:label "processing" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#profile_making
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#profile_making> rdf:type owl:NamedIndividual ,
                                                                                              <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Profile_making> ;
                                                                                     <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processing_is_intended_for_individuals> "Natural" ;
                                                                                     <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "Refers to any personal data processing process that aims to evaluate, analyze or predict various aspects of a natural person." ;
                                                                                     <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#to_determine_behaviors_or_standards_relative_to> "Economic situation" ,
                                                                                                                                                                                                           "Health" ,
                                                                                                                                                                                                           "Intereses" ,
                                                                                                                                                                                                           "Location" ,
                                                                                                                                                                                                           "Other similar aspects" ,
                                                                                                                                                                                                           "Personal preferences" ,
                                                                                                                                                                                                           "Physical movement" ,
                                                                                                                                                                                                           "Professional performance" ,
                                                                                                                                                                                                           "Skills" ;
                                                                                     rdfs:comment "Refers to any personal data processing process that aims to evaluate, analyze or predict various aspects of a natural person."@en ,
                                                                                                  "Refers to any personal data processing process that aims to evaluate, analyze or predict various aspects of a natural person."@es ;
                                                                                     rdfs:label "profile making" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proportionality
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proportionality> rdf:type owl:NamedIndividual ,
                                                                                               <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Proportionality> ;
                                                                                      <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "It involves ensuring that the way in which personal data is handled is balanced and appropriate in relation to the purposes for which the data was collected and the nature of the information involved" ;
                                                                                      rdfs:comment "It involves ensuring that the way in which personal data is handled is balanced and appropriate in relation to the purposes for which the data was collected and the nature of the information involved"@en ,
                                                                                                   "It involves ensuring that the way in which personal data is handled is balanced and appropriate in relation to the purposes for which the data was collected and the nature of the information involved"@es ;
                                                                                      rdfs:label "proportionality" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#pseudonymization
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#pseudonymization> rdf:type owl:NamedIndividual ,
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Pseudonymization> ;
                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "The process of processing personal data in such a way that it cannot be directly attributed to a data subject without the use of additional information. This additional information is kept separately and is subject to technical and organizational measures designed to ensure that personal data cannot be linked to an identified or identifiable natural person." ;
                                                                                       rdfs:comment "The process of processing personal data in such a way that it cannot be directly attributed to a data subject without the use of additional information. This additional information is kept separately and is subject to technical and organizational measures designed to ensure that personal data cannot be linked to an identified or identifiable natural person."@en ,
                                                                                                    "The process of processing personal data in such a way that it cannot be directly attributed to a data subject without the use of additional information. This additional information is kept separately and is subject to technical and organizational measures designed to ensure that personal data cannot be linked to an identified or identifiable natural person."@es ;
                                                                                       rdfs:label "pseudonymization" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#quality
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#quality> rdf:type owl:NamedIndividual ,
                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Quality> ;
                                                                              <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#associated_to> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data> ;
                                                                              <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_in_charge_of> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment> ;
                                                                              <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "Personal data needs to be accurate, complete, complete and clear. This means that the data must be accurate and free of errors, accurately reflecting the reality of the person to whom it pertains." ;
                                                                              rdfs:comment "Personal data needs to be accurate, complete, complete and clear. This means that the data must be accurate and free of errors, accurately reflecting the reality of the person to whom it pertains."@en ,
                                                                                           "Personal data needs to be accurate, complete, complete and clear. This means that the data must be accurate and free of errors, accurately reflecting the reality of the person to whom it pertains."@es ;
                                                                              rdfs:label "quality" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#recall_mechanisms
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#recall_mechanisms> rdf:type owl:NamedIndividual ,
                                                                                                 <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Recall_mechanisms> ;
                                                                                        <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#son_establecidos_por> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment> ;
                                                                                        <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "Means that must be available for an individual to revoke his consent to the processing of his personal data" ;
                                                                                        <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#must_be> "Simple procedure, similar to the procedure by which consent was obtained" ;
                                                                                        <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#must_guarantee> "Effectiveness, i.e., achieving revocation of consent" ,
                                                                                                                                                                             "Efficiency, i.e. that the revocation of consent does not take too much time or effort, both on the part of the data subject and the data controller." ,
                                                                                                                                                                             "Expeditiousness, i.e., the speed or promptness with which the consent revocation process is conducted" ,
                                                                                                                                                                             "Free of charge, which implies that the consent revocation process should not generate additional costs for the data subject." ;
                                                                                        rdfs:comment "Means that must be available for an individual to revoke his consent to the processing of his personal data"@en ,
                                                                                                     "Means that must be available for an individual to revoke his consent to the processing of his personal data"@es ;
                                                                                        rdfs:label "recall mechanisms" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#recipient
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#recipient> rdf:type owl:NamedIndividual ,
                                                                                         <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Recipient> ;
                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#control_functions> "Person who has been notified with personal data" ;
                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_of_person> "Natural or Legal" ;
                                                                                rdfs:label "recipient" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#relevance_of_personal_data
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#relevance_of_personal_data> rdf:type owl:NamedIndividual ,
                                                                                                          <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Relevance> ;
                                                                                                 <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "That the data collected must be relevant and directly related to the specific purpose for which it is collected." ;
                                                                                                 rdfs:comment "That the data collected must be relevant and directly related to the specific purpose for which it is collected."@en ,
                                                                                                              "That the data collected must be relevant and directly related to the specific purpose for which it is collected."@es ;
                                                                                                 rdfs:label "relevance of personal data" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment> rdf:type owl:NamedIndividual ,
                                                                                                         <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Controller> ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_related_to> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#delegate> ,
                                                                                                                                                                                    <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority> ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#must_have_been_complied_with_regard_to_proactive_responsibility> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#principios> ,
                                                                                                                                                                                                                                      <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#rights> ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#must_render_accounts_regarding_the_treatment_with> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_owner> ,
                                                                                                                                                                                                                        <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority> ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#accrediting_compliance_with_the_mechanisms> "Implementation of certification systems, which are formal processes through which an independent entity evaluates and verifies compliance with the requirements established in standards, regulations or norms related to data protection." ,
                                                                                                                                                                                                                 "Make use of self- and co-regulatory schemes, i.e. programs or frameworks in which organizations voluntarily commit to comply with certain data protection standards and principles." ,
                                                                                                                                                                                                                 "Use of best practices, i.e. recommended methods and processes that have proven to be effective in the protection of personal data." ,
                                                                                                                                                                                                                 "Use of protection codes, which are associated with a set of principles, guidelines and specific rules established by data protection authorities to regulate the handling of personal data in certain sectors or contexts." ,
                                                                                                                                                                                                                 "Use of standards, i.e., follow guidelines and criteria established by internationally recognized organizations for the handling and protection of personal data." ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#activity_in_respect_to_proactive_and_demonstrated_responsibility> "Implementation of mechanisms for the protection of personal data, which implies guaranteeing compliance with the principles, rights and obligations established in the Organic Law for the Protection of Personal Data." ,
                                                                                                                                                                                                                                       "To demonstrate compliance with these mechanisms and applicable regulations, that is, to have evidence and documents that demonstrate that the mechanisms and applicable regulations are being followed." ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#activity_within_opposition_law> "The controller shall cease processing the personal data, unless it can demonstrate compelling legitimate grounds justifying the processing which outweigh the interests, rights and freedoms of the data subject, or for the purposes of the lodging, exercise or defense of claims." ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#activity_within_right_of_access> "The person responsible for the processing of personal data must implement adequate means to facilitate the exercise of the right of access by the data subject" ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#activity_within_the_right_of_correction_and_update> "The data controller must respond to requests for rectification and updating, and if necessary, inform the recipient of the data so that he/she can also carry out the corresponding update." ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#activity_within_the_right_of_deletion> "The controller shall implement methods and techniques aimed at deleting, rendering unreadable, or rendering unrecognizable in a definitive and secure manner personal data." ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#contact_data> "Address of legal domicile" ,
                                                                                                                                                                                   "E-mail address" ,
                                                                                                                                                                                   "Names and surnames" ,
                                                                                                                                                                                   "Telephone number" ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#control_functions> "Responsible for deciding on the purpose and processing of personal data" ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#deadline_in_days_for_the_right_of_access> 15 ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#deadline_in_days_for_the_right_to_oppose_opposition> 15 ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#delegate_comments> "Ensure that the involvement of the personal data protection officer, in all matters relating to personal data protection, is appropriate and timely." ,
                                                                                                                                                                                        "Ensure that the personal data protection officer establishes direct communication with the highest executive and decision-making levels of the data controller." ,
                                                                                                                                                                                        "Facilitate access to the personal data of the processing operations, as well as all the resources and elements necessary to guarantee the correct and free performance of its functions." ,
                                                                                                                                                                                        "They may not dismiss or sanction the personal data protection officer for the proper performance of his or her duties." ,
                                                                                                                                                                                        "Train and update the personal data protection officer on the subject, in accordance with the technical regulations issued by the Personal Data Protection Authority." ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#in_the_event_of_a_challenge_of_data_exaccuracy> "The accuracy of the personal data must be verified, so it must be placed in the database, where the challenged information is contained, that it has been the subject of disagreement by the data owner." ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minor_infractions> "Choosing a processor of personal data that does not offer sufficient guarantees to make effective the exercise of the right to the protection of personal data." ,
                                                                                                                                                                                        "Failure to attend, late or unjustified response to requests or complaints from the holder" ,
                                                                                                                                                                                        "Failure to comply with the corrective measures ordered by the Personal Data Protection Authority." ,
                                                                                                                                                                                        "Failure to implement data protection by design and by default" ,
                                                                                                                                                                                        "Failure to maintain available personal data protection policies related to the processing of personal data" ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#nature_of_the_entity> "Public or Private" ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#obligations> "Allowing audits and inspections by accredited auditors" ,
                                                                                                                                                                                  "Comply with any other obligation established by applicable regulations or other Ecuadorian laws." ,
                                                                                                                                                                                  "Conduct security adequacy assessments prior to the processing of personal data." ,
                                                                                                                                                                                  "Designate a Data Protection Officer when necessary." ,
                                                                                                                                                                                  "Develop customized data protection policies" ,
                                                                                                                                                                                  "Ensuring that data controllers comply with regulations and best practices" ,
                                                                                                                                                                                  "Establish confidentiality agreements with personnel and processors." ,
                                                                                                                                                                                  "Implement administrative, technical and legal measures to guarantee the proper treatment of data" ,
                                                                                                                                                                                  "Integrate data protection from system design onwards" ,
                                                                                                                                                                                  "Maintain the National Registry of Personal Data Protection up to date." ,
                                                                                                                                                                                  "Notifying the Personal Data Protection Authority and the data owner of violations of the security measures implemented for the processing of personal data in accordance with the procedure established for this purpose." ,
                                                                                                                                                                                  "Periodically evaluate the effectiveness of the administrative, technical and legal measures adopted." ,
                                                                                                                                                                                  "Take the necessary technological, physical, administrative, organizational and legal measures to prevent, deter, reduce, mitigate and control identified risks and breaches." ,
                                                                                                                                                                                  "Treat personal data in accordance with the Organic Law on Personal Data Protection and relevant regulations." ,
                                                                                                                                                                                  "Use risk analysis and management methodologies adapted to the particularities of data processing and the parties involved." ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#serious_infractions> "Do not sign contracts that include confidentiality clauses with those who handle personal data." ,
                                                                                                                                                                                          "Failure to allow or cooperate with audits or inspections by an accredited auditor" ,
                                                                                                                                                                                          "Failure to comply with corrective measures or insufficient compliance, especially if previous sanctions have been imposed for minor infractions and there is a recidivism." ,
                                                                                                                                                                                          "Failure to conduct impact assessments when necessary" ,
                                                                                                                                                                                          "Failure to designate a data protection officer when necessary" ,
                                                                                                                                                                                          "Failure to implement measures to prevent and control data security risks" ,
                                                                                                                                                                                          "Failure to inform the Data Protection Authority and the Data Controller about security breaches affecting individual rights." ,
                                                                                                                                                                                          "Failure to keep the National Data Protection Registry up to date as required." ,
                                                                                                                                                                                          "Failure to notify the holder of security breaches affecting his rights" ,
                                                                                                                                                                                          "Failure to put in place adequate measures to protect personal data as required by law and relevant regulations" ,
                                                                                                                                                                                          "Failure to register the required information in the National Data Protection Registry." ,
                                                                                                                                                                                          "Failure to use appropriate methodologies to analyze and manage the risks associated with personal data" ,
                                                                                                                                                                                          "Sharing of personal data without following legal requirements and established procedures" ,
                                                                                                                                                                                          "Using information or data for purposes other than those initially stated" ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#time_of_attention_in_days_for_the_right_of_removal> 15.0 ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#time_of_attention_within_days_for_the_right_of_correction_and_update> 15 ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_authority> "Public" ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_of_organism_participation> "Alone or together with others" ;
                                                                                                <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_of_person> "Natural or Legal" ;
                                                                                                rdfs:label "responsible for treatment" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#revocation_of_consent
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#revocation_of_consent> rdf:type owl:NamedIndividual ,
                                                                                                     <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Revocation_of_consent> ;
                                                                                            <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#can_count_on> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#recall_mechanisms> ;
                                                                                            <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#regarding_treatment> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processing> ;
                                                                                            <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#justification_for_revocation> "No justification required for revocation of consent" ;
                                                                                            <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#when_it_can_be_produced> "At any time, when the holder deems it pertinent" ;
                                                                                            rdfs:label "revocation of consent" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_not_to_be_object_to_automated_evaluations
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_not_to_be_object_to_automated_evaluations> rdf:type owl:NamedIndividual ,
                                                                                                                               <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_not_to_be_object_to_automated_evaluations> ;
                                                                                                                      <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#for_the> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_owner> ;
                                                                                                                      <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_related_to> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#consent> ;
                                                                                                                      <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_account_encumbered> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processor> ,
                                                                                                                                                                                                                     <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment> ;
                                                                                                                      <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#will_not_be_able_to_deal> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#sensitive_data> ;
                                                                                                                      <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "The holder has the right not to be subjected to decisions that are based in whole or in part on automated assessments, including profiling, if these decisions have a legal impact on him or her or threaten his or her fundamental rights and freedoms" ;
                                                                                                                      rdfs:comment "The holder has the right not to be subjected to decisions that are based in whole or in part on automated assessments, including profiling, if these decisions have a legal impact on him or her or threaten his or her fundamental rights and freedoms"@en ,
                                                                                                                                   "The holder has the right not to be subjected to decisions that are based in whole or in part on automated assessments, including profiling, if these decisions have a legal impact on him or her or threaten his or her fundamental rights and freedoms"@es ;
                                                                                                                      rdfs:label "right not to be object to automated evaluations" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_access
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_access> rdf:type owl:NamedIndividual ,
                                                                                               <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_of_access> ;
                                                                                      <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_related_to> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_information> ;
                                                                                      <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_account_encumbered> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment> ;
                                                                                      <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "The holder has the right to access and obtain free of charge all his personal data, as well as the detailed information in accordance with the right to information, without the need for any justification whatsoever." ;
                                                                                      rdfs:comment "The holder has the right to access and obtain free of charge all his personal data, as well as the detailed information in accordance with the right to information, without the need for any justification whatsoever."@en ,
                                                                                                   "The holder has the right to access and obtain free of charge all his personal data, as well as the detailed information in accordance with the right to information, without the need for any justification whatsoever."@es ;
                                                                                      rdfs:label "right of access" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_deletion
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_deletion> rdf:type owl:NamedIndividual ,
                                                                                                 <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_of_deletion> ;
                                                                                        <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_account_encumbered> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment> ;
                                                                                        <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "The data subject has the right to have his or her personal data deleted by the controller in certain specific cases" ;
                                                                                        <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#when_personal_data_may_be_deleted> "Revoke previously given consent or indicate that consent has not been given for one or more specific purposes, without the need to provide any justification" ,
                                                                                                                                                                                                "The personal data have fulfilled the purpose for which they were collected or processed" ,
                                                                                                                                                                                                "The processing affects fundamental rights or individual liberties of the data subject." ,
                                                                                                                                                                                                "The processing does not comply with the established principles of the Organic Law on Personal Data Protection." ,
                                                                                                                                                                                                "The processing is not necessary or relevant for the fulfillment of the purpose" ,
                                                                                                                                                                                                "The term of conservation of personal data has expired." ,
                                                                                                                                                                                                "There is a legal obligation" ;
                                                                                        rdfs:comment "The data subject has the right to have his or her personal data deleted by the controller in certain specific cases"@en ,
                                                                                                     "The data subject has the right to have his or her personal data deleted by the controller in certain specific cases"@es ;
                                                                                        rdfs:label "right of deletion" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_opposition
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_opposition> rdf:type owl:NamedIndividual ,
                                                                                                   <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_of_opposition> ;
                                                                                          <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_account_encumbered> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment> ;
                                                                                          <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#deadline_in_days_for_the_right_to_oppose_opposition> 15.0 ;
                                                                                          <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "The owner has the right to oppose or refuse the processing of his/her personal data under certain scenarios" ;
                                                                                          <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#in_direct_marketing_cases> "The data subject can always object to the processing of his personal data for direct marketing, including profiling, in which case the personal data will no longer be processed for this purpose." ;
                                                                                          <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#when_it_can_be_opposed_to_treatment> "If the Organic Law on Personal Data Protection explicitly permits the type of processing in progress or proposed" ,
                                                                                                                                                                                                    "If the data are not publicly available and are not related to matters of public interest required by other Ecuadorian laws" ,
                                                                                                                                                                                                    "If the processing of personal data is for the purpose of direct marketing" ,
                                                                                                                                                                                                    "If the treatment does not affect the rights of others" ,
                                                                                                                                                                                                    "When the consent of the data subject is not necessary for the processing as a consequence of the concurrence of a legitimate interest." ;
                                                                                          rdfs:comment "The owner has the right to oppose or refuse the processing of his/her personal data under certain scenarios"@en ,
                                                                                                       "The owner has the right to oppose or refuse the processing of his/her personal data under certain scenarios"@es ;
                                                                                          rdfs:label "right of opposition" .


