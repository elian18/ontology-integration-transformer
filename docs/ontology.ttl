                                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Accurate> "Deben ser precisos" ;
                                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Clear> "Deben ser claros" ;
                                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Complete> "Deben ser completos" ;
                                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Exact> "Deben ser exactos" ;
                                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "Lo que se realice con los datos del titular debe ser claro y de fácil acceso." ;
