                                                                                         <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "This is used when the data is subject to a defense of claims for a particular subject matter." ;
                                                                                         rdfs:label "defense of claims001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#delegate001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#delegate001> rdf:type owl:NamedIndividual ,
                                                                                         <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_data_delegate_in_verification> ;
                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#is_compliant_with_the_following_roles> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#delegate001> ;
                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Advise> "Advises the data protection authority" ;
                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Advise_on_risk_analysis> "Advises the authority on risk analysis issues." ;
                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Audit> "Assists in audit processes and performs audits" ;
                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Cooperate_with_the_Personal_Data_Protection_Authority> "Cooperates with the authority" ;
                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Delegate_functions> """Among its functions are:
- Advising the person in charge
- Supervising the Authority
- Advise on risk analysis
- Cooperate with the Authority""" ;
                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Details_of_the_law_details> "Information" ;
                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "It assists the data processor and data controller in specific cases and monitors them, performs auditing processes and collaborates with the authority to keep the other processes running smoothly." ;
                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Name> "Antonio" ;
                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Nature> "The nature of its functions" ;
                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_detail> "Helps the authority to fulfill its functions" ;
                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_information> "Delegate information" ;
                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Purpose> "These are the actions to be performed" ;
                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Scope> "Scope of functions" ;
                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Supervise> "He/she is in charge of supervising when the manager's activities require supervision." ;
                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Volume> "Volume of data handled" ;
                                                                                rdfs:label "delegate001" .


