                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#where_in_the_national_scope_is_held> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#national_companies001> ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "This aspect considers measures that can be applied to national companies in the event of non-compliance with the proper use of data." ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Minor_infractions_national_public_company> "0.1 to 0.7 of the company's turnover." ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#National_company_detail> "General company information. For example, KFC." ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Serious_infractions_national_public_company> "from 0.7 to 1% of the business volume, it may increase depending on the company's degree of non-compliance" ;
                                                                                          rdfs:label "national companies001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#notification001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#notification001> rdf:type owl:NamedIndividual ,
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Notification> ;
                                                                                    <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#account_with_actions_as> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#notification001> ;
                                                                                    <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "It is used as a method of communication with the owner when their personal data has been affected in any way." ;
                                                                                    <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Preservation_time> "The data to be transferred must be stored for a certain period of time." ;
                                                                                    <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Secrecy_of_communications> "Data must be subject to secrecy in communications." ;
                                                                                    <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Security_notification_of_infringement> "5 days" ;
                                                                                    <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#time_of_a_vulnerability_notification> "3 days" ;
                                                                                    rdfs:label "notification001" .


