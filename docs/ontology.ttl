                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Disposal> "Economic data must be accessible" ;
                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "Momentary data" ;
                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Updated> "Economic data must be updatable" ;
                                                                                rdfs:label "economic001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#epidemiological_studies001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#epidemiological_studies001> rdf:type owl:NamedIndividual ,
                                                                                                        <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Epidemiological_studies> ;
                                                                                               <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#segmented_into_the_following_national_cases> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#epidemiological_studies001> ;
                                                                                               <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Anonymization> "The holder of the information must have his data anonymized so that a transfer" ;
                                                                                               <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Exceptions> "Exceptions are available when an epidemiological study is conducted" ;
                                                                                               <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "In a pandemic or epidemic, the holder's information may be used without his/her consent." ;
                                                                                               rdfs:label "epidemiological studies001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#exceptions001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#exceptions001> rdf:type owl:NamedIndividual ,
