                                                                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "These are scenarios in which the owner's permission is not required to use his or her information." ;
                                                                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Informed> "Exceptions to international transfer of the holder's data must be reported." ;
                                                                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Legal_or_regulatory_obligation> "International exceptions must have a legal or regulatory obligation" ;
                                                                                                                                rdfs:label "exceptions for transfers or international communications001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#exceptions_to_consent_for_national_transfer001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#exceptions_to_consent_for_national_transfer001> rdf:type owl:NamedIndividual ,
                                                                                                                            <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Exceptions_to_consent_for_national_transfers> ;
                                                                                                                   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#as_to_the_national_and_international_related_to_it_be_held> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#exceptions_to_consent_for_national_transfer001> ;
