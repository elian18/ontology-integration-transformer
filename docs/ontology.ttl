###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#financial001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#financial001> rdf:type owl:NamedIndividual ,
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Financial> ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#in_consideration_of_credit_data_is_held> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#financial001> ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Access> "Financial data must be accessible" ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Correction> "Financial data must be rectifiable" ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Disposal> "It must be possible to delete financial data" ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "Momentary data that involves additional information such as account statements." ,
                                                                                                                                                                    "When the objective is to process the data for specific purposes, whether historical, statistical or scientific." ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Updated> "It must be possible to update financial data" ;
                                                                                 rdfs:label "financial001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#free_consent001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#free_consent001> rdf:type owl:NamedIndividual ;
                                                                                    <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#can_be> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#free_consent001> ;
