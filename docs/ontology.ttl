###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Follow-up_from_design
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Follow-up_from_design> rdf:type owl:Class ;
                                                                                          rdfs:subClassOf <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_data_security> ;
                                                                                          <http://purl.org/dc/terms/source> "LOPDP, art. 39"@es ,
                                                                                                                            "LOPDP, art. 47"@es ;
                                                                                          rdfs:comment "Correspondences with the DPV: is close to dpv:PrivacyByDesign. Bridge with the GDPR: is close to gdprtext:DataProtectionByDesignAndByDefault (through dpv:PrivacyByDesign); is close to gdprtext:PrivacyByDesign (through dpv:PrivacyByDesign)."@en ,
                                                                                                       "Correspondencias con el DPV: se parece a dpv:PrivacyByDesign. Puente con el GDPR: se parece a gdprtext:DataProtectionByDesignAndByDefault (por dpv:PrivacyByDesign); se parece a gdprtext:PrivacyByDesign (por dpv:PrivacyByDesign)."@es ;
                                                                                          rdfs:label "Follow up from design" ;
                                                                                          <http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#DataProtectionByDesignAndByDefault> ,
                                                                                                                                           <http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#PrivacyByDesign> ,
                                                                                                                                           <https://w3id.org/dpv#PrivacyByDesign> .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Follow-up_from_design> ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#closeMatch> ;
   owl:annotatedTarget <http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#DataProtectionByDesignAndByDefault> ;
   <http://www.semanticweb.org/profiles/ontopriv-gdpr-alignment#chainedBy> <https://w3id.org/dpv#PrivacyByDesign> ;
   rdfs:comment "Encadenado por el DPV: OntoPriv Follow-up_from_design closeMatch dpv:PrivacyByDesign y GDPRtEXT DataProtectionByDesignAndByDefault exactMatch dpv:PrivacyByDesign."@es ;
   owl:versionInfo "1"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Follow-up_from_design> ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#closeMatch> ;
   owl:annotatedTarget <http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#PrivacyByDesign> ;
   <http://www.semanticweb.org/profiles/ontopriv-gdpr-alignment#chainedBy> <https://w3id.org/dpv#PrivacyByDesign> ;
