                                                                        <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/dpv#PersonalDataAudit> .


###  http://www.semanticweb.org/profiles/ecuador-lopdp#DataSecurityBreach
<http://www.semanticweb.org/profiles/ecuador-lopdp#DataSecurityBreach> rdf:type owl:Class ;
                                                                       <http://purl.org/dc/terms/source> "LOPDP, art. 4"@es ;
                                                                       rdfs:comment "Correspondences with the DPV: is related to dpv:DataBreachRecord."@en ,
                                                                                    "Correspondencias con el DPV: está relacionado con dpv:DataBreachRecord."@es ;
                                                                       rdfs:label "Vulneración de la seguridad de los datos personales"@es ;
                                                                       <http://www.w3.org/2004/02/skos/core#definition> "Incidente de seguridad que afecta la confidencialidad, disponibilidad o integridad de los datos personales."@es ;
                                                                       <http://www.w3.org/2004/02/skos/core#relatedMatch> <https://w3id.org/dpv#DataBreachRecord> .


###  http://www.semanticweb.org/profiles/ecuador-lopdp#DirectRequirement
<http://www.semanticweb.org/profiles/ecuador-lopdp#DirectRequirement> rdf:type owl:Class ;
                                                                      <http://purl.org/dc/terms/source> "LOPDP, art. 62"@es ;
                                                                      rdfs:comment "Correspondences with the DPV: is close to dpv:RequestRequiresAction."@en ,
                                                                                   "Correspondencias con el DPV: se parece a dpv:RequestRequiresAction."@es ;
                                                                      rdfs:label "requerimiento directo"@es ;
                                                                      <http://www.w3.org/2004/02/skos/core#closeMatch> <https://w3id.org/dpv#RequestRequiresAction> ;
                                                                      <http://www.w3.org/2004/02/skos/core#definition> "Acción gratuita que puede ejercer el titular ante el responsable del tratamiento sobre sus derechos."@es .


###  http://www.semanticweb.org/profiles/ecuador-lopdp#DutyOfConfidentiality
<http://www.semanticweb.org/profiles/ecuador-lopdp#DutyOfConfidentiality> rdf:type owl:Class ;
                                                                          <http://purl.org/dc/terms/source> "LOPDP, art. 30"@es ;
                                                                          rdfs:comment "Correspondences with the DPV: is related to dpv:ContractConfidentialityClause."@en ,
                                                                                       "Correspondencias con el DPV: está relacionado con dpv:ContractConfidentialityClause."@es ;
                                                                          rdfs:label "Deber de confidencialidad"@es ;
                                                                          <http://www.w3.org/2004/02/skos/core#definition> "Obligación de responsables, encargados y terceras personas en el tratamiento de datos de salud para garantizar su seguridad y complementar el secreto profesional."@es ;
                                                                          <http://www.w3.org/2004/02/skos/core#relatedMatch> <https://w3id.org/dpv#ContractConfidentialityClause> .


###  http://www.semanticweb.org/profiles/ecuador-lopdp#ImpactAssessment
<http://www.semanticweb.org/profiles/ecuador-lopdp#ImpactAssessment> rdf:type owl:Class ;
                                                                     <http://purl.org/dc/terms/source> "LOPDP, art. 42"@es ;
                                                                     rdfs:comment "Correspondences with the DPV: is the same as dpv:ImpactAssessment. Bridge with the GDPR: is close to gdprtext:FactorsForImpactAssessment (through dpv:ImpactAssessment); is close to gdprtext:ImpactAssessment (through dpv:ImpactAssessment)."@en ,
                                                                                  "Correspondencias con el DPV: es igual a dpv:ImpactAssessment. Puente con el GDPR: se parece a gdprtext:FactorsForImpactAssessment (por dpv:ImpactAssessment); se parece a gdprtext:ImpactAssessment (por dpv:ImpactAssessment)."@es ;
                                                                     rdfs:label "evaluación de impacto del tratamiento de datos personales"@es ;
                                                                     <http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#FactorsForImpactAssessment> ,
                                                                                                                      <http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#ImpactAssessment> ;
                                                                     <http://www.w3.org/2004/02/skos/core#definition> "Proceso obligatorio realizado por el responsable para identificar riesgos altos en el tratamiento de datos personales."@es ;
                                                                     <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/dpv#ImpactAssessment> .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://www.semanticweb.org/profiles/ecuador-lopdp#ImpactAssessment> ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#closeMatch> ;
   owl:annotatedTarget <http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#FactorsForImpactAssessment> ;
   <http://www.semanticweb.org/profiles/ontopriv-gdpr-alignment#chainedBy> <https://w3id.org/dpv#ImpactAssessment> ;
   rdfs:comment "Encadenado por el DPV: OntoPriv ImpactAssessment exactMatch dpv:ImpactAssessment y GDPRtEXT FactorsForImpactAssessment exactMatch dpv:ImpactAssessment."@es ;
   owl:versionInfo "1"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://www.semanticweb.org/profiles/ecuador-lopdp#ImpactAssessment> ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#closeMatch> ;
   owl:annotatedTarget <http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#ImpactAssessment> ;
   <http://www.semanticweb.org/profiles/ontopriv-gdpr-alignment#chainedBy> <https://w3id.org/dpv#ImpactAssessment> ;
   rdfs:comment "Encadenado por el DPV: OntoPriv ImpactAssessment exactMatch dpv:ImpactAssessment y GDPRtEXT ImpactAssessment exactMatch dpv:ImpactAssessment."@es ;
   owl:versionInfo "1"
 ] .


###  http://www.semanticweb.org/profiles/ecuador-lopdp#MinorAutomatedDecisionRight
<http://www.semanticweb.org/profiles/ecuador-lopdp#MinorAutomatedDecisionRight> rdf:type owl:Class ;
                                                                                <http://purl.org/dc/terms/source> "LOPDP, art. 21"@es ;
                                                                                rdfs:comment "Correspondences with the DPV: is a kind of dpv:DataSubjectRight; is related to dpv:AutomatedDecisionMaking."@en ,
                                                                                             "Correspondencias con el DPV: es un tipo de dpv:DataSubjectRight; está relacionado con dpv:AutomatedDecisionMaking."@es ;
                                                                                rdfs:label "Derecho de niñas, niños y adolescentes a no ser objeto de una decisión basada única o parcialmente en valoraciones automatizadas"@es ;
                                                                                <http://www.w3.org/2004/02/skos/core#broadMatch> <https://w3id.org/dpv#DataSubjectRight> ;
                                                                                <http://www.w3.org/2004/02/skos/core#definition> "Prohibición de tratar datos sensibles o de menores de edad mediante valoraciones automatizadas, salvo autorización expresa o interés público esencial."@es ;
                                                                                <http://www.w3.org/2004/02/skos/core#relatedMatch> <https://w3id.org/dpv#AutomatedDecisionMaking> .


###  http://www.semanticweb.org/profiles/ecuador-lopdp#NationalDataProtectionRegistry
<http://www.semanticweb.org/profiles/ecuador-lopdp#NationalDataProtectionRegistry> rdf:type owl:Class ;
                                                                                   <http://purl.org/dc/terms/source> "LOPDP, art. 51"@es ;
                                                                                   rdfs:comment "Correspondences with the DPV: is a kind of dpv:PublicRegisterOfEntities."@en ,
                                                                                                "Correspondencias con el DPV: es un tipo de dpv:PublicRegisterOfEntities."@es ;
                                                                                   rdfs:label "Registro Nacional de protección de datos personales"@es ;
                                                                                   <http://www.w3.org/2004/02/skos/core#broadMatch> <https://w3id.org/dpv#PublicRegisterOfEntities> ;
                                                                                   <http://www.w3.org/2004/02/skos/core#definition> "Sistema donde el responsable debe reportar y mantener actualizada la información sobre el tratamiento de datos."@es .


###  http://www.semanticweb.org/profiles/ecuador-lopdp#PersonalDataProtection
<http://www.semanticweb.org/profiles/ecuador-lopdp#PersonalDataProtection> rdf:type owl:Class ;
                                                                           <http://purl.org/dc/terms/source> "LOPDP, art. 1"@es ;
                                                                           rdfs:comment "Correspondences with the DPV: is related to dpv:SensitivePersonalData."@en ,
                                                                                        "Correspondencias con el DPV: está relacionado con dpv:SensitivePersonalData."@es ;
                                                                           rdfs:label "protección de datos personales"@es ;
                                                                           <http://www.w3.org/2004/02/skos/core#definition> "Derecho que incluye el acceso y decisión sobre información y datos de carácter personal."@es ;
                                                                           <http://www.w3.org/2004/02/skos/core#relatedMatch> <https://w3id.org/dpv#SensitivePersonalData> .


###  http://www.semanticweb.org/profiles/ecuador-lopdp#PrivacyByDefault
<http://www.semanticweb.org/profiles/ecuador-lopdp#PrivacyByDefault> rdf:type owl:Class ;
                                                                     <http://purl.org/dc/terms/source> "LOPDP, art. 39"@es ;
                                                                     rdfs:comment "Correspondences with the DPV: is the same as dpv:PrivacyByDefault."@en ,
                                                                                  "Correspondencias con el DPV: es igual a dpv:PrivacyByDefault."@es ;
                                                                     rdfs:label "protección de datos por defecto"@es ;
                                                                     <http://www.w3.org/2004/02/skos/core#definition> "Obligación de tratar únicamente los datos personales estrictamente necesarios para cada fin específico."@es ;
                                                                     <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/dpv#PrivacyByDefault> .


###  http://www.semanticweb.org/profiles/ecuador-lopdp#ProportionalityPrinciple
<http://www.semanticweb.org/profiles/ecuador-lopdp#ProportionalityPrinciple> rdf:type owl:Class ;
                                                                             <http://purl.org/dc/terms/source> "LOPDP, art. 71"@es ;
                                                                             rdfs:comment "Correspondences with the DPV: is a kind of dpv:Principle."@en ,
                                                                                          "Correspondencias con el DPV: es un tipo de dpv:Principle."@es ;
                                                                             rdfs:label "principio de proporcionalidad"@es ;
                                                                             <http://www.w3.org/2004/02/skos/core#broadMatch> <https://w3id.org/dpv#Principle> ;
                                                                             <http://www.w3.org/2004/02/skos/core#definition> "Criterio utilizado para establecer la cuantía de la multa basado en la intencionalidad, reiteración, perjuicio y reincidencia."@es .


###  http://www.semanticweb.org/profiles/ecuador-lopdp#ProvisionalMeasures
<http://www.semanticweb.org/profiles/ecuador-lopdp#ProvisionalMeasures> rdf:type owl:Class ;
                                                                        <http://purl.org/dc/terms/source> "LOPDP, art. 74"@es ;
                                                                        rdfs:label "Medidas provisionales o cautelares"@es ;
                                                                        <http://www.w3.org/2004/02/skos/core#definition> "Medidas de protección o cautelares aplicables por la Autoridad de Protección de Datos Personales según la norma procedimental administrativa."@es .


###  http://www.semanticweb.org/profiles/ecuador-lopdp#Recidivism
<http://www.semanticweb.org/profiles/ecuador-lopdp#Recidivism> rdf:type owl:Class ;
                                                               <http://purl.org/dc/terms/source> "LOPDP, art. 71"@es ;
                                                               rdfs:comment "Correspondences with the DPV: is related to dpv:RuleViolated."@en ,
                                                                            "Correspondencias con el DPV: está relacionado con dpv:RuleViolated."@es ;
                                                               rdfs:label "reincidencia"@es ;
                                                               <http://www.w3.org/2004/02/skos/core#definition> "Circunstancia donde la infracción precedente es de la misma naturaleza que la que se pretende sancionar."@es ;
                                                               <http://www.w3.org/2004/02/skos/core#relatedMatch> <https://w3id.org/dpv#RuleViolated> .


###  http://www.semanticweb.org/profiles/ecuador-lopdp#RiskReport
<http://www.semanticweb.org/profiles/ecuador-lopdp#RiskReport> rdf:type owl:Class ;
                                                               <http://purl.org/dc/terms/source> "LOPDP, art. 9"@es ;
                                                               rdfs:comment "Correspondences with the DPV: is close to dpv:RiskAssessment; is a kind of dpv:RiskConcept."@en ,
                                                                            "Correspondencias con el DPV: se parece a dpv:RiskAssessment; es un tipo de dpv:RiskConcept."@es ;
                                                               rdfs:label "Informe de riesgo"@es ;
                                                               <http://www.w3.org/2004/02/skos/core#broadMatch> <https://w3id.org/dpv#RiskConcept> ;
                                                               <http://www.w3.org/2004/02/skos/core#closeMatch> <https://w3id.org/dpv#RiskAssessment> ;
                                                               <http://www.w3.org/2004/02/skos/core#definition> "Documento requerido por la Autoridad para verificar amenazas a los derechos de los titulares."@es .


###  http://www.semanticweb.org/profiles/ecuador-lopdp#SelfRegulation
<http://www.semanticweb.org/profiles/ecuador-lopdp#SelfRegulation> rdf:type owl:Class ;
                                                                   <http://purl.org/dc/terms/source> "LOPDP, art. 52"@es ;
                                                                   rdfs:comment "Correspondences with the DPV: is a kind of dpv:CertificationSeal."@en ,
                                                                                "Correspondencias con el DPV: es un tipo de dpv:CertificationSeal."@es ;
                                                                   rdfs:label "Autorregulación"@es ;
                                                                   <http://www.w3.org/2004/02/skos/core#broadMatch> <https://w3id.org/dpv#CertificationSeal> ;
                                                                   <http://www.w3.org/2004/02/skos/core#definition> "Facultad voluntaria de adherirse a códigos de conducta y certificaciones sin eximir la responsabilidad legal."@es .


###  http://www.semanticweb.org/profiles/ecuador-lopdp#TechnicalAndLegalMeasures
<http://www.semanticweb.org/profiles/ecuador-lopdp#TechnicalAndLegalMeasures> rdf:type owl:Class ;
                                                                              <http://purl.org/dc/terms/source> "LOPDP, art. 65"@es ;
                                                                              rdfs:comment "Correspondences with the DPV: is the same as dpv:TechnicalOrganisationalMeasure; is a kind of dpv:LegalMeasure; is a kind of dpv:TechnicalMeasure."@en ,
                                                                                           "Correspondencias con el DPV: es igual a dpv:TechnicalOrganisationalMeasure; es un tipo de dpv:LegalMeasure; es un tipo de dpv:TechnicalMeasure."@es ;
                                                                              rdfs:label "medidas técnicas, jurídicas, organizativas o administrativas"@es ;
                                                                              <http://www.w3.org/2004/02/skos/core#broadMatch> <https://w3id.org/dpv#LegalMeasure> ,
                                                                                                                               <https://w3id.org/dpv#TechnicalMeasure> ;
                                                                              <http://www.w3.org/2004/02/skos/core#definition> "Imposición de medidas para garantizar un tratamiento adecuado de los datos personales."@es ;
                                                                              <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/dpv#TechnicalOrganisationalMeasure> .


###  http://www.semanticweb.org/profiles/ecuador-lopdp#UnfulfilledRegistry
<http://www.semanticweb.org/profiles/ecuador-lopdp#UnfulfilledRegistry> rdf:type owl:Class ;
                                                                        rdfs:label "Registro Único de Responsables y Encargados Incumplidos"@es ;
                                                                        <http://www.w3.org/2004/02/skos/core#definition> "Registro de responsables y encargados del tratamiento de datos personales que han incurrido en infracciones, con fines sociales, estadísticos, preventivos y de capacitación."@es .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#access_right001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#access_right001> rdf:type owl:NamedIndividual ,
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Right_of_access_in_verification> ;
                                                                                    <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#can_be_rights_of> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#access_right001> ;
                                                                                    <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Consent_in_verification> "Must be consented to by the owner" ;
                                                                                    <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "This right states that the owner of the information has the right to access it free of charge and in detail within 15 days." ;
                                                                                    <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Informed> "It can be an informed consent" ;
                                                                                    <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Not_informed> "May be an uninformed consent" ;
                                                                                    <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Revoke_consent> "It must be possible to revoke the consent at any time, this can be done by the owner of the data." ;
                                                                                    <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Updated> "Must be updated" ;
                                                                                    <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_of_access_time> "15 days" ;
                                                                                    rdfs:label "access right001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#addressee_in_verification001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#addressee_in_verification001> rdf:type owl:NamedIndividual ,
                                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Addressee_in_verification> ;
                                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#is_compliant_with_the_following_roles> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#addressee_in_verification001> ;
                                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Details_of_the_law_details> "Information" ;
                                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "It is the natural or legal person to whom the holder's data will be sent." ;
                                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Name> "Pedro" ;
                                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_detail> "Person receiving the information" ;
                                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_information> "Recipient information" ;
                                                                                                 rdfs:label "addressee in verification001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#administrative001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#administrative001> rdf:type owl:NamedIndividual ,
                                                                                               <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Administrative> ;
                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#that_can_be_of_the_type> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#administrative001> ;
                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Applied> "When the measure is applied" ;
                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Cessation_of_treatment> "When the corrective action stops" ;
                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Exceptions> "Exceptions applicable to administrative companies" ;
                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "Actions to be taken in administrative cases." ;
                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Guidelines> "Administrative guidelines" ,
                                                                                                                                                                     "Guidelines to follow" ;
                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Not_applied> "When a verification process does not apply" ;
                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Regulations> "Administrative regulations" ;
                                                                                      rdfs:label "administrative001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#administrative_or_judicial_authorities001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#administrative_or_judicial_authorities001> rdf:type owl:NamedIndividual ,
                                                                                                                       <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Administrative_or_judicial_authorities> ;
                                                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#segmented_into_the_following_national_cases> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#administrative_or_judicial_authorities001> ;
                                                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Exceptions> "Administrative and legal exemptions are available" ;
                                                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "In an investigation process, the holder's data may be used either by a judge or an administrative entity." ;
                                                                                                              rdfs:label "administrative or judicial authorities001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#admitted_countries001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#admitted_countries001> rdf:type owl:NamedIndividual ,
                                                                                                   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Admitted_Countries> ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#where_in_in_the_international_field_you_have_to_have> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#admitted_countries001> ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Availability> "Information must be available" ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Communicate> "The information must be communicated" ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Correct> "The information must be corrected" ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Data_admitted_countries_international_transfer> "Admitted countries information" ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "These are the countries that are allowed to carry out data transfer processes with Ecuador." ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Mitigate> "The information must be mitigated" ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Prevent> "Information must be prevented" ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Transmit> "The information must be transmitted" ;
                                                                                          rdfs:label "admitted countries001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#análisis_de_riesgo_amenazas_y_vulnerabilidades001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#análisis_de_riesgo_amenazas_y_vulnerabilidades001> rdf:type owl:NamedIndividual ,
                                                                                                                               <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Risk_analysis_of_threats_and_vulnerabilities> ;
                                                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#account_with_actions_as> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#análisis_de_riesgo_amenazas_y_vulnerabilidades001> ;
                                                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "Es una tarea que debe realizar el responsable y encargado del tratamiento de los datos para evitar la presencia de esta amenazas." ;
                                                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Risk> "Riego presente en un análisis de datos" ;
                                                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Secrecy_of_communications> "La transferencia de información debe ser secreta" ;
                                                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Threat> "Amenaza a los datos" ;
                                                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Vulnerabilidad> "Vulnerabildiad presente en los datos en procesos de transferencia" ;
                                                                                                                      rdfs:label "análisis de riesgo amenazas y vulnerabilidades001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#applicable_safety_measures001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#applicable_safety_measures001> rdf:type owl:NamedIndividual ,
                                                                                                           <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Applicable_safety_measures> ;
                                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#account_with_actions_as> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#applicable_safety_measures001> ;
                                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Check> "The applicable security measures must control the risk to the data." ;
                                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Excess_of_authorization> "The applicable security measures must prevent the authorization process in the data." ;
                                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "Concrete actions that the responsible and in charge must take into consideration at the moment of a change or mishandling of the data of the owner of the information." ;
                                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Mitigate> "The applicable security measures must mitigate the risk to the data." ;
                                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Not_authorized> "The applicable security measures must prevent unauthorized access to the data." ;
                                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Prevent> "The applicable security measures must prevent the risk to the data." ;
                                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Reduce> "The applicable security measures must reduce the risk to the data." ;
                                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Secrecy_of_communications> "The applicable security measures must be governed by the secrecy of data communications." ;
                                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Stop> "The applicable security measures must prevent data compromise" ;
                                                                                                  rdfs:label "applicable safety measures001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#authority001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#authority001> rdf:type owl:NamedIndividual ,
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_Data_Protection_Authority_in_verification> ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#is_compliant_with_the_following_roles> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#authority001> ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Advise_on_risk_analysis> "Gives assistance on specific issues" ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Control_systemized_and_stabilized_control> "Follows up on everything" ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Cooperate_with_the_Personal_Data_Protection_Authority> "cooperates with the authority" ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Correct> "Corrects errors generated by the responsible parties in the information transfer process." ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Designation_of_the_authority_process> "The Personal Data Authority is designated in accordance with the provisions of the Constitution of Ecuador." ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Details_of_the_law_details> "Information on the members of the law" ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "He is in charge of supervising that everything is in order and if there is any inconsistency, he solves it." ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Mitigate> "Mitigates data risks" ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Name> "Juan" ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_detail> "It is responsible for the implementation of corrective actions." ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_information> "Authority data" ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Prevent> "Prevents errors" ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Sanctioning_administrative_procedure> "Performs the corresponding procedure" ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Serious> "from 10 to 20 unified basic salaries" ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Slight> "from 1 to 10 basic unified salaries." ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Supervise> "Supervises the delegate" ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Transfer_or_international_communication> "The Personal Data Authority is responsible for establishing the international transfer and communication processes." ;
                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Very_serious> "It is not specified what sanction to take in these cases, more aspects should be considered." ;
                                                                                 rdfs:label "authority001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#authorization_for_international_transfer001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#authorization_for_international_transfer001> rdf:type owl:NamedIndividual ,
                                                                                                                         <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Authorization_for_international_transfer> ;
                                                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#where_in_in_the_international_field_you_have_to_have> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#authorization_for_international_transfer001> ;
                                                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Excess_of_authorization> "When in an international transfer an organization has many privileges" ;
                                                                                                                <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "It is the permission you must have to perform an international data transfer." ;
                                                                                                                rdfs:label "authorization for international transfer001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#bank_or_stock_bank_data001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#bank_or_stock_bank_data001> rdf:type owl:NamedIndividual ,
                                                                                                        <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Banking_stock_or_stock_market_data> ;
                                                                                               <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#segmented_into_the_following_international_cases> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#bank_or_stock_bank_data001> ;
                                                                                               <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Detail_banking_data_or_stock_market_details> "Details of bank or stock exchange data in an international transfer exception" ;
                                                                                               <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "In an international process involving money, the data of the owner of the information may be used." ;
                                                                                               rdfs:label "bank or stock bank data001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#banking001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#banking001> rdf:type owl:NamedIndividual ,
                                                                                        <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Banking> ;
                                                                               <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#in_consideration_of_credit_data_is_held> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#banking001> ;
                                                                               <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Access> "The holder has access to his bank details" ;
                                                                               <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Correction> "Bank details must be able to be rectified" ;
                                                                               <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Detail_banking_data_or_stock_market_details> "The banking data has a banking or stock market detail." ;
                                                                               <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Disposal> "It must be possible to delete bank details" ;
                                                                               <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "Bank type data" ;
                                                                               <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Updated> "The data must be up to date" ;
                                                                               rdfs:label "banking001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#boys_and_girls001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#boys_and_girls001> rdf:type owl:NamedIndividual ,
                                                                                               <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Boys_and_girls> ;
                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#and_as_your_age_will_have_to_be_of_your_age> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#boys_and_girls001> ;
                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Anonymization> "It should be possible to anonymize data on children." ;
                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Correction> "Children's data must be able to be rectified" ;
                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Disposal> "Children's data must be able to be removed" ;
                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "They are a special type of owner that needs the explicit consent of their legal representative for the person in charge or owner of the information to make use of them. The age range to be considered as children's data is from 0 to 11 years old." ;
                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Supervision> "They need the supervision of their parents or legal guardian in order to make use of this information." ;
                                                                                      rdfs:label "boys and girls001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#certifying_entity001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#certifying_entity001> rdf:type owl:NamedIndividual ,
                                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Certifying_entity_in_verification> ;
                                                                                         <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#account_with_a_certifying_entity> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#certifying_entity001> ;
                                                                                         <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Certifying_international_transfer_processes> "The information transfer process must be certified." ;
                                                                                         <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Conducting_audits> "Audits must be carried out by certified entities." ;
                                                                                         <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "It is responsible for accrediting the information transfer processes, it is an entity endorsed by the Authority for the Protection of Personal Data." ;
                                                                                         <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Issue_certifications> "Certification must be issued when any information transfer process is carried out." ;
                                                                                         <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Issue_stamps> "Stamps should be issued" ;
                                                                                         rdfs:label "certifying entity001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#commercial001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#commercial001> rdf:type owl:NamedIndividual ,
                                                                                           <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Commercial> ;
                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#in_consideration_of_credit_data_is_held> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#commercial001> ;
                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Access> "Commercial data must be accessible" ;
                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Disposal> "It must be possible to delete commercial data" ,
                                                                                                                                                               "It must be possible to rectify commercial data" ;
                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "Commercial data to carry out transactions" ;
                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Updated> "Commercial data must be up to date" ;
                                                                                  rdfs:label "commercial001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento001> rdf:type owl:NamedIndividual ,
                                                                                               <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Consent_in_verification> ;
                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consent_is_emphasized> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento001> ;
                                                                                      rdfs:label "consentimiento001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento_autorizado001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento_autorizado001> rdf:type owl:NamedIndividual ,
                                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Authorized_consent> ;
                                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#can_be> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento_autorizado001> ;
                                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Commercial_use> "No se puede hacer uso de los datos del titular a menos este último así lo decida y puede remitir su consentimiento en cualquier momento, no se puede comercializar o transferir a terceros los datos personales de los usuarios" ;
                                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Consent_authorized_informed_consent> "consentimiento informado ante un hecho" ;
                                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Free_authorized_consent> "consentimiento libre para realizar una o más acciones sobre los datos" ;
                                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "El consentimiento autorizado ocurre cuando se le informa al titular de la información sobre el uso que se le va a dar a la misma, además se pide su autorización sobre el uso de esa información." ,
                                                                                                                                                                                    "El consentimiento no autorizado ocurre cuando no se le informa al titular de la información sobre el uso que se le va a dar a la misma, además no se pide su autorización sobre el uso de esa información." ;
                                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Informed> "Informar sobre lo que se va a hacer" ;
                                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Not_informed> "No informar al titular sobre lo que se va a hacer" ;
                                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Specific_authorized_consent> "consentimiento sobre algo concreto al momento de realizar una transferencia" ;
                                                                                                 <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Unequivocal_authorized_consent> "consentimiento inequívo por parte del titular ante alguna acción" ;
                                                                                                 rdfs:label "consentimiento autorizado001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento_no_autorizado001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento_no_autorizado001> rdf:type owl:NamedIndividual ,
                                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Unauthorized_consent> ;
                                                                                                    <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#can_be> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento_no_autorizado001> ;
                                                                                                    <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Not_informed> "No informar al titular sobre la no autorización del consentimiento" ;
                                                                                                    <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Reason_for_refusal_of_consent> "Detalles del por qué no se autorizó el consentimiento para realizar una transferencia" ;
                                                                                                    rdfs:label "consentimiento no autorizado001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consultation_right001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consultation_right001> rdf:type owl:NamedIndividual ,
                                                                                                   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Right_to_consult_in_verification> ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#can_be_rights_of> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consultation_right001> ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Consent_in_verification> "Must be consented to by the owner" ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "This right refers to the obligation that the law has in the event of a request for information by the owner of the information." ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Informed> "It can be an informed consent" ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Not_informed> "May be an uninformed consent" ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Revoke_consent> "It must be possible to revoke the consent at any time, this can be done by the owner of the data." ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Updated> "Must be updated" ;
                                                                                          rdfs:label "consultation right001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#continuous_monitoring_for_non-consenting_countries001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#continuous_monitoring_for_non-consenting_countries001> rdf:type owl:NamedIndividual ,
                                                                                                                                   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Continuous_control_for_countries_without_consent> ;
                                                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#where_in_in_the_international_field_you_have_to_have> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#continuous_monitoring_for_non-consenting_countries001> ;
                                                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Check> "A control system must be followed with the information" ;
                                                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Control_systemized_and_stabilized_control> "The control must be permanent and systematized." ;
                                                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "In case the country is not in the list of admitted countries, the transfer can be made as long as a continuous control with this country is carried out." ;
                                                                                                                          rdfs:label "continuous monitoring for non consenting countries001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#corrective_actions001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#corrective_actions001> rdf:type owl:NamedIndividual ,
                                                                                                   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Corrective_measures> ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#the_verification_covers_aspects_such_as> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#corrective_actions001> ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Application> "What will be done" ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Applied> "Corrective action implemented" ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Cessation_of_treatment> "When the corrective action stops" ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Disposal> "A corrective action can be eliminated" ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "These are actions to be taken in case of misuse of data or information provided by the owner of the information." ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Guidelines> "Guidelines for corrective action" ,
                                                                                                                                                                         "What will be followed" ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Not_applied> "When a corrective action is not implemented" ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Regulations> "Remedial action regulations" ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Technical_control> "A correct telecommunications service must be provided and the Telecommunications Regulation and Control Agency must check/verify that the measures implemented to share this information are correctly implemented." ;
                                                                                          rdfs:label "corrective actions001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#credit_data001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#credit_data001> rdf:type owl:NamedIndividual ,
                                                                                            <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Credit_data_in_verification> ;
                                                                                   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#that_can_be> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#credit_data001> ;
                                                                                   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Access> "Los datos crediticios deben tener un acceso libre para el titular" ;
                                                                                   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Correction> "Los datos crediticios deben poderse rectificar" ;
                                                                                   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Credit_detail_data> """Estos datos pueden ser usados en procesos de investigación sin el consentimiento del titular.

Por otro parte los datos crediticios son los datos bursátiles o bancarios del titular que en caso de no se necesarios para una investigación no pueden ser usados por terceros sin el consentimiento explícito del titular de la información.""" ;
                                                                                   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Disposal> "Los datos crediticios pueden ser eliminados" ;
                                                                                   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "Son datos de carácter bancario que se pueden usar en algún proceso investigativo." ;
                                                                                   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Purpose> "Los datos crediticios en general tienen una finalidad de uso en casos de análisis y no pueden ser comunicados o difundos para cualquier otra finalidad o fin." ;
                                                                                   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Updated> "Los datos crediticios pueden ser actualizados" ;
                                                                                   rdfs:label "credit data001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#data_people_over_age_001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#data_people_over_age_001> rdf:type owl:NamedIndividual ,
                                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Data_Seniors_data> ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#and_the_owner_divides_into> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#data_people_over_age_001> ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Access> "Data must be accessible" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Accidental_or_illegal_destruction_or_communication> "Data must not be subject to intentional or accidental destruction." ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Advise> "The data must be available for consultation" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Advise_on_risk_analysis> "The delegate provides risk analysis advice to the data authority." ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Alterations> "Data are prone to alterations, this should be avoided." ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Anonymization> "Data must be anonymized" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Audit> "Data must be auditable" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Check> "The risks present in the data must be controlled" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Control_systemized_and_stabilized_control> "Permanent control of the data must be carried out" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Cooperate_with_the_Personal_Data_Protection_Authority> "The data is subject to cooperation between members of the law enforcement community." ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Correct> "The risks present in the data must be corrected" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Correction> "It must be possible to rectify the data" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Delegate_functions> "Some data are manipulated by the delegate" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Details_of_the_law_details> "The data are present in the members of the law." ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Disposal> "It must be possible to delete data" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "These are data subjects over 18 years of age who do not need the permission of another person in order to use their data." ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Impact_assessment> "The impact of the data must be assessed" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Large_scale_treatment> "Large-scale data analysis is required" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Loss> "Prevent data loss" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Mitigate> "Data risks must be mitigated" ,
                                                                                                                                                                          "Mitigating data risks" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Name> "Holder's name" ,
                                                                                                                                                                      "The name of the owner of the data must be known." ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#National_registry_for_the_protection_of_personal_data> "Data must be in a national registry" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Nature> "The nature of the data must be known" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Nature_of_the_data> "The nature of the data must be known" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Organizational> "Organizational data exist; they are data from organizations" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_data_encryption> "The owner of the data has the option to encrypt his data" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_data_security_details> "Data must be secure" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_detail> "The data stores in detail the holder's information." ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_information> "Personal information of the data subject" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Prevent> "Data risks must be prevented" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Purpose> "The purpose of the data must be defined" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Reduce> "Reduce data risks" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Risk> "Data should avoid being subject to risk" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Sanctioning_administrative_procedure> "The manipulated data are subject to an administrative sanctioning process." ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Scope> "Data must have a defined scope of use" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Secrecy_of_communications> "Data must be subject to secrecy in communications" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Security_notification_of_infringement> "The data owner must be notified in the event of a breach of data security." ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Serious> "Holder data may be subject to serious infringement" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Seudonomización> "The data must be treated in such a way that it is not known who the owner is in case of loss of data." ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Slight> "Holder's data may be subject to minor violations." ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Stop> "Preventing data from misuse" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Supervise> "Holder data must be monitored" ,
                                                                                                                                                                           "The data are supervised by the data delegate." ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Systematic_evaluation> "A semantic evaluation must be performed" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Technical_measurements> "Technical measures must be taken with the data" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Threat> "Data are subject to threats" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Updated> "The data must be up to date" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Very_serious> "The holder's data may be subject to very serious infringements" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Volume> "The volume of data must be known" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Vulnerabilidad> "The data is exposed to vulnerabilities" ;
                                                                                             rdfs:label "data people over age 001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#data_persons_minors001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#data_persons_minors001> rdf:type owl:NamedIndividual ,
                                                                                                    <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Data_persons_minors> ;
                                                                                           <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#and_the_owner_divides_into> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#data_people_over_age_001> ;
                                                                                           <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Access> "Children's data must be accessible" ;
                                                                                           <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Anonymization> "It must be possible to anonymize the data of minors." ;
                                                                                           <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Correction> "Children's data must be able to be rectified" ;
                                                                                           <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Disposal> "It must be possible to delete the data of minors" ;
                                                                                           <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "These are data that cannot be used freely by the owner of the information without first having permission or knowing key points about the use of their data." ;
                                                                                           <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Updated> "Children's data must be able to be updated" ;
                                                                                           rdfs:label "data persons minors001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#data_protection_mechanisms001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#data_protection_mechanisms001> rdf:type owl:NamedIndividual ,
                                                                                                           <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Data_protection_mechanisms> ;
                                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#account_with_actions_as> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#data_protection_mechanisms001> ;
                                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Celerity> "Data protection mechanisms must be speeded up" ;
                                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Efficiency> "Data protection mechanisms must be effective" ,
                                                                                                                                                                                 "Data protection mechanisms must be efficient" ;
                                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "Actions that must be taken into account with regard to data so that they are not violated." ;
                                                                                                  <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Gratuity> "Data protection mechanisms must be free of charge" ;
                                                                                                  rdfs:label "data protection mechanisms001" .


###  http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#deceased_persons_data001
<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#deceased_persons_data001> rdf:type owl:NamedIndividual ,
                                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Deceased_persons_data> ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#and_the_owner_divides_into> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#deceased_persons_data001> ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Access> "They must have optimal access" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Correction> "It must be possible to rectify" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Disposal> "It should be possible to eliminate" ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "These are data of deceased owners, but the person in charge of them, such as their legal representative, can make use of them." ;
                                                                                             <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Updated> "Must be up to date" ;
                                                                                             rdfs:label "deceased persons data001" .


