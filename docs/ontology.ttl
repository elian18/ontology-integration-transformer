                                                                                   rdfs:label "terminología" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#territorial_application
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#territorial_application> rdf:type owl:NamedIndividual ,
                                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Territorial> ;
                                                                                              <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#the_law_applies_in> <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processing> ,
                                                                                                                                                                                       <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#location_of_the_personal_data_protection_system_members> ;
                                                                                              <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#scope_of_legislation> "The Organic Law on Personal Data Protection will apply in certain scenarios, notwithstanding the existence of other international rules or regulations, i.e., the Organic Law on Personal Data Protection will apply regardless of any other international regulations that may exist." ;
                                                                                              rdfs:label "territorial application" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#transparency
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#transparency> rdf:type owl:NamedIndividual ,
                                                                                            <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Transparency> ;
                                                                                   <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "The processing of personal data must be transparent, therefore, all information on this process must be easily accessible and understandable, using simple and clear language." ;
                                                                                   rdfs:comment "The processing of personal data must be transparent, therefore, all information on this process must be easily accessible and understandable, using simple and clear language."@en ,
                                                                                                "The processing of personal data must be transparent, therefore, all information on this process must be easily accessible and understandable, using simple and clear language."@es ;
                                                                                   rdfs:label "transparency" .


###  http://www.semanticweb.org/ley-organica-proteccion-datos-personales#turnover
<http://www.semanticweb.org/ley-organica-proteccion-datos-personales#turnover> rdf:type owl:NamedIndividual ,
                                                                                        <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Turnover> ;
                                                                               <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description> "This refers to the total income generated by the sale of products and the rendering of services carried out by commercial entities during the last fiscal year corresponding to their activities, which is calculated by deducting Value Added Tax (VAT) and other taxes directly related to economic operations." ;
                                                                               rdfs:comment "This refers to the total income generated by the sale of products and the rendering of services carried out by commercial entities during the last fiscal year corresponding to their activities, which is calculated by deducting Value Added Tax (VAT) and other taxes directly related to economic operations."@en ,
                                                                                            "This refers to the total income generated by the sale of products and the rendering of services carried out by commercial entities during the last fiscal year corresponding to their activities, which is calculated by deducting Value Added Tax (VAT) and other taxes directly related to economic operations."@es ;
                                                                               rdfs:label "turnover" .


