                                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Seudonomización> "Pseudonomizing data" ;
                                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Stop> "Prevent access to data" ;
                                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Systematic_evaluation> "Type of risk assessment" ;
                                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Systematic_observation> "Keeping track of security" ;
                                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Technical_measurements> "Measures for possible failures" ;
                                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Threat> "Threat to data" ;
                                                                                              <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Vulnerabilidad> "Place that can exploit a threat" ;
