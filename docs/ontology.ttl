                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Specific_threats> "Threats that may affect the legitimate interest of a transfer of information" ;
                                                                                      <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Vital_interest_detail_of_another_person> "Vital information about another person" ;
                                                                                      rdfs:label "legal interest001" .


