                                                                                                 <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#inclusiveness_in> "People with special educational needs" ,
                                                                                                                                                                                        "Students of all levels" ,
                                                                                                                                                                                        "Teachers or professors" ;
                                                                                                 <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_access_and_availability> "Appropriate, healthy, constructive, safe and responsible use and management of information and communication technologies." ,
                                                                                                                                                                                                        "Development in Information and Communication Technologies" ,
                                                                                                                                                                                                        "Information and Communication Technologies Training" ,
                                                                                                                                                                                                        "Information and Communication Technology Learning" ,
                                                                                                                                                                                                        "Knowledge of Information and Communication Technologies." ,
