<http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#legal_relationship001> rdf:type owl:NamedIndividual ,
                                                                                                   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Legal_relationship> ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#segmented_into_the_following_national_cases> <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#legal_relationship001> ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Exceptions> "A legal relationship must exist in the domestic transfer" ;
                                                                                          <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail> "When the connection of data to a database is required and there is an agreement between the data controller and the data subject, this exception may be used." ;
                                                                                          rdfs:label "legal relationship001" .


