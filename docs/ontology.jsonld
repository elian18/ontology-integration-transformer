}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#certifying_entity",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "Entity that has the capacity to issue certifications in the area of personal data protection, in a non-exclusive manner, which means that it is not the only entity with this power, and other organizations may also grant certifications in the same area."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_authorized_by" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Certifying_entity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Entity that has the capacity to issue certifications in the area of personal data protection, in a non-exclusive manner, which means that it is not the only entity with this power, and other organizations may also grant certifications in the same area."
  }, {
    "@language" : "es",
    "@value" : "Entity that has the capacity to issue certifications in the area of personal data protection, in a non-exclusive manner, which means that it is not the only entity with this power, and other organizations may also grant certifications in the same area."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "certifying entity"
  } ]
}, {
