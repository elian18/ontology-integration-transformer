    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#the_law_has_the_following_rights"
  } ],
  "http://www.w3.org/2004/02/skos/core#relatedMatch" : [ {
    "@id" : "https://w3id.org/dpv#hasRight"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#certifying_entity001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Certifying_international_transfer_processes" : [ {
    "@value" : "The information transfer process must be certified."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Conducting_audits" : [ {
    "@value" : "Audits must be carried out by certified entities."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "It is responsible for accrediting the information transfer processes, it is an entity endorsed by the Authority for the Protection of Personal Data."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Issue_certifications" : [ {
    "@value" : "Certification must be issued when any information transfer process is carried out."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Issue_stamps" : [ {
    "@value" : "Stamps should be issued"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#account_with_a_certifying_entity" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#certifying_entity001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Certifying_entity_in_verification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "certifying entity001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#commercial001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Access" : [ {
    "@value" : "Commercial data must be accessible"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Disposal" : [ {
    "@value" : "It must be possible to delete commercial data"
  }, {
    "@value" : "It must be possible to rectify commercial data"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "Commercial data to carry out transactions"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Updated" : [ {
    "@value" : "Commercial data must be up to date"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#in_consideration_of_credit_data_is_held" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#commercial001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Commercial"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "commercial001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consent_is_emphasized",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "consent is emphasized"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Consent_in_verification"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consent_is_emphasized" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Consent_in_verification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "consentimiento001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento_autorizado001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Commercial_use" : [ {
    "@value" : "No se puede hacer uso de los datos del titular a menos este último así lo decida y puede remitir su consentimiento en cualquier momento, no se puede comercializar o transferir a terceros los datos personales de los usuarios"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Consent_authorized_informed_consent" : [ {
    "@value" : "consentimiento informado ante un hecho"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Free_authorized_consent" : [ {
    "@value" : "consentimiento libre para realizar una o más acciones sobre los datos"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "El consentimiento autorizado ocurre cuando se le informa al titular de la información sobre el uso que se le va a dar a la misma, además se pide su autorización sobre el uso de esa información."
  }, {
    "@value" : "El consentimiento no autorizado ocurre cuando no se le informa al titular de la información sobre el uso que se le va a dar a la misma, además no se pide su autorización sobre el uso de esa información."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Informed" : [ {
    "@value" : "Informar sobre lo que se va a hacer"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Not_informed" : [ {
    "@value" : "No informar al titular sobre lo que se va a hacer"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Specific_authorized_consent" : [ {
    "@value" : "consentimiento sobre algo concreto al momento de realizar una transferencia"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Unequivocal_authorized_consent" : [ {
    "@value" : "consentimiento inequívo por parte del titular ante alguna acción"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#can_be" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento_autorizado001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Authorized_consent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "consentimiento autorizado001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento_no_autorizado001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Not_informed" : [ {
    "@value" : "No informar al titular sobre la no autorización del consentimiento"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Reason_for_refusal_of_consent" : [ {
    "@value" : "Detalles del por qué no se autorizó el consentimiento para realizar una transferencia"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#can_be" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento_no_autorizado001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Unauthorized_consent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "consentimiento no autorizado001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consultation_right001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Consent_in_verification" : [ {
    "@value" : "Must be consented to by the owner"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "This right refers to the obligation that the law has in the event of a request for information by the owner of the information."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Informed" : [ {
    "@value" : "It can be an informed consent"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Not_informed" : [ {
    "@value" : "May be an uninformed consent"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Revoke_consent" : [ {
    "@value" : "It must be possible to revoke the consent at any time, this can be done by the owner of the data."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Updated" : [ {
    "@value" : "Must be updated"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#can_be_rights_of" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consultation_right001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Right_to_consult_in_verification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "consultation right001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#continuous_monitoring_for_non-consenting_countries001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Check" : [ {
    "@value" : "A control system must be followed with the information"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Control_systemized_and_stabilized_control" : [ {
    "@value" : "The control must be permanent and systematized."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "In case the country is not in the list of admitted countries, the transfer can be made as long as a continuous control with this country is carried out."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#where_in_in_the_international_field_you_have_to_have" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#continuous_monitoring_for_non-consenting_countries001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Continuous_control_for_countries_without_consent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "continuous monitoring for non consenting countries001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#corrective_actions001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Application" : [ {
    "@value" : "What will be done"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Applied" : [ {
    "@value" : "Corrective action implemented"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Cessation_of_treatment" : [ {
    "@value" : "When the corrective action stops"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Disposal" : [ {
    "@value" : "A corrective action can be eliminated"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "These are actions to be taken in case of misuse of data or information provided by the owner of the information."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Guidelines" : [ {
    "@value" : "Guidelines for corrective action"
  }, {
    "@value" : "What will be followed"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Not_applied" : [ {
    "@value" : "When a corrective action is not implemented"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Regulations" : [ {
    "@value" : "Remedial action regulations"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Technical_control" : [ {
    "@value" : "A correct telecommunications service must be provided and the Telecommunications Regulation and Control Agency must check/verify that the measures implemented to share this information are correctly implemented."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#the_verification_covers_aspects_such_as" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#corrective_actions001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Corrective_measures"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "corrective actions001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#credit_data001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Access" : [ {
    "@value" : "Los datos crediticios deben tener un acceso libre para el titular"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Correction" : [ {
    "@value" : "Los datos crediticios deben poderse rectificar"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Credit_detail_data" : [ {
    "@value" : "Estos datos pueden ser usados en procesos de investigación sin el consentimiento del titular.\n\nPor otro parte los datos crediticios son los datos bursátiles o bancarios del titular que en caso de no se necesarios para una investigación no pueden ser usados por terceros sin el consentimiento explícito del titular de la información."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Disposal" : [ {
    "@value" : "Los datos crediticios pueden ser eliminados"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "Son datos de carácter bancario que se pueden usar en algún proceso investigativo."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Purpose" : [ {
    "@value" : "Los datos crediticios en general tienen una finalidad de uso en casos de análisis y no pueden ser comunicados o difundos para cualquier otra finalidad o fin."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Updated" : [ {
    "@value" : "Los datos crediticios pueden ser actualizados"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#that_can_be" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#credit_data001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Credit_data_in_verification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "credit data001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#data_people_over_age_001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Access" : [ {
    "@value" : "Data must be accessible"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Accidental_or_illegal_destruction_or_communication" : [ {
    "@value" : "Data must not be subject to intentional or accidental destruction."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Advise" : [ {
    "@value" : "The data must be available for consultation"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Advise_on_risk_analysis" : [ {
    "@value" : "The delegate provides risk analysis advice to the data authority."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Alterations" : [ {
    "@value" : "Data are prone to alterations, this should be avoided."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Anonymization" : [ {
    "@value" : "Data must be anonymized"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Audit" : [ {
    "@value" : "Data must be auditable"
  } ],
