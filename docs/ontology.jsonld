    "@value" : "public sector001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#responsible001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Analysis_methodologies" : [ {
    "@value" : "Places analysis methodologies"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Binding_cooperative_rules" : [ {
    "@value" : "The person in charge and the person responsible are responsible for the application of binding cooperative rules."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Contract" : [ {
    "@value" : "It is present in the process of signing a contract, it can also be present in the process of signing a contract, these same functions have the data processor in the present law."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Details_of_the_law_details" : [ {
    "@value" : "Information"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "It performs the transfer, verification and security processes on the owner's data."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Impact_assessment" : [ {
    "@value" : "The data controller is responsible for carrying out the impact assessment."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Implementing_verification_processes" : [ {
    "@value" : "Implements verification processes"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Maintaining_the_accuracy_of_the_information" : [ {
    "@value" : "The person in charge and the person in charge are responsible for maintaining the accuracy of the information in the transfer and verification processes."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Members_of_the_protection_system_details" : [ {
    "@value" : "General information"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Name" : [ {
    "@value" : "Carla"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Obligations_of_the_responsible_person_and_manager" : [ {
    "@value" : "Perform transfer and verification processes, apply processes, use methodologies and take technological measures."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Perform_evaluations" : [ {
    "@value" : "Evaluates what the manager does"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_data_security_details" : [ {
    "@value" : "The person in charge and responsible for personal data is responsible for ensuring the security of the owner's data."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_detail" : [ {
    "@value" : "It is responsible for the processing of the holder's personal data and for the authorization to carry out international transfers."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_information" : [ {
    "@value" : "Information about the responsible party"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Protection_policies" : [ {
    "@value" : "Establishes data protection policies"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Safety_from_design_by_defect" : [ {
    "@value" : "You must implement security from the default design in the data."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Security_notification_of_infringement" : [ {
    "@value" : "The person in charge is responsible for notifying in the event of a security leak."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Self-regulation" : [ {
    "@value" : "Data controllers and processors must adhere to codes of conduct, seals, certifications and protection marks, without this constituting an exemption from the responsibility to comply with the provisions of this law, its regulations, guidelines and regulations issued by the Personal Data Protection Authority."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Serious" : [ {
    "@value" : "These violations are commensurate with the data controller's infraction or misconduct.\nFor example, failure to implement administrative measures."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Slight" : [ {
    "@value" : "These infractions are in accordance with the infraction or fault of the data controller.\nFor example, failure to process or implement a process in the transfer of information would be considered a minor infraction."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Very_serious" : [ {
    "@value" : "Not specified, but if there is, the Authority decides what action to take."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Violations_in_verification" : [ {
    "@value" : "Faults in their actions"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#is_compliant_with_the_following_roles" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#responsible001"
  } ],
