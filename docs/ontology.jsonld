  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Anonymization" : [ {
    "@value" : "It should be possible to anonymize data on children."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Correction" : [ {
    "@value" : "Children's data must be able to be rectified"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Disposal" : [ {
    "@value" : "Children's data must be able to be removed"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "They are a special type of owner that needs the explicit consent of their legal representative for the person in charge or owner of the information to make use of them. The age range to be considered as children's data is from 0 to 11 years old."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Supervision" : [ {
    "@value" : "They need the supervision of their parents or legal guardian in order to make use of this information."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#and_as_your_age_will_have_to_be_of_your_age" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#boys_and_girls001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Boys_and_girls"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "boys and girls001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#can_be",
