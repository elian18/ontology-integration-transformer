    "@value" : "Correspondencias con el DPV: es más general que dpv:DataBreachNotice."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "excepciones a la notificación de vulneración"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
