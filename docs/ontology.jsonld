  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Certifying_international_transfer_processes" : [ {
    "@value" : "Approve the transfer processes when these are clear"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Contract" : [ {
    "@value" : "Contract with stakeholders"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Data_admitted_countries_international_transfer" : [ {
    "@value" : "Admitted countries information"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Detail_transfer_domestic_domestic_scope" : [ {
    "@value" : "Information"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Exceptions" : [ {
    "@value" : "Exceptions that may occur in the transfer process"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Informed" : [ {
    "@value" : "Rights informed"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Legal_or_regulatory_obligation" : [ {
    "@value" : "Legal obligations"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#has_elements_of_transfer_and_communication" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#transfer_or_communication001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
