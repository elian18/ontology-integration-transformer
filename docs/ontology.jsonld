  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "rights to correct update update delete and oppose"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Exceptions_of_right"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#rights_to_not_be_the_object_of_automated_assessments",
