}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#applicability",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#scope_of_legislation" : [ {
    "@value" : "La Ley Orgánica de Protección de Datos Personales se aplicará en ciertos escenarios"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Applicability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "applicability"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#application_favorable_to_the_owner",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "In situations where there is uncertainty as to how to interpret and apply the legal or contractual provisions related to the protection of personal data, judicial and administrative officials must opt for the interpretation that benefits the owner of such data, i.e., the owner must be favored in terms of protection and safeguarding of his personal data in case of ambiguity or doubt in the application of the Organic Law for the Protection of Personal Data."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Application_favorable_to_the_owner"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "In situations where there is uncertainty as to how to interpret and apply the legal or contractual provisions related to the protection of personal data, judicial and administrative officials must opt for the interpretation that benefits the owner of such data, i.e., the owner must be favored in terms of protection and safeguarding of his personal data in case of ambiguity or doubt in the application of the Organic Law for the Protection of Personal Data."
  }, {
    "@language" : "es",
    "@value" : "In situations where there is uncertainty as to how to interpret and apply the legal or contractual provisions related to the protection of personal data, judicial and administrative officials must opt for the interpretation that benefits the owner of such data, i.e., the owner must be favored in terms of protection and safeguarding of his personal data in case of ambiguity or doubt in the application of the Organic Law for the Protection of Personal Data."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "application favorable to the owner"
  } ]
