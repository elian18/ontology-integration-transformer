  }, {
    "@language" : "es",
    "@value" : "Correspondencias con el DPV: está relacionado con dpv:DataBreachRecord."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Vulneración de la seguridad de los datos personales"
