}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#obtaining_personal_data_directly_by_the_owner",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Owner"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "obtaining personal data directly by the owner"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Owner"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#organic_law_on_personal_data_protection",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#target" : [ {
    "@value" : "The fundamental purpose of the Organic Law on Personal Data Protection is to ensure the effective application of the right to the protection of personal data. This right covers both access to and decision-making on information and data of a personal nature and the guarantee of their due protection. To this end, the law regulates, foresees and develops principles, rights, obligations and protection mechanisms necessary to comprehensively safeguard the privacy and security of personal data."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Organic_Law_on_Personal_Data_Protection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "organic law on personal data protection"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#penalties_for_Serious_Infringements",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#by" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#serious_infractions"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#destined_for" : [ {
    "@value" : "Public sector employees or officials"
  }, {
    "@value" : "The Controller or Processor of personal data or, if applicable, a third party, may be a private law entity or a public company."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#determination_of_the_fine_in_respect_to_penalties_for_infringement_of_the_responsible_person_or_person_in_charge_of_treatment" : [ {
    "@value" : "Intentionality, which will evaluate the offender's conduct to determine if there was intent to commit the infraction."
  }, {
    "@value" : "Nature of the damage, where the negative consequences for the right to the protection of personal data will be evaluated."
  }, {
    "@value" : "Recidivism, which is considered when the previous infraction is similar to the one to be sanctioned again."
  }, {
    "@value" : "Reiteration of the infraction, which considers when the controller or processor of personal data has been previously sanctioned for two or more infractions of lesser gravity, or for an infraction of equal or greater gravity."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_related_to" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proportionality"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#turnover"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_of_penalty_for_infractions_to_the_responsible_party_or_the_processor" : [ {
    "@value" : "A fine ranging from 0.7% to 1% of the turnover for the fiscal year immediately preceding the imposition of the fine shall be imposed."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_of_penalty_for_infractions_toward_public_servants_or_officials" : [ {
    "@value" : "It shall be punished with a fine ranging from 10 to 20 unified basic salaries of the public servant or official."
  }, {
    "@value" : "This sanction does not rule out the possibility of the State assuming additional liability for damages caused, which will be governed in accordance with the corresponding regulations."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#will_be_imposed_by" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Penalties_for_Serious_Infringements"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "penalties for Serious Infringements"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "Data that identifies or makes identifiable a natural person, directly or indirectly."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#it_is_not_imputable_to_be_inaccurate_when" : [ {
    "@value" : "If the inaccurate data was obtained directly by the controller from the data subject"
  }, {
    "@value" : "If the inaccurate data were obtained by the data controller from a public record"
  }, {
    "@value" : "If the inaccurate data were obtained by the data controller through an intermediary, following the regulations applicable in the sector that allow the intervention of an intermediary to collect and transmit the data to the data controller"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#must_comply_with" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#principios"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_are_composed_of" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#biometric_data"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#credit_data"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#deceased_persons_data"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#genetic_data"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#health_related_data"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#sensitive_data"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#specialized_subject_data"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#to_comply_with_quality_you_must" : [ {
    "@value" : "Accurate, i.e. the personal data must be precise and faithfully reflect the reality or situation they represent, without errors, contradictions or inaccuracies."
  }, {
    "@value" : "Accurate, that personal data must be correct and accurately reflect reality without errors or inaccuracies."
  }, {
    "@value" : "Clear, i.e. personal data must be understandable and not give rise to ambiguous or confusing interpretations."
  }, {
    "@value" : "Complete, i.e. the personal data must include all relevant and necessary details for the purpose of processing, without omitting important information."
  }, {
    "@value" : "Integral, that is to say, the personal data must not have been altered, modified or corrupted in any way that affects its veracity."
  }, {
    "@value" : "Updated, i.e. personal data must reflect the most recent situation of the person or object to which it refers, and be modified or updated when necessary to maintain its validity."
  }, {
    "@value" : "Verifiable, i.e. personal data must be verifiable and capable of being checked against reliable sources or evidence to confirm its authenticity and validity."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Data that identifies or makes identifiable a natural person, directly or indirectly."
  }, {
    "@language" : "es",
    "@value" : "Data that identifies or makes identifiable a natural person, directly or indirectly."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "personal data"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_are_composed_of",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "personal data are composed of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid221"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#actions_regarding_health_data_processing" : [ {
    "@value" : "For when dealing with anonymized health data"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#actions_regarding_independence_of_control" : [ {
    "@value" : "Investigation action, which involves carrying out investigations into possible violations of data protection legislation in an independent and partial manner."
  }, {
    "@value" : "Prevention action, which consists of promoting good practices and providing guidance and advice to organizations and citizens on how to protect personal data and comply with privacy regulations."
  }, {
    "@value" : "Sanction action, which arises once violations of data protection legislation are identified, whereby the Data Protection Authority has the power to impose appropriate and proportionate sanctions."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#authorization_for_treatment_of_anonymized_health_data" : [ {
    "@value" : "A favorable report from the Health Authority, which confirms that the technical protocol complies with the standards and regulations established by the Organic Law on Personal Data Protection and other related laws."
  }, {
    "@value" : "Provide technical protocol containing the necessary details to ensure the protection of health data."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#control_functions" : [ {
    "@value" : "It is the control and oversight body responsible for guaranteeing all citizens the protection of their personal data, and for taking all necessary actions to ensure that the principles, rights, guarantees and procedures set forth in the Organic Law on Personal Data Protection and its implementing regulations are respected."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#designation" : [ {
    "@value" : "The Personal Data Protection Authority shall be appointed in accordance with the provisions of the Constitution of the Republic."
  }, {
    "@value" : "The appointment is made from a list of three candidates provided by the President of the Republic"
  }, {
    "@value" : "The selection is based on criteria of specialization and merit, and the process is public, allowing for citizen challenges."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#duration_of_charge" : [ {
    "@value" : "The Personal Data Protection Authority will exercise its functions for a period of 5 years."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#functions" : [ {
    "@value" : "Apply sanctions to those responsible, delegates, persons in charge and third parties, in accordance with the provisions of the Organic Law on Personal Data Protection."
  }, {
    "@value" : "Attending to consultations on personal data protection matters"
  }, {
    "@value" : "Control and supervise the exercise of the right to personal data protection within the data processing carried out through the National System of Public Registries."
  }, {
    "@value" : "Create, manage and administer the National Registry of Personal Data Protection, and collaborate with public and private entities to ensure its correct operation."
  }, {
    "@value" : "Establish guidelines for the analysis, evaluation and selection of personal data security measures."
  }, {
    "@value" : "Exercise the supervision, control and evaluation of the activities carried out by the person responsible for and in charge of the processing of personal data."
  }, {
    "@value" : "Investigate, analyze and resolve complaints filed by data subjects, as well as those initiated by the Personal Data Protection Authority, in addition to imposing appropriate sanctions"
  }, {
    "@value" : "Issue guidelines for the design and content of the personal data processing policy."
  }, {
    "@value" : "Keep a statistical record of personal data security breaches and identify possible security measures for each of them."
  }, {
    "@value" : "Perform or delegate technical audits to the processing of personal data."
  }, {
    "@value" : "Periodically publish a guide to personal data protection regulations."
  }, {
    "@value" : "Promote adequate and effective coordination with accountability officers and participate in international and regional initiatives for the protection of personal data protection."
  }, {
    "@value" : "Promote and encourage the exercise of the right to the protection of personal data, as well as the awareness and understanding of the risks, rules, guarantees and rights of individuals in relation to the processing and use of their personal data, with special emphasis on activities aimed at priority groups such as children and adolescents."
  }, {
    "@value" : "To dictate standard data protection clauses and verify the content of additional or specific clauses or guarantees."
  }, {
    "@value" : "To issue general or technical regulations, criteria and other acts necessary for the exercise of its powers and the guarantee of the exercise of the right to the protection of personal data."
  }, {
    "@value" : "To represent internationally the interests related to the protection of personal data."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#known_as" : [ {
    "@value" : "Data Protection Superintendent"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#requirements_that_must_be_met" : [ {
    "@value" : "Must have at least a fourth level degree and a minimum of 10 years of experience in areas related to the regulation of the Organic Law for the Protection of Personal Data."
  }, {
    "@value" : "The Personal Data Protection Authority must be a professional in law, information systems, communication or technology."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#revocation" : [ {
    "@value" : "His mandate can only be revoked by impeachment after an impeachment trial conducted by the National Assembly."
  }, {
    "@value" : "Its mandate can only be revoked in accordance with the grounds established in the Ecuadorian laws regulating public service."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_authority" : [ {
    "@value" : "Public"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_protection_authority"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "personal data protection authority"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_seals",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "Recognition awarded for having implemented best practices in the processes, thus contributing to promote the holder's confidence."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_given_by" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processor"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_protection_seals"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Recognition awarded for having implemented best practices in the processes, thus contributing to promote the holder's confidence."
  }, {
    "@language" : "es",
    "@value" : "Recognition awarded for having implemented best practices in the processes, thus contributing to promote the holder's confidence."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "personal data protection seals"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_security_vulnerability",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#affects_to" : [ {
    "@value" : "Availability of personal data"
  }, {
    "@value" : "Confidentiality of personal data"
  }, {
    "@value" : "Integrity of personal data"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "Security incident"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_security_vulnerability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Security incident"
  }, {
    "@language" : "es",
    "@value" : "Security incident"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "personal data security vulnerability"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_under_specialized_regulations",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#explanation_of_concept_of_inapplicability" : [ {
    "@value" : "Personal data whose processing is regulated in specialized regulations of equal or higher hierarchy in matters of risk management for natural disasters; and, security and defense of the State, in any of these cases must comply with international standards in the field of human rights and the principles of this Law, and at least with the criteria of legality, proportionality and necessity."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_under_specialized_regulations"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "personal data under specialized regulations"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#principios",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#are_composed_of" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Purpose"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#application_favorable_to_the_owner"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#confidentiality"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#conservation"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#independence_of_control"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#juridicity"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#loyalty"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minimization_of_personal_data"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proactive_and_demonstrated_accountability"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proportionality"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#quality"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#relevance_of_personal_data"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#security"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#transparency"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "La Ley Orgnánica de Protección de Datos Personale se regirá por un conjunto de principios, sin perjuicio de otros principios establecidos en la Constitución de la República, los instrumentos internacionales ratificados por el Estado u otras normas jurídicas"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Principles"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "La Ley Orgnánica de Protección de Datos Personale se regirá por un conjunto de principios, sin perjuicio de otros principios establecidos en la Constitución de la República, los instrumentos internacionales ratificados por el Estado u otras normas jurídicas"
  }, {
    "@language" : "es",
    "@value" : "La Ley Orgnánica de Protección de Datos Personale se regirá por un conjunto de principios, sin perjuicio de otros principios establecidos en la Constitución de la República, los instrumentos internacionales ratificados por el Estado u otras normas jurídicas"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "principios"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#principle_of_attachment_with_sanction_to_the_responsible_party_or_the_treatment_manager",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Minor_infractions_penalties"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "principle of attachment with sanction to the responsible party or the treatment manager"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Sanctions"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proactive_and_demonstrated_accountability",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "The person or entity responsible for handling personal data must take measures in advance to protect that information and personal data, which implies demonstrating that mechanisms and actions have been implemented to ensure that the data are handled securely and in accordance with the Organic Law on Personal Data Protection."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_implemented_by" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Proactive_and_demonstrated_accountability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The person or entity responsible for handling personal data must take measures in advance to protect that information and personal data, which implies demonstrating that mechanisms and actions have been implemented to ensure that the data are handled securely and in accordance with the Organic Law on Personal Data Protection."
  }, {
    "@language" : "es",
    "@value" : "The person or entity responsible for handling personal data must take measures in advance to protect that information and personal data, which implies demonstrating that mechanisms and actions have been implemented to ensure that the data are handled securely and in accordance with the Organic Law on Personal Data Protection."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "proactive and demonstrated accountability"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#processing",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "El conjunto de acciones o procedimientos que se aplican a los datos o información con el fin de transformarlos, analizarlos, organizarlos o manipularlos de alguna manera para obtener resultados específicos"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_related_to" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processing"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#scope_of_application"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Processing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "El conjunto de acciones o procedimientos que se aplican a los datos o información con el fin de transformarlos, analizarlos, organizarlos o manipularlos de alguna manera para obtener resultados específicos"
  }, {
    "@language" : "es",
    "@value" : "El conjunto de acciones o procedimientos que se aplican a los datos o información con el fin de transformarlos, analizarlos, organizarlos o manipularlos de alguna manera para obtener resultados específicos"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "processing"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#profile_making",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processing_is_intended_for_individuals" : [ {
    "@value" : "Natural"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "Refers to any personal data processing process that aims to evaluate, analyze or predict various aspects of a natural person."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#to_determine_behaviors_or_standards_relative_to" : [ {
    "@value" : "Economic situation"
  }, {
    "@value" : "Health"
  }, {
    "@value" : "Intereses"
  }, {
    "@value" : "Location"
  }, {
    "@value" : "Other similar aspects"
  }, {
    "@value" : "Personal preferences"
  }, {
    "@value" : "Physical movement"
  }, {
    "@value" : "Professional performance"
  }, {
    "@value" : "Skills"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Profile_making"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Refers to any personal data processing process that aims to evaluate, analyze or predict various aspects of a natural person."
  }, {
    "@language" : "es",
    "@value" : "Refers to any personal data processing process that aims to evaluate, analyze or predict various aspects of a natural person."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "profile making"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proportionality",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "It involves ensuring that the way in which personal data is handled is balanced and appropriate in relation to the purposes for which the data was collected and the nature of the information involved"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Proportionality"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "It involves ensuring that the way in which personal data is handled is balanced and appropriate in relation to the purposes for which the data was collected and the nature of the information involved"
  }, {
    "@language" : "es",
    "@value" : "It involves ensuring that the way in which personal data is handled is balanced and appropriate in relation to the purposes for which the data was collected and the nature of the information involved"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "proportionality"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#pseudonymization",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "The process of processing personal data in such a way that it cannot be directly attributed to a data subject without the use of additional information. This additional information is kept separately and is subject to technical and organizational measures designed to ensure that personal data cannot be linked to an identified or identifiable natural person."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Pseudonymization"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The process of processing personal data in such a way that it cannot be directly attributed to a data subject without the use of additional information. This additional information is kept separately and is subject to technical and organizational measures designed to ensure that personal data cannot be linked to an identified or identifiable natural person."
  }, {
    "@language" : "es",
    "@value" : "The process of processing personal data in such a way that it cannot be directly attributed to a data subject without the use of additional information. This additional information is kept separately and is subject to technical and organizational measures designed to ensure that personal data cannot be linked to an identified or identifiable natural person."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "pseudonymization"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#purposes_of_the_processing_of_data_by_private_and_public_entities",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Health_related_data_processing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "purposes of the processing of data by private and public entities"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Health_related_data_processing"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#quality",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#associated_to" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "Personal data needs to be accurate, complete, complete and clear. This means that the data must be accurate and free of errors, accurately reflecting the reality of the person to whom it pertains."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_in_charge_of" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Quality"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Personal data needs to be accurate, complete, complete and clear. This means that the data must be accurate and free of errors, accurately reflecting the reality of the person to whom it pertains."
  }, {
    "@language" : "es",
    "@value" : "Personal data needs to be accurate, complete, complete and clear. This means that the data must be accurate and free of errors, accurately reflecting the reality of the person to whom it pertains."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "quality"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#recall_mechanisms",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "Means that must be available for an individual to revoke his consent to the processing of his personal data"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#must_be" : [ {
    "@value" : "Simple procedure, similar to the procedure by which consent was obtained"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#must_guarantee" : [ {
    "@value" : "Effectiveness, i.e., achieving revocation of consent"
  }, {
    "@value" : "Efficiency, i.e. that the revocation of consent does not take too much time or effort, both on the part of the data subject and the data controller."
  }, {
    "@value" : "Expeditiousness, i.e., the speed or promptness with which the consent revocation process is conducted"
  }, {
    "@value" : "Free of charge, which implies that the consent revocation process should not generate additional costs for the data subject."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#son_establecidos_por" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Recall_mechanisms"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Means that must be available for an individual to revoke his consent to the processing of his personal data"
  }, {
    "@language" : "es",
    "@value" : "Means that must be available for an individual to revoke his consent to the processing of his personal data"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "recall mechanisms"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#recipient",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#control_functions" : [ {
    "@value" : "Person who has been notified with personal data"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_of_person" : [ {
    "@value" : "Natural or Legal"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Recipient"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "recipient"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#regarding_treatment",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Revocation_of_consent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "regarding treatment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_processing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Revocation_of_consent"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#regulated_treatment_in_specialized_regulations_regarding",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Specialized_subject_data"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "regulated treatment in specialized regulations regarding"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Specialized_subject_data"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#relevance_of_personal_data",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "That the data collected must be relevant and directly related to the specific purpose for which it is collected."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Relevance"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "That the data collected must be relevant and directly related to the specific purpose for which it is collected."
  }, {
    "@language" : "es",
    "@value" : "That the data collected must be relevant and directly related to the specific purpose for which it is collected."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "relevance of personal data"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#requirements_that_must_be_met",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_protection_authority"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "requirements that must be met"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_protection_authority"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsable_de_canalizar_el_ejercicio_de_derechos",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "responsable de canalizar el ejercicio de derechos"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_protection_authority"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_channeling_the_exercise_of_rights",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "responsible for channeling the exercise of rights"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_establishing_the_deadlines_for_suspension_or_periodic_review_within_data_processing_is",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Conservation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "responsible for establishing the deadlines for suspension or periodic review within data processing is"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Controller"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Conservation"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_implementing_safety_measures",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Security"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "responsible for implementing safety measures"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid229"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Security"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#accrediting_compliance_with_the_mechanisms" : [ {
    "@value" : "Implementation of certification systems, which are formal processes through which an independent entity evaluates and verifies compliance with the requirements established in standards, regulations or norms related to data protection."
  }, {
    "@value" : "Make use of self- and co-regulatory schemes, i.e. programs or frameworks in which organizations voluntarily commit to comply with certain data protection standards and principles."
  }, {
    "@value" : "Use of best practices, i.e. recommended methods and processes that have proven to be effective in the protection of personal data."
  }, {
    "@value" : "Use of protection codes, which are associated with a set of principles, guidelines and specific rules established by data protection authorities to regulate the handling of personal data in certain sectors or contexts."
  }, {
    "@value" : "Use of standards, i.e., follow guidelines and criteria established by internationally recognized organizations for the handling and protection of personal data."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#activity_in_respect_to_proactive_and_demonstrated_responsibility" : [ {
    "@value" : "Implementation of mechanisms for the protection of personal data, which implies guaranteeing compliance with the principles, rights and obligations established in the Organic Law for the Protection of Personal Data."
  }, {
    "@value" : "To demonstrate compliance with these mechanisms and applicable regulations, that is, to have evidence and documents that demonstrate that the mechanisms and applicable regulations are being followed."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#activity_within_opposition_law" : [ {
    "@value" : "The controller shall cease processing the personal data, unless it can demonstrate compelling legitimate grounds justifying the processing which outweigh the interests, rights and freedoms of the data subject, or for the purposes of the lodging, exercise or defense of claims."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#activity_within_right_of_access" : [ {
    "@value" : "The person responsible for the processing of personal data must implement adequate means to facilitate the exercise of the right of access by the data subject"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#activity_within_the_right_of_correction_and_update" : [ {
    "@value" : "The data controller must respond to requests for rectification and updating, and if necessary, inform the recipient of the data so that he/she can also carry out the corresponding update."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#activity_within_the_right_of_deletion" : [ {
    "@value" : "The controller shall implement methods and techniques aimed at deleting, rendering unreadable, or rendering unrecognizable in a definitive and secure manner personal data."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#contact_data" : [ {
    "@value" : "Address of legal domicile"
  }, {
    "@value" : "E-mail address"
  }, {
    "@value" : "Names and surnames"
  }, {
    "@value" : "Telephone number"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#control_functions" : [ {
    "@value" : "Responsible for deciding on the purpose and processing of personal data"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#deadline_in_days_for_the_right_of_access" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "15"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#deadline_in_days_for_the_right_to_oppose_opposition" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "15"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#delegate_comments" : [ {
    "@value" : "Ensure that the involvement of the personal data protection officer, in all matters relating to personal data protection, is appropriate and timely."
  }, {
    "@value" : "Ensure that the personal data protection officer establishes direct communication with the highest executive and decision-making levels of the data controller."
  }, {
    "@value" : "Facilitate access to the personal data of the processing operations, as well as all the resources and elements necessary to guarantee the correct and free performance of its functions."
  }, {
    "@value" : "They may not dismiss or sanction the personal data protection officer for the proper performance of his or her duties."
  }, {
    "@value" : "Train and update the personal data protection officer on the subject, in accordance with the technical regulations issued by the Personal Data Protection Authority."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#in_the_event_of_a_challenge_of_data_exaccuracy" : [ {
    "@value" : "The accuracy of the personal data must be verified, so it must be placed in the database, where the challenged information is contained, that it has been the subject of disagreement by the data owner."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_related_to" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#delegate"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minor_infractions" : [ {
    "@value" : "Choosing a processor of personal data that does not offer sufficient guarantees to make effective the exercise of the right to the protection of personal data."
  }, {
    "@value" : "Failure to attend, late or unjustified response to requests or complaints from the holder"
  }, {
    "@value" : "Failure to comply with the corrective measures ordered by the Personal Data Protection Authority."
  }, {
    "@value" : "Failure to implement data protection by design and by default"
  }, {
    "@value" : "Failure to maintain available personal data protection policies related to the processing of personal data"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#must_have_been_complied_with_regard_to_proactive_responsibility" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#principios"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#rights"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#must_render_accounts_regarding_the_treatment_with" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_owner"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#nature_of_the_entity" : [ {
    "@value" : "Public or Private"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#obligations" : [ {
    "@value" : "Allowing audits and inspections by accredited auditors"
  }, {
    "@value" : "Comply with any other obligation established by applicable regulations or other Ecuadorian laws."
  }, {
    "@value" : "Conduct security adequacy assessments prior to the processing of personal data."
  }, {
    "@value" : "Designate a Data Protection Officer when necessary."
  }, {
    "@value" : "Develop customized data protection policies"
  }, {
    "@value" : "Ensuring that data controllers comply with regulations and best practices"
  }, {
    "@value" : "Establish confidentiality agreements with personnel and processors."
  }, {
    "@value" : "Implement administrative, technical and legal measures to guarantee the proper treatment of data"
  }, {
    "@value" : "Integrate data protection from system design onwards"
  }, {
    "@value" : "Maintain the National Registry of Personal Data Protection up to date."
  }, {
    "@value" : "Notifying the Personal Data Protection Authority and the data owner of violations of the security measures implemented for the processing of personal data in accordance with the procedure established for this purpose."
  }, {
    "@value" : "Periodically evaluate the effectiveness of the administrative, technical and legal measures adopted."
  }, {
    "@value" : "Take the necessary technological, physical, administrative, organizational and legal measures to prevent, deter, reduce, mitigate and control identified risks and breaches."
  }, {
    "@value" : "Treat personal data in accordance with the Organic Law on Personal Data Protection and relevant regulations."
  }, {
    "@value" : "Use risk analysis and management methodologies adapted to the particularities of data processing and the parties involved."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#serious_infractions" : [ {
    "@value" : "Do not sign contracts that include confidentiality clauses with those who handle personal data."
  }, {
    "@value" : "Failure to allow or cooperate with audits or inspections by an accredited auditor"
  }, {
    "@value" : "Failure to comply with corrective measures or insufficient compliance, especially if previous sanctions have been imposed for minor infractions and there is a recidivism."
  }, {
    "@value" : "Failure to conduct impact assessments when necessary"
  }, {
    "@value" : "Failure to designate a data protection officer when necessary"
  }, {
    "@value" : "Failure to implement measures to prevent and control data security risks"
  }, {
    "@value" : "Failure to inform the Data Protection Authority and the Data Controller about security breaches affecting individual rights."
  }, {
    "@value" : "Failure to keep the National Data Protection Registry up to date as required."
  }, {
    "@value" : "Failure to notify the holder of security breaches affecting his rights"
  }, {
    "@value" : "Failure to put in place adequate measures to protect personal data as required by law and relevant regulations"
  }, {
    "@value" : "Failure to register the required information in the National Data Protection Registry."
  }, {
    "@value" : "Failure to use appropriate methodologies to analyze and manage the risks associated with personal data"
  }, {
    "@value" : "Sharing of personal data without following legal requirements and established procedures"
  }, {
    "@value" : "Using information or data for purposes other than those initially stated"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#time_of_attention_in_days_for_the_right_of_removal" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#decimal",
    "@value" : "15.0"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#time_of_attention_within_days_for_the_right_of_correction_and_update" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "15"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_authority" : [ {
    "@value" : "Public"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_of_organism_participation" : [ {
    "@value" : "Alone or together with others"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_of_person" : [ {
    "@value" : "Natural or Legal"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Controller"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "responsible for treatment"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#revocation",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_protection_authority"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "revocation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_protection_authority"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#revocation_of_consent",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#can_count_on" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#recall_mechanisms"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#justification_for_revocation" : [ {
    "@value" : "No justification required for revocation of consent"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#regarding_treatment" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processing"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#when_it_can_be_produced" : [ {
    "@value" : "At any time, when the holder deems it pertinent"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Revocation_of_consent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "revocation of consent"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_account_encumbered",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid232"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "right account encumbered"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Controller"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_not_to_be_object_to_automated_evaluations",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "The holder has the right not to be subjected to decisions that are based in whole or in part on automated assessments, including profiling, if these decisions have a legal impact on him or her or threaten his or her fundamental rights and freedoms"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#for_the" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_owner"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_related_to" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#consent"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_account_encumbered" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processor"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#will_not_be_able_to_deal" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#sensitive_data"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_not_to_be_object_to_automated_evaluations"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The holder has the right not to be subjected to decisions that are based in whole or in part on automated assessments, including profiling, if these decisions have a legal impact on him or her or threaten his or her fundamental rights and freedoms"
  }, {
    "@language" : "es",
    "@value" : "The holder has the right not to be subjected to decisions that are based in whole or in part on automated assessments, including profiling, if these decisions have a legal impact on him or her or threaten his or her fundamental rights and freedoms"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "right not to be object to automated evaluations"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_access",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "The holder has the right to access and obtain free of charge all his personal data, as well as the detailed information in accordance with the right to information, without the need for any justification whatsoever."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_related_to" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_information"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_account_encumbered" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_of_access"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The holder has the right to access and obtain free of charge all his personal data, as well as the detailed information in accordance with the right to information, without the need for any justification whatsoever."
  }, {
    "@language" : "es",
    "@value" : "The holder has the right to access and obtain free of charge all his personal data, as well as the detailed information in accordance with the right to information, without the need for any justification whatsoever."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "right of access"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_deletion",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "The data subject has the right to have his or her personal data deleted by the controller in certain specific cases"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_account_encumbered" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#when_personal_data_may_be_deleted" : [ {
    "@value" : "Revoke previously given consent or indicate that consent has not been given for one or more specific purposes, without the need to provide any justification"
  }, {
    "@value" : "The personal data have fulfilled the purpose for which they were collected or processed"
  }, {
    "@value" : "The processing affects fundamental rights or individual liberties of the data subject."
  }, {
    "@value" : "The processing does not comply with the established principles of the Organic Law on Personal Data Protection."
  }, {
    "@value" : "The processing is not necessary or relevant for the fulfillment of the purpose"
  }, {
    "@value" : "The term of conservation of personal data has expired."
  }, {
    "@value" : "There is a legal obligation"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_of_deletion"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The data subject has the right to have his or her personal data deleted by the controller in certain specific cases"
  }, {
    "@language" : "es",
    "@value" : "The data subject has the right to have his or her personal data deleted by the controller in certain specific cases"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "right of deletion"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_opposition",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#deadline_in_days_for_the_right_to_oppose_opposition" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#decimal",
    "@value" : "15.0"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "The owner has the right to oppose or refuse the processing of his/her personal data under certain scenarios"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#in_direct_marketing_cases" : [ {
    "@value" : "The data subject can always object to the processing of his personal data for direct marketing, including profiling, in which case the personal data will no longer be processed for this purpose."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_account_encumbered" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#when_it_can_be_opposed_to_treatment" : [ {
    "@value" : "If the Organic Law on Personal Data Protection explicitly permits the type of processing in progress or proposed"
  }, {
    "@value" : "If the data are not publicly available and are not related to matters of public interest required by other Ecuadorian laws"
  }, {
    "@value" : "If the processing of personal data is for the purpose of direct marketing"
  }, {
    "@value" : "If the treatment does not affect the rights of others"
  }, {
    "@value" : "When the consent of the data subject is not necessary for the processing as a consequence of the concurrence of a legitimate interest."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_of_opposition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The owner has the right to oppose or refuse the processing of his/her personal data under certain scenarios"
  }, {
    "@language" : "es",
    "@value" : "The owner has the right to oppose or refuse the processing of his/her personal data under certain scenarios"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "right of opposition"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_access_and_availability",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
