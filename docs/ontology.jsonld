  "http://www.w3.org/2004/02/skos/core#closeMatch" : [ {
    "@id" : "http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#ImposeConfidentialityObligationOnPersonnel"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Instrumento legal para garantizar el manejo adecuado de datos personales por parte del personal y encargados."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "https://w3id.org/dpv#ConfidentialityAgreement"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/profiles/ecuador-lopdp#DataBreachException",
