}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Purpose",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/source" : [ {
    "@language" : "es",
    "@value" : "LOPDP, art. 10"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "Personal data may not be processed for purposes other than those established at the time of collection, unless the conditions permitting further processing as set forth in the Organic Law on the Protection of Personal Data are met."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_distinct_from_data_collection_in_the" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processing"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#shall_be" : [ {
    "@value" : "Communicated to the owner of the data, therefore, the owner of the data must be informed in a clear and understandable manner about the purposes of the processing, so that he/she can make informed decisions about the use of his/her personal data."
  }, {
    "@value" : "Determined, i.e., they must be specific and well defined, without ambiguity, so that it is clear what will be done with the data collected."
  }, {
    "@value" : "Explicit, i.e. they must be transparent and easily understandable for the data subject, without leaving room for confusing interpretations."
  }, {
    "@value" : "Legitimate, which means that they must be based on valid legal grounds and comply with data protection regulations."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Purpose"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Personal data may not be processed for purposes other than those established at the time of collection, unless the conditions permitting further processing as set forth in the Organic Law on the Protection of Personal Data are met. Correspondences with the DPV: is related to dpv:Purpose."
  }, {
    "@language" : "es",
    "@value" : "Personal data may not be processed for purposes other than those established at the time of collection, unless the conditions permitting further processing as set forth in the Organic Law on the Protection of Personal Data are met. Correspondencias con el DPV: está relacionado con dpv:Purpose."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Purpose"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Principles"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Principles"
  } ],
  "http://www.w3.org/2004/02/skos/core#relatedMatch" : [ {
    "@id" : "https://w3id.org/dpv#Purpose"
  } ]
}, {
