  }, {
    "@language" : "es",
    "@value" : "Data processing must be necessary to achieve the intended purpose and no more data must be collected than is necessary for that specific purpose."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "need"
  } ]
