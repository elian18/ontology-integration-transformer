  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "This aspect considers measures that can be applied to national companies in the event of non-compliance with the proper use of data."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Minor_infractions_national_public_company" : [ {
    "@value" : "0.1 to 0.7 of the company's turnover."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#National_company_detail" : [ {
    "@value" : "General company information. For example, KFC."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Serious_infractions_national_public_company" : [ {
    "@value" : "from 0.7 to 1% of the business volume, it may increase depending on the company's degree of non-compliance"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#where_in_the_national_scope_is_held" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#national_companies001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Domestic_Companies"
  } ],
