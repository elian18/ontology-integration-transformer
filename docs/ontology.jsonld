    "@value" : "sanciones"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#scenarios_for_treatment_by_private_and_public_entities",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Health_related_data_processing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "scenarios for treatment by private and public entities"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Health_related_data_processing"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#scope_of_application",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#scope_of_legislation" : [ {
    "@value" : "The law will apply to the processing of personal data regardless of the medium in which it is stored, whether in automated or non-automated formats. This implies that the law is equally applicable to data stored in automated systems, such as electronic databases, as well as to data that may exist in non-automated formats, such as physical documents or paper files."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Scope_of_application"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "scope of application"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#scope_of_legislation",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Correspondences with the DPV: is related to dpv:hasScope."
  }, {
    "@language" : "es",
    "@value" : "Correspondencias con el DPV: está relacionado con dpv:hasScope."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Scope_of_application"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "scope of legislation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Scope_of_application"
  } ],
  "http://www.w3.org/2004/02/skos/core#relatedMatch" : [ {
    "@id" : "https://w3id.org/dpv#hasScope"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#security",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "Implementation of adequate and necessary measures to protect personal data against risks, threats and vulnerabilities, considering the current state of technology"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_implementing_safety_measures" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processor"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#types_of_safety_measures" : [ {
    "@value" : "Organizational measures, i.e. measures that refer to the internal policies, procedures and structures that an organization implements to protect personal data."
  }, {
    "@value" : "Technical measures, i.e. measures that involve the use of technology to protect personal data, these may include the use of firewalls, data encryption, intrusion detection software, biometric access controls, among others."
  }, {
    "@value" : "Type of measures covering aspects such as physical security of equipment and data centers, risk management, business continuity and security incident response."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Security"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Implementation of adequate and necessary measures to protect personal data against risks, threats and vulnerabilities, considering the current state of technology"
  }, {
    "@language" : "es",
    "@value" : "Implementation of adequate and necessary measures to protect personal data against risks, threats and vulnerabilities, considering the current state of technology"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "security"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#sensitive_data",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_not_subject_to_processing_according_to_the_right_to_not_be_the_object_of_automated_decisions" : [ {
    "@value" : "Sensitive data of children and adolescents may not be processed unless expressly authorized by the legal representative."
  }, {
    "@value" : "Sensitive data of the data subject may not be processed without his/her express authorization."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_related_to" : [ {
    "@value" : "Cultural identity"
  }, {
    "@value" : "Datos biométricos"
  }, {
    "@value" : "Ethnicity"
  }, {
    "@value" : "Gender Identity"
  }, {
    "@value" : "Genetic data"
  }, {
    "@value" : "Health"
  }, {
    "@value" : "Ideology"
  }, {
    "@value" : "Judicial past"
  }, {
    "@value" : "Migratory status"
  }, {
    "@value" : "Political affiliation"
  }, {
    "@value" : "Religion"
  }, {
    "@value" : "Sexual Orientation"
  }, {
    "@value" : "Stateless persons and refugees in need of international protection"
  }, {
    "@value" : "Those whose improper treatment may give rise to discrimination, infringe or may infringe fundamental rights and freedoms."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_subjects_to_treatment_according_to_the_right_to_not_be_the_object_of_automated_decisions" : [ {
    "@value" : "When the processing is necessary to protect an essential public interest, as assessed according to international human rights standards, and meets at least the minimum criteria"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "Refers to information specific or linked to certain sensitive or particular categories of a person."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#shall_at_least_comply_with_the_minimum_with" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minimum_criteria"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Sensitive_data"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Refers to information specific or linked to certain sensitive or particular categories of a person."
  }, {
    "@language" : "es",
    "@value" : "Refers to information specific or linked to certain sensitive or particular categories of a person."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "sensitive data"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#sensitive_data_processing",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "The processing of sensitive personal data is prohibited, except in specific situations where it is justified."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#sensitive_data_processing_scenarios" : [ {
    "@value" : "The owner has given his/her explicit consent for the processing of his/her personal data, clearly specifying the purposes for which the data is to be processed."
  }, {
    "@value" : "The processing is necessary for archiving purposes in the public interest, scientific or historical research purposes or statistical purposes."
  }, {
    "@value" : "The processing is necessary for the performance of obligations and exercise of rights specific to the controller or the data subject in the field of labor law, social security and social protection."
  }, {
    "@value" : "The processing is necessary to protect the vital interests of the data subject or of another natural person, in the event that the data subject is physically or legally incapable of giving consent."
  }, {
    "@value" : "The processing relates to personal data that the data subject has manifestly made public"
  }, {
    "@value" : "Treatment is performed by order of a judicial authority."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Sensitive_data_processing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The processing of sensitive personal data is prohibited, except in specific situations where it is justified."
  }, {
    "@language" : "es",
    "@value" : "The processing of sensitive personal data is prohibited, except in specific situations where it is justified."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "sensitive data processing"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#sensitive_data_processing_scenarios",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Sensitive_data_processing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "sensitive data processing scenarios"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Sensitive_data_processing"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#serious_infractions",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#committed_by" : [ {
