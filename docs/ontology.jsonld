  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "It is the way in which the data is treated, it must be treated and therefore transferred only when strictly necessary. In addition, the presence of threats is verified."
  } ],
