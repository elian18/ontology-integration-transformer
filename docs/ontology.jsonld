    "@value" : "Correspondencias con el DPV: es igual a dpv:PersonalDataAudit."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "auditorías de protección de datos"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Mecanismo de verificación sobre el cumplimiento de las normas corporativas vinculantes."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "https://w3id.org/dpv#PersonalDataAudit"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/profiles/ecuador-lopdp#DataSecurityBreach",
