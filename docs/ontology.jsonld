  "http://purl.org/dc/terms/source" : [ {
    "@language" : "es",
    "@value" : "LOPDP, art. 15"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Correspondences with the DPV: is the same as dpv:DataSanitisationTechnique; is broader than dpv:DataRedaction; is related to dpv:DataDeletionPolicy."
  }, {
    "@language" : "es",
    "@value" : "Correspondencias con el DPV: es igual a dpv:DataSanitisationTechnique; es más general que dpv:DataRedaction; está relacionado con dpv:DataDeletionPolicy."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Métodos de eliminación"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Técnicas para hacer ilegibles o irreconocibles los datos de forma definitiva y segura."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "https://w3id.org/dpv#DataSanitisationTechnique"
  } ],
  "http://www.w3.org/2004/02/skos/core#narrowMatch" : [ {
    "@id" : "https://w3id.org/dpv#DataRedaction"
  } ],
  "http://www.w3.org/2004/02/skos/core#relatedMatch" : [ {
    "@id" : "https://w3id.org/dpv#DataDeletionPolicy"
  } ]
