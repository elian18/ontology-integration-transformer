  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Scientist" : [ {
    "@value" : "If it is a scientific topic, it is possible to use the information"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Statistician" : [ {
    "@value" : "If it is a statistical issue, it is possible to use the information"
