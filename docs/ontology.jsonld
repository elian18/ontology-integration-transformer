  } ],
  "http://www.w3.org/2004/02/skos/core#narrowMatch" : [ {
    "@id" : "https://w3id.org/dpv#DataBreachNotice"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/profiles/ecuador-lopdp#DataDeletion",
