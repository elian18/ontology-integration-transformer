  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "Person or entity legally appointed to represent and exercise the rights and obligations related to the personal data of a deceased individual."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#exercise_of_rights_by_the_deceased_owner" : [ {
    "@value" : "To contact the person responsible for the processing of personal data in order to request access, rectification and updating or deletion of the personal data of the deceased person he/she represents."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Successor_right_holder"
  } ],
