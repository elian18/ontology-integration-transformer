  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_consult",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#garatize_that" : [ {
    "@value" : "The consultation is free of charge"
  }, {
    "@value" : "The consultation is public"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#where_you_can_consult" : [ {
    "@value" : "National Registry of Personal Data Protection"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_consult"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "right to consult"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_correction_and_update",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "The holder has the right to obtain from the data controller the rectification and updating of inaccurate or incomplete personal data."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_account_encumbered" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_correction_and_update"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The holder has the right to obtain from the data controller the rectification and updating of inaccurate or incomplete personal data."
  }, {
    "@language" : "es",
    "@value" : "The holder has the right to obtain from the data controller the rectification and updating of inaccurate or incomplete personal data."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "right to correction and update"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_digital_education",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#guaranteeing_digital_education" : [ {
    "@value" : "Higher education system"
  }, {
    "@value" : "The national education system"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#inclusiveness_in" : [ {
    "@value" : "People with special educational needs"
  }, {
    "@value" : "Students of all levels"
  }, {
    "@value" : "Teachers or professors"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_access_and_availability" : [ {
    "@value" : "Appropriate, healthy, constructive, safe and responsible use and management of information and communication technologies."
  }, {
    "@value" : "Development in Information and Communication Technologies"
  }, {
    "@value" : "Information and Communication Technologies Training"
  }, {
    "@value" : "Information and Communication Technology Learning"
  }, {
    "@value" : "Knowledge of Information and Communication Technologies."
  }, {
    "@value" : "Training in Information and Communication Technologies"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_digital_education"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "right to digital education"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_information",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#know_in_the_right_to_information" : [ {
    "@value" : "Any other purpose or additional treatment"
  }, {
    "@value" : "How to exercise your rights of access, deletion, rectification, updating, opposition, cancellation, limitation of processing and not to be subject to automatic decisions."
  }, {
    "@value" : "Identity and contact details of the personal data protection officer, if applicable"
  }, {
    "@value" : "The different types of treatment"
  }, {
    "@value" : "The existence of a database containing your personal data"
  }, {
    "@value" : "The existence of automated evaluations and decisions, including profiling"
  }, {
    "@value" : "The identity and contact details of the person responsible for processing personal data, including address, telephone number and e-mail address"
  }, {
    "@value" : "The impact of providing incorrect or inaccurate personal data"
  }, {
    "@value" : "The legal basis for the treatment"
  }, {
    "@value" : "The option to revoke consent at any time"
  }, {
    "@value" : "The origin of the personal data if it was not obtained directly from the data subject."
  }, {
    "@value" : "The period during which the data will be kept"
  }, {
    "@value" : "The possible consequences for the holder if he/she provides or refuses to provide his/her personal data"
  }, {
    "@value" : "Treatment purposes"
  }, {
    "@value" : "Where and how to file complaints with the data controller and the Personal Data Protection Authority"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#must_be_aware_of_the_possibility_of_realizing" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#revocation_of_consent"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#must_comply_with_the_principles_of" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#loyalty"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#transparency"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_information"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "right to information"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_suspension_of_treatment",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#assumptions_for_processing_the_data_in_the_event_of_a_data_challenge" : [ {
    "@value" : "Claims defense"
  }, {
    "@value" : "Claims exercise"
  }, {
    "@value" : "Formulation of claims"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#conditions_for_the_suspension_of_treatment" : [ {
    "@value" : "The controller no longer needs the personal data for the purposes of the processing, but the data subject needs the data for the formulation, exercise or defense of claims"
  }, {
    "@value" : "The processing is unlawful and the data subject opposes the deletion of the personal data and requests instead the limitation of its use."
  }, {
    "@value" : "When the data subject contests the accuracy of the personal data, while the data controller verifies the accuracy of the personal data"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "The data subject shall have the right to obtain from the data controller the suspension of data processing, when certain scenarios are met"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#incurring_the_owner_to_the_personal_data_protection_authority" : [ {
    "@value" : "In the event that the data controller or processor refuses to suspend the processing of the data requested by the data subject"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_account_encumbered" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processor"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_suspension_of_treatment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The data subject shall have the right to obtain from the data controller the suspension of data processing, when certain scenarios are met"
  }, {
    "@language" : "es",
    "@value" : "The data subject shall have the right to obtain from the data controller the suspension of data processing, when certain scenarios are met"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "right to suspension of treatment"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_update_correction_or_deletion_of_the_credit_data_holder",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights_of_credit_data_owners"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "right to update correction or deletion of the credit data holder"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights_of_credit_data_owners"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#rights",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#are_constituted_of" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_not_to_be_object_to_automated_evaluations"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_access"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_deletion"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_opposition"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_consult"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_correction_and_update"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_digital_education"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_information"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_suspension_of_treatment"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description_responsible_for_channeling_exercise_of_rights" : [ {
    "@value" : "It involves consideration of the individuals responsible for ensuring that the rights of the holder are properly exercised."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#irrevocability" : [ {
    "@value" : "The holder's rights are non-transferable and cannot be waived; therefore, any clause or provision that contradicts this will be considered null and void."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#limitation_on_exercise_of_rights_by_secondary_laws" : [ {
    "@value" : "Regulations or rules complementary to the Personal Data Protection Law may not restrict or limit the rights of the owner."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsable_de_canalizar_el_ejercicio_de_derechos" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_channeling_the_exercise_of_rights" : [ {
    "@value" : "Competent judges in accordance with the procedure established in the Organic Law on Personal Data Protection."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "rights"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#rights_of_credit_data_holders",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights_of_credit_data_owners"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "rights of credit data holders"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights_of_credit_data_owners"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#rights_of_credit_data_owners",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#mechanisms_to_secure_the_right_of_access_of_the_credit_data_holder" : [ {
    "@value" : "Delivery of printouts of the reports so that the owner of the credit data can verify the veracity and accuracy of its content, without being able to use it for credit or commercial purposes."
  }, {
    "@value" : "Direct observation through screens that the credit reference service providers will make available on the holder of credit data"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_access_by_credit_data_holders" : [ {
    "@value" : "As often as requested by the credit data subject with respect to the information that credit reference service providers have about him/her."
  }, {
    "@value" : "It shall be free of charge"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_update_correction_or_deletion_of_the_credit_data_holder" : [ {
    "@value" : "The owner of the credit data may demand the right to update, rectify or delete the credit data before the sources of information through a written request."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#rights_of_credit_data_holders" : [ {
    "@value" : "Personal access to the information of which it is the owner of credit data."
  }, {
    "@value" : "That the credit report allows to know clearly and accurately the condition of your credit history."
  }, {
    "@value" : "That the sources of information update, rectify or eliminate, as the case may be, information that is unlawful, false, inaccurate, erroneous, incomplete or outdated."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#source_of_information_activity_on_the_application" : [ {
    "@value" : "If the credit data review process is initiated, it is necessary to clearly indicate in the reports issued that the information that is the subject of the request is being reviewed at the request of the holder."
  }, {
    "@value" : "The sources of information must resolve the request within a maximum period of 15 days from its submission, either admitting it or rejecting it with a detailed explanation of the reasons"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights_of_credit_data_owners"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "rights of credit data owners"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#rights_to_correct_update_update_delete_and_oppose",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
