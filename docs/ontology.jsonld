  } ],
  "http://www.w3.org/2004/02/skos/core#closeMatch" : [ {
    "@id" : "https://w3id.org/dpv#RiskAssessment"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Documento requerido por la Autoridad para verificar amenazas a los derechos de los titulares."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/profiles/ecuador-lopdp#SelfRegulation",
