    "@language" : "es",
    "@value" : "LOPDP, art. 65"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Correspondences with the DPV: is the same as dpv:Delete; is related to dpv:DataDeletionPolicy."
  }, {
    "@language" : "es",
    "@value" : "Correspondencias con el DPV: es igual a dpv:Delete; está relacionado con dpv:DataDeletionPolicy."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "eliminación de los datos"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Medida correctiva que consiste en suprimir los datos personales objeto de la infracción."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "https://w3id.org/dpv#Delete"
  } ],
  "http://www.w3.org/2004/02/skos/core#relatedMatch" : [ {
    "@id" : "https://w3id.org/dpv#DataDeletionPolicy"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/profiles/ecuador-lopdp#DataDeletionMethods",
