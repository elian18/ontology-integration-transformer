}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#teenagers001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Access" : [ {
    "@value" : "Adolescent data must be accessible"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Anonymization" : [ {
    "@value" : "It must be possible to anonymize adolescent data."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Correction" : [ {
    "@value" : "Adolescent data must be able to be rectified"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Disposal" : [ {
    "@value" : "It should be possible to delete teenage data"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "In order to make use of their data, no detailed supervision is necessary, only the use to which the data will be put needs to be clearly stated. The age range to be considered as adolescent data is from 12 to 17 years old."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Supervision" : [ {
    "@value" : "Teenagers can use their personal information without the need for adult consent, they do not need supervision, but the use that will be made of their data must be very clear."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Updated" : [ {
    "@value" : "Adolescent data must be updatable"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#and_as_your_age_will_have_to_be_of_your_age" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#teenagers001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Teenagers"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "teenagers001"
  } ]
