  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "responsible001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_of_access_time",
