  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "right of access time"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_of_deletion001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Consent_in_verification" : [ {
    "@value" : "Must be consented to by the owner"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "This right talks about the scenarios in which the owner of the information can delete his/her data and for this purpose he/she has a period of 15 days."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Informed" : [ {
    "@value" : "It can be an informed consent"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Not_informed" : [ {
    "@value" : "It can be an informed consent"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Purpose" : [ {
    "@value" : "To delete data, it must have a purpose."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Revoke_consent" : [ {
    "@value" : "It must be possible to revoke the consent at any time, this can be done by the owner of the data."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Updated" : [ {
    "@value" : "Must be updated"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#can_be_rights_of" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_of_deletion001"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#time_of_right_to_elimination" : [ {
    "@value" : "15 days"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Right_of_deletion_in_verification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "right of deletion001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_to_correct_and_update001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Consent_in_verification" : [ {
    "@value" : "Must be consented to by the owner"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "This right states that the owner of the information has the possibility to update their data when it is inaccurate or incomplete, and this must be done within 15 days."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Informed" : [ {
    "@value" : "It can be an informed consent"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Not_informed" : [ {
    "@value" : "May be an uninformed consent"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Preservation_time" : [ {
    "@value" : "The time is 15 days"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Revoke_consent" : [ {
    "@value" : "It must be possible to revoke the consent at any time, this can be done by the owner of the data."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Scope_of_credit_rights" : [ {
    "@value" : "In the credit rights it is stipulated that such rights, as well as all the rights present in the law, have the option of a rectification of information in case the holder needs it."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Updated" : [ {
    "@value" : "Must be updated"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#can_be_rights_of" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_to_correct_and_update001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Right_to_correct_and_update_in_verification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "right to correct and update001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_to_portability001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Compatible" : [ {
    "@value" : "Must be compatible"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Consent_in_verification" : [ {
    "@value" : "Must be consented to by the owner"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "This right talks about how the holder can request the transfer of his data to another person or responsible when the situation warrants it and for this right there is no established time."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Gratuity" : [ {
    "@value" : "Must be free of charge for the holder"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Informed" : [ {
    "@value" : "It can be an informed consent"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Not_informed" : [ {
    "@value" : "May be an uninformed consent"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Revoke_consent" : [ {
    "@value" : "It must be possible to revoke the consent at any time, this can be done by the owner of the data."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Structured" : [ {
    "@value" : "Must be structured"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Updated" : [ {
    "@value" : "Must be updated"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#can_be_rights_of" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_to_portability001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Right_to_portability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "right to portability001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_to_the_information001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Consent_in_verification" : [ {
    "@value" : "Must be consented to by the owner"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Data_use" : [ {
    "@value" : "The owner's data must be free from use in information automation processes, in order to avoid automated decisions on any specific subject."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "This right means that the owner of the data must know what is going to be done with them and how they are going to be treated either in the field of data processing or in the field of transfer of information, and to complete this task there is a period of 30 days."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Informed" : [ {
    "@value" : "Puede ser un consentimiento informado"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Not_informed" : [ {
    "@value" : "May be an uninformed consent"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Preservation_time" : [ {
    "@value" : "It has 30 days to inform the holder that his data was obtained in a non-direct way, this is done by the responsible and in charge."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Revoke_consent" : [ {
    "@value" : "It must be possible to revoke the consent at any time, this can be done by the owner of the data."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Updated" : [ {
    "@value" : "The information must be up to date"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#can_be_rights_of" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_to_the_information001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Right_to_information_in_verification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "right to the information001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#rights001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Rights_in_verification" : [ {
    "@value" : "Rights of the holder before the law"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#exceptions_to_rights" : [ {
    "@value" : "Exceptions to the rights, cases in which the holder's data can be used without his/her consent."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#the_law_has_the_following_rights" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#rights001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Rights_in_verification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "rights001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#sanctioning_regime001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "These are the consequences to which the entities involved in the law are prone to. Verify that everything is working correctly and if not, a penalty is applied."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Precautionary_measures" : [ {
    "@value" : "Precautionary measures"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Sanctioning_administrative_procedure" : [ {
    "@value" : "Actions in case of a bad practice in the use of data"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#the_verification_covers_aspects_such_as" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#sanctioning_regime001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Sanctioning_regime"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "sanctioning regime001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#security_from_design001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "It is the initial protection to which the data is subject and it is the responsibility of the data controller to apply it."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Safety_from_design_by_defect" : [ {
    "@value" : "Data must be subject to security by design by default"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#account_with_actions_as" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#security_from_design001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Follow-up_from_design"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "security from design001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#security_security_presents_itself_as",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "security security presents itself as"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_data_security"
  } ]
