    "@language" : "es",
    "@value" : "LOPDP, art. 42"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Correspondences with the DPV: is the same as dpv:ImpactAssessment. Bridge with the GDPR: is close to gdprtext:FactorsForImpactAssessment (through dpv:ImpactAssessment); is close to gdprtext:ImpactAssessment (through dpv:ImpactAssessment)."
  }, {
    "@language" : "es",
    "@value" : "Correspondencias con el DPV: es igual a dpv:ImpactAssessment. Puente con el GDPR: se parece a gdprtext:FactorsForImpactAssessment (por dpv:ImpactAssessment); se parece a gdprtext:ImpactAssessment (por dpv:ImpactAssessment)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "evaluación de impacto del tratamiento de datos personales"
  } ],
  "http://www.w3.org/2004/02/skos/core#closeMatch" : [ {
    "@id" : "http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#FactorsForImpactAssessment"
  }, {
    "@id" : "http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#ImpactAssessment"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Proceso obligatorio realizado por el responsable para identificar riesgos altos en el tratamiento de datos personales."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "https://w3id.org/dpv#ImpactAssessment"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/profiles/ecuador-lopdp#MinorAutomatedDecisionRight",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@language" : "es",
    "@value" : "LOPDP, art. 21"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Correspondences with the DPV: is a kind of dpv:DataSubjectRight; is related to dpv:AutomatedDecisionMaking."
  }, {
    "@language" : "es",
    "@value" : "Correspondencias con el DPV: es un tipo de dpv:DataSubjectRight; está relacionado con dpv:AutomatedDecisionMaking."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Derecho de niñas, niños y adolescentes a no ser objeto de una decisión basada única o parcialmente en valoraciones automatizadas"
  } ],
  "http://www.w3.org/2004/02/skos/core#broadMatch" : [ {
    "@id" : "https://w3id.org/dpv#DataSubjectRight"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Prohibición de tratar datos sensibles o de menores de edad mediante valoraciones automatizadas, salvo autorización expresa o interés público esencial."
  } ],
  "http://www.w3.org/2004/02/skos/core#relatedMatch" : [ {
    "@id" : "https://w3id.org/dpv#AutomatedDecisionMaking"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/profiles/ecuador-lopdp#NationalDataProtectionRegistry",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
