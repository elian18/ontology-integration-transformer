  } ],
  "http://www.w3.org/2004/02/skos/core#broadMatch" : [ {
    "@id" : "https://w3id.org/dpv#PublicRegisterOfEntities"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Sistema donde el responsable debe reportar y mantener actualizada la información sobre el tratamiento de datos."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/profiles/ecuador-lopdp#PersonalDataProtection",
