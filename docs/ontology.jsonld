  "http://purl.org/dc/terms/source" : [ {
    "@language" : "es",
    "@value" : "LOPDP, art. 39"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Correspondences with the DPV: is the same as dpv:PrivacyByDefault."
  }, {
    "@language" : "es",
    "@value" : "Correspondencias con el DPV: es igual a dpv:PrivacyByDefault."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "protección de datos por defecto"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
