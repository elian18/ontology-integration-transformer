}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#treatment001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Analysis_methodologies" : [ {
    "@value" : "Analysis methodology to be used on the data"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Binding_cooperative_rules" : [ {
    "@value" : "The person in charge and the person responsible are responsible for the application of binding cooperative rules."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Details_of_the_law_details" : [ {
    "@value" : "Information"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "It performs the same activities as the data controller in terms of transfer, verification and security."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Implementing_verification_processes" : [ {
    "@value" : "Must implement data verification processes"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Maintaining_the_accuracy_of_the_information" : [ {
    "@value" : "The person in charge and the person in charge are responsible for maintaining the accuracy of the information in the transfer and verification processes."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Members_of_the_protection_system_details" : [ {
    "@value" : "Information indicating that it is part of the law"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Name" : [ {
    "@value" : "Ana"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#National_registry_for_the_protection_of_personal_data" : [ {
    "@value" : "Records data information"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Obligations_of_the_responsible_person_and_manager" : [ {
    "@value" : "Apply processes, implement protection policies, use methodologies and take technological measures"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Perform_evaluations" : [ {
    "@value" : "It is responsible for conducting evaluations"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_data_security_details" : [ {
    "@value" : "The person in charge and responsible for personal data is responsible for ensuring the security of the owner's data."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_detail" : [ {
    "@value" : "It is in charge of data processing and transfer processes when its assistance is required."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_information" : [ {
    "@value" : "Personal information of the person in charge"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Protection_policies" : [ {
    "@value" : "Data protection policies to be applied to the data"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Safety_from_design_by_defect" : [ {
    "@value" : "Security must be in place from the beginning of the data processing."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Self-regulation" : [ {
    "@value" : "Data controllers and processors must adhere to codes of conduct, seals, certifications and protection marks, without this constituting an exemption from the responsibility to comply with the provisions of this law, its regulations, guidelines and regulations issued by the Personal Data Protection Authority."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Serious" : [ {
    "@value" : "These infractions are in accordance with the infraction or fault of the person responsible for the data.\nFor example, if an administrative procedure is not carried out."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Slight" : [ {
    "@value" : "These infractions are in accordance with the infraction or fault of the data controller.\nFor example, failure to process or implement a process in the transfer of information would be considered a minor infraction."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Very_serious" : [ {
    "@value" : "Not specified, but if there is, the Authority decides what action to take."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#is_compliant_with_the_following_roles" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#treatment001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Treatment_Manager_in_verification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "treatment001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#unequivocal_consent001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Informed" : [ {
    "@value" : "When any unambiguous consent is requested from the data subject"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Not_informed" : [ {
    "@value" : "When unambiguous consent is not requested from the data subject"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#can_be" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#unequivocal_consent001"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "unequivocal consent001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#verification001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Audit" : [ {
    "@value" : "Verification processes should be audited when necessary."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Audit_detail" : [ {
    "@value" : "Information on the audit performed"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "They are misuses of the information by the people who had contact with the data."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#a_process_of" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#verification001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Verification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "verification001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#violation_investigation001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Detail_of_investigation_of_infringements" : [ {
    "@value" : "If the data subject has breach information, he/she is subject to an international exception on his/her data."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "When the owner of the information has committed an offense or committed a crime, this information may be investigated without the owner's consent."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#segmented_into_the_following_international_cases" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#violation_investigation001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Infringement_investigation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "violation investigation001"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#vital_interest_in_another_person001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "When the data subject is unable to consent to the use of the data."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Vital_interest_detail_of_another_person" : [ {
    "@value" : "Research for a critical disease"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#segmented_into_the_following_international_cases" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#vital_interest_in_another_person001"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Vital_interest_of_another_person"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "vital interest in another person001"
  } ]
