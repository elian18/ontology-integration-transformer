}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#claims",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#answer_the_claim" : [ {
    "@value" : "The responsible party must respond to the request within 10 days, either with an affirmative or negative answer, notifying and executing the corresponding actions."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#are_destined_to" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#before_answering_the_claim" : [ {
    "@value" : "The Personal Data Protection Authority may carry out actions including preliminary investigations, information gathering and evaluation of the circumstances of the case, in accordance with the provisions of the Organic Administrative Code."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#claims_of" : [ {
    "@value" : "Claims related to the exercise of the holder's rights in the processing of personal data"
  }, {
    "@value" : "Complaints related to compliance with obligations of the data controller"
  }, {
    "@value" : "Complaints related to the application of principles in data processing"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#in_the_face_of_a_denial_or_no_response_to_the_claim" : [ {
    "@value" : "The data subject may bring civil, criminal or constitutional actions as deemed necessary."
  }, {
    "@value" : "The holder may file an administrative complaint with the Personal Data Protection Authority."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#may_be_done_by_means" : [ {
    "@value" : "Digitals"
  }, {
    "@value" : "Physicists"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#may_be_made_by" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_owner"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#may_be_made_in_shape" : [ {
    "@value" : "Free"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#submit_in_case_of_claim" : [ {
    "@value" : "Presentar quejas"
  }, {
    "@value" : "Submit petitions"
  }, {
    "@value" : "Submit requirements"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Claims"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "claims"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#claims_of",
