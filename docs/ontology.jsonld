  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Reglas de obligatorio cumplimiento para el grupo empresarial que regulan la transferencia internacional de datos."
  } ],
  "http://www.w3.org/2004/02/skos/core#narrowMatch" : [ {
    "@id" : "https://w3id.org/dpv#ContractualTerms"
