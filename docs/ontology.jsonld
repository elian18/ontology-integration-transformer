  "http://www.w3.org/2004/02/skos/core#narrowMatch" : [ {
    "@id" : "https://w3id.org/dpv#UntilTimeDuration"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/profiles/ecuador-lopdp#CodesOfConduct",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@language" : "es",
    "@value" : "LOPDP, art. 53"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Correspondences with the DPV: is the same as dpv:CodeOfConduct. Bridge with the GDPR: is close to gdprtext:CodeOfConduct (through dpv:CodeOfConduct)."
  }, {
    "@language" : "es",
    "@value" : "Correspondencias con el DPV: es igual a dpv:CodeOfConduct. Puente con el GDPR: se parece a gdprtext:CodeOfConduct (por dpv:CodeOfConduct)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "códigos de conducta"
  } ],
  "http://www.w3.org/2004/02/skos/core#closeMatch" : [ {
    "@id" : "http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#CodeOfConduct"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Instrumentos sectoriales promovidos para el cumplimiento de la normativa de protección de datos."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "https://w3id.org/dpv#CodeOfConduct"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/profiles/ecuador-lopdp#ConfidentialityAgreement",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@language" : "es",
    "@value" : "LOPDP, art. 47"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
