  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minimization_of_personal_data",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "It implies that the amount of data collected must be limited and restricted to what is strictly necessary to fulfill the purpose of the processing."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Minimization"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "It implies that the amount of data collected must be limited and restricted to what is strictly necessary to fulfill the purpose of the processing."
  }, {
    "@language" : "es",
    "@value" : "It implies that the amount of data collected must be limited and restricted to what is strictly necessary to fulfill the purpose of the processing."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "minimization of personal data"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minimum_criteria",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#are_composed_of" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legality"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#need"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proportionality"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Minimum_criteria"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "minimum criteria"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minor_infractions",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#committed_by" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processor"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Minor_infractions"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Correspondences with the DPV: is related to dpv:hasSeverity."
  }, {
    "@language" : "es",
    "@value" : "Correspondencias con el DPV: está relacionado con dpv:hasSeverity."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid705"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "minor infractions"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Controller"
  } ],
  "http://www.w3.org/2004/02/skos/core#relatedMatch" : [ {
    "@id" : "https://w3id.org/dpv#hasSeverity"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minor_infractions_penalties",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#by" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minor_infractions"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#destined_for" : [ {
    "@value" : "Servidores o funcionarios del sector público"
  }, {
    "@value" : "The Controller or Processor of personal data or, if applicable, a third party, may be a private law entity or a public company."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#determination_of_the_fine_in_respect_to_penalties_for_infringement_of_the_responsible_person_or_person_in_charge_of_treatment" : [ {
    "@value" : "Intentionality, which will evaluate the offender's conduct to determine if there was intent to commit the infraction."
  }, {
    "@value" : "Nature of the damage, where the negative consequences for the right to the protection of personal data will be evaluated."
  }, {
    "@value" : "Recidivism, which is considered when the previous infraction is similar to the one to be sanctioned again."
  }, {
    "@value" : "Reiteration of the infraction, which considers when the controller or processor of personal data has been previously sanctioned for two or more infractions of lesser gravity, or for an infraction of equal or greater gravity."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_related_to" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proportionality"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#turnover"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#principle_of_attachment_with_sanction_to_the_responsible_party_or_the_treatment_manager" : [ {
    "@value" : "Proportionality"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_of_penalty_for_infractions_to_the_responsible_party_or_the_processor" : [ {
    "@value" : "A fine ranging from 0.1% to 0.7% of the turnover for the fiscal year immediately preceding the imposition of the fine shall be imposed."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_of_penalty_for_infractions_toward_public_servants_or_officials" : [ {
    "@value" : "Shall be sanctioned with a fine ranging from 1 to 10 basic unified salaries of the public servant or public official"
  }, {
    "@value" : "This sanction does not rule out the possibility of the State assuming additional liability for damages caused, which will be governed in accordance with the corresponding regulations."
  } ],
