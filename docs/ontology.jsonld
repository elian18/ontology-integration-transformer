}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#deceased_owner",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#account_with_a" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#successor_right_holder"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "An individual who, in life, was the owner of personal data and has died."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Deceased_owner"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An individual who, in life, was the owner of personal data and has died."
  }, {
    "@language" : "es",
    "@value" : "An individual who, in life, was the owner of personal data and has died."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "deceased owner"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#deceased_persons_data",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#explanation_of_concept_of_inapplicability" : [ {
    "@value" : "This exemption establishes that the law does not apply to data related to deceased individuals, recognizing the special nature of post mortem information. The exemption allows the processing of data relating to individuals who are deceased, without being subject to the general provisions of this law."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Deceased_persons_data"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "deceased persons data"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#delegate",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#a_data_protection_delegate_will_be_assigned" : [ {
    "@value" : "When it refers to the large-scale processing of special categories of data, in accordance with the provisions of the regulations of the Organic Law on Personal Data Protection."
  }, {
    "@value" : "When the activities of the person responsible for or in charge of the processing of personal data require a permanent and systematized control due to the volume, nature, scope or purposes of the processing, as established in the Organic Law for the Protection of Personal Data or in the regulations issued by the Authority for the Protection of Personal Data."
  }, {
    "@value" : "When the data processing is not related to national security or defense of the State, and does not involve classified or confidential information as stipulated in the specialized laws in this area."
  }, {
    "@value" : "When the treatment is carried out by those who make up the public sector in accordance with Article 225 of the Constitution of the Republic."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#contact_data" : [ {
    "@value" : "E-mail address"
  }, {
    "@value" : "Home address"
  }, {
    "@value" : "Names and surnames"
  }, {
    "@value" : "Telephone number"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#control_functions" : [ {
    "@value" : "Advise on risk analysis, impact assessment and evaluation of security measures, and supervise their implementation."
  }, {
    "@value" : "Advise the responsible party, the personnel of the responsible party and the person in charge of the processing of personal data, on the provisions contained in the Organic Law for the Protection of Personal Data, the regulations, directives, guidelines and other regulations issued by the Authority for the Protection of Personal Data."
  }, {
    "@value" : "Cooperate with the Personal Data Protection Authority and act as a point of contact with such entity, in relation to issues concerning the processing of personal data."
  }, {
    "@value" : "Perform such other functions as the Personal Data Protection Authority may assign, especially in the case of special categories of personal data."
  }, {
    "@value" : "Supervise compliance with the provisions contained in the Personal Data Protection Law and the regulations, directives, guidelines and other regulations issued by the Personal Data Protection Authority."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_related_to" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#shall_be_observed_by" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processor"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_of_person" : [ {
    "@value" : "Natural"
  } ],
