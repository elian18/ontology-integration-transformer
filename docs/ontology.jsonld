}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#exceptions_from_rights_for_the_right_to_automated_assessments",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#for" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_not_to_be_object_to_automated_evaluations"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#rights_to_not_be_the_object_of_automated_assessments" : [ {
    "@value" : "Is based on the explicit consent of the owner"
  }, {
    "@value" : "It is authorized by the applicable regulations, court order, resolution or reasoned mandate of the competent technical authority, for which adequate measures must be established to safeguard the fundamental rights and freedoms of the holder."
  }, {
    "@value" : "The automated decision does not entail serious impacts or verifiable risks for the owner"
  }, {
    "@value" : "The automated decision is necessary for the conclusion or performance of a contract between the data subject and the controller or processor of personal data."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#the_right_to_not_be_object_to_automated_assessments_may_not_be_revocable" : [ {
    "@value" : "A data subject cannot be made to waive the right not to be subject to automated valuations in advance by means of contracts"
  }, {
    "@value" : "When a decision is made based only on automated assessments, the data subject must be clearly informed of his or her right not to be subjected to these automated assessments"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Exceptions_of_rights"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "exceptions from rights for the right to automated assessments"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#exceptions_to_rights_for_rectification_update_deletion_and_opposition",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#for" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_deletion"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_opposition"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_correction_and_update"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#rights_to_correct_update_update_delete_and_oppose" : [ {
    "@value" : "If the applicant is not the owner of the personal data or his legal representative is not duly accredited."
  }, {
    "@value" : "In situations where the public interest is involved, the processing of personal data will be allowed, as long as international human rights standards are respected, the principles of the Organic Law for the Protection of Personal Data are complied with and the minimum criteria established by this law are followed."
  }, {
    "@value" : "In the processing of personal data that are necessary for the filing of information that is part of the State's patrimony, for scientific, historical or statistical research."
  }, {
    "@value" : "When it may cause damage to rights or affect the legitimate interests of third parties and this is accredited by the database controller at the time of responding to the data subject's request to exercise the respective right, i.e., if the database controller can demonstrate that complying with the data subject's request could damage the rights or legitimate interests of other persons, then it may refuse to comply with the request."
  }, {
    "@value" : "When it may hinder judicial or administrative proceedings in progress, duly notified."
  }, {
    "@value" : "When the data are necessary for the formulation, exercise or defense of claims or appeals."
  }, {
    "@value" : "When the data are necessary to comply with a court order, resolution or reasoned mandate from a competent public authority."
  }, {
    "@value" : "When the data are necessary to exercise the right to freedom of expression and opinion."
  }, {
    "@value" : "When the data is necessary for the fulfillment of a legal or contractual obligation."
  }, {
    "@value" : "When the data is necessary to protect the vital interest of the data subject or another natural person."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Exceptions_of_rights"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "exceptions to rights for rectification update deletion and opposition"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#exercise_of_rights",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "Ability of the data subject to access information and training related to the proper use and processing of his or her personal data."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#must_provide_training_and_information" : [ {
    "@value" : "Civil society organizations"
  }, {
    "@value" : "Educational entities"
  }, {
    "@value" : "Providers of information and knowledge society services"
  }, {
    "@value" : "State"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Exercise_of_rights"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Ability of the data subject to access information and training related to the proper use and processing of his or her personal data."
  }, {
    "@language" : "es",
    "@value" : "Ability of the data subject to access information and training related to the proper use and processing of his or her personal data."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "exercise of rights"
  } ]
