  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "When the owner's data is necessary or required for public reasons."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Public_interest_detail" : [ {
    "@value" : "If the data is in the public interest, it may be subject to international exceptions."
