    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Violations"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#conditions_for_legitimate_treatment",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid699"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "conditions for legitimate treatment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_processing"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#conditions_for_the_suspension_of_treatment",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_suspension_of_treatment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "conditions for the suspension of treatment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_suspension_of_treatment"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#confidentiality",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "Information obtained from the processing of personal data must be handled with care and kept secret. This means that the information should not be used or shared for purposes other than those for which it was collected, unless there are special circumstances permitted by law that justify further processing of the data."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Confidentiality"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Information obtained from the processing of personal data must be handled with care and kept secret. This means that the information should not be used or shared for purposes other than those for which it was collected, unless there are special circumstances permitted by law that justify further processing of the data."
  }, {
    "@language" : "es",
    "@value" : "Information obtained from the processing of personal data must be handled with care and kept secret. This means that the information should not be used or shared for purposes other than those for which it was collected, unless there are special circumstances permitted by law that justify further processing of the data."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "confidentiality"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#consent",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#characteristics_that_the_information_transferred_to_the_owner_must_have" : [ {
    "@value" : "Clear, simple and easy to understand language"
  }, {
    "@value" : "Preferably, the information should be available in the language chosen by the owner."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#conditions_for_legitimate_treatment" : [ {
    "@value" : "By consent of the owner for the processing of his personal data for one or more specific purposes."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "Expression by which the owner of the personal data grants his/her authorization to the data controller to process such data."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#for_health-related_data_without_consent" : [ {
    "@value" : "The consent of the owner shall not be required for the processing of health data."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#for_plurality_of_purposes" : [ {
    "@value" : "It is necessary to specify that such consent is given for all the purposes for which consent is being requested."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#how_the_information_may_be_transmitted_to_the_owner" : [ {
    "@value" : "Within any testable mode"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#in_cases_of_direct_data_gathering_by_the" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_owner"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#in_the_case_of_no_direct_data_collection_by_the" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_owner"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_related_to" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#consent_defects"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#revocation_of_consent"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#to_deal_with_and_communicate_personal_data_must" : [ {
    "@value" : "The manifestation of the holder's will to do so must be counted, i.e., when the data subject has given his/her consent for the processing or communication of personal data to occur."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#valid" : [ {
    "@value" : "Free from defects of consent"
  }, {
    "@value" : "Informed to ensure transparency and the right to information"
  }, {
    "@value" : "Specific with respect to the means and purposes of processing"
  }, {
    "@value" : "Unequivocal, no doubt about the authorization granted by the holder"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Consent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Expression by which the owner of the personal data grants his/her authorization to the data controller to process such data."
  }, {
    "@language" : "es",
    "@value" : "Expression by which the owner of the personal data grants his/her authorization to the data controller to process such data."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "consent"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#consent_defects",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "They refer to situations in which the person does not fully understand what he/she is authorizing or when his/her consent is not truly free and voluntary."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Consent_defects"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "They refer to situations in which the person does not fully understand what he/she is authorizing or when his/her consent is not truly free and voluntary."
  }, {
    "@language" : "es",
    "@value" : "They refer to situations in which the person does not fully understand what he/she is authorizing or when his/her consent is not truly free and voluntary."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "consent defects"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#conservation",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "The conservation of personal data implies keeping them for a period that does not exceed the time necessary to fulfill the purpose for which they were initially collected and processed."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#extended_preservation_of_personal_data_processing" : [ {
    "@value" : "Archival purposes in the public interest, i.e., preservation of data for archival purposes that benefit the public interest, such as preserving the historical or administrative memory of a society."
  }, {
    "@value" : "Historical research purposes for the purpose of studying events, periods or aspects of the past to better understand history, the evolution of society, cultures or institutions over time."
  }, {
    "@value" : "Scientific research purposes, that is, when the processing of personal data is used for scientific studies that seek to generate knowledge, understand natural or social phenomena, validate theories or contribute to the advancement of a particular discipline."
  }, {
    "@value" : "Statistical research purposes with the objective of performing quantitative and qualitative analyses to understand patterns, trends and relationships in a specific population or phenomenon."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_establishing_the_deadlines_for_suspension_or_periodic_review_within_data_processing_is" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Conservation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The conservation of personal data implies keeping them for a period that does not exceed the time necessary to fulfill the purpose for which they were initially collected and processed."
  }, {
    "@language" : "es",
    "@value" : "The conservation of personal data implies keeping them for a period that does not exceed the time necessary to fulfill the purpose for which they were initially collected and processed."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "conservation"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#contact_data",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Correspondences with the DPV: is close to dpv:hasContact."
  }, {
    "@language" : "es",
    "@value" : "Correspondencias con el DPV: se parece a dpv:hasContact."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid702"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "contact data"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Delegate"
  } ],
  "http://www.w3.org/2004/02/skos/core#closeMatch" : [ {
    "@id" : "https://w3id.org/dpv#hasContact"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#control_functions",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Members_of_the_personal_data_protection_system"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "control functions"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Members_of_the_personal_data_protection_system"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#corrective_measures",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#before_dictating_corrective_measures" : [ {
    "@value" : "To have a competent technical report that allows correcting, reversing or eliminating conducts contrary to the Organic Law for the Protection of Personal Data and the regulations issued by the Authority for the Protection of Personal Data."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#cases_to_incur_in_corrective_measures" : [ {
    "@value" : "In the event that controllers, persons in charge of processing personal data and certification bodies and, if applicable, third parties, are involved in the alleged commission of a minor infringement and are included in the Unified Registry of non-compliant controllers and persons in charge of processing personal data."
  }, {
    "@value" : "In the event that controllers, persons in charge of the processing of personal data and certification bodies are involved in the alleged commission of a serious infringement"
  }, {
    "@value" : "In the event that controllers, persons in charge of the processing of personal data and certification bodies are involved in the alleged commission of a very serious infringement"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#for_minor_infractions" : [ {
    "@value" : "The Personal Data Protection Authority will directly activate the administrative sanctioning procedure, stating in the resolution both the applicable corrective measures and the sanction corresponding to the infraction committed."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#for_serious_infractions" : [ {
    "@value" : "The Data Protection Authority will initially apply corrective measures. If they are not adequately complied with, sanctions for serious infringements will be imposed through the administrative sanctioning procedure."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#for_very_serious_offenses" : [ {
    "@value" : "The Personal Data Protection Authority will directly activate the administrative sanctioning procedure, stating in the resolution both the applicable corrective measures and the sanction corresponding to the infraction committed."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#in_the_case_of_non-compliance_of" : [ {
    "@value" : "Diposiciones prevista en la Ley Orgnánica de Protección de Datos Personales"
  }, {
    "@value" : "Disobedience of the directives and guidelines issued by the Authority for the Protection of Personal Data."
  }, {
    "@value" : "Infringement of data owner's rights"
  }, {
    "@value" : "Violation of the fundamental principles related to the right to the protection of personal data."
  }, {
    "@value" : "Violation of the regulations established by the Personal Data Protection Authority."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#what_will_be_the_corrective_measures" : [ {
    "@value" : "Data deletion"
  }, {
    "@value" : "The cessation of treatment, under certain conditions or time limits"
  }, {
    "@value" : "The imposition of technical, legal, organizational or administrative measures to ensure proper processing of personal data"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#will_be_imposed_by" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Corrective_measures"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "corrective measures"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#count_with_the_following",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Owner"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "count with the following"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Owner"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#credit_data",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "Data that integrate the economic behavior of natural persons, to analyze their financial capacity."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Credit_data"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Data that integrate the economic behavior of natural persons, to analyze their financial capacity."
  }, {
    "@language" : "es",
    "@value" : "Data that integrate the economic behavior of natural persons, to analyze their financial capacity."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "credit data"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#credit_data_processing",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#allow_evaluate" : [ {
    "@value" : "The commercial conduct of the data subject"
  }, {
    "@value" : "The conclusion of business in general of the data subject."
  }, {
    "@value" : "The data subject's ability to pay"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#cannot_be_done_with_the_processing_of_credit_data" : [ {
    "@value" : "The following may not be communicated"
  }, {
    "@value" : "The following may not be disseminated"
  }, {
    "@value" : "They may not have a secondary purpose"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#credit_data_relative_with" : [ {
    "@value" : "Banking obligations"
  }, {
    "@value" : "Commercial obligations"
  }, {
    "@value" : "Financial obligations"
  }, {
    "@value" : "Obligaciones de carácter financiero"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#destined" : [ {
    "@value" : "For analysis purposes only"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#enforceable_obligation_for_credit_data" : [ {
    "@value" : "After five years have elapsed since the obligation has become due, the following may not be reported"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#for_information_about" : [ {
    "@value" : "Capital adequacy"
  }, {
    "@value" : "Creditworthiness"
  }, {
    "@value" : "Fulfillment of commercial obligations"
  }, {
    "@value" : "Fulfillment of credit obligations"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#sources_from_whence_the_credit_data_was_obtained" : [ {
    "@value" : "Public access sources"
  }, {
    "@value" : "Sources from information provided by the data owner"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Credit_data_processing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "credit data processing"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#credit_data_relative_with",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Credit_data_processing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "credit data relative with"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Credit_data_processing"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_base",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "A structured data set encompasses any form, mode of creation, storage, organization, type of medium, treatment, processing, location or access, whether centralized, decentralized or distributed functionally or geographically."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_base"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A structured data set encompasses any form, mode of creation, storage, organization, type of medium, treatment, processing, location or access, whether centralized, decentralized or distributed functionally or geographically."
  }, {
    "@language" : "es",
    "@value" : "A structured data set encompasses any form, mode of creation, storage, organization, type of medium, treatment, processing, location or access, whether centralized, decentralized or distributed functionally or geographically."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "data base"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_not_subject_to_processing_according_to_the_right_to_not_be_the_object_of_automated_decisions",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Sensitive_data"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "data not subject to processing according to the right to not be the object of automated decisions"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Sensitive_data"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_or_database_of_criminal_infractions",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#explanation_of_concept_of_inapplicability" : [ {
    "@value" : "Data or databases established for the prevention, investigation, detection or prosecution of criminal offenses or execution of criminal sanctions, carried out by the competent state agencies in compliance with their legal functions. In any of these cases, international human rights standards and the principles of this Law must be complied with, and at least the criteria of legality, proportionality and necessity must be met."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_or_database_of_criminal_infractions"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "data or database of criminal infractions"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_owner",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#cases_in_which_the_owner_should_be_informed" : [ {
    "@value" : "When the personal data is not obtained directly from the owner"
  }, {
    "@value" : "When the personal data were obtained from a source accessible to the public"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#control_functions" : [ {
    "@value" : "Person whose data is processed"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#count_with_the_following" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#rights"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#in_case_of_impugning_the_exaccuracy_of_data_a" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#in_case_of_no_direct_obtaining_by_the_owner" : [ {
    "@value" : "The holder shall be informed within thirty (30) days or at the time of the first communication with the holder."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#in_case_of_suspension_of_treatment_must_resort_to" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#in_cases_of_automated_evaluations" : [ {
    "@value" : "You may challenge automated decisions regarding the data subject's data before the data controller."
  }, {
    "@value" : "You may request from the controller a detailed and reasoned explanation of the decision taken regarding the processing of your personal data."
  }, {
    "@value" : "You may request from the data controller information on the types of data used and the source from which the data was obtained."
  }, {
    "@value" : "You may request the evaluation criteria on the automated program."
  }, {
    "@value" : "You may submit comments on the processing of your personal data."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#obtaining_personal_data_directly_by_the_owner" : [ {
    "@value" : "Information on how such data will be used must be provided to the data subject prior to collection, i.e., at the time the personal data is requested or collected from the data subject."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_of_person" : [ {
    "@value" : "Natural"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Owner"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "data owner"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processing",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#before_the_revocation_of_consent_is_considered_to_be_considered" : [ {
    "@value" : "It is considered lawful, i.e. even if the data subject decides to revoke his/her consent to data processing, this does not invalidate or invalidate the data processing that was lawfully carried out prior to the revocation of consent."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#conditions_for_legitimate_treatment" : [ {
    "@value" : "For processing of personal data contained in publicly accessible databases"
  }, {
    "@value" : "Personal data involved in data processing may be used prior to entering into a contract if requested by the data subject, or during the performance of a contract to fulfill the obligations of the data controller, a person designated to handle the data, or another legally authorized party."
  }, {
    "@value" : "Processing personal data to satisfy a legitimate interest of the data controller or a third party. However, this legitimate interest cannot prevail over the fundamental rights of the data subjects."
  }, {
    "@value" : "That it is carried out by the data controller in compliance with a legal obligation."
  }, {
    "@value" : "That the collection, storage, use or any other operation carried out with personal data is justified in the performance of a task in the public interest or in the exercise of public powers vested in the data controller."
  }, {
    "@value" : "To be carried out by the data controller, by court order"
  }, {
    "@value" : "To protect the vital interests of the data subject or of another natural person, such as life, health or integrity"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "Any action or set of actions performed on personal data, whether by means of fully automated, partially automated or non-automated technical processes. These actions include, but are not limited to: collecting, compiling, obtaining, recording, organizing, structuring, preserving, safeguarding, adapting, modifying, deleting, indexing, extracting, consulting, processing, using, possessing, exploiting, distributing, assigning, communicating, transferring or otherwise providing access to, collating, interconnecting, limiting, deleting, destroying and, in general, any use of personal data."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#determine_the_compatibility" : [ {
    "@value" : "Consideration should be given to the logical expectations that the data subject might have about the future use of his or her data, based on his or her relationship with the data controller"
  }, {
    "@value" : "It should be verified that there are sufficient safeguards both in the original processing and in the proposed new processing to protect the rights and privacy of data subjects."
  }, {
    "@value" : "The environment and circumstances in which the data were first obtained should be analyzed."
  }, {
    "@value" : "The information provided to the data subject during the initial collection process should be taken into account."
  }, {
    "@value" : "The potential impact of further processing of the data on data subjects should be analyzed"
  }, {
    "@value" : "The type of personal data collected and its sensitivity must be evaluated."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#for_different_purpose" : [ {
    "@value" : "If they are compatible with the purposes for which they were collected."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#has_as_the_basis_of" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legal_interest"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_based_on" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#principios"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#low_legitimate_interest" : [ {
    "@value" : "Only data that is strictly necessary to fulfill the purposes established in relation to the consent given and the intended processing may be processed."
  }, {
    "@value" : "The Data Protection Authority has the power to request a risk report from the data controller to assess possible threats to the legitimate expectations of data subjects and their fundamental rights."
  }, {
    "@value" : "The data controller must ensure that the data processing is transparent to the data subject."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#territorial_application_scenario" : [ {
    "@value" : "The processing of personal data is carried out in any part of the national territory."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_processing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Any action or set of actions performed on personal data, whether by means of fully automated, partially automated or non-automated technical processes. These actions include, but are not limited to: collecting, compiling, obtaining, recording, organizing, structuring, preserving, safeguarding, adapting, modifying, deleting, indexing, extracting, consulting, processing, using, possessing, exploiting, distributing, assigning, communicating, transferring or otherwise providing access to, collating, interconnecting, limiting, deleting, destroying and, in general, any use of personal data."
  }, {
    "@language" : "es",
    "@value" : "Any action or set of actions performed on personal data, whether by means of fully automated, partially automated or non-automated technical processes. These actions include, but are not limited to: collecting, compiling, obtaining, recording, organizing, structuring, preserving, safeguarding, adapting, modifying, deleting, indexing, extracting, consulting, processing, using, possessing, exploiting, distributing, assigning, communicating, transferring or otherwise providing access to, collating, interconnecting, limiting, deleting, destroying and, in general, any use of personal data."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "data processing"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processing_is_intended_for_individuals",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Profile_making"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "data processing is intended for individuals"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Profile_making"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processor",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#control_functions" : [ {
    "@value" : "Processor of personal data on behalf of and for the account of a controller of personal data"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#delegate_comments" : [ {
    "@value" : "Ensure that the involvement of the personal data protection officer, in all matters relating to personal data protection, is appropriate and timely."
  }, {
    "@value" : "Ensure that the personal data protection officer establishes direct communication with the highest executive and decision-making levels of the data processor."
  }, {
    "@value" : "Facilitate access to the personal data of the processing operations, as well as all the resources and elements necessary to guarantee the correct and free performance of its functions."
  }, {
    "@value" : "They may not dismiss or sanction the personal data protection officer for the proper performance of his or her duties."
  }, {
    "@value" : "Train and update the personal data protection officer on the subject, in accordance with the technical regulations issued by the Personal Data Protection Authority."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_related_to" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#delegate"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minor_infractions" : [ {
    "@value" : "Failure to allow or cooperate with audits or inspections carried out by the data controller or other auditor authorized by the Personal Data Protection Authority"
  }, {
    "@value" : "Failure to comply with the corrective measures ordered by the Personal Data Protection Authority."
  }, {
    "@value" : "Failure to cooperate with the data controller to enable the data controller to respond adequately to requests from data subjects"
  }, {
    "@value" : "Failure to provide the data controller with all the information necessary to comply with the obligations established by the Organic Law on Personal Data Protection and the corresponding regulations."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#nature_of_the_entity" : [ {
    "@value" : "Public or Private"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#obligations" : [ {
    "@value" : "Allowing audits and inspections by accredited auditors"
  }, {
    "@value" : "Comply with any other obligation established by applicable regulations or other Ecuadorian laws."
  }, {
    "@value" : "Conduct security adequacy assessments prior to the processing of personal data."
  }, {
    "@value" : "Designate a Data Protection Officer when necessary."
  }, {
    "@value" : "Develop customized data protection policies"
  }, {
    "@value" : "Ensure that data processors comply with regulations and best practices."
  }, {
    "@value" : "Establish confidentiality agreements with personnel and data controllers."
  }, {
    "@value" : "Implement administrative, technical and legal measures to guarantee the proper treatment of data"
  }, {
    "@value" : "Maintain the National Registry of Personal Data Protection up to date."
  }, {
    "@value" : "Notifying the Personal Data Protection Authority and the data owner of violations of the security measures implemented for the processing of personal data in accordance with the procedure established for this purpose."
  }, {
    "@value" : "Periodically evaluate the effectiveness of the administrative, technical and legal measures adopted."
  }, {
    "@value" : "Take the necessary technological, physical, administrative, organizational and legal measures to prevent, deter, reduce, mitigate and control identified risks and breaches."
  }, {
    "@value" : "Treat personal data in accordance with the Organic Law on Personal Data Protection and relevant regulations."
  }, {
    "@value" : "Use risk analysis and management methodologies adapted to the particularities of data processing and the parties involved."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#serious_infractions" : [ {
    "@value" : "Failure to comply with corrective measures or partial or defective compliance with them, provided that a sanction for a minor infraction has been applied beforehand for this reason."
  }, {
    "@value" : "Failure to implement mechanisms designed to maintain the confidentiality, integrity, availability and resilience of personal data"
  }, {
    "@value" : "Failure to implement preventive and corrective measures in the security of personal data in order to avoid violations."
  }, {
    "@value" : "Failure to notify the data controller of any breach of security of personal data in accordance with the Organic Law on Personal Data Protection or with unjustified delay."
  }, {
    "@value" : "Failure to process personal data in accordance with the provisions of the contract with the data controller"
  }, {
    "@value" : "Failure to sign contracts containing confidentiality and appropriate treatment of personal data clauses with the personnel in charge of the treatment of personal data or whoever has knowledge of the personal data."
  }, {
    "@value" : "Not to delete the personal data transferred or communicated to the person in charge of the processing of personal data, once its assignment has been completed."
  }, {
    "@value" : "Processing personal data without respecting the principles and rights established in the Organic Law for the Protection of Personal Data, its regulations and the rules issued by the Authority for the Protection of Personal Data."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_authority" : [ {
    "@value" : "Public"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_of_organism_participation" : [ {
    "@value" : "Alone or together with others"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#type_of_person" : [ {
    "@value" : "Natural or Legal"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Processor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "data processor"
  } ]
