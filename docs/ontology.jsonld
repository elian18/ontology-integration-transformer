}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#anonymization",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "The implementation of measures to prevent the identification or re-identification of a natural person shall be carried out without incurring disproportionate efforts. This implies that privacy-preserving actions shall be taken without requiring excessive resources, time or effort that are not justified by the benefits or purpose pursued."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Anonymization"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The implementation of measures to prevent the identification or re-identification of a natural person shall be carried out without incurring disproportionate efforts. This implies that privacy-preserving actions shall be taken without requiring excessive resources, time or effort that are not justified by the benefits or purpose pursued."
  }, {
    "@language" : "es",
    "@value" : "The implementation of measures to prevent the identification or re-identification of a natural person shall be carried out without incurring disproportionate efforts. This implies that privacy-preserving actions shall be taken without requiring excessive resources, time or effort that are not justified by the benefits or purpose pursued."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "anonymization"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#anonymized_data",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#explanation_of_concept_of_inapplicability" : [ {
    "@value" : "As soon as the data is no longer anonymized or anonymized, its processing will be subject to compliance with the obligations of this Law, especially the obligation to have a lawful basis for continuing to process the data in a non-anonymized or non-anonymized manner."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Anonymized_data"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "anonymized data"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#answer_the_claim",
