}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#health_related_data",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "Personal data relating to the physical or mental health of an individual, including the provision of health care services, which reveal information about his or her health status"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Health_Related_Data"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Personal data relating to the physical or mental health of an individual, including the provision of health care services, which reveal information about his or her health status"
  }, {
    "@language" : "es",
    "@value" : "Personal data relating to the physical or mental health of an individual, including the provision of health care services, which reveal information about his or her health status"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "health related data"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#health_related_data_processing",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#application_scenarios_for_processing_of_data_without_consent" : [ {
    "@value" : "Treatment is necessary for reasons of public interest in the field of public health, such as in situations of serious health threats that transcend borders."
  }, {
    "@value" : "Treatment is necessary to ensure high standards of quality and safety in medical care, medicines or medical devices."
  }, {
    "@value" : "When the data processing is related to preventive medicine, the assessment of work capacity, medical diagnosis, the provision of medical or social assistance, or the management of health and social services."
  }, {
    "@value" : "When treatment is vital to protect the patient's life and the patient is unable to give consent due to physical or legal status"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#health-related_data_collection_and_processing" : [ {
    "@value" : "The institutions that make up the National Health System and health professionals may collect and process data related to the health of their patients who are or have been under treatment by those institutions."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#in_respect_to_the" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#consent"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#purposes_of_the_processing_of_data_by_private_and_public_entities" : [ {
    "@value" : "Scientific research purposes"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#scenarios_for_treatment_by_private_and_public_entities" : [ {
    "@value" : "Provided that the data processing is authorized by the Personal Data Protection Authority."
  }, {
    "@value" : "Provided that the data used for the research are anonymized."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#shall_be_authorized_by" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#supervise_treatment_in_health_service_management_activities" : [ {
    "@value" : "Data processing in activities related to the management of health and social services may only be carried out by professionals subject to the duty of professional secrecy or under their supervision."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Health_related_data_processing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "health related data processing"
  } ]
