  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#collection",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "Refers to the process of acquiring and obtaining data from various sources, such as sensors, databases, online forms, historical records, among others."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#is_related_to" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#consent"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#need_of" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#consent"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Collection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Refers to the process of acquiring and obtaining data from various sources, such as sensors, databases, online forms, historical records, among others."
  }, {
    "@language" : "es",
    "@value" : "Refers to the process of acquiring and obtaining data from various sources, such as sensors, databases, online forms, historical records, among others."
  } ],
