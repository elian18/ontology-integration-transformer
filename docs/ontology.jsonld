}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#known_as",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_protection_authority"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "known as"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_protection_authority"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legal_interest",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "Legal justification for the processing of personal data that is not directly related to the individual's consent, compliance with a legal obligation or the performance of a contract."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Legal_interest"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Legal justification for the processing of personal data that is not directly related to the individual's consent, compliance with a legal obligation or the performance of a contract."
  }, {
    "@language" : "es",
    "@value" : "Legal justification for the processing of personal data that is not directly related to the individual's consent, compliance with a legal obligation or the performance of a contract."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "legal interest"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legal_persons_data",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#explanation_of_concept_of_inapplicability" : [ {
    "@value" : "Data that identifies or makes identifiable legal entities"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#information_suceptible_to_treatment_is_accessible" : [ {
    "@value" : "Public"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#treatment_suceptible_information" : [ {
    "@value" : "In the case of public servants, the historical and updated information of their asset declaration and remuneration shall be submitted for processing."
  }, {
    "@value" : "Personal data concerning the contact of professionals and commercial data"
  }, {
    "@value" : "Representatives, partners and shareholders of legal entities, as well as public servants, may be subject to the processing of personal data in the context of their professional practice, line of business, competencies, powers, attributions or positions. This processing refers specifically to information such as names and surnames, functions or positions held, postal or e-mail addresses and professional telephone numbers."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Legal_persons_data"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "legal persons data"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legal_representative_owner",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#activity_of_the_legal_representative_owner" : [ {
    "@value" : "Ensure that the rights and privacy of the owner he/she represents are respected at all times."
  }, {
    "@value" : "Make informed decisions about the processing of the personal data of the owner he/she represents."
  }, {
    "@value" : "Provide consent for the processing of data on behalf of the data subject he/she represents."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "The legal representative of an owner who is unable to give consent acts on behalf of and in the interest of the owner in situations where the owner is unable to give consent due to incapacity, minority or other similar circumstances."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Legal_representative_owner"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The legal representative of an owner who is unable to give consent acts on behalf of and in the interest of the owner in situations where the owner is unable to give consent due to incapacity, minority or other similar circumstances."
  }, {
    "@language" : "es",
    "@value" : "The legal representative of an owner who is unable to give consent acts on behalf of and in the interest of the owner in situations where the owner is unable to give consent due to incapacity, minority or other similar circumstances."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "legal representative owner"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legality",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "Data processing must be carried out in accordance with the Organic Law on Personal Data Protection."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Legality"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Data processing must be carried out in accordance with the Organic Law on Personal Data Protection."
  }, {
    "@language" : "es",
    "@value" : "Data processing must be carried out in accordance with the Organic Law on Personal Data Protection."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "legality"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#limitation_on_exercise_of_rights_by_secondary_laws",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "limitation on exercise of rights by secondary laws"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#location_of_the_personal_data_protection_system_members",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#territorial_application_scenario" : [ {
    "@value" : "If the controller or processor of personal data is not domiciled in the national territory, the Organic Law on Personal Data Protection may apply due to a specific contract or public international law regulations. In other words, even if the controller or processor does not reside in Ecuador, they may be subject to comply with the country's data protection law due to contractual agreements or international regulations."
  }, {
    "@value" : "If the data subject resides in Ecuador and the controller or processor has no establishment in the country, and the data processing is linked to activities that include the offer of goods or services to data subjects, whether or not it involves payment, or is intended to monitor their behavior, provided that such monitoring is carried out within Ecuadorian territory."
  }, {
    "@value" : "If the person in charge of or responsible for the processing of personal data is domiciled in any part of national territory"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Location_of_the_personal_data_protection_system_integrants"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "location of the personal data protection system members"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#low_legitimate_interest",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_processing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "low legitimate interest"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_processing"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#loyalty",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "The data subject should clearly know that they are collecting, using or processing your personal data, and how it will be treated."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Loyalty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The data subject should clearly know that they are collecting, using or processing your personal data, and how it will be treated."
  }, {
    "@language" : "es",
    "@value" : "The data subject should clearly know that they are collecting, using or processing your personal data, and how it will be treated."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "loyalty"
  } ]
