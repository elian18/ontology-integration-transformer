  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "Las instituciones legales pueden hacer uso de los datos del titular en procesos de investigación sin el consentimiento de este último."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Legal_institutions_detail" : [ {
    "@value" : "In the event that a legal institution requests legal action on the data in an international transfer, it may do so."
  } ],
