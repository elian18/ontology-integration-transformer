  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Correspondences with the DPV: is related to dpv:hasRight."
  }, {
    "@language" : "es",
    "@value" : "Correspondencias con el DPV: está relacionado con dpv:hasRight."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Rights_in_verification"
  } ],
