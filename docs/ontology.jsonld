  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Incidente de seguridad que afecta la confidencialidad, disponibilidad o integridad de los datos personales."
  } ],
  "http://www.w3.org/2004/02/skos/core#relatedMatch" : [ {
    "@id" : "https://w3id.org/dpv#DataBreachRecord"
  } ]
