    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minor_infractions_penalties"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#penalties_for_Serious_Infringements"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#will_be_imposed_by" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Sanctions"
  } ],
