  }, {
    "@language" : "es",
    "@value" : "Correspondencias con el DPV: es igual a dpv:ConfidentialityAgreement. Puente con el GDPR: se parece a gdprtext:ImposeConfidentialityObligationOnPersonnel (por dpv:ConfidentialityAgreement)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
