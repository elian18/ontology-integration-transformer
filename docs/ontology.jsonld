}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#special_personal_data_categories",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "Refers to sensitive information that requires additional protection due to its sensitive or potentially damaging nature if misused."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#special_categories_of_personal_data_are_composed_of" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_under_17_years_old"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#disabled_owner_data"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#health_related_data"
  }, {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#sensitive_data"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Special_personal_data_categories"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Refers to sensitive information that requires additional protection due to its sensitive or potentially damaging nature if misused."
  }, {
    "@language" : "es",
    "@value" : "Refers to sensitive information that requires additional protection due to its sensitive or potentially damaging nature if misused."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "special personal data categories"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#specialized_subject_data",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#description" : [ {
    "@value" : "Data subject to specific regulations established by other Ecuadorian or foreign laws."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#regulated_treatment_in_specialized_regulations_regarding" : [ {
    "@value" : "Datos en materia de desastres naturales, es decir, eventos catastróficos causados por fenómenos naturales como terremotos, huracanes, inundaciones, incendios forestales, entre otros, que pueden causar daños significativos a la vida, la propiedad y el medio ambiente"
  }, {
    "@value" : "Datos en materia de sectores regulados, es decir, áreas de actividad que están sujetas a regulaciones detalladas y específicas establecidas por leyes o normativas sectoriales ecuatoriana"
  }, {
    "@value" : "Freedom of expression data, i.e. the fundamental right of individuals to express their opinions, ideas and thoughts without censorship or repression by the State or other entities"
  }, {
    "@value" : "National security and state defense data, i.e. activities and policies aimed at protecting the territorial integrity, sovereignty and national interests of a country against internal and external threats, including acts of terrorism, espionage and military aggression."
  }, {
    "@value" : "Personal data provided to administrative or judicial authorities, i.e. personal data that must be provided to government authorities, whether administrative (e.g. government agencies) or judicial (e.g. courts), in compliance with lawful requests supported by law and in the exercise of their lawful powers."
  }, {
    "@value" : "Risk management data, i.e., processes and practices used to identify, assess and mitigate potential risks faced by organizations in their business activities or service delivery."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#shall_at_least_comply_with_the_minimum_with" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minimum_criteria"
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#will_be_subject_to" : [ {
    "@value" : "If necessary, compliance with international human rights standards shall be ensured."
  }, {
    "@value" : "Principles established in specialized regulations"
  }, {
    "@value" : "Principles of the Organic Law for the Protection of Personal Data"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Specialized_subject_data"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Data subject to specific regulations established by other Ecuadorian or foreign laws."
  }, {
    "@language" : "es",
    "@value" : "Data subject to specific regulations established by other Ecuadorian or foreign laws."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "specialized subject data"
  } ]
