}, {
  "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#public_sector001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Accidental_or_illegal_destruction_or_communication" : [ {
    "@value" : "The public sector is subject to accidental destruction or disclosure of its data."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Alterations" : [ {
    "@value" : "The public sector is subject to alterations in its data."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#General_detail" : [ {
    "@value" : "These are security actions to be considered in the public sector."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Loss" : [ {
    "@value" : "The public sector is subject to a loss in its data"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Risk" : [ {
    "@value" : "The public sector is subject to data risk."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Secrecy_of_communications" : [ {
    "@value" : "The public sector is subject to secrecy of communications in its data."
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Threat" : [ {
    "@value" : "The public sector is subject to a threat to its data"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Vulnerabilidad" : [ {
    "@value" : "Public sector is subject to data vulnerabilities"
  } ],
  "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#account_with_actions_as" : [ {
    "@id" : "http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#public_sector001"
  } ],
