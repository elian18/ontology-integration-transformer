    "@value" : "LOPDP, art. 1"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Correspondences with the DPV: is related to dpv:SensitivePersonalData."
  }, {
    "@language" : "es",
    "@value" : "Correspondencias con el DPV: está relacionado con dpv:SensitivePersonalData."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "protección de datos personales"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Derecho que incluye el acceso y decisión sobre información y datos de carácter personal."
  } ],
  "http://www.w3.org/2004/02/skos/core#relatedMatch" : [ {
    "@id" : "https://w3id.org/dpv#SensitivePersonalData"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/profiles/ecuador-lopdp#PrivacyByDefault",
