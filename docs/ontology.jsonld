  "@id" : "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#family_or_domestic_activities",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#explanation_of_concept_of_inapplicability" : [ {
    "@value" : "Refers to those actions related to family and family relationships. In this context, the use of personal data could be associated with family matters, exchange of information between family members or other activities that take place within the family environment."
  } ],
  "http://www.semanticweb.org/ley-organica-proteccion-datos-personales#in_case_of_processing_it_must_be_compliant_with" : [ {
