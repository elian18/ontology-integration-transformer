  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Correspondences with the DPV: is a kind of dpv:LegalCompliance; is broader than dpv:ContractualTerms; is related to dpv:FulfilmentOfContractualObligation."
  }, {
    "@language" : "es",
    "@value" : "Correspondencias con el DPV: es un tipo de dpv:LegalCompliance; es más general que dpv:ContractualTerms; está relacionado con dpv:FulfilmentOfContractualObligation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
