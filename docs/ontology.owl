    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Follow-up_from_design -->


    <owl:Class rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Follow-up_from_design">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_data_security"/>
        <terms:source xml:lang="es">LOPDP, art. 39</terms:source>
        <terms:source xml:lang="es">LOPDP, art. 47</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is close to dpv:PrivacyByDesign. Bridge with the GDPR: is close to gdprtext:DataProtectionByDesignAndByDefault (through dpv:PrivacyByDesign); is close to gdprtext:PrivacyByDesign (through dpv:PrivacyByDesign).</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: se parece a dpv:PrivacyByDesign. Puente con el GDPR: se parece a gdprtext:DataProtectionByDesignAndByDefault (por dpv:PrivacyByDesign); se parece a gdprtext:PrivacyByDesign (por dpv:PrivacyByDesign).</rdfs:comment>
        <rdfs:label>Follow up from design</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#DataProtectionByDesignAndByDefault"/>
        <skos:closeMatch rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#PrivacyByDesign"/>
        <skos:closeMatch rdf:resource="https://w3id.org/dpv#PrivacyByDesign"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Follow-up_from_design"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
        <owl:annotatedTarget rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#DataProtectionByDesignAndByDefault"/>
        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#PrivacyByDesign"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv Follow-up_from_design closeMatch dpv:PrivacyByDesign y GDPRtEXT DataProtectionByDesignAndByDefault exactMatch dpv:PrivacyByDesign.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Follow-up_from_design"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
        <owl:annotatedTarget rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#PrivacyByDesign"/>
        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#PrivacyByDesign"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv Follow-up_from_design closeMatch dpv:PrivacyByDesign y GDPRtEXT PrivacyByDesign closeMatch dpv:PrivacyByDesign.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Governmental_information_security_mechanism -->


