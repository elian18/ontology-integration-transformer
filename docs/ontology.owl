    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Controller">
        <terms:source xml:lang="es">LOPDP, art. 17</terms:source>
        <terms:source xml:lang="es">LOPDP, art. 33</terms:source>
        <terms:source xml:lang="es">LOPDP, art. 4</terms:source>
        <terms:source xml:lang="es">LOPDP, art. 41</terms:source>
        <terms:source xml:lang="es">LOPDP, art. 49</terms:source>
        <terms:source xml:lang="es">LOPDP, art. 57</terms:source>
        <terms:source xml:lang="es">LOPDP, art. 67</terms:source>
        <terms:source xml:lang="es">LOPDP, art. 9</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is the same as dpv:DataController. Bridge with the GDPR: is close to gdprtext:Controller (through dpv:DataController).</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es igual a dpv:DataController. Puente con el GDPR: se parece a gdprtext:Controller (por dpv:DataController).</rdfs:comment>
        <rdfs:label>Data Controller</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#Controller"/>
