    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_data_security -->


    <owl:Class rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_data_security">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Organic_Law_on_Personal_Data_Protection"/>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is close to dpv:DataSecurityManagement. Bridge with the GDPR: is close to gdprtext:SecurityOfPersonalData (through dpv:DataSecurityManagement).</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: se parece a dpv:DataSecurityManagement. Puente con el GDPR: se parece a gdprtext:SecurityOfPersonalData (por dpv:DataSecurityManagement).</rdfs:comment>
        <rdfs:label>Personal data security</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#SecurityOfPersonalData"/>
        <skos:closeMatch rdf:resource="https://w3id.org/dpv#DataSecurityManagement"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_data_security"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
        <owl:annotatedTarget rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#SecurityOfPersonalData"/>
        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#DataSecurityManagement"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv Personal_data_security closeMatch dpv:DataSecurityManagement y GDPRtEXT SecurityOfPersonalData closeMatch dpv:DataSecurityManagement.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Axiom>
    


