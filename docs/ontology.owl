    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights">
        <terms:source xml:lang="es">LOPDP, art. 57</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is close to dpv:DataSubjectRight. Bridge with the GDPR: is close to gdprtext:Rights (through dpv:DataSubjectRight).</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: se parece a dpv:DataSubjectRight. Puente con el GDPR: se parece a gdprtext:Rights (por dpv:DataSubjectRight).</rdfs:comment>
        <rdfs:label>Rights</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#Rights"/>
        <skos:closeMatch rdf:resource="https://w3id.org/dpv#DataSubjectRight"/>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
        <owl:annotatedTarget rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#Rights"/>
        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#DataSubjectRight"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv Rights closeMatch dpv:DataSubjectRight y GDPRtEXT Rights closeMatch dpv:DataSubjectRight.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Axiom>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights_of_credit_data_owners">
        <terms:source xml:lang="es">LOPDP, art. 29</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is a kind of dpv:DataSubjectRight.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es un tipo de dpv:DataSubjectRight.</rdfs:comment>
        <rdfs:label>Rights of credit data owners</rdfs:label>
        <skos:broadMatch rdf:resource="https://w3id.org/dpv#DataSubjectRight"/>
