        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#PublicInterest"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv Public_interest closeMatch dpv:PublicInterest y GDPRtEXT PublicInterest closeMatch dpv:PublicInterest.</rdfs:comment>
