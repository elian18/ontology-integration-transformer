        <rdfs:comment xml:lang="en">Correspondences with the DPV: is close to dpv:Collect.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: se parece a dpv:Collect.</rdfs:comment>
        <rdfs:label>Collection</rdfs:label>
