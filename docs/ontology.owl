    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Legal_interest -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Legal_interest">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Terminology"/>
        <terms:source xml:lang="es">LOPDP, art. 9</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is the same as dpv:LegitimateInterest. Bridge with the GDPR: is close to gdprtext:LegitimateInterest (through dpv:LegitimateInterest).</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es igual a dpv:LegitimateInterest. Puente con el GDPR: se parece a gdprtext:LegitimateInterest (por dpv:LegitimateInterest).</rdfs:comment>
        <rdfs:label>Legal interest</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#LegitimateInterest"/>
        <skos:exactMatch rdf:resource="https://w3id.org/dpv#LegitimateInterest"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Legal_interest"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
        <owl:annotatedTarget rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#LegitimateInterest"/>
        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#LegitimateInterest"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv Legal_interest exactMatch dpv:LegitimateInterest y GDPRtEXT LegitimateInterest exactMatch dpv:LegitimateInterest.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Axiom>
    


