    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Inapplicability">
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is related to dpv:Applicability.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: está relacionado con dpv:Applicability.</rdfs:comment>
        <rdfs:label>Inapplicability</rdfs:label>
        <skos:relatedMatch rdf:resource="https://w3id.org/dpv#Applicability"/>
