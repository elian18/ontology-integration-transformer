        <rdfs:label>Minimum criteria</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Organic_Law_on_Personal_Data_Protection">
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is a kind of dpv:Law.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es un tipo de dpv:Law.</rdfs:comment>
        <rdfs:label>Organic Law on Personal Data Protection</rdfs:label>
        <skos:broadMatch rdf:resource="https://w3id.org/dpv#Law"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data">
        <terms:source xml:lang="es">LOPDP, art. 4</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is the same as dpv:PersonalData. Bridge with the GDPR: is close to gdprtext:PersonalData (through dpv:PersonalData).</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es igual a dpv:PersonalData. Puente con el GDPR: se parece a gdprtext:PersonalData (por dpv:PersonalData).</rdfs:comment>
        <rdfs:label>Personal data</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#PersonalData"/>
        <skos:exactMatch rdf:resource="https://w3id.org/dpv#PersonalData"/>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
        <owl:annotatedTarget rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#PersonalData"/>
        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#PersonalData"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv Personal_data exactMatch dpv:PersonalData y GDPRtEXT PersonalData exactMatch dpv:PersonalData.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Axiom>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_protection_authority">
        <terms:source xml:lang="es">LOPDP, art. 4</terms:source>
        <terms:source xml:lang="es">LOPDP, art. 41</terms:source>
        <terms:source xml:lang="es">LOPDP, art. 49</terms:source>
        <terms:source xml:lang="es">LOPDP, art. 57</terms:source>
        <terms:source xml:lang="es">LOPDP, art. 65</terms:source>
        <terms:source xml:lang="es">LOPDP, art. 76</terms:source>
        <terms:source xml:lang="es">LOPDP, art. 77</terms:source>
        <terms:source xml:lang="es">LOPDP, art. 9</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is the same as dpv:DataProtectionAuthority. Bridge with the GDPR: is close to gdprtext:RegulatoryAuthority (through dpv:DataProtectionAuthority).</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es igual a dpv:DataProtectionAuthority. Puente con el GDPR: se parece a gdprtext:RegulatoryAuthority (por dpv:DataProtectionAuthority).</rdfs:comment>
        <rdfs:label>Personal data protection authority</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#RegulatoryAuthority"/>
        <skos:exactMatch rdf:resource="https://w3id.org/dpv#DataProtectionAuthority"/>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_protection_authority"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
        <owl:annotatedTarget rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#RegulatoryAuthority"/>
        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#DataProtectionAuthority"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv Personal_data_protection_authority exactMatch dpv:DataProtectionAuthority y GDPRtEXT RegulatoryAuthority exactMatch dpv:DataProtectionAuthority.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Axiom>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_protection_seals">
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is close to dpv:CertificationSeal. Bridge with the GDPR: is close to gdprtext:SealsAndCertification (through dpv:CertificationSeal).</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: se parece a dpv:CertificationSeal. Puente con el GDPR: se parece a gdprtext:SealsAndCertification (por dpv:CertificationSeal).</rdfs:comment>
        <rdfs:label>Personal data protection seals</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#SealsAndCertification"/>
        <skos:closeMatch rdf:resource="https://w3id.org/dpv#CertificationSeal"/>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_protection_seals"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
        <owl:annotatedTarget rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#SealsAndCertification"/>
        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#CertificationSeal"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv Personal_data_protection_seals closeMatch dpv:CertificationSeal y GDPRtEXT SealsAndCertification exactMatch dpv:CertificationSeal.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Axiom>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_security_vulnerability">
        <rdfs:label>Personal data security vulnerability</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Principles">
        <terms:source xml:lang="es">LOPDP, art. 57</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is a kind of dpv:Principle.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es un tipo de dpv:Principle.</rdfs:comment>
        <rdfs:label>Principles</rdfs:label>
        <skos:broadMatch rdf:resource="https://w3id.org/dpv#Principle"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Proactive_and_demonstrated_accountability">
        <terms:source xml:lang="es">LOPDP, art. 10</terms:source>
        <rdfs:label>Proactive and demonstrated accountability</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Processing">
        <terms:source xml:lang="es">LOPDP, art. 4</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is the same as dpv:Processing. Bridge with the GDPR: is close to gdprtext:AutomatedProcessing (through dpv:Processing); is close to gdprtext:Processing (through dpv:Processing).</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es igual a dpv:Processing. Puente con el GDPR: se parece a gdprtext:AutomatedProcessing (por dpv:Processing); se parece a gdprtext:Processing (por dpv:Processing).</rdfs:comment>
        <rdfs:label>Processing</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#AutomatedProcessing"/>
        <skos:closeMatch rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#Processing"/>
        <skos:exactMatch rdf:resource="https://w3id.org/dpv#Processing"/>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Processing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
        <owl:annotatedTarget rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#AutomatedProcessing"/>
        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#Processing"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv Processing exactMatch dpv:Processing y GDPRtEXT AutomatedProcessing exactMatch dpv:Processing.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Processing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
        <owl:annotatedTarget rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#Processing"/>
        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#Processing"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv Processing exactMatch dpv:Processing y GDPRtEXT Processing exactMatch dpv:Processing.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Axiom>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Profile_making">
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is the same as dpv:Profiling.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es igual a dpv:Profiling.</rdfs:comment>
        <rdfs:label>Profile making</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/dpv#Profiling"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Purpose">
        <terms:source xml:lang="es">LOPDP, art. 10</terms:source>
        <rdfs:comment xml:lang="en">Personal data may not be processed for purposes other than those established at the time of collection, unless the conditions permitting further processing as set forth in the Organic Law on the Protection of Personal Data are met. Correspondences with the DPV: is related to dpv:Purpose.</rdfs:comment>
        <rdfs:comment xml:lang="es">Personal data may not be processed for purposes other than those established at the time of collection, unless the conditions permitting further processing as set forth in the Organic Law on the Protection of Personal Data are met. Correspondencias con el DPV: está relacionado con dpv:Purpose.</rdfs:comment>
        <rdfs:label>Purpose</rdfs:label>
        <skos:relatedMatch rdf:resource="https://w3id.org/dpv#Purpose"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Quality">
        <terms:source xml:lang="es">LOPDP, art. 10</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is related to dpv:DataQualityManagement.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: está relacionado con dpv:DataQualityManagement.</rdfs:comment>
        <rdfs:label>Quality</rdfs:label>
        <skos:relatedMatch rdf:resource="https://w3id.org/dpv#DataQualityManagement"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Recall_mechanisms">
        <rdfs:label>Recall mechanisms</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Revocation_of_consent">
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is close to dpv:WithdrawConsent. Bridge with the GDPR: is close to gdprtext:CanBeWithdrawnEasilyConsentObligation (through dpv:WithdrawConsent); is close to gdprtext:WithdrawingConsent (through dpv:WithdrawConsent).</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: se parece a dpv:WithdrawConsent. Puente con el GDPR: se parece a gdprtext:CanBeWithdrawnEasilyConsentObligation (por dpv:WithdrawConsent); se parece a gdprtext:WithdrawingConsent (por dpv:WithdrawConsent).</rdfs:comment>
        <rdfs:label>Revocation of consent</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#CanBeWithdrawnEasilyConsentObligation"/>
        <skos:closeMatch rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#WithdrawingConsent"/>
        <skos:closeMatch rdf:resource="https://w3id.org/dpv#WithdrawConsent"/>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Revocation_of_consent"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
        <owl:annotatedTarget rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#CanBeWithdrawnEasilyConsentObligation"/>
        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#WithdrawConsent"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv Revocation_of_consent closeMatch dpv:WithdrawConsent y GDPRtEXT CanBeWithdrawnEasilyConsentObligation closeMatch dpv:WithdrawConsent.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Revocation_of_consent"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
        <owl:annotatedTarget rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#WithdrawingConsent"/>
        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#WithdrawConsent"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv Revocation_of_consent closeMatch dpv:WithdrawConsent y GDPRtEXT WithdrawingConsent closeMatch dpv:WithdrawConsent.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Axiom>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_not_to_be_object_to_automated_evaluations">
        <terms:source xml:lang="es">LOPDP, art. 20</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is a kind of dpv:DataSubjectRight; is related to dpv:AutomatedDecisionMaking.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es un tipo de dpv:DataSubjectRight; está relacionado con dpv:AutomatedDecisionMaking.</rdfs:comment>
        <rdfs:label>Right not to be object to automated evaluations</rdfs:label>
        <skos:broadMatch rdf:resource="https://w3id.org/dpv#DataSubjectRight"/>
        <skos:relatedMatch rdf:resource="https://w3id.org/dpv#AutomatedDecisionMaking"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_of_deletion">
        <terms:source xml:lang="es">LOPDP, art. 15</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is a kind of dpv:DataSubjectRight; is related to dpv:StorageDeletion.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es un tipo de dpv:DataSubjectRight; está relacionado con dpv:StorageDeletion.</rdfs:comment>
        <rdfs:label>Right of deletion</rdfs:label>
        <skos:broadMatch rdf:resource="https://w3id.org/dpv#DataSubjectRight"/>
        <skos:relatedMatch rdf:resource="https://w3id.org/dpv#StorageDeletion"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_of_opposition">
        <terms:source xml:lang="es">LOPDP, art. 16</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is a kind of dpv:DataSubjectRight.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es un tipo de dpv:DataSubjectRight.</rdfs:comment>
        <rdfs:label>Right of opposition</rdfs:label>
        <skos:broadMatch rdf:resource="https://w3id.org/dpv#DataSubjectRight"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_consult">
        <terms:source xml:lang="es">LOPDP, art. 22</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is a kind of dpv:DataSubjectRight; is related to dpv:Consult.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es un tipo de dpv:DataSubjectRight; está relacionado con dpv:Consult.</rdfs:comment>
        <rdfs:label>Right to consult</rdfs:label>
        <skos:broadMatch rdf:resource="https://w3id.org/dpv#DataSubjectRight"/>
        <skos:relatedMatch rdf:resource="https://w3id.org/dpv#Consult"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_digital_education">
        <terms:source xml:lang="es">LOPDP, art. 23</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is a kind of dpv:DataSubjectRight; is related to dpv:DigitalLiteracy.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es un tipo de dpv:DataSubjectRight; está relacionado con dpv:DigitalLiteracy.</rdfs:comment>
        <rdfs:label>Right to digital education</rdfs:label>
        <skos:broadMatch rdf:resource="https://w3id.org/dpv#DataSubjectRight"/>
        <skos:relatedMatch rdf:resource="https://w3id.org/dpv#DigitalLiteracy"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_information">
        <terms:source xml:lang="es">LOPDP, art. 12</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is a kind of dpv:DataSubjectRight; is related to dpv:RightNotice.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es un tipo de dpv:DataSubjectRight; está relacionado con dpv:RightNotice.</rdfs:comment>
        <rdfs:label>Right to information</rdfs:label>
        <skos:broadMatch rdf:resource="https://w3id.org/dpv#DataSubjectRight"/>
        <skos:relatedMatch rdf:resource="https://w3id.org/dpv#RightNotice"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_suspension_of_treatment">
        <terms:source xml:lang="es">LOPDP, art. 19</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is a kind of dpv:DataSubjectRight.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es un tipo de dpv:DataSubjectRight.</rdfs:comment>
        <rdfs:label>Right to suspension of treatment</rdfs:label>
        <skos:broadMatch rdf:resource="https://w3id.org/dpv#DataSubjectRight"/>
