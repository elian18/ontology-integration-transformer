        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#DataController"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv Data_Controller exactMatch dpv:DataController y GDPRtEXT Controller exactMatch dpv:DataController.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Axiom>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Owner">
