    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Sources_accessible_to_the_public -->


    <owl:Class rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Sources_accessible_to_the_public">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Exceptions_to_consent_for_national_transfers"/>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is the same as dpv:PublicDataSource. Bridge with the GDPR: is close to gdprtext:MadePublicByDataSubject (through dpv:PublicDataSource).</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es igual a dpv:PublicDataSource. Puente con el GDPR: se parece a gdprtext:MadePublicByDataSubject (por dpv:PublicDataSource).</rdfs:comment>
        <rdfs:label>Sources accessible to the public</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#MadePublicByDataSubject"/>
        <skos:exactMatch rdf:resource="https://w3id.org/dpv#PublicDataSource"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Sources_accessible_to_the_public"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
        <owl:annotatedTarget rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#MadePublicByDataSubject"/>
        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#PublicDataSource"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv Sources_accessible_to_the_public exactMatch dpv:PublicDataSource y GDPRtEXT MadePublicByDataSubject exactMatch dpv:PublicDataSource.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Axiom>
    


