    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#principio_de_transparencia001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#principio_de_transparencia001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Transparency_principles"/>
        <OntologiaLOPDP:that_are_divided_into rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#principio_de_transparencia001"/>
        <OntologiaLOPDP:Accurate>Deben ser precisos</OntologiaLOPDP:Accurate>
        <OntologiaLOPDP:Clear>Deben ser claros</OntologiaLOPDP:Clear>
        <OntologiaLOPDP:Complete>Deben ser completos</OntologiaLOPDP:Complete>
        <OntologiaLOPDP:Exact>Deben ser exactos</OntologiaLOPDP:Exact>
        <OntologiaLOPDP:General_detail>Lo que se realice con los datos del titular debe ser claro y de fácil acceso.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Integral>Deben ser íntegros</OntologiaLOPDP:Integral>
        <OntologiaLOPDP:Risk>Cuentan con un riesgo</OntologiaLOPDP:Risk>
        <OntologiaLOPDP:Threat>Estan propensos a amenazas</OntologiaLOPDP:Threat>
        <OntologiaLOPDP:Verifiable>Deben ser comprobables</OntologiaLOPDP:Verifiable>
        <rdfs:label>principio de transparencia001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#principios_de_confidencialidad001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#principios_de_confidencialidad001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Confidentiality_principles"/>
        <OntologiaLOPDP:that_are_divided_into rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#principios_de_confidencialidad001"/>
        <OntologiaLOPDP:Accurate>Deben ser precisos</OntologiaLOPDP:Accurate>
        <OntologiaLOPDP:Clear>Deben ser claros</OntologiaLOPDP:Clear>
        <OntologiaLOPDP:Complete>Deben estar completos</OntologiaLOPDP:Complete>
        <OntologiaLOPDP:Exact>Deben ser exactos</OntologiaLOPDP:Exact>
        <OntologiaLOPDP:General_detail>Solo las personas autorizadas deben tener acceso a la información contenida en los datos del titular.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Integral>Deben ser íntegros</OntologiaLOPDP:Integral>
        <OntologiaLOPDP:Risk>Siempre pueden tener un riesgo</OntologiaLOPDP:Risk>
        <OntologiaLOPDP:Threat>Estan propensos a amenazas</OntologiaLOPDP:Threat>
        <OntologiaLOPDP:Verifiable>Deben ser comprobables</OntologiaLOPDP:Verifiable>
        <rdfs:label>principios de confidencialidad001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#principios_de_conservación001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#principios_de_conservación001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Conservation_principles"/>
        <OntologiaLOPDP:that_are_divided_into rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#principios_de_conservación001"/>
        <OntologiaLOPDP:Accurate>Deben ser íntegros</OntologiaLOPDP:Accurate>
        <OntologiaLOPDP:Clear>Deben ser claros</OntologiaLOPDP:Clear>
        <OntologiaLOPDP:Complete>Deben ser completos</OntologiaLOPDP:Complete>
        <OntologiaLOPDP:Exact>Deben ser exactos</OntologiaLOPDP:Exact>
        <OntologiaLOPDP:General_detail>Los datos de titular se deben conservar el tiempo necesario y no mantenerlos luego de su periodo de uso.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Integral>Deben ser íntegros</OntologiaLOPDP:Integral>
        <OntologiaLOPDP:Risk>Cuentan con un riesgo</OntologiaLOPDP:Risk>
        <OntologiaLOPDP:Threat>Estan sujetos a una amenaza</OntologiaLOPDP:Threat>
        <OntologiaLOPDP:Verifiable>Deben ser comprobables</OntologiaLOPDP:Verifiable>
        <rdfs:label>principios de conservación001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#principios_de_seguridad001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#principios_de_seguridad001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Safety_principles"/>
        <OntologiaLOPDP:that_are_divided_into rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#principios_de_seguridad001"/>
        <OntologiaLOPDP:Accurate>Deben ser precisos</OntologiaLOPDP:Accurate>
        <OntologiaLOPDP:Clear>Deben ser claros</OntologiaLOPDP:Clear>
        <OntologiaLOPDP:Complete>Deben ser completos</OntologiaLOPDP:Complete>
        <OntologiaLOPDP:Exact>Deben ser exactos</OntologiaLOPDP:Exact>
        <OntologiaLOPDP:General_detail>Los datos de titular de la información deben ser protegidos con las medidas de seguridad adecuadas.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Integral>Deben ser íntegros</OntologiaLOPDP:Integral>
        <OntologiaLOPDP:Risk>Cuentan con un riesgo</OntologiaLOPDP:Risk>
        <OntologiaLOPDP:Threat>Estan sujetos a amenazas</OntologiaLOPDP:Threat>
        <OntologiaLOPDP:Verifiable>Deben ser comprobables</OntologiaLOPDP:Verifiable>
        <rdfs:label>principios de seguridad001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#principles001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#principles001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Principles_in_verification"/>
        <OntologiaLOPDP:has_the_following_principles_to_consider rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#principles001"/>
        <OntologiaLOPDP:Accurate>They are accurate</OntologiaLOPDP:Accurate>
        <OntologiaLOPDP:Clarity_and_accuracy>Fundamental properties of a principle</OntologiaLOPDP:Clarity_and_accuracy>
        <OntologiaLOPDP:Clear>The principles must be clear</OntologiaLOPDP:Clear>
        <OntologiaLOPDP:Complete>They are complete</OntologiaLOPDP:Complete>
        <OntologiaLOPDP:Confidentiality>They play a role in confidentiality</OntologiaLOPDP:Confidentiality>
        <OntologiaLOPDP:Conservation>Help in data preservation</OntologiaLOPDP:Conservation>
        <OntologiaLOPDP:Exact>They are accurate</OntologiaLOPDP:Exact>
        <OntologiaLOPDP:Explicit>Explicit purpose</OntologiaLOPDP:Explicit>
        <OntologiaLOPDP:General_detail>They are a mechanism by which the holder&apos;s information is safeguarded, they help to ensure the correct use of the information.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Integral>They are integral</OntologiaLOPDP:Integral>
        <OntologiaLOPDP:Legitimate>Legitimate purpose</OntologiaLOPDP:Legitimate>
        <OntologiaLOPDP:Personal_data_security_details>They fulfill a security role</OntologiaLOPDP:Personal_data_security_details>
        <OntologiaLOPDP:Purpose>They have a purpose</OntologiaLOPDP:Purpose>
        <OntologiaLOPDP:Risk>They may have a risk</OntologiaLOPDP:Risk>
        <OntologiaLOPDP:Threat>Prevent a threat</OntologiaLOPDP:Threat>
        <OntologiaLOPDP:Transparency>Verify data transparency</OntologiaLOPDP:Transparency>
        <OntologiaLOPDP:Verifiable>The principles are verifiable</OntologiaLOPDP:Verifiable>
        <OntologiaLOPDP:Vulnerabilidad>Help to avoid vulnerabilities</OntologiaLOPDP:Vulnerabilidad>
        <rdfs:label>principles001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#public_administrations001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#public_administrations001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Public_governments"/>
        <OntologiaLOPDP:segmented_into_the_following_national_cases rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#public_administrations001"/>
        <OntologiaLOPDP:Exceptions>It has exceptions at the national level that apply</OntologiaLOPDP:Exceptions>
        <OntologiaLOPDP:Historical>If it is a historical issue, the information can be used for the following purposes</OntologiaLOPDP:Historical>
        <OntologiaLOPDP:Scientist>If it is a scientific topic, it is possible to use the information</OntologiaLOPDP:Scientist>
        <OntologiaLOPDP:Statistician>If it is a statistical issue, it is possible to use the information</OntologiaLOPDP:Statistician>
        <rdfs:label>public administrations001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#public_interest001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#public_interest001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Public_interest"/>
        <OntologiaLOPDP:segmented_into_the_following_international_cases rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#public_interest001"/>
        <OntologiaLOPDP:General_detail>When the owner&apos;s data is necessary or required for public reasons.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Public_interest_detail>If the data is in the public interest, it may be subject to international exceptions.</OntologiaLOPDP:Public_interest_detail>
        <rdfs:label>public interest001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#public_sector001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#public_sector001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Governmental_information_security_mechanism"/>
        <OntologiaLOPDP:account_with_actions_as rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#public_sector001"/>
        <OntologiaLOPDP:Accidental_or_illegal_destruction_or_communication>The public sector is subject to accidental destruction or disclosure of its data.</OntologiaLOPDP:Accidental_or_illegal_destruction_or_communication>
        <OntologiaLOPDP:Alterations>The public sector is subject to alterations in its data.</OntologiaLOPDP:Alterations>
        <OntologiaLOPDP:General_detail>These are security actions to be considered in the public sector.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Loss>The public sector is subject to a loss in its data</OntologiaLOPDP:Loss>
        <OntologiaLOPDP:Risk>The public sector is subject to data risk.</OntologiaLOPDP:Risk>
        <OntologiaLOPDP:Secrecy_of_communications>The public sector is subject to secrecy of communications in its data.</OntologiaLOPDP:Secrecy_of_communications>
        <OntologiaLOPDP:Threat>The public sector is subject to a threat to its data</OntologiaLOPDP:Threat>
        <OntologiaLOPDP:Vulnerabilidad>Public sector is subject to data vulnerabilities</OntologiaLOPDP:Vulnerabilidad>
        <rdfs:label>public sector001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#responsible001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#responsible001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Responsible_for_treatment_in_verification"/>
        <OntologiaLOPDP:is_compliant_with_the_following_roles rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#responsible001"/>
        <OntologiaLOPDP:Analysis_methodologies>Places analysis methodologies</OntologiaLOPDP:Analysis_methodologies>
        <OntologiaLOPDP:Binding_cooperative_rules>The person in charge and the person responsible are responsible for the application of binding cooperative rules.</OntologiaLOPDP:Binding_cooperative_rules>
        <OntologiaLOPDP:Contract>It is present in the process of signing a contract, it can also be present in the process of signing a contract, these same functions have the data processor in the present law.</OntologiaLOPDP:Contract>
        <OntologiaLOPDP:Details_of_the_law_details>Information</OntologiaLOPDP:Details_of_the_law_details>
        <OntologiaLOPDP:General_detail>It performs the transfer, verification and security processes on the owner&apos;s data.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Impact_assessment>The data controller is responsible for carrying out the impact assessment.</OntologiaLOPDP:Impact_assessment>
        <OntologiaLOPDP:Implementing_verification_processes>Implements verification processes</OntologiaLOPDP:Implementing_verification_processes>
        <OntologiaLOPDP:Maintaining_the_accuracy_of_the_information>The person in charge and the person in charge are responsible for maintaining the accuracy of the information in the transfer and verification processes.</OntologiaLOPDP:Maintaining_the_accuracy_of_the_information>
        <OntologiaLOPDP:Members_of_the_protection_system_details>General information</OntologiaLOPDP:Members_of_the_protection_system_details>
        <OntologiaLOPDP:Name>Carla</OntologiaLOPDP:Name>
        <OntologiaLOPDP:Obligations_of_the_responsible_person_and_manager>Perform transfer and verification processes, apply processes, use methodologies and take technological measures.</OntologiaLOPDP:Obligations_of_the_responsible_person_and_manager>
        <OntologiaLOPDP:Perform_evaluations>Evaluates what the manager does</OntologiaLOPDP:Perform_evaluations>
        <OntologiaLOPDP:Personal_data_security_details>The person in charge and responsible for personal data is responsible for ensuring the security of the owner&apos;s data.</OntologiaLOPDP:Personal_data_security_details>
        <OntologiaLOPDP:Personal_detail>It is responsible for the processing of the holder&apos;s personal data and for the authorization to carry out international transfers.</OntologiaLOPDP:Personal_detail>
        <OntologiaLOPDP:Personal_information>Information about the responsible party</OntologiaLOPDP:Personal_information>
        <OntologiaLOPDP:Protection_policies>Establishes data protection policies</OntologiaLOPDP:Protection_policies>
        <OntologiaLOPDP:Safety_from_design_by_defect>You must implement security from the default design in the data.</OntologiaLOPDP:Safety_from_design_by_defect>
        <OntologiaLOPDP:Security_notification_of_infringement>The person in charge is responsible for notifying in the event of a security leak.</OntologiaLOPDP:Security_notification_of_infringement>
        <OntologiaLOPDP:Self-regulation>Data controllers and processors must adhere to codes of conduct, seals, certifications and protection marks, without this constituting an exemption from the responsibility to comply with the provisions of this law, its regulations, guidelines and regulations issued by the Personal Data Protection Authority.</OntologiaLOPDP:Self-regulation>
        <OntologiaLOPDP:Serious>These violations are commensurate with the data controller&apos;s infraction or misconduct.
For example, failure to implement administrative measures.</OntologiaLOPDP:Serious>
        <OntologiaLOPDP:Slight>These infractions are in accordance with the infraction or fault of the data controller.
For example, failure to process or implement a process in the transfer of information would be considered a minor infraction.</OntologiaLOPDP:Slight>
        <OntologiaLOPDP:Very_serious>Not specified, but if there is, the Authority decides what action to take.</OntologiaLOPDP:Very_serious>
        <OntologiaLOPDP:Violations_in_verification>Faults in their actions</OntologiaLOPDP:Violations_in_verification>
        <rdfs:label>responsible001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_of_deletion001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_of_deletion001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Right_of_deletion_in_verification"/>
        <OntologiaLOPDP:can_be_rights_of rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_of_deletion001"/>
        <OntologiaLOPDP:Consent_in_verification>Must be consented to by the owner</OntologiaLOPDP:Consent_in_verification>
        <OntologiaLOPDP:General_detail>This right talks about the scenarios in which the owner of the information can delete his/her data and for this purpose he/she has a period of 15 days.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Informed>It can be an informed consent</OntologiaLOPDP:Informed>
        <OntologiaLOPDP:Not_informed>It can be an informed consent</OntologiaLOPDP:Not_informed>
        <OntologiaLOPDP:Purpose>To delete data, it must have a purpose.</OntologiaLOPDP:Purpose>
        <OntologiaLOPDP:Revoke_consent>It must be possible to revoke the consent at any time, this can be done by the owner of the data.</OntologiaLOPDP:Revoke_consent>
        <OntologiaLOPDP:Updated>Must be updated</OntologiaLOPDP:Updated>
        <OntologiaLOPDP:time_of_right_to_elimination>15 days</OntologiaLOPDP:time_of_right_to_elimination>
        <rdfs:label>right of deletion001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_to_correct_and_update001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_to_correct_and_update001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Right_to_correct_and_update_in_verification"/>
        <OntologiaLOPDP:can_be_rights_of rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_to_correct_and_update001"/>
        <OntologiaLOPDP:Consent_in_verification>Must be consented to by the owner</OntologiaLOPDP:Consent_in_verification>
        <OntologiaLOPDP:General_detail>This right states that the owner of the information has the possibility to update their data when it is inaccurate or incomplete, and this must be done within 15 days.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Informed>It can be an informed consent</OntologiaLOPDP:Informed>
        <OntologiaLOPDP:Not_informed>May be an uninformed consent</OntologiaLOPDP:Not_informed>
        <OntologiaLOPDP:Preservation_time>The time is 15 days</OntologiaLOPDP:Preservation_time>
        <OntologiaLOPDP:Revoke_consent>It must be possible to revoke the consent at any time, this can be done by the owner of the data.</OntologiaLOPDP:Revoke_consent>
        <OntologiaLOPDP:Scope_of_credit_rights>In the credit rights it is stipulated that such rights, as well as all the rights present in the law, have the option of a rectification of information in case the holder needs it.</OntologiaLOPDP:Scope_of_credit_rights>
        <OntologiaLOPDP:Updated>Must be updated</OntologiaLOPDP:Updated>
        <rdfs:label>right to correct and update001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_to_portability001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_to_portability001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Right_to_portability"/>
        <OntologiaLOPDP:can_be_rights_of rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_to_portability001"/>
        <OntologiaLOPDP:Compatible>Must be compatible</OntologiaLOPDP:Compatible>
        <OntologiaLOPDP:Consent_in_verification>Must be consented to by the owner</OntologiaLOPDP:Consent_in_verification>
        <OntologiaLOPDP:General_detail>This right talks about how the holder can request the transfer of his data to another person or responsible when the situation warrants it and for this right there is no established time.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Gratuity>Must be free of charge for the holder</OntologiaLOPDP:Gratuity>
        <OntologiaLOPDP:Informed>It can be an informed consent</OntologiaLOPDP:Informed>
        <OntologiaLOPDP:Not_informed>May be an uninformed consent</OntologiaLOPDP:Not_informed>
        <OntologiaLOPDP:Revoke_consent>It must be possible to revoke the consent at any time, this can be done by the owner of the data.</OntologiaLOPDP:Revoke_consent>
        <OntologiaLOPDP:Structured>Must be structured</OntologiaLOPDP:Structured>
        <OntologiaLOPDP:Updated>Must be updated</OntologiaLOPDP:Updated>
        <rdfs:label>right to portability001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_to_the_information001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_to_the_information001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Right_to_information_in_verification"/>
        <OntologiaLOPDP:can_be_rights_of rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#right_to_the_information001"/>
        <OntologiaLOPDP:Consent_in_verification>Must be consented to by the owner</OntologiaLOPDP:Consent_in_verification>
        <OntologiaLOPDP:Data_use>The owner&apos;s data must be free from use in information automation processes, in order to avoid automated decisions on any specific subject.</OntologiaLOPDP:Data_use>
        <OntologiaLOPDP:General_detail>This right means that the owner of the data must know what is going to be done with them and how they are going to be treated either in the field of data processing or in the field of transfer of information, and to complete this task there is a period of 30 days.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Informed>Puede ser un consentimiento informado</OntologiaLOPDP:Informed>
        <OntologiaLOPDP:Not_informed>May be an uninformed consent</OntologiaLOPDP:Not_informed>
        <OntologiaLOPDP:Preservation_time>It has 30 days to inform the holder that his data was obtained in a non-direct way, this is done by the responsible and in charge.</OntologiaLOPDP:Preservation_time>
        <OntologiaLOPDP:Revoke_consent>It must be possible to revoke the consent at any time, this can be done by the owner of the data.</OntologiaLOPDP:Revoke_consent>
        <OntologiaLOPDP:Updated>The information must be up to date</OntologiaLOPDP:Updated>
        <rdfs:label>right to the information001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#rights001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#rights001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Rights_in_verification"/>
        <OntologiaLOPDP:the_law_has_the_following_rights rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#rights001"/>
        <OntologiaLOPDP:Rights_in_verification>Rights of the holder before the law</OntologiaLOPDP:Rights_in_verification>
        <OntologiaLOPDP:exceptions_to_rights>Exceptions to the rights, cases in which the holder&apos;s data can be used without his/her consent.</OntologiaLOPDP:exceptions_to_rights>
        <rdfs:label>rights001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#sanctioning_regime001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#sanctioning_regime001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Sanctioning_regime"/>
        <OntologiaLOPDP:the_verification_covers_aspects_such_as rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#sanctioning_regime001"/>
        <OntologiaLOPDP:General_detail>These are the consequences to which the entities involved in the law are prone to. Verify that everything is working correctly and if not, a penalty is applied.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Precautionary_measures>Precautionary measures</OntologiaLOPDP:Precautionary_measures>
        <OntologiaLOPDP:Sanctioning_administrative_procedure>Actions in case of a bad practice in the use of data</OntologiaLOPDP:Sanctioning_administrative_procedure>
        <rdfs:label>sanctioning regime001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#security_from_design001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#security_from_design001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Follow-up_from_design"/>
        <OntologiaLOPDP:account_with_actions_as rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#security_from_design001"/>
        <OntologiaLOPDP:General_detail>It is the initial protection to which the data is subject and it is the responsibility of the data controller to apply it.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Safety_from_design_by_defect>Data must be subject to security by design by default</OntologiaLOPDP:Safety_from_design_by_defect>
        <rdfs:label>security from design001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#sensitive_data001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#sensitive_data001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Sensitive_data_in_verification"/>
        <OntologiaLOPDP:that_can_be rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#sensitive_data001"/>
        <OntologiaLOPDP:Access>They must have optimal access</OntologiaLOPDP:Access>
        <OntologiaLOPDP:Anonymization>Data must be anonymized</OntologiaLOPDP:Anonymization>
        <OntologiaLOPDP:Correction>It must be possible to rectify</OntologiaLOPDP:Correction>
        <OntologiaLOPDP:Disposal>It should be possible to eliminate</OntologiaLOPDP:Disposal>
        <OntologiaLOPDP:Updated>The data must be up to date</OntologiaLOPDP:Updated>
        <rdfs:label>sensitive data001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#solve_an_urgence001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#solve_an_urgence001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Solve_an_emergency"/>
        <OntologiaLOPDP:segmented_into_the_following_national_cases rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#solve_an_urgence001"/>
        <OntologiaLOPDP:Anonymization>A nationwide transfer can be forced when an emergency is expected to be solved and must be anonymous.</OntologiaLOPDP:Anonymization>
        <OntologiaLOPDP:Exceptions>A transfer can be forced at the national level when an emergency is expected to be solved</OntologiaLOPDP:Exceptions>
        <OntologiaLOPDP:General_detail>This exception indicates that in the event of a vital emergency, the owner&apos;s data may be used without the owner&apos;s consent.</OntologiaLOPDP:General_detail>
        <rdfs:label>solve an urgence001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#sources_accessible_to_the_public001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#sources_accessible_to_the_public001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Sources_accessible_to_the_public"/>
        <OntologiaLOPDP:segmented_into_the_following_national_cases rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#sources_accessible_to_the_public001"/>
        <OntologiaLOPDP:Exceptions>At the national level, the sources must be accessible to the public.</OntologiaLOPDP:Exceptions>
        <OntologiaLOPDP:General_detail>The holder&apos;s data may be used as long as the information is present in public sources. For example, public databases.</OntologiaLOPDP:General_detail>
        <rdfs:label>sources accessible to the public001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#specific_consent001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#specific_consent001">
        <OntologiaLOPDP:can_be rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#specific_consent001"/>
        <OntologiaLOPDP:Informed>When any specific consent is requested from the data subject</OntologiaLOPDP:Informed>
        <OntologiaLOPDP:Not_informed>When no specific consent is requested from the data subject.</OntologiaLOPDP:Not_informed>
        <rdfs:label>specific consent001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#techniques001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#techniques001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Techniques"/>
        <OntologiaLOPDP:that_can_be_of_the_type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#techniques001"/>
        <OntologiaLOPDP:Applied>When the verification process is applied</OntologiaLOPDP:Applied>
        <OntologiaLOPDP:Cessation_of_treatment>When the corrective action stops</OntologiaLOPDP:Cessation_of_treatment>
        <OntologiaLOPDP:General_detail>Technical corrective actions, e.g., error corrections in information transfer events.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Guidelines>Guidelines for a technical process</OntologiaLOPDP:Guidelines>
        <OntologiaLOPDP:Guidelines>Technical guidelines</OntologiaLOPDP:Guidelines>
        <OntologiaLOPDP:Not_applied>When the verification process does not apply</OntologiaLOPDP:Not_applied>
        <OntologiaLOPDP:Regulations>Technical regulations</OntologiaLOPDP:Regulations>
        <OntologiaLOPDP:Technical_measurements>Measures for a technical verification process</OntologiaLOPDP:Technical_measurements>
        <rdfs:label>techniques001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#teenagers001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#teenagers001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Teenagers"/>
        <OntologiaLOPDP:and_as_your_age_will_have_to_be_of_your_age rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#teenagers001"/>
        <OntologiaLOPDP:Access>Adolescent data must be accessible</OntologiaLOPDP:Access>
        <OntologiaLOPDP:Anonymization>It must be possible to anonymize adolescent data.</OntologiaLOPDP:Anonymization>
        <OntologiaLOPDP:Correction>Adolescent data must be able to be rectified</OntologiaLOPDP:Correction>
        <OntologiaLOPDP:Disposal>It should be possible to delete teenage data</OntologiaLOPDP:Disposal>
        <OntologiaLOPDP:General_detail>In order to make use of their data, no detailed supervision is necessary, only the use to which the data will be put needs to be clearly stated. The age range to be considered as adolescent data is from 12 to 17 years old.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Supervision>Teenagers can use their personal information without the need for adult consent, they do not need supervision, but the use that will be made of their data must be very clear.</OntologiaLOPDP:Supervision>
        <OntologiaLOPDP:Updated>Adolescent data must be updatable</OntologiaLOPDP:Updated>
        <rdfs:label>teenagers001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#transfer_or_communication001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#transfer_or_communication001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Transfer_or_communication"/>
        <OntologiaLOPDP:has_elements_of_transfer_and_communication rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#transfer_or_communication001"/>
        <OntologiaLOPDP:Certifying_international_transfer_processes>Approve the transfer processes when these are clear</OntologiaLOPDP:Certifying_international_transfer_processes>
        <OntologiaLOPDP:Contract>Contract with stakeholders</OntologiaLOPDP:Contract>
        <OntologiaLOPDP:Data_admitted_countries_international_transfer>Admitted countries information</OntologiaLOPDP:Data_admitted_countries_international_transfer>
        <OntologiaLOPDP:Detail_transfer_domestic_domestic_scope>Information</OntologiaLOPDP:Detail_transfer_domestic_domestic_scope>
        <OntologiaLOPDP:Exceptions>Exceptions that may occur in the transfer process</OntologiaLOPDP:Exceptions>
        <OntologiaLOPDP:Informed>Rights informed</OntologiaLOPDP:Informed>
        <OntologiaLOPDP:Legal_or_regulatory_obligation>Legal obligations</OntologiaLOPDP:Legal_or_regulatory_obligation>
        <rdfs:label>transfer or communication001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#treatment001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#treatment001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Treatment_Manager_in_verification"/>
        <OntologiaLOPDP:is_compliant_with_the_following_roles rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#treatment001"/>
        <OntologiaLOPDP:Analysis_methodologies>Analysis methodology to be used on the data</OntologiaLOPDP:Analysis_methodologies>
        <OntologiaLOPDP:Binding_cooperative_rules>The person in charge and the person responsible are responsible for the application of binding cooperative rules.</OntologiaLOPDP:Binding_cooperative_rules>
        <OntologiaLOPDP:Details_of_the_law_details>Information</OntologiaLOPDP:Details_of_the_law_details>
        <OntologiaLOPDP:General_detail>It performs the same activities as the data controller in terms of transfer, verification and security.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Implementing_verification_processes>Must implement data verification processes</OntologiaLOPDP:Implementing_verification_processes>
        <OntologiaLOPDP:Maintaining_the_accuracy_of_the_information>The person in charge and the person in charge are responsible for maintaining the accuracy of the information in the transfer and verification processes.</OntologiaLOPDP:Maintaining_the_accuracy_of_the_information>
        <OntologiaLOPDP:Members_of_the_protection_system_details>Information indicating that it is part of the law</OntologiaLOPDP:Members_of_the_protection_system_details>
        <OntologiaLOPDP:Name>Ana</OntologiaLOPDP:Name>
        <OntologiaLOPDP:National_registry_for_the_protection_of_personal_data>Records data information</OntologiaLOPDP:National_registry_for_the_protection_of_personal_data>
        <OntologiaLOPDP:Obligations_of_the_responsible_person_and_manager>Apply processes, implement protection policies, use methodologies and take technological measures</OntologiaLOPDP:Obligations_of_the_responsible_person_and_manager>
        <OntologiaLOPDP:Perform_evaluations>It is responsible for conducting evaluations</OntologiaLOPDP:Perform_evaluations>
        <OntologiaLOPDP:Personal_data_security_details>The person in charge and responsible for personal data is responsible for ensuring the security of the owner&apos;s data.</OntologiaLOPDP:Personal_data_security_details>
        <OntologiaLOPDP:Personal_detail>It is in charge of data processing and transfer processes when its assistance is required.</OntologiaLOPDP:Personal_detail>
        <OntologiaLOPDP:Personal_information>Personal information of the person in charge</OntologiaLOPDP:Personal_information>
        <OntologiaLOPDP:Protection_policies>Data protection policies to be applied to the data</OntologiaLOPDP:Protection_policies>
        <OntologiaLOPDP:Safety_from_design_by_defect>Security must be in place from the beginning of the data processing.</OntologiaLOPDP:Safety_from_design_by_defect>
        <OntologiaLOPDP:Self-regulation>Data controllers and processors must adhere to codes of conduct, seals, certifications and protection marks, without this constituting an exemption from the responsibility to comply with the provisions of this law, its regulations, guidelines and regulations issued by the Personal Data Protection Authority.</OntologiaLOPDP:Self-regulation>
        <OntologiaLOPDP:Serious>These infractions are in accordance with the infraction or fault of the person responsible for the data.
For example, if an administrative procedure is not carried out.</OntologiaLOPDP:Serious>
        <OntologiaLOPDP:Slight>These infractions are in accordance with the infraction or fault of the data controller.
For example, failure to process or implement a process in the transfer of information would be considered a minor infraction.</OntologiaLOPDP:Slight>
        <OntologiaLOPDP:Very_serious>Not specified, but if there is, the Authority decides what action to take.</OntologiaLOPDP:Very_serious>
        <rdfs:label>treatment001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#unequivocal_consent001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#unequivocal_consent001">
        <OntologiaLOPDP:can_be rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#unequivocal_consent001"/>
        <OntologiaLOPDP:Informed>When any unambiguous consent is requested from the data subject</OntologiaLOPDP:Informed>
        <OntologiaLOPDP:Not_informed>When unambiguous consent is not requested from the data subject</OntologiaLOPDP:Not_informed>
        <rdfs:label>unequivocal consent001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#verification001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#verification001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Verification"/>
        <OntologiaLOPDP:a_process_of rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#verification001"/>
        <OntologiaLOPDP:Audit>Verification processes should be audited when necessary.</OntologiaLOPDP:Audit>
        <OntologiaLOPDP:Audit_detail>Information on the audit performed</OntologiaLOPDP:Audit_detail>
        <OntologiaLOPDP:General_detail>They are misuses of the information by the people who had contact with the data.</OntologiaLOPDP:General_detail>
        <rdfs:label>verification001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#violation_investigation001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#violation_investigation001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Infringement_investigation"/>
        <OntologiaLOPDP:segmented_into_the_following_international_cases rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#violation_investigation001"/>
        <OntologiaLOPDP:Detail_of_investigation_of_infringements>If the data subject has breach information, he/she is subject to an international exception on his/her data.</OntologiaLOPDP:Detail_of_investigation_of_infringements>
        <OntologiaLOPDP:General_detail>When the owner of the information has committed an offense or committed a crime, this information may be investigated without the owner&apos;s consent.</OntologiaLOPDP:General_detail>
        <rdfs:label>violation investigation001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#vital_interest_in_another_person001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#vital_interest_in_another_person001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Vital_interest_of_another_person"/>
        <OntologiaLOPDP:segmented_into_the_following_international_cases rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#vital_interest_in_another_person001"/>
        <OntologiaLOPDP:General_detail>When the data subject is unable to consent to the use of the data.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Vital_interest_detail_of_another_person>Research for a critical disease</OntologiaLOPDP:Vital_interest_detail_of_another_person>
        <rdfs:label>vital interest in another person001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Members_of_the_personal_data_protection_system -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Members_of_the_personal_data_protection_system">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Members_of_the_personal_data_protection_system"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_owner"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processor"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#delegate"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#recipient"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"/>
        <ley-organica-proteccion-datos-personales:description>They are all those persons who participate in the Personal Data Protection Law.</ley-organica-proteccion-datos-personales:description>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Purpose -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Purpose">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Purpose"/>
        <ley-organica-proteccion-datos-personales:is_distinct_from_data_collection_in_the rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processing"/>
        <ley-organica-proteccion-datos-personales:description>Personal data may not be processed for purposes other than those established at the time of collection, unless the conditions permitting further processing as set forth in the Organic Law on the Protection of Personal Data are met.</ley-organica-proteccion-datos-personales:description>
        <ley-organica-proteccion-datos-personales:shall_be>Communicated to the owner of the data, therefore, the owner of the data must be informed in a clear and understandable manner about the purposes of the processing, so that he/she can make informed decisions about the use of his/her personal data.</ley-organica-proteccion-datos-personales:shall_be>
        <ley-organica-proteccion-datos-personales:shall_be>Determined, i.e., they must be specific and well defined, without ambiguity, so that it is clear what will be done with the data collected.</ley-organica-proteccion-datos-personales:shall_be>
        <ley-organica-proteccion-datos-personales:shall_be>Explicit, i.e. they must be transparent and easily understandable for the data subject, without leaving room for confusing interpretations.</ley-organica-proteccion-datos-personales:shall_be>
        <ley-organica-proteccion-datos-personales:shall_be>Legitimate, which means that they must be based on valid legal grounds and comply with data protection regulations.</ley-organica-proteccion-datos-personales:shall_be>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#anonymization -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#anonymization">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Anonymization"/>
        <ley-organica-proteccion-datos-personales:description>The implementation of measures to prevent the identification or re-identification of a natural person shall be carried out without incurring disproportionate efforts. This implies that privacy-preserving actions shall be taken without requiring excessive resources, time or effort that are not justified by the benefits or purpose pursued.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">The implementation of measures to prevent the identification or re-identification of a natural person shall be carried out without incurring disproportionate efforts. This implies that privacy-preserving actions shall be taken without requiring excessive resources, time or effort that are not justified by the benefits or purpose pursued.</rdfs:comment>
        <rdfs:comment xml:lang="es">The implementation of measures to prevent the identification or re-identification of a natural person shall be carried out without incurring disproportionate efforts. This implies that privacy-preserving actions shall be taken without requiring excessive resources, time or effort that are not justified by the benefits or purpose pursued.</rdfs:comment>
        <rdfs:label>anonymization</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#anonymized_data -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#anonymized_data">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Anonymized_data"/>
        <ley-organica-proteccion-datos-personales:explanation_of_concept_of_inapplicability>As soon as the data is no longer anonymized or anonymized, its processing will be subject to compliance with the obligations of this Law, especially the obligation to have a lawful basis for continuing to process the data in a non-anonymized or non-anonymized manner.</ley-organica-proteccion-datos-personales:explanation_of_concept_of_inapplicability>
        <rdfs:label>anonymized data</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#applicability -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#applicability">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Applicability"/>
        <ley-organica-proteccion-datos-personales:scope_of_legislation>La Ley Orgánica de Protección de Datos Personales se aplicará en ciertos escenarios</ley-organica-proteccion-datos-personales:scope_of_legislation>
        <rdfs:label>applicability</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#application_favorable_to_the_owner -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#application_favorable_to_the_owner">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Application_favorable_to_the_owner"/>
        <ley-organica-proteccion-datos-personales:description>In situations where there is uncertainty as to how to interpret and apply the legal or contractual provisions related to the protection of personal data, judicial and administrative officials must opt for the interpretation that benefits the owner of such data, i.e., the owner must be favored in terms of protection and safeguarding of his personal data in case of ambiguity or doubt in the application of the Organic Law for the Protection of Personal Data.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">In situations where there is uncertainty as to how to interpret and apply the legal or contractual provisions related to the protection of personal data, judicial and administrative officials must opt for the interpretation that benefits the owner of such data, i.e., the owner must be favored in terms of protection and safeguarding of his personal data in case of ambiguity or doubt in the application of the Organic Law for the Protection of Personal Data.</rdfs:comment>
        <rdfs:comment xml:lang="es">In situations where there is uncertainty as to how to interpret and apply the legal or contractual provisions related to the protection of personal data, judicial and administrative officials must opt for the interpretation that benefits the owner of such data, i.e., the owner must be favored in terms of protection and safeguarding of his personal data in case of ambiguity or doubt in the application of the Organic Law for the Protection of Personal Data.</rdfs:comment>
        <rdfs:label>application favorable to the owner</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#biometric_data -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#biometric_data">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Biometric_data"/>
        <ley-organica-proteccion-datos-personales:description>Unique personal data, related to the physical or physiological characteristics, or behaviors of a natural person that allows or confirms the unique identification of such person, such as facial images or fingerprint data, among others.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">Unique personal data, related to the physical or physiological characteristics, or behaviors of a natural person that allows or confirms the unique identification of such person, such as facial images or fingerprint data, among others.</rdfs:comment>
        <rdfs:comment xml:lang="es">Unique personal data, related to the physical or physiological characteristics, or behaviors of a natural person that allows or confirms the unique identification of such person, such as facial images or fingerprint data, among others.</rdfs:comment>
        <rdfs:label>biometric data</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#certifying_entity -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#certifying_entity">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Certifying_entity"/>
        <ley-organica-proteccion-datos-personales:is_authorized_by rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"/>
        <ley-organica-proteccion-datos-personales:description>Entity that has the capacity to issue certifications in the area of personal data protection, in a non-exclusive manner, which means that it is not the only entity with this power, and other organizations may also grant certifications in the same area.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">Entity that has the capacity to issue certifications in the area of personal data protection, in a non-exclusive manner, which means that it is not the only entity with this power, and other organizations may also grant certifications in the same area.</rdfs:comment>
        <rdfs:comment xml:lang="es">Entity that has the capacity to issue certifications in the area of personal data protection, in a non-exclusive manner, which means that it is not the only entity with this power, and other organizations may also grant certifications in the same area.</rdfs:comment>
        <rdfs:label>certifying entity</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#claims -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#claims">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Claims"/>
        <ley-organica-proteccion-datos-personales:are_destined_to rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"/>
        <ley-organica-proteccion-datos-personales:may_be_made_by rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_owner"/>
        <ley-organica-proteccion-datos-personales:answer_the_claim>The responsible party must respond to the request within 10 days, either with an affirmative or negative answer, notifying and executing the corresponding actions.</ley-organica-proteccion-datos-personales:answer_the_claim>
        <ley-organica-proteccion-datos-personales:before_answering_the_claim>The Personal Data Protection Authority may carry out actions including preliminary investigations, information gathering and evaluation of the circumstances of the case, in accordance with the provisions of the Organic Administrative Code.</ley-organica-proteccion-datos-personales:before_answering_the_claim>
        <ley-organica-proteccion-datos-personales:claims_of>Claims related to the exercise of the holder&apos;s rights in the processing of personal data</ley-organica-proteccion-datos-personales:claims_of>
        <ley-organica-proteccion-datos-personales:claims_of>Complaints related to compliance with obligations of the data controller</ley-organica-proteccion-datos-personales:claims_of>
        <ley-organica-proteccion-datos-personales:claims_of>Complaints related to the application of principles in data processing</ley-organica-proteccion-datos-personales:claims_of>
        <ley-organica-proteccion-datos-personales:in_the_face_of_a_denial_or_no_response_to_the_claim>The data subject may bring civil, criminal or constitutional actions as deemed necessary.</ley-organica-proteccion-datos-personales:in_the_face_of_a_denial_or_no_response_to_the_claim>
        <ley-organica-proteccion-datos-personales:in_the_face_of_a_denial_or_no_response_to_the_claim>The holder may file an administrative complaint with the Personal Data Protection Authority.</ley-organica-proteccion-datos-personales:in_the_face_of_a_denial_or_no_response_to_the_claim>
        <ley-organica-proteccion-datos-personales:may_be_done_by_means>Digitals</ley-organica-proteccion-datos-personales:may_be_done_by_means>
        <ley-organica-proteccion-datos-personales:may_be_done_by_means>Physicists</ley-organica-proteccion-datos-personales:may_be_done_by_means>
        <ley-organica-proteccion-datos-personales:may_be_made_in_shape>Free</ley-organica-proteccion-datos-personales:may_be_made_in_shape>
        <ley-organica-proteccion-datos-personales:submit_in_case_of_claim>Presentar quejas</ley-organica-proteccion-datos-personales:submit_in_case_of_claim>
        <ley-organica-proteccion-datos-personales:submit_in_case_of_claim>Submit petitions</ley-organica-proteccion-datos-personales:submit_in_case_of_claim>
        <ley-organica-proteccion-datos-personales:submit_in_case_of_claim>Submit requirements</ley-organica-proteccion-datos-personales:submit_in_case_of_claim>
        <rdfs:label>claims</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#collection -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#collection">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Collection"/>
        <ley-organica-proteccion-datos-personales:is_related_to rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#consent"/>
        <ley-organica-proteccion-datos-personales:need_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#consent"/>
        <ley-organica-proteccion-datos-personales:description>Refers to the process of acquiring and obtaining data from various sources, such as sensors, databases, online forms, historical records, among others.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">Refers to the process of acquiring and obtaining data from various sources, such as sensors, databases, online forms, historical records, among others.</rdfs:comment>
        <rdfs:comment xml:lang="es">Refers to the process of acquiring and obtaining data from various sources, such as sensors, databases, online forms, historical records, among others.</rdfs:comment>
        <rdfs:label>collection</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#confidentiality -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#confidentiality">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Confidentiality"/>
        <ley-organica-proteccion-datos-personales:description>Information obtained from the processing of personal data must be handled with care and kept secret. This means that the information should not be used or shared for purposes other than those for which it was collected, unless there are special circumstances permitted by law that justify further processing of the data.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">Information obtained from the processing of personal data must be handled with care and kept secret. This means that the information should not be used or shared for purposes other than those for which it was collected, unless there are special circumstances permitted by law that justify further processing of the data.</rdfs:comment>
        <rdfs:comment xml:lang="es">Information obtained from the processing of personal data must be handled with care and kept secret. This means that the information should not be used or shared for purposes other than those for which it was collected, unless there are special circumstances permitted by law that justify further processing of the data.</rdfs:comment>
        <rdfs:label>confidentiality</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#consent -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#consent">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Consent"/>
        <ley-organica-proteccion-datos-personales:in_cases_of_direct_data_gathering_by_the rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_owner"/>
        <ley-organica-proteccion-datos-personales:in_the_case_of_no_direct_data_collection_by_the rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_owner"/>
        <ley-organica-proteccion-datos-personales:is_related_to rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#consent_defects"/>
        <ley-organica-proteccion-datos-personales:is_related_to rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#revocation_of_consent"/>
        <ley-organica-proteccion-datos-personales:characteristics_that_the_information_transferred_to_the_owner_must_have>Clear, simple and easy to understand language</ley-organica-proteccion-datos-personales:characteristics_that_the_information_transferred_to_the_owner_must_have>
        <ley-organica-proteccion-datos-personales:characteristics_that_the_information_transferred_to_the_owner_must_have>Preferably, the information should be available in the language chosen by the owner.</ley-organica-proteccion-datos-personales:characteristics_that_the_information_transferred_to_the_owner_must_have>
        <ley-organica-proteccion-datos-personales:conditions_for_legitimate_treatment>By consent of the owner for the processing of his personal data for one or more specific purposes.</ley-organica-proteccion-datos-personales:conditions_for_legitimate_treatment>
        <ley-organica-proteccion-datos-personales:description>Expression by which the owner of the personal data grants his/her authorization to the data controller to process such data.</ley-organica-proteccion-datos-personales:description>
        <ley-organica-proteccion-datos-personales:for_health-related_data_without_consent>The consent of the owner shall not be required for the processing of health data.</ley-organica-proteccion-datos-personales:for_health-related_data_without_consent>
        <ley-organica-proteccion-datos-personales:for_plurality_of_purposes>It is necessary to specify that such consent is given for all the purposes for which consent is being requested.</ley-organica-proteccion-datos-personales:for_plurality_of_purposes>
        <ley-organica-proteccion-datos-personales:how_the_information_may_be_transmitted_to_the_owner>Within any testable mode</ley-organica-proteccion-datos-personales:how_the_information_may_be_transmitted_to_the_owner>
        <ley-organica-proteccion-datos-personales:to_deal_with_and_communicate_personal_data_must>The manifestation of the holder&apos;s will to do so must be counted, i.e., when the data subject has given his/her consent for the processing or communication of personal data to occur.</ley-organica-proteccion-datos-personales:to_deal_with_and_communicate_personal_data_must>
        <ley-organica-proteccion-datos-personales:valid>Free from defects of consent</ley-organica-proteccion-datos-personales:valid>
        <ley-organica-proteccion-datos-personales:valid>Informed to ensure transparency and the right to information</ley-organica-proteccion-datos-personales:valid>
        <ley-organica-proteccion-datos-personales:valid>Specific with respect to the means and purposes of processing</ley-organica-proteccion-datos-personales:valid>
        <ley-organica-proteccion-datos-personales:valid>Unequivocal, no doubt about the authorization granted by the holder</ley-organica-proteccion-datos-personales:valid>
        <rdfs:comment xml:lang="en">Expression by which the owner of the personal data grants his/her authorization to the data controller to process such data.</rdfs:comment>
        <rdfs:comment xml:lang="es">Expression by which the owner of the personal data grants his/her authorization to the data controller to process such data.</rdfs:comment>
        <rdfs:label>consent</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#consent_defects -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#consent_defects">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Consent_defects"/>
        <ley-organica-proteccion-datos-personales:description>They refer to situations in which the person does not fully understand what he/she is authorizing or when his/her consent is not truly free and voluntary.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">They refer to situations in which the person does not fully understand what he/she is authorizing or when his/her consent is not truly free and voluntary.</rdfs:comment>
        <rdfs:comment xml:lang="es">They refer to situations in which the person does not fully understand what he/she is authorizing or when his/her consent is not truly free and voluntary.</rdfs:comment>
        <rdfs:label>consent defects</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#conservation -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#conservation">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Conservation"/>
        <ley-organica-proteccion-datos-personales:responsible_for_establishing_the_deadlines_for_suspension_or_periodic_review_within_data_processing_is rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"/>
        <ley-organica-proteccion-datos-personales:description>The conservation of personal data implies keeping them for a period that does not exceed the time necessary to fulfill the purpose for which they were initially collected and processed.</ley-organica-proteccion-datos-personales:description>
        <ley-organica-proteccion-datos-personales:extended_preservation_of_personal_data_processing>Archival purposes in the public interest, i.e., preservation of data for archival purposes that benefit the public interest, such as preserving the historical or administrative memory of a society.</ley-organica-proteccion-datos-personales:extended_preservation_of_personal_data_processing>
        <ley-organica-proteccion-datos-personales:extended_preservation_of_personal_data_processing>Historical research purposes for the purpose of studying events, periods or aspects of the past to better understand history, the evolution of society, cultures or institutions over time.</ley-organica-proteccion-datos-personales:extended_preservation_of_personal_data_processing>
        <ley-organica-proteccion-datos-personales:extended_preservation_of_personal_data_processing>Scientific research purposes, that is, when the processing of personal data is used for scientific studies that seek to generate knowledge, understand natural or social phenomena, validate theories or contribute to the advancement of a particular discipline.</ley-organica-proteccion-datos-personales:extended_preservation_of_personal_data_processing>
        <ley-organica-proteccion-datos-personales:extended_preservation_of_personal_data_processing>Statistical research purposes with the objective of performing quantitative and qualitative analyses to understand patterns, trends and relationships in a specific population or phenomenon.</ley-organica-proteccion-datos-personales:extended_preservation_of_personal_data_processing>
        <rdfs:comment xml:lang="en">The conservation of personal data implies keeping them for a period that does not exceed the time necessary to fulfill the purpose for which they were initially collected and processed.</rdfs:comment>
        <rdfs:comment xml:lang="es">The conservation of personal data implies keeping them for a period that does not exceed the time necessary to fulfill the purpose for which they were initially collected and processed.</rdfs:comment>
        <rdfs:label>conservation</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#corrective_measures -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#corrective_measures">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Corrective_measures"/>
        <ley-organica-proteccion-datos-personales:will_be_imposed_by rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"/>
        <ley-organica-proteccion-datos-personales:before_dictating_corrective_measures>To have a competent technical report that allows correcting, reversing or eliminating conducts contrary to the Organic Law for the Protection of Personal Data and the regulations issued by the Authority for the Protection of Personal Data.</ley-organica-proteccion-datos-personales:before_dictating_corrective_measures>
        <ley-organica-proteccion-datos-personales:cases_to_incur_in_corrective_measures>In the event that controllers, persons in charge of processing personal data and certification bodies and, if applicable, third parties, are involved in the alleged commission of a minor infringement and are included in the Unified Registry of non-compliant controllers and persons in charge of processing personal data.</ley-organica-proteccion-datos-personales:cases_to_incur_in_corrective_measures>
        <ley-organica-proteccion-datos-personales:cases_to_incur_in_corrective_measures>In the event that controllers, persons in charge of the processing of personal data and certification bodies are involved in the alleged commission of a serious infringement</ley-organica-proteccion-datos-personales:cases_to_incur_in_corrective_measures>
        <ley-organica-proteccion-datos-personales:cases_to_incur_in_corrective_measures>In the event that controllers, persons in charge of the processing of personal data and certification bodies are involved in the alleged commission of a very serious infringement</ley-organica-proteccion-datos-personales:cases_to_incur_in_corrective_measures>
        <ley-organica-proteccion-datos-personales:for_minor_infractions>The Personal Data Protection Authority will directly activate the administrative sanctioning procedure, stating in the resolution both the applicable corrective measures and the sanction corresponding to the infraction committed.</ley-organica-proteccion-datos-personales:for_minor_infractions>
        <ley-organica-proteccion-datos-personales:for_serious_infractions>The Data Protection Authority will initially apply corrective measures. If they are not adequately complied with, sanctions for serious infringements will be imposed through the administrative sanctioning procedure.</ley-organica-proteccion-datos-personales:for_serious_infractions>
        <ley-organica-proteccion-datos-personales:for_very_serious_offenses>The Personal Data Protection Authority will directly activate the administrative sanctioning procedure, stating in the resolution both the applicable corrective measures and the sanction corresponding to the infraction committed.</ley-organica-proteccion-datos-personales:for_very_serious_offenses>
        <ley-organica-proteccion-datos-personales:in_the_case_of_non-compliance_of>Diposiciones prevista en la Ley Orgnánica de Protección de Datos Personales</ley-organica-proteccion-datos-personales:in_the_case_of_non-compliance_of>
        <ley-organica-proteccion-datos-personales:in_the_case_of_non-compliance_of>Disobedience of the directives and guidelines issued by the Authority for the Protection of Personal Data.</ley-organica-proteccion-datos-personales:in_the_case_of_non-compliance_of>
        <ley-organica-proteccion-datos-personales:in_the_case_of_non-compliance_of>Infringement of data owner&apos;s rights</ley-organica-proteccion-datos-personales:in_the_case_of_non-compliance_of>
        <ley-organica-proteccion-datos-personales:in_the_case_of_non-compliance_of>Violation of the fundamental principles related to the right to the protection of personal data.</ley-organica-proteccion-datos-personales:in_the_case_of_non-compliance_of>
        <ley-organica-proteccion-datos-personales:in_the_case_of_non-compliance_of>Violation of the regulations established by the Personal Data Protection Authority.</ley-organica-proteccion-datos-personales:in_the_case_of_non-compliance_of>
        <ley-organica-proteccion-datos-personales:what_will_be_the_corrective_measures>Data deletion</ley-organica-proteccion-datos-personales:what_will_be_the_corrective_measures>
        <ley-organica-proteccion-datos-personales:what_will_be_the_corrective_measures>The cessation of treatment, under certain conditions or time limits</ley-organica-proteccion-datos-personales:what_will_be_the_corrective_measures>
        <ley-organica-proteccion-datos-personales:what_will_be_the_corrective_measures>The imposition of technical, legal, organizational or administrative measures to ensure proper processing of personal data</ley-organica-proteccion-datos-personales:what_will_be_the_corrective_measures>
        <rdfs:label>corrective measures</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#credit_data -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#credit_data">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Credit_data"/>
        <ley-organica-proteccion-datos-personales:description>Data that integrate the economic behavior of natural persons, to analyze their financial capacity.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">Data that integrate the economic behavior of natural persons, to analyze their financial capacity.</rdfs:comment>
        <rdfs:comment xml:lang="es">Data that integrate the economic behavior of natural persons, to analyze their financial capacity.</rdfs:comment>
        <rdfs:label>credit data</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#credit_data_processing -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#credit_data_processing">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Credit_data_processing"/>
        <ley-organica-proteccion-datos-personales:allow_evaluate>The commercial conduct of the data subject</ley-organica-proteccion-datos-personales:allow_evaluate>
        <ley-organica-proteccion-datos-personales:allow_evaluate>The conclusion of business in general of the data subject.</ley-organica-proteccion-datos-personales:allow_evaluate>
        <ley-organica-proteccion-datos-personales:allow_evaluate>The data subject&apos;s ability to pay</ley-organica-proteccion-datos-personales:allow_evaluate>
        <ley-organica-proteccion-datos-personales:cannot_be_done_with_the_processing_of_credit_data>The following may not be communicated</ley-organica-proteccion-datos-personales:cannot_be_done_with_the_processing_of_credit_data>
        <ley-organica-proteccion-datos-personales:cannot_be_done_with_the_processing_of_credit_data>The following may not be disseminated</ley-organica-proteccion-datos-personales:cannot_be_done_with_the_processing_of_credit_data>
        <ley-organica-proteccion-datos-personales:cannot_be_done_with_the_processing_of_credit_data>They may not have a secondary purpose</ley-organica-proteccion-datos-personales:cannot_be_done_with_the_processing_of_credit_data>
        <ley-organica-proteccion-datos-personales:credit_data_relative_with>Banking obligations</ley-organica-proteccion-datos-personales:credit_data_relative_with>
        <ley-organica-proteccion-datos-personales:credit_data_relative_with>Commercial obligations</ley-organica-proteccion-datos-personales:credit_data_relative_with>
        <ley-organica-proteccion-datos-personales:credit_data_relative_with>Financial obligations</ley-organica-proteccion-datos-personales:credit_data_relative_with>
        <ley-organica-proteccion-datos-personales:credit_data_relative_with>Obligaciones de carácter financiero</ley-organica-proteccion-datos-personales:credit_data_relative_with>
        <ley-organica-proteccion-datos-personales:destined>For analysis purposes only</ley-organica-proteccion-datos-personales:destined>
        <ley-organica-proteccion-datos-personales:enforceable_obligation_for_credit_data>After five years have elapsed since the obligation has become due, the following may not be reported</ley-organica-proteccion-datos-personales:enforceable_obligation_for_credit_data>
        <ley-organica-proteccion-datos-personales:for_information_about>Capital adequacy</ley-organica-proteccion-datos-personales:for_information_about>
        <ley-organica-proteccion-datos-personales:for_information_about>Creditworthiness</ley-organica-proteccion-datos-personales:for_information_about>
        <ley-organica-proteccion-datos-personales:for_information_about>Fulfillment of commercial obligations</ley-organica-proteccion-datos-personales:for_information_about>
        <ley-organica-proteccion-datos-personales:for_information_about>Fulfillment of credit obligations</ley-organica-proteccion-datos-personales:for_information_about>
        <ley-organica-proteccion-datos-personales:sources_from_whence_the_credit_data_was_obtained>Public access sources</ley-organica-proteccion-datos-personales:sources_from_whence_the_credit_data_was_obtained>
        <ley-organica-proteccion-datos-personales:sources_from_whence_the_credit_data_was_obtained>Sources from information provided by the data owner</ley-organica-proteccion-datos-personales:sources_from_whence_the_credit_data_was_obtained>
        <rdfs:label>credit data processing</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_base -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_base">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_base"/>
        <ley-organica-proteccion-datos-personales:description>A structured data set encompasses any form, mode of creation, storage, organization, type of medium, treatment, processing, location or access, whether centralized, decentralized or distributed functionally or geographically.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">A structured data set encompasses any form, mode of creation, storage, organization, type of medium, treatment, processing, location or access, whether centralized, decentralized or distributed functionally or geographically.</rdfs:comment>
        <rdfs:comment xml:lang="es">A structured data set encompasses any form, mode of creation, storage, organization, type of medium, treatment, processing, location or access, whether centralized, decentralized or distributed functionally or geographically.</rdfs:comment>
        <rdfs:label>data base</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_or_database_of_criminal_infractions -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_or_database_of_criminal_infractions">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_or_database_of_criminal_infractions"/>
        <ley-organica-proteccion-datos-personales:explanation_of_concept_of_inapplicability>Data or databases established for the prevention, investigation, detection or prosecution of criminal offenses or execution of criminal sanctions, carried out by the competent state agencies in compliance with their legal functions. In any of these cases, international human rights standards and the principles of this Law must be complied with, and at least the criteria of legality, proportionality and necessity must be met.</ley-organica-proteccion-datos-personales:explanation_of_concept_of_inapplicability>
        <rdfs:label>data or database of criminal infractions</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_owner -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_owner">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Owner"/>
        <ley-organica-proteccion-datos-personales:count_with_the_following rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#rights"/>
        <ley-organica-proteccion-datos-personales:in_case_of_impugning_the_exaccuracy_of_data_a rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"/>
        <ley-organica-proteccion-datos-personales:in_case_of_suspension_of_treatment_must_resort_to rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"/>
        <ley-organica-proteccion-datos-personales:cases_in_which_the_owner_should_be_informed>When the personal data is not obtained directly from the owner</ley-organica-proteccion-datos-personales:cases_in_which_the_owner_should_be_informed>
        <ley-organica-proteccion-datos-personales:cases_in_which_the_owner_should_be_informed>When the personal data were obtained from a source accessible to the public</ley-organica-proteccion-datos-personales:cases_in_which_the_owner_should_be_informed>
        <ley-organica-proteccion-datos-personales:control_functions>Person whose data is processed</ley-organica-proteccion-datos-personales:control_functions>
        <ley-organica-proteccion-datos-personales:in_case_of_no_direct_obtaining_by_the_owner>The holder shall be informed within thirty (30) days or at the time of the first communication with the holder.</ley-organica-proteccion-datos-personales:in_case_of_no_direct_obtaining_by_the_owner>
        <ley-organica-proteccion-datos-personales:in_cases_of_automated_evaluations>You may challenge automated decisions regarding the data subject&apos;s data before the data controller.</ley-organica-proteccion-datos-personales:in_cases_of_automated_evaluations>
        <ley-organica-proteccion-datos-personales:in_cases_of_automated_evaluations>You may request from the controller a detailed and reasoned explanation of the decision taken regarding the processing of your personal data.</ley-organica-proteccion-datos-personales:in_cases_of_automated_evaluations>
        <ley-organica-proteccion-datos-personales:in_cases_of_automated_evaluations>You may request from the data controller information on the types of data used and the source from which the data was obtained.</ley-organica-proteccion-datos-personales:in_cases_of_automated_evaluations>
        <ley-organica-proteccion-datos-personales:in_cases_of_automated_evaluations>You may request the evaluation criteria on the automated program.</ley-organica-proteccion-datos-personales:in_cases_of_automated_evaluations>
        <ley-organica-proteccion-datos-personales:in_cases_of_automated_evaluations>You may submit comments on the processing of your personal data.</ley-organica-proteccion-datos-personales:in_cases_of_automated_evaluations>
        <ley-organica-proteccion-datos-personales:obtaining_personal_data_directly_by_the_owner>Information on how such data will be used must be provided to the data subject prior to collection, i.e., at the time the personal data is requested or collected from the data subject.</ley-organica-proteccion-datos-personales:obtaining_personal_data_directly_by_the_owner>
        <ley-organica-proteccion-datos-personales:type_of_person>Natural</ley-organica-proteccion-datos-personales:type_of_person>
        <rdfs:label>data owner</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processing -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processing">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_processing"/>
        <ley-organica-proteccion-datos-personales:has_as_the_basis_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legal_interest"/>
        <ley-organica-proteccion-datos-personales:is_based_on rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#principios"/>
        <ley-organica-proteccion-datos-personales:before_the_revocation_of_consent_is_considered_to_be_considered>It is considered lawful, i.e. even if the data subject decides to revoke his/her consent to data processing, this does not invalidate or invalidate the data processing that was lawfully carried out prior to the revocation of consent.</ley-organica-proteccion-datos-personales:before_the_revocation_of_consent_is_considered_to_be_considered>
        <ley-organica-proteccion-datos-personales:conditions_for_legitimate_treatment>For processing of personal data contained in publicly accessible databases</ley-organica-proteccion-datos-personales:conditions_for_legitimate_treatment>
        <ley-organica-proteccion-datos-personales:conditions_for_legitimate_treatment>Personal data involved in data processing may be used prior to entering into a contract if requested by the data subject, or during the performance of a contract to fulfill the obligations of the data controller, a person designated to handle the data, or another legally authorized party.</ley-organica-proteccion-datos-personales:conditions_for_legitimate_treatment>
        <ley-organica-proteccion-datos-personales:conditions_for_legitimate_treatment>Processing personal data to satisfy a legitimate interest of the data controller or a third party. However, this legitimate interest cannot prevail over the fundamental rights of the data subjects.</ley-organica-proteccion-datos-personales:conditions_for_legitimate_treatment>
        <ley-organica-proteccion-datos-personales:conditions_for_legitimate_treatment>That it is carried out by the data controller in compliance with a legal obligation.</ley-organica-proteccion-datos-personales:conditions_for_legitimate_treatment>
        <ley-organica-proteccion-datos-personales:conditions_for_legitimate_treatment>That the collection, storage, use or any other operation carried out with personal data is justified in the performance of a task in the public interest or in the exercise of public powers vested in the data controller.</ley-organica-proteccion-datos-personales:conditions_for_legitimate_treatment>
        <ley-organica-proteccion-datos-personales:conditions_for_legitimate_treatment>To be carried out by the data controller, by court order</ley-organica-proteccion-datos-personales:conditions_for_legitimate_treatment>
        <ley-organica-proteccion-datos-personales:conditions_for_legitimate_treatment>To protect the vital interests of the data subject or of another natural person, such as life, health or integrity</ley-organica-proteccion-datos-personales:conditions_for_legitimate_treatment>
        <ley-organica-proteccion-datos-personales:description>Any action or set of actions performed on personal data, whether by means of fully automated, partially automated or non-automated technical processes. These actions include, but are not limited to: collecting, compiling, obtaining, recording, organizing, structuring, preserving, safeguarding, adapting, modifying, deleting, indexing, extracting, consulting, processing, using, possessing, exploiting, distributing, assigning, communicating, transferring or otherwise providing access to, collating, interconnecting, limiting, deleting, destroying and, in general, any use of personal data.</ley-organica-proteccion-datos-personales:description>
        <ley-organica-proteccion-datos-personales:determine_the_compatibility>Consideration should be given to the logical expectations that the data subject might have about the future use of his or her data, based on his or her relationship with the data controller</ley-organica-proteccion-datos-personales:determine_the_compatibility>
        <ley-organica-proteccion-datos-personales:determine_the_compatibility>It should be verified that there are sufficient safeguards both in the original processing and in the proposed new processing to protect the rights and privacy of data subjects.</ley-organica-proteccion-datos-personales:determine_the_compatibility>
        <ley-organica-proteccion-datos-personales:determine_the_compatibility>The environment and circumstances in which the data were first obtained should be analyzed.</ley-organica-proteccion-datos-personales:determine_the_compatibility>
        <ley-organica-proteccion-datos-personales:determine_the_compatibility>The information provided to the data subject during the initial collection process should be taken into account.</ley-organica-proteccion-datos-personales:determine_the_compatibility>
        <ley-organica-proteccion-datos-personales:determine_the_compatibility>The potential impact of further processing of the data on data subjects should be analyzed</ley-organica-proteccion-datos-personales:determine_the_compatibility>
        <ley-organica-proteccion-datos-personales:determine_the_compatibility>The type of personal data collected and its sensitivity must be evaluated.</ley-organica-proteccion-datos-personales:determine_the_compatibility>
        <ley-organica-proteccion-datos-personales:for_different_purpose>If they are compatible with the purposes for which they were collected.</ley-organica-proteccion-datos-personales:for_different_purpose>
        <ley-organica-proteccion-datos-personales:low_legitimate_interest>Only data that is strictly necessary to fulfill the purposes established in relation to the consent given and the intended processing may be processed.</ley-organica-proteccion-datos-personales:low_legitimate_interest>
        <ley-organica-proteccion-datos-personales:low_legitimate_interest>The Data Protection Authority has the power to request a risk report from the data controller to assess possible threats to the legitimate expectations of data subjects and their fundamental rights.</ley-organica-proteccion-datos-personales:low_legitimate_interest>
        <ley-organica-proteccion-datos-personales:low_legitimate_interest>The data controller must ensure that the data processing is transparent to the data subject.</ley-organica-proteccion-datos-personales:low_legitimate_interest>
        <ley-organica-proteccion-datos-personales:territorial_application_scenario>The processing of personal data is carried out in any part of the national territory.</ley-organica-proteccion-datos-personales:territorial_application_scenario>
        <rdfs:comment xml:lang="en">Any action or set of actions performed on personal data, whether by means of fully automated, partially automated or non-automated technical processes. These actions include, but are not limited to: collecting, compiling, obtaining, recording, organizing, structuring, preserving, safeguarding, adapting, modifying, deleting, indexing, extracting, consulting, processing, using, possessing, exploiting, distributing, assigning, communicating, transferring or otherwise providing access to, collating, interconnecting, limiting, deleting, destroying and, in general, any use of personal data.</rdfs:comment>
        <rdfs:comment xml:lang="es">Any action or set of actions performed on personal data, whether by means of fully automated, partially automated or non-automated technical processes. These actions include, but are not limited to: collecting, compiling, obtaining, recording, organizing, structuring, preserving, safeguarding, adapting, modifying, deleting, indexing, extracting, consulting, processing, using, possessing, exploiting, distributing, assigning, communicating, transferring or otherwise providing access to, collating, interconnecting, limiting, deleting, destroying and, in general, any use of personal data.</rdfs:comment>
        <rdfs:label>data processing</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processor -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processor">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Processor"/>
        <ley-organica-proteccion-datos-personales:is_related_to rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#delegate"/>
        <ley-organica-proteccion-datos-personales:control_functions>Processor of personal data on behalf of and for the account of a controller of personal data</ley-organica-proteccion-datos-personales:control_functions>
        <ley-organica-proteccion-datos-personales:delegate_comments>Ensure that the involvement of the personal data protection officer, in all matters relating to personal data protection, is appropriate and timely.</ley-organica-proteccion-datos-personales:delegate_comments>
        <ley-organica-proteccion-datos-personales:delegate_comments>Ensure that the personal data protection officer establishes direct communication with the highest executive and decision-making levels of the data processor.</ley-organica-proteccion-datos-personales:delegate_comments>
        <ley-organica-proteccion-datos-personales:delegate_comments>Facilitate access to the personal data of the processing operations, as well as all the resources and elements necessary to guarantee the correct and free performance of its functions.</ley-organica-proteccion-datos-personales:delegate_comments>
        <ley-organica-proteccion-datos-personales:delegate_comments>They may not dismiss or sanction the personal data protection officer for the proper performance of his or her duties.</ley-organica-proteccion-datos-personales:delegate_comments>
        <ley-organica-proteccion-datos-personales:delegate_comments>Train and update the personal data protection officer on the subject, in accordance with the technical regulations issued by the Personal Data Protection Authority.</ley-organica-proteccion-datos-personales:delegate_comments>
        <ley-organica-proteccion-datos-personales:minor_infractions>Failure to allow or cooperate with audits or inspections carried out by the data controller or other auditor authorized by the Personal Data Protection Authority</ley-organica-proteccion-datos-personales:minor_infractions>
        <ley-organica-proteccion-datos-personales:minor_infractions>Failure to comply with the corrective measures ordered by the Personal Data Protection Authority.</ley-organica-proteccion-datos-personales:minor_infractions>
        <ley-organica-proteccion-datos-personales:minor_infractions>Failure to cooperate with the data controller to enable the data controller to respond adequately to requests from data subjects</ley-organica-proteccion-datos-personales:minor_infractions>
        <ley-organica-proteccion-datos-personales:minor_infractions>Failure to provide the data controller with all the information necessary to comply with the obligations established by the Organic Law on Personal Data Protection and the corresponding regulations.</ley-organica-proteccion-datos-personales:minor_infractions>
        <ley-organica-proteccion-datos-personales:nature_of_the_entity>Public or Private</ley-organica-proteccion-datos-personales:nature_of_the_entity>
        <ley-organica-proteccion-datos-personales:obligations>Allowing audits and inspections by accredited auditors</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Comply with any other obligation established by applicable regulations or other Ecuadorian laws.</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Conduct security adequacy assessments prior to the processing of personal data.</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Designate a Data Protection Officer when necessary.</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Develop customized data protection policies</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Ensure that data processors comply with regulations and best practices.</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Establish confidentiality agreements with personnel and data controllers.</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Implement administrative, technical and legal measures to guarantee the proper treatment of data</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Maintain the National Registry of Personal Data Protection up to date.</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Notifying the Personal Data Protection Authority and the data owner of violations of the security measures implemented for the processing of personal data in accordance with the procedure established for this purpose.</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Periodically evaluate the effectiveness of the administrative, technical and legal measures adopted.</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Take the necessary technological, physical, administrative, organizational and legal measures to prevent, deter, reduce, mitigate and control identified risks and breaches.</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Treat personal data in accordance with the Organic Law on Personal Data Protection and relevant regulations.</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Use risk analysis and management methodologies adapted to the particularities of data processing and the parties involved.</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:serious_infractions>Failure to comply with corrective measures or partial or defective compliance with them, provided that a sanction for a minor infraction has been applied beforehand for this reason.</ley-organica-proteccion-datos-personales:serious_infractions>
        <ley-organica-proteccion-datos-personales:serious_infractions>Failure to implement mechanisms designed to maintain the confidentiality, integrity, availability and resilience of personal data</ley-organica-proteccion-datos-personales:serious_infractions>
        <ley-organica-proteccion-datos-personales:serious_infractions>Failure to implement preventive and corrective measures in the security of personal data in order to avoid violations.</ley-organica-proteccion-datos-personales:serious_infractions>
        <ley-organica-proteccion-datos-personales:serious_infractions>Failure to notify the data controller of any breach of security of personal data in accordance with the Organic Law on Personal Data Protection or with unjustified delay.</ley-organica-proteccion-datos-personales:serious_infractions>
        <ley-organica-proteccion-datos-personales:serious_infractions>Failure to process personal data in accordance with the provisions of the contract with the data controller</ley-organica-proteccion-datos-personales:serious_infractions>
        <ley-organica-proteccion-datos-personales:serious_infractions>Failure to sign contracts containing confidentiality and appropriate treatment of personal data clauses with the personnel in charge of the treatment of personal data or whoever has knowledge of the personal data.</ley-organica-proteccion-datos-personales:serious_infractions>
        <ley-organica-proteccion-datos-personales:serious_infractions>Not to delete the personal data transferred or communicated to the person in charge of the processing of personal data, once its assignment has been completed.</ley-organica-proteccion-datos-personales:serious_infractions>
        <ley-organica-proteccion-datos-personales:serious_infractions>Processing personal data without respecting the principles and rights established in the Organic Law for the Protection of Personal Data, its regulations and the rules issued by the Authority for the Protection of Personal Data.</ley-organica-proteccion-datos-personales:serious_infractions>
        <ley-organica-proteccion-datos-personales:type_authority>Public</ley-organica-proteccion-datos-personales:type_authority>
        <ley-organica-proteccion-datos-personales:type_of_organism_participation>Alone or together with others</ley-organica-proteccion-datos-personales:type_of_organism_participation>
        <ley-organica-proteccion-datos-personales:type_of_person>Natural or Legal</ley-organica-proteccion-datos-personales:type_of_person>
        <rdfs:label>data processor</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_types -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_types">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_types"/>
        <ley-organica-proteccion-datos-personales:data_types_are_comprised_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data"/>
        <ley-organica-proteccion-datos-personales:data_types_are_comprised_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#special_personal_data_categories"/>
        <ley-organica-proteccion-datos-personales:description>Within the Organic Law for the Protection of Personal Data, different types of data are classified and classified as follows</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">Within the Organic Law for the Protection of Personal Data, different types of data are classified and classified as follows</rdfs:comment>
        <rdfs:comment xml:lang="es">Within the Organic Law for the Protection of Personal Data, different types of data are classified and classified as follows</rdfs:comment>
        <rdfs:label>data types</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_under_17_years_old -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_under_17_years_old">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_under_17_years_old"/>
        <rdfs:label>data under 17 years old</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#deceased_owner -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#deceased_owner">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Deceased_owner"/>
        <ley-organica-proteccion-datos-personales:account_with_a rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#successor_right_holder"/>
        <ley-organica-proteccion-datos-personales:description>An individual who, in life, was the owner of personal data and has died.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">An individual who, in life, was the owner of personal data and has died.</rdfs:comment>
        <rdfs:comment xml:lang="es">An individual who, in life, was the owner of personal data and has died.</rdfs:comment>
        <rdfs:label>deceased owner</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#deceased_persons_data -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#deceased_persons_data">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Deceased_persons_data"/>
        <ley-organica-proteccion-datos-personales:explanation_of_concept_of_inapplicability>This exemption establishes that the law does not apply to data related to deceased individuals, recognizing the special nature of post mortem information. The exemption allows the processing of data relating to individuals who are deceased, without being subject to the general provisions of this law.</ley-organica-proteccion-datos-personales:explanation_of_concept_of_inapplicability>
        <rdfs:label>deceased persons data</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#delegate -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#delegate">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Delegate"/>
        <ley-organica-proteccion-datos-personales:is_related_to rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"/>
        <ley-organica-proteccion-datos-personales:shall_be_observed_by rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processor"/>
        <ley-organica-proteccion-datos-personales:shall_be_observed_by rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"/>
        <ley-organica-proteccion-datos-personales:a_data_protection_delegate_will_be_assigned>When it refers to the large-scale processing of special categories of data, in accordance with the provisions of the regulations of the Organic Law on Personal Data Protection.</ley-organica-proteccion-datos-personales:a_data_protection_delegate_will_be_assigned>
        <ley-organica-proteccion-datos-personales:a_data_protection_delegate_will_be_assigned>When the activities of the person responsible for or in charge of the processing of personal data require a permanent and systematized control due to the volume, nature, scope or purposes of the processing, as established in the Organic Law for the Protection of Personal Data or in the regulations issued by the Authority for the Protection of Personal Data.</ley-organica-proteccion-datos-personales:a_data_protection_delegate_will_be_assigned>
        <ley-organica-proteccion-datos-personales:a_data_protection_delegate_will_be_assigned>When the data processing is not related to national security or defense of the State, and does not involve classified or confidential information as stipulated in the specialized laws in this area.</ley-organica-proteccion-datos-personales:a_data_protection_delegate_will_be_assigned>
        <ley-organica-proteccion-datos-personales:a_data_protection_delegate_will_be_assigned>When the treatment is carried out by those who make up the public sector in accordance with Article 225 of the Constitution of the Republic.</ley-organica-proteccion-datos-personales:a_data_protection_delegate_will_be_assigned>
        <ley-organica-proteccion-datos-personales:contact_data>E-mail address</ley-organica-proteccion-datos-personales:contact_data>
        <ley-organica-proteccion-datos-personales:contact_data>Home address</ley-organica-proteccion-datos-personales:contact_data>
        <ley-organica-proteccion-datos-personales:contact_data>Names and surnames</ley-organica-proteccion-datos-personales:contact_data>
        <ley-organica-proteccion-datos-personales:contact_data>Telephone number</ley-organica-proteccion-datos-personales:contact_data>
        <ley-organica-proteccion-datos-personales:control_functions>Advise on risk analysis, impact assessment and evaluation of security measures, and supervise their implementation.</ley-organica-proteccion-datos-personales:control_functions>
        <ley-organica-proteccion-datos-personales:control_functions>Advise the responsible party, the personnel of the responsible party and the person in charge of the processing of personal data, on the provisions contained in the Organic Law for the Protection of Personal Data, the regulations, directives, guidelines and other regulations issued by the Authority for the Protection of Personal Data.</ley-organica-proteccion-datos-personales:control_functions>
        <ley-organica-proteccion-datos-personales:control_functions>Cooperate with the Personal Data Protection Authority and act as a point of contact with such entity, in relation to issues concerning the processing of personal data.</ley-organica-proteccion-datos-personales:control_functions>
        <ley-organica-proteccion-datos-personales:control_functions>Perform such other functions as the Personal Data Protection Authority may assign, especially in the case of special categories of personal data.</ley-organica-proteccion-datos-personales:control_functions>
        <ley-organica-proteccion-datos-personales:control_functions>Supervise compliance with the provisions contained in the Personal Data Protection Law and the regulations, directives, guidelines and other regulations issued by the Personal Data Protection Authority.</ley-organica-proteccion-datos-personales:control_functions>
        <ley-organica-proteccion-datos-personales:type_of_person>Natural</ley-organica-proteccion-datos-personales:type_of_person>
        <rdfs:label>delegate</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#disabled_owner_data -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#disabled_owner_data">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Disabled_owner_data"/>
        <rdfs:label>disabled owner data</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#exceptions_from_rights_for_the_right_to_automated_assessments -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#exceptions_from_rights_for_the_right_to_automated_assessments">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Exceptions_of_rights"/>
        <ley-organica-proteccion-datos-personales:for rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_not_to_be_object_to_automated_evaluations"/>
        <ley-organica-proteccion-datos-personales:rights_to_not_be_the_object_of_automated_assessments>Is based on the explicit consent of the owner</ley-organica-proteccion-datos-personales:rights_to_not_be_the_object_of_automated_assessments>
        <ley-organica-proteccion-datos-personales:rights_to_not_be_the_object_of_automated_assessments>It is authorized by the applicable regulations, court order, resolution or reasoned mandate of the competent technical authority, for which adequate measures must be established to safeguard the fundamental rights and freedoms of the holder.</ley-organica-proteccion-datos-personales:rights_to_not_be_the_object_of_automated_assessments>
        <ley-organica-proteccion-datos-personales:rights_to_not_be_the_object_of_automated_assessments>The automated decision does not entail serious impacts or verifiable risks for the owner</ley-organica-proteccion-datos-personales:rights_to_not_be_the_object_of_automated_assessments>
        <ley-organica-proteccion-datos-personales:rights_to_not_be_the_object_of_automated_assessments>The automated decision is necessary for the conclusion or performance of a contract between the data subject and the controller or processor of personal data.</ley-organica-proteccion-datos-personales:rights_to_not_be_the_object_of_automated_assessments>
        <ley-organica-proteccion-datos-personales:the_right_to_not_be_object_to_automated_assessments_may_not_be_revocable>A data subject cannot be made to waive the right not to be subject to automated valuations in advance by means of contracts</ley-organica-proteccion-datos-personales:the_right_to_not_be_object_to_automated_assessments_may_not_be_revocable>
        <ley-organica-proteccion-datos-personales:the_right_to_not_be_object_to_automated_assessments_may_not_be_revocable>When a decision is made based only on automated assessments, the data subject must be clearly informed of his or her right not to be subjected to these automated assessments</ley-organica-proteccion-datos-personales:the_right_to_not_be_object_to_automated_assessments_may_not_be_revocable>
        <rdfs:label>exceptions from rights for the right to automated assessments</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#exceptions_to_rights_for_rectification_update_deletion_and_opposition -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#exceptions_to_rights_for_rectification_update_deletion_and_opposition">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Exceptions_of_rights"/>
        <ley-organica-proteccion-datos-personales:for rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_deletion"/>
        <ley-organica-proteccion-datos-personales:for rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_opposition"/>
        <ley-organica-proteccion-datos-personales:for rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_correction_and_update"/>
        <ley-organica-proteccion-datos-personales:rights_to_correct_update_update_delete_and_oppose>If the applicant is not the owner of the personal data or his legal representative is not duly accredited.</ley-organica-proteccion-datos-personales:rights_to_correct_update_update_delete_and_oppose>
        <ley-organica-proteccion-datos-personales:rights_to_correct_update_update_delete_and_oppose>In situations where the public interest is involved, the processing of personal data will be allowed, as long as international human rights standards are respected, the principles of the Organic Law for the Protection of Personal Data are complied with and the minimum criteria established by this law are followed.</ley-organica-proteccion-datos-personales:rights_to_correct_update_update_delete_and_oppose>
        <ley-organica-proteccion-datos-personales:rights_to_correct_update_update_delete_and_oppose>In the processing of personal data that are necessary for the filing of information that is part of the State&apos;s patrimony, for scientific, historical or statistical research.</ley-organica-proteccion-datos-personales:rights_to_correct_update_update_delete_and_oppose>
        <ley-organica-proteccion-datos-personales:rights_to_correct_update_update_delete_and_oppose>When it may cause damage to rights or affect the legitimate interests of third parties and this is accredited by the database controller at the time of responding to the data subject&apos;s request to exercise the respective right, i.e., if the database controller can demonstrate that complying with the data subject&apos;s request could damage the rights or legitimate interests of other persons, then it may refuse to comply with the request.</ley-organica-proteccion-datos-personales:rights_to_correct_update_update_delete_and_oppose>
        <ley-organica-proteccion-datos-personales:rights_to_correct_update_update_delete_and_oppose>When it may hinder judicial or administrative proceedings in progress, duly notified.</ley-organica-proteccion-datos-personales:rights_to_correct_update_update_delete_and_oppose>
        <ley-organica-proteccion-datos-personales:rights_to_correct_update_update_delete_and_oppose>When the data are necessary for the formulation, exercise or defense of claims or appeals.</ley-organica-proteccion-datos-personales:rights_to_correct_update_update_delete_and_oppose>
        <ley-organica-proteccion-datos-personales:rights_to_correct_update_update_delete_and_oppose>When the data are necessary to comply with a court order, resolution or reasoned mandate from a competent public authority.</ley-organica-proteccion-datos-personales:rights_to_correct_update_update_delete_and_oppose>
        <ley-organica-proteccion-datos-personales:rights_to_correct_update_update_delete_and_oppose>When the data are necessary to exercise the right to freedom of expression and opinion.</ley-organica-proteccion-datos-personales:rights_to_correct_update_update_delete_and_oppose>
        <ley-organica-proteccion-datos-personales:rights_to_correct_update_update_delete_and_oppose>When the data is necessary for the fulfillment of a legal or contractual obligation.</ley-organica-proteccion-datos-personales:rights_to_correct_update_update_delete_and_oppose>
        <ley-organica-proteccion-datos-personales:rights_to_correct_update_update_delete_and_oppose>When the data is necessary to protect the vital interest of the data subject or another natural person.</ley-organica-proteccion-datos-personales:rights_to_correct_update_update_delete_and_oppose>
        <rdfs:label>exceptions to rights for rectification update deletion and opposition</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#exercise_of_rights -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#exercise_of_rights">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Exercise_of_rights"/>
        <ley-organica-proteccion-datos-personales:description>Ability of the data subject to access information and training related to the proper use and processing of his or her personal data.</ley-organica-proteccion-datos-personales:description>
        <ley-organica-proteccion-datos-personales:must_provide_training_and_information>Civil society organizations</ley-organica-proteccion-datos-personales:must_provide_training_and_information>
        <ley-organica-proteccion-datos-personales:must_provide_training_and_information>Educational entities</ley-organica-proteccion-datos-personales:must_provide_training_and_information>
        <ley-organica-proteccion-datos-personales:must_provide_training_and_information>Providers of information and knowledge society services</ley-organica-proteccion-datos-personales:must_provide_training_and_information>
        <ley-organica-proteccion-datos-personales:must_provide_training_and_information>State</ley-organica-proteccion-datos-personales:must_provide_training_and_information>
        <rdfs:comment xml:lang="en">Ability of the data subject to access information and training related to the proper use and processing of his or her personal data.</rdfs:comment>
        <rdfs:comment xml:lang="es">Ability of the data subject to access information and training related to the proper use and processing of his or her personal data.</rdfs:comment>
        <rdfs:label>exercise of rights</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#family_or_domestic_activities -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#family_or_domestic_activities">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Family_or_domestic_activities"/>
        <ley-organica-proteccion-datos-personales:in_case_of_processing_it_must_be_compliant_with rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#principios"/>
        <ley-organica-proteccion-datos-personales:explanation_of_concept_of_inapplicability>Refers to those actions related to family and family relationships. In this context, the use of personal data could be associated with family matters, exchange of information between family members or other activities that take place within the family environment.</ley-organica-proteccion-datos-personales:explanation_of_concept_of_inapplicability>
        <rdfs:label>family or domestic activities</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#genetic_data -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#genetic_data">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Genetic_data"/>
        <ley-organica-proteccion-datos-personales:description>Unique personal data related to inherited or acquired genetic characteristics of a natural person that provide unique information about an individual&apos;s physiology or health.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">Unique personal data related to inherited or acquired genetic characteristics of a natural person that provide unique information about an individual&apos;s physiology or health.</rdfs:comment>
        <rdfs:comment xml:lang="es">Unique personal data related to inherited or acquired genetic characteristics of a natural person that provide unique information about an individual&apos;s physiology or health.</rdfs:comment>
        <rdfs:label>genetic data</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#health_related_data -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#health_related_data">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Health_Related_Data"/>
        <ley-organica-proteccion-datos-personales:description>Personal data relating to the physical or mental health of an individual, including the provision of health care services, which reveal information about his or her health status</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">Personal data relating to the physical or mental health of an individual, including the provision of health care services, which reveal information about his or her health status</rdfs:comment>
        <rdfs:comment xml:lang="es">Personal data relating to the physical or mental health of an individual, including the provision of health care services, which reveal information about his or her health status</rdfs:comment>
        <rdfs:label>health related data</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#health_related_data_processing -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#health_related_data_processing">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Health_related_data_processing"/>
        <ley-organica-proteccion-datos-personales:in_respect_to_the rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#consent"/>
        <ley-organica-proteccion-datos-personales:shall_be_authorized_by rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"/>
        <ley-organica-proteccion-datos-personales:application_scenarios_for_processing_of_data_without_consent>Treatment is necessary for reasons of public interest in the field of public health, such as in situations of serious health threats that transcend borders.</ley-organica-proteccion-datos-personales:application_scenarios_for_processing_of_data_without_consent>
        <ley-organica-proteccion-datos-personales:application_scenarios_for_processing_of_data_without_consent>Treatment is necessary to ensure high standards of quality and safety in medical care, medicines or medical devices.</ley-organica-proteccion-datos-personales:application_scenarios_for_processing_of_data_without_consent>
        <ley-organica-proteccion-datos-personales:application_scenarios_for_processing_of_data_without_consent>When the data processing is related to preventive medicine, the assessment of work capacity, medical diagnosis, the provision of medical or social assistance, or the management of health and social services.</ley-organica-proteccion-datos-personales:application_scenarios_for_processing_of_data_without_consent>
        <ley-organica-proteccion-datos-personales:application_scenarios_for_processing_of_data_without_consent>When treatment is vital to protect the patient&apos;s life and the patient is unable to give consent due to physical or legal status</ley-organica-proteccion-datos-personales:application_scenarios_for_processing_of_data_without_consent>
        <ley-organica-proteccion-datos-personales:health-related_data_collection_and_processing>The institutions that make up the National Health System and health professionals may collect and process data related to the health of their patients who are or have been under treatment by those institutions.</ley-organica-proteccion-datos-personales:health-related_data_collection_and_processing>
        <ley-organica-proteccion-datos-personales:purposes_of_the_processing_of_data_by_private_and_public_entities>Scientific research purposes</ley-organica-proteccion-datos-personales:purposes_of_the_processing_of_data_by_private_and_public_entities>
        <ley-organica-proteccion-datos-personales:scenarios_for_treatment_by_private_and_public_entities>Provided that the data processing is authorized by the Personal Data Protection Authority.</ley-organica-proteccion-datos-personales:scenarios_for_treatment_by_private_and_public_entities>
        <ley-organica-proteccion-datos-personales:scenarios_for_treatment_by_private_and_public_entities>Provided that the data used for the research are anonymized.</ley-organica-proteccion-datos-personales:scenarios_for_treatment_by_private_and_public_entities>
        <ley-organica-proteccion-datos-personales:supervise_treatment_in_health_service_management_activities>Data processing in activities related to the management of health and social services may only be carried out by professionals subject to the duty of professional secrecy or under their supervision.</ley-organica-proteccion-datos-personales:supervise_treatment_in_health_service_management_activities>
        <rdfs:label>health related data processing</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#holder_between_15_to_17_years_old -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#holder_between_15_to_17_years_old">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Holder_between_15_to_17_years_old"/>
        <ley-organica-proteccion-datos-personales:age>Persons whose age is between 15 and 17 years old</ley-organica-proteccion-datos-personales:age>
        <ley-organica-proteccion-datos-personales:can_give_explicit_consent_to_treatment rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ley-organica-proteccion-datos-personales:can_give_explicit_consent_to_treatment>
        <rdfs:label>holder between 15 to 17 years old</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#holder_over_17_years_old -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#holder_over_17_years_old">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Holder_over_17_years_old"/>
        <ley-organica-proteccion-datos-personales:age>Persons over or equal to 18 years of age</ley-organica-proteccion-datos-personales:age>
        <ley-organica-proteccion-datos-personales:can_give_explicit_consent_to_treatment rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ley-organica-proteccion-datos-personales:can_give_explicit_consent_to_treatment>
        <rdfs:label>holder over 17 years old</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#holder_under_15_years_old -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#holder_under_15_years_old">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Holder_under_15_years_old"/>
        <ley-organica-proteccion-datos-personales:must_have_a rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legal_representative_owner"/>
        <ley-organica-proteccion-datos-personales:age>Persons under 15 years of age</ley-organica-proteccion-datos-personales:age>
        <ley-organica-proteccion-datos-personales:can_give_explicit_consent_to_treatment rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ley-organica-proteccion-datos-personales:can_give_explicit_consent_to_treatment>
        <rdfs:label>holder under 15 years old</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#inapplicability -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#inapplicability">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Inapplicability"/>
        <ley-organica-proteccion-datos-personales:is_the_non_application_of_the_law_in rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#anonymized_data"/>
        <ley-organica-proteccion-datos-personales:is_the_non_application_of_the_law_in rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_or_database_of_criminal_infractions"/>
        <ley-organica-proteccion-datos-personales:is_the_non_application_of_the_law_in rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#deceased_persons_data"/>
        <ley-organica-proteccion-datos-personales:is_the_non_application_of_the_law_in rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#family_or_domestic_activities"/>
        <ley-organica-proteccion-datos-personales:is_the_non_application_of_the_law_in rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#journalistic_activities"/>
        <ley-organica-proteccion-datos-personales:is_the_non_application_of_the_law_in rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legal_persons_data"/>
        <ley-organica-proteccion-datos-personales:is_the_non_application_of_the_law_in rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_under_specialized_regulations"/>
        <ley-organica-proteccion-datos-personales:scope_of_legislation>The Organic Law on Personal Data Protection will not apply in certain cases.</ley-organica-proteccion-datos-personales:scope_of_legislation>
        <rdfs:label>inapplicability</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#independence_of_control -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#independence_of_control">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Independence_of_control"/>
        <ley-organica-proteccion-datos-personales:is_supervised_by rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"/>
        <ley-organica-proteccion-datos-personales:description>Capacity of the Data Protection Authority to carry out its functions of supervision and application of the Organic Law on Data Protection in an impartial manner and without external interference.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">Capacity of the Data Protection Authority to carry out its functions of supervision and application of the Organic Law on Data Protection in an impartial manner and without external interference.</rdfs:comment>
        <rdfs:comment xml:lang="es">Capacity of the Data Protection Authority to carry out its functions of supervision and application of the Organic Law on Data Protection in an impartial manner and without external interference.</rdfs:comment>
        <rdfs:label>independence of control</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#journalistic_activities -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#journalistic_activities">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Journalistic_activities"/>
        <ley-organica-proteccion-datos-personales:explanation_of_concept_of_inapplicability>Refers to the practices and processes involved in the production and dissemination of news and editorial content by journalistic professionals.</ley-organica-proteccion-datos-personales:explanation_of_concept_of_inapplicability>
        <rdfs:label>journalistic activities</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#juridicity -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#juridicity">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Juridicity"/>
        <ley-organica-proteccion-datos-personales:description>Personal data must be processed in strict compliance with the principles, rights and obligations established in the Constitution, international instruments, this Law, its Regulations and other applicable rules and jurisprudence.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">Personal data must be processed in strict compliance with the principles, rights and obligations established in the Constitution, international instruments, this Law, its Regulations and other applicable rules and jurisprudence.</rdfs:comment>
        <rdfs:comment xml:lang="es">Personal data must be processed in strict compliance with the principles, rights and obligations established in the Constitution, international instruments, this Law, its Regulations and other applicable rules and jurisprudence.</rdfs:comment>
        <rdfs:label>juridicity</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legal_interest -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legal_interest">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Legal_interest"/>
        <ley-organica-proteccion-datos-personales:description>Legal justification for the processing of personal data that is not directly related to the individual&apos;s consent, compliance with a legal obligation or the performance of a contract.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">Legal justification for the processing of personal data that is not directly related to the individual&apos;s consent, compliance with a legal obligation or the performance of a contract.</rdfs:comment>
        <rdfs:comment xml:lang="es">Legal justification for the processing of personal data that is not directly related to the individual&apos;s consent, compliance with a legal obligation or the performance of a contract.</rdfs:comment>
        <rdfs:label>legal interest</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legal_persons_data -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legal_persons_data">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Legal_persons_data"/>
        <ley-organica-proteccion-datos-personales:explanation_of_concept_of_inapplicability>Data that identifies or makes identifiable legal entities</ley-organica-proteccion-datos-personales:explanation_of_concept_of_inapplicability>
        <ley-organica-proteccion-datos-personales:information_suceptible_to_treatment_is_accessible>Public</ley-organica-proteccion-datos-personales:information_suceptible_to_treatment_is_accessible>
        <ley-organica-proteccion-datos-personales:treatment_suceptible_information>In the case of public servants, the historical and updated information of their asset declaration and remuneration shall be submitted for processing.</ley-organica-proteccion-datos-personales:treatment_suceptible_information>
        <ley-organica-proteccion-datos-personales:treatment_suceptible_information>Personal data concerning the contact of professionals and commercial data</ley-organica-proteccion-datos-personales:treatment_suceptible_information>
        <ley-organica-proteccion-datos-personales:treatment_suceptible_information>Representatives, partners and shareholders of legal entities, as well as public servants, may be subject to the processing of personal data in the context of their professional practice, line of business, competencies, powers, attributions or positions. This processing refers specifically to information such as names and surnames, functions or positions held, postal or e-mail addresses and professional telephone numbers.</ley-organica-proteccion-datos-personales:treatment_suceptible_information>
        <rdfs:label>legal persons data</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legal_representative_owner -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legal_representative_owner">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Legal_representative_owner"/>
        <ley-organica-proteccion-datos-personales:activity_of_the_legal_representative_owner>Ensure that the rights and privacy of the owner he/she represents are respected at all times.</ley-organica-proteccion-datos-personales:activity_of_the_legal_representative_owner>
        <ley-organica-proteccion-datos-personales:activity_of_the_legal_representative_owner>Make informed decisions about the processing of the personal data of the owner he/she represents.</ley-organica-proteccion-datos-personales:activity_of_the_legal_representative_owner>
        <ley-organica-proteccion-datos-personales:activity_of_the_legal_representative_owner>Provide consent for the processing of data on behalf of the data subject he/she represents.</ley-organica-proteccion-datos-personales:activity_of_the_legal_representative_owner>
        <ley-organica-proteccion-datos-personales:description>The legal representative of an owner who is unable to give consent acts on behalf of and in the interest of the owner in situations where the owner is unable to give consent due to incapacity, minority or other similar circumstances.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">The legal representative of an owner who is unable to give consent acts on behalf of and in the interest of the owner in situations where the owner is unable to give consent due to incapacity, minority or other similar circumstances.</rdfs:comment>
        <rdfs:comment xml:lang="es">The legal representative of an owner who is unable to give consent acts on behalf of and in the interest of the owner in situations where the owner is unable to give consent due to incapacity, minority or other similar circumstances.</rdfs:comment>
        <rdfs:label>legal representative owner</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legality -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legality">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Legality"/>
        <ley-organica-proteccion-datos-personales:description>Data processing must be carried out in accordance with the Organic Law on Personal Data Protection.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">Data processing must be carried out in accordance with the Organic Law on Personal Data Protection.</rdfs:comment>
        <rdfs:comment xml:lang="es">Data processing must be carried out in accordance with the Organic Law on Personal Data Protection.</rdfs:comment>
        <rdfs:label>legality</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#location_of_the_personal_data_protection_system_members -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#location_of_the_personal_data_protection_system_members">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Location_of_the_personal_data_protection_system_integrants"/>
        <ley-organica-proteccion-datos-personales:territorial_application_scenario>If the controller or processor of personal data is not domiciled in the national territory, the Organic Law on Personal Data Protection may apply due to a specific contract or public international law regulations. In other words, even if the controller or processor does not reside in Ecuador, they may be subject to comply with the country&apos;s data protection law due to contractual agreements or international regulations.</ley-organica-proteccion-datos-personales:territorial_application_scenario>
        <ley-organica-proteccion-datos-personales:territorial_application_scenario>If the data subject resides in Ecuador and the controller or processor has no establishment in the country, and the data processing is linked to activities that include the offer of goods or services to data subjects, whether or not it involves payment, or is intended to monitor their behavior, provided that such monitoring is carried out within Ecuadorian territory.</ley-organica-proteccion-datos-personales:territorial_application_scenario>
        <ley-organica-proteccion-datos-personales:territorial_application_scenario>If the person in charge of or responsible for the processing of personal data is domiciled in any part of national territory</ley-organica-proteccion-datos-personales:territorial_application_scenario>
        <rdfs:label>location of the personal data protection system members</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#loyalty -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#loyalty">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Loyalty"/>
        <ley-organica-proteccion-datos-personales:description>The data subject should clearly know that they are collecting, using or processing your personal data, and how it will be treated.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">The data subject should clearly know that they are collecting, using or processing your personal data, and how it will be treated.</rdfs:comment>
        <rdfs:comment xml:lang="es">The data subject should clearly know that they are collecting, using or processing your personal data, and how it will be treated.</rdfs:comment>
        <rdfs:label>loyalty</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minimization_of_personal_data -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minimization_of_personal_data">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Minimization"/>
        <ley-organica-proteccion-datos-personales:description>It implies that the amount of data collected must be limited and restricted to what is strictly necessary to fulfill the purpose of the processing.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">It implies that the amount of data collected must be limited and restricted to what is strictly necessary to fulfill the purpose of the processing.</rdfs:comment>
        <rdfs:comment xml:lang="es">It implies that the amount of data collected must be limited and restricted to what is strictly necessary to fulfill the purpose of the processing.</rdfs:comment>
        <rdfs:label>minimization of personal data</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minimum_criteria -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minimum_criteria">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Minimum_criteria"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#legality"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#need"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proportionality"/>
        <rdfs:label>minimum criteria</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minor_infractions -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minor_infractions">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Minor_infractions"/>
        <ley-organica-proteccion-datos-personales:committed_by rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processor"/>
        <ley-organica-proteccion-datos-personales:committed_by rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minor_infractions_penalties -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minor_infractions_penalties">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Minor_infractions_penalties"/>
        <ley-organica-proteccion-datos-personales:by rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minor_infractions"/>
        <ley-organica-proteccion-datos-personales:is_related_to rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proportionality"/>
        <ley-organica-proteccion-datos-personales:is_related_to rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#turnover"/>
        <ley-organica-proteccion-datos-personales:will_be_imposed_by rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"/>
        <ley-organica-proteccion-datos-personales:destined_for>Servidores o funcionarios del sector público</ley-organica-proteccion-datos-personales:destined_for>
        <ley-organica-proteccion-datos-personales:destined_for>The Controller or Processor of personal data or, if applicable, a third party, may be a private law entity or a public company.</ley-organica-proteccion-datos-personales:destined_for>
        <ley-organica-proteccion-datos-personales:determination_of_the_fine_in_respect_to_penalties_for_infringement_of_the_responsible_person_or_person_in_charge_of_treatment>Intentionality, which will evaluate the offender&apos;s conduct to determine if there was intent to commit the infraction.</ley-organica-proteccion-datos-personales:determination_of_the_fine_in_respect_to_penalties_for_infringement_of_the_responsible_person_or_person_in_charge_of_treatment>
        <ley-organica-proteccion-datos-personales:determination_of_the_fine_in_respect_to_penalties_for_infringement_of_the_responsible_person_or_person_in_charge_of_treatment>Nature of the damage, where the negative consequences for the right to the protection of personal data will be evaluated.</ley-organica-proteccion-datos-personales:determination_of_the_fine_in_respect_to_penalties_for_infringement_of_the_responsible_person_or_person_in_charge_of_treatment>
        <ley-organica-proteccion-datos-personales:determination_of_the_fine_in_respect_to_penalties_for_infringement_of_the_responsible_person_or_person_in_charge_of_treatment>Recidivism, which is considered when the previous infraction is similar to the one to be sanctioned again.</ley-organica-proteccion-datos-personales:determination_of_the_fine_in_respect_to_penalties_for_infringement_of_the_responsible_person_or_person_in_charge_of_treatment>
        <ley-organica-proteccion-datos-personales:determination_of_the_fine_in_respect_to_penalties_for_infringement_of_the_responsible_person_or_person_in_charge_of_treatment>Reiteration of the infraction, which considers when the controller or processor of personal data has been previously sanctioned for two or more infractions of lesser gravity, or for an infraction of equal or greater gravity.</ley-organica-proteccion-datos-personales:determination_of_the_fine_in_respect_to_penalties_for_infringement_of_the_responsible_person_or_person_in_charge_of_treatment>
        <ley-organica-proteccion-datos-personales:principle_of_attachment_with_sanction_to_the_responsible_party_or_the_treatment_manager>Proportionality</ley-organica-proteccion-datos-personales:principle_of_attachment_with_sanction_to_the_responsible_party_or_the_treatment_manager>
        <ley-organica-proteccion-datos-personales:type_of_penalty_for_infractions_to_the_responsible_party_or_the_processor>A fine ranging from 0.1% to 0.7% of the turnover for the fiscal year immediately preceding the imposition of the fine shall be imposed.</ley-organica-proteccion-datos-personales:type_of_penalty_for_infractions_to_the_responsible_party_or_the_processor>
        <ley-organica-proteccion-datos-personales:type_of_penalty_for_infractions_toward_public_servants_or_officials>Shall be sanctioned with a fine ranging from 1 to 10 basic unified salaries of the public servant or public official</ley-organica-proteccion-datos-personales:type_of_penalty_for_infractions_toward_public_servants_or_officials>
        <ley-organica-proteccion-datos-personales:type_of_penalty_for_infractions_toward_public_servants_or_officials>This sanction does not rule out the possibility of the State assuming additional liability for damages caused, which will be governed in accordance with the corresponding regulations.</ley-organica-proteccion-datos-personales:type_of_penalty_for_infractions_toward_public_servants_or_officials>
        <rdfs:label>minor infractions penalties</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#need -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#need">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Need"/>
        <ley-organica-proteccion-datos-personales:description>Data processing must be necessary to achieve the intended purpose and no more data must be collected than is necessary for that specific purpose.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">Data processing must be necessary to achieve the intended purpose and no more data must be collected than is necessary for that specific purpose.</rdfs:comment>
        <rdfs:comment xml:lang="es">Data processing must be necessary to achieve the intended purpose and no more data must be collected than is necessary for that specific purpose.</rdfs:comment>
        <rdfs:label>need</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#normativa_especializada -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#normativa_especializada">
        <rdfs:label>normativa especializada</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#organic_law_on_personal_data_protection -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#organic_law_on_personal_data_protection">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Organic_Law_on_Personal_Data_Protection"/>
        <ley-organica-proteccion-datos-personales:target>The fundamental purpose of the Organic Law on Personal Data Protection is to ensure the effective application of the right to the protection of personal data. This right covers both access to and decision-making on information and data of a personal nature and the guarantee of their due protection. To this end, the law regulates, foresees and develops principles, rights, obligations and protection mechanisms necessary to comprehensively safeguard the privacy and security of personal data.</ley-organica-proteccion-datos-personales:target>
        <rdfs:label>organic law on personal data protection</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#penalties_for_Serious_Infringements -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#penalties_for_Serious_Infringements">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Penalties_for_Serious_Infringements"/>
        <ley-organica-proteccion-datos-personales:by rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#serious_infractions"/>
        <ley-organica-proteccion-datos-personales:is_related_to rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proportionality"/>
        <ley-organica-proteccion-datos-personales:is_related_to rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#turnover"/>
        <ley-organica-proteccion-datos-personales:will_be_imposed_by rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"/>
        <ley-organica-proteccion-datos-personales:destined_for>Public sector employees or officials</ley-organica-proteccion-datos-personales:destined_for>
        <ley-organica-proteccion-datos-personales:destined_for>The Controller or Processor of personal data or, if applicable, a third party, may be a private law entity or a public company.</ley-organica-proteccion-datos-personales:destined_for>
        <ley-organica-proteccion-datos-personales:determination_of_the_fine_in_respect_to_penalties_for_infringement_of_the_responsible_person_or_person_in_charge_of_treatment>Intentionality, which will evaluate the offender&apos;s conduct to determine if there was intent to commit the infraction.</ley-organica-proteccion-datos-personales:determination_of_the_fine_in_respect_to_penalties_for_infringement_of_the_responsible_person_or_person_in_charge_of_treatment>
        <ley-organica-proteccion-datos-personales:determination_of_the_fine_in_respect_to_penalties_for_infringement_of_the_responsible_person_or_person_in_charge_of_treatment>Nature of the damage, where the negative consequences for the right to the protection of personal data will be evaluated.</ley-organica-proteccion-datos-personales:determination_of_the_fine_in_respect_to_penalties_for_infringement_of_the_responsible_person_or_person_in_charge_of_treatment>
        <ley-organica-proteccion-datos-personales:determination_of_the_fine_in_respect_to_penalties_for_infringement_of_the_responsible_person_or_person_in_charge_of_treatment>Recidivism, which is considered when the previous infraction is similar to the one to be sanctioned again.</ley-organica-proteccion-datos-personales:determination_of_the_fine_in_respect_to_penalties_for_infringement_of_the_responsible_person_or_person_in_charge_of_treatment>
        <ley-organica-proteccion-datos-personales:determination_of_the_fine_in_respect_to_penalties_for_infringement_of_the_responsible_person_or_person_in_charge_of_treatment>Reiteration of the infraction, which considers when the controller or processor of personal data has been previously sanctioned for two or more infractions of lesser gravity, or for an infraction of equal or greater gravity.</ley-organica-proteccion-datos-personales:determination_of_the_fine_in_respect_to_penalties_for_infringement_of_the_responsible_person_or_person_in_charge_of_treatment>
        <ley-organica-proteccion-datos-personales:type_of_penalty_for_infractions_to_the_responsible_party_or_the_processor>A fine ranging from 0.7% to 1% of the turnover for the fiscal year immediately preceding the imposition of the fine shall be imposed.</ley-organica-proteccion-datos-personales:type_of_penalty_for_infractions_to_the_responsible_party_or_the_processor>
        <ley-organica-proteccion-datos-personales:type_of_penalty_for_infractions_toward_public_servants_or_officials>It shall be punished with a fine ranging from 10 to 20 unified basic salaries of the public servant or official.</ley-organica-proteccion-datos-personales:type_of_penalty_for_infractions_toward_public_servants_or_officials>
        <ley-organica-proteccion-datos-personales:type_of_penalty_for_infractions_toward_public_servants_or_officials>This sanction does not rule out the possibility of the State assuming additional liability for damages caused, which will be governed in accordance with the corresponding regulations.</ley-organica-proteccion-datos-personales:type_of_penalty_for_infractions_toward_public_servants_or_officials>
        <rdfs:label>penalties for Serious Infringements</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data"/>
        <ley-organica-proteccion-datos-personales:must_comply_with rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#principios"/>
        <ley-organica-proteccion-datos-personales:personal_data_are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#biometric_data"/>
        <ley-organica-proteccion-datos-personales:personal_data_are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#credit_data"/>
        <ley-organica-proteccion-datos-personales:personal_data_are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#deceased_persons_data"/>
        <ley-organica-proteccion-datos-personales:personal_data_are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#genetic_data"/>
        <ley-organica-proteccion-datos-personales:personal_data_are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#health_related_data"/>
        <ley-organica-proteccion-datos-personales:personal_data_are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#sensitive_data"/>
        <ley-organica-proteccion-datos-personales:personal_data_are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#specialized_subject_data"/>
        <ley-organica-proteccion-datos-personales:description>Data that identifies or makes identifiable a natural person, directly or indirectly.</ley-organica-proteccion-datos-personales:description>
        <ley-organica-proteccion-datos-personales:it_is_not_imputable_to_be_inaccurate_when>If the inaccurate data was obtained directly by the controller from the data subject</ley-organica-proteccion-datos-personales:it_is_not_imputable_to_be_inaccurate_when>
        <ley-organica-proteccion-datos-personales:it_is_not_imputable_to_be_inaccurate_when>If the inaccurate data were obtained by the data controller from a public record</ley-organica-proteccion-datos-personales:it_is_not_imputable_to_be_inaccurate_when>
        <ley-organica-proteccion-datos-personales:it_is_not_imputable_to_be_inaccurate_when>If the inaccurate data were obtained by the data controller through an intermediary, following the regulations applicable in the sector that allow the intervention of an intermediary to collect and transmit the data to the data controller</ley-organica-proteccion-datos-personales:it_is_not_imputable_to_be_inaccurate_when>
        <ley-organica-proteccion-datos-personales:to_comply_with_quality_you_must>Accurate, i.e. the personal data must be precise and faithfully reflect the reality or situation they represent, without errors, contradictions or inaccuracies.</ley-organica-proteccion-datos-personales:to_comply_with_quality_you_must>
        <ley-organica-proteccion-datos-personales:to_comply_with_quality_you_must>Accurate, that personal data must be correct and accurately reflect reality without errors or inaccuracies.</ley-organica-proteccion-datos-personales:to_comply_with_quality_you_must>
        <ley-organica-proteccion-datos-personales:to_comply_with_quality_you_must>Clear, i.e. personal data must be understandable and not give rise to ambiguous or confusing interpretations.</ley-organica-proteccion-datos-personales:to_comply_with_quality_you_must>
        <ley-organica-proteccion-datos-personales:to_comply_with_quality_you_must>Complete, i.e. the personal data must include all relevant and necessary details for the purpose of processing, without omitting important information.</ley-organica-proteccion-datos-personales:to_comply_with_quality_you_must>
        <ley-organica-proteccion-datos-personales:to_comply_with_quality_you_must>Integral, that is to say, the personal data must not have been altered, modified or corrupted in any way that affects its veracity.</ley-organica-proteccion-datos-personales:to_comply_with_quality_you_must>
        <ley-organica-proteccion-datos-personales:to_comply_with_quality_you_must>Updated, i.e. personal data must reflect the most recent situation of the person or object to which it refers, and be modified or updated when necessary to maintain its validity.</ley-organica-proteccion-datos-personales:to_comply_with_quality_you_must>
        <ley-organica-proteccion-datos-personales:to_comply_with_quality_you_must>Verifiable, i.e. personal data must be verifiable and capable of being checked against reliable sources or evidence to confirm its authenticity and validity.</ley-organica-proteccion-datos-personales:to_comply_with_quality_you_must>
        <rdfs:comment xml:lang="en">Data that identifies or makes identifiable a natural person, directly or indirectly.</rdfs:comment>
        <rdfs:comment xml:lang="es">Data that identifies or makes identifiable a natural person, directly or indirectly.</rdfs:comment>
        <rdfs:label>personal data</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_protection_authority"/>
        <ley-organica-proteccion-datos-personales:actions_regarding_health_data_processing>For when dealing with anonymized health data</ley-organica-proteccion-datos-personales:actions_regarding_health_data_processing>
        <ley-organica-proteccion-datos-personales:actions_regarding_independence_of_control>Investigation action, which involves carrying out investigations into possible violations of data protection legislation in an independent and partial manner.</ley-organica-proteccion-datos-personales:actions_regarding_independence_of_control>
        <ley-organica-proteccion-datos-personales:actions_regarding_independence_of_control>Prevention action, which consists of promoting good practices and providing guidance and advice to organizations and citizens on how to protect personal data and comply with privacy regulations.</ley-organica-proteccion-datos-personales:actions_regarding_independence_of_control>
        <ley-organica-proteccion-datos-personales:actions_regarding_independence_of_control>Sanction action, which arises once violations of data protection legislation are identified, whereby the Data Protection Authority has the power to impose appropriate and proportionate sanctions.</ley-organica-proteccion-datos-personales:actions_regarding_independence_of_control>
        <ley-organica-proteccion-datos-personales:authorization_for_treatment_of_anonymized_health_data>A favorable report from the Health Authority, which confirms that the technical protocol complies with the standards and regulations established by the Organic Law on Personal Data Protection and other related laws.</ley-organica-proteccion-datos-personales:authorization_for_treatment_of_anonymized_health_data>
        <ley-organica-proteccion-datos-personales:authorization_for_treatment_of_anonymized_health_data>Provide technical protocol containing the necessary details to ensure the protection of health data.</ley-organica-proteccion-datos-personales:authorization_for_treatment_of_anonymized_health_data>
        <ley-organica-proteccion-datos-personales:control_functions>It is the control and oversight body responsible for guaranteeing all citizens the protection of their personal data, and for taking all necessary actions to ensure that the principles, rights, guarantees and procedures set forth in the Organic Law on Personal Data Protection and its implementing regulations are respected.</ley-organica-proteccion-datos-personales:control_functions>
        <ley-organica-proteccion-datos-personales:designation>The Personal Data Protection Authority shall be appointed in accordance with the provisions of the Constitution of the Republic.</ley-organica-proteccion-datos-personales:designation>
        <ley-organica-proteccion-datos-personales:designation>The appointment is made from a list of three candidates provided by the President of the Republic</ley-organica-proteccion-datos-personales:designation>
        <ley-organica-proteccion-datos-personales:designation>The selection is based on criteria of specialization and merit, and the process is public, allowing for citizen challenges.</ley-organica-proteccion-datos-personales:designation>
        <ley-organica-proteccion-datos-personales:duration_of_charge>The Personal Data Protection Authority will exercise its functions for a period of 5 years.</ley-organica-proteccion-datos-personales:duration_of_charge>
        <ley-organica-proteccion-datos-personales:functions>Apply sanctions to those responsible, delegates, persons in charge and third parties, in accordance with the provisions of the Organic Law on Personal Data Protection.</ley-organica-proteccion-datos-personales:functions>
        <ley-organica-proteccion-datos-personales:functions>Attending to consultations on personal data protection matters</ley-organica-proteccion-datos-personales:functions>
        <ley-organica-proteccion-datos-personales:functions>Control and supervise the exercise of the right to personal data protection within the data processing carried out through the National System of Public Registries.</ley-organica-proteccion-datos-personales:functions>
        <ley-organica-proteccion-datos-personales:functions>Create, manage and administer the National Registry of Personal Data Protection, and collaborate with public and private entities to ensure its correct operation.</ley-organica-proteccion-datos-personales:functions>
        <ley-organica-proteccion-datos-personales:functions>Establish guidelines for the analysis, evaluation and selection of personal data security measures.</ley-organica-proteccion-datos-personales:functions>
        <ley-organica-proteccion-datos-personales:functions>Exercise the supervision, control and evaluation of the activities carried out by the person responsible for and in charge of the processing of personal data.</ley-organica-proteccion-datos-personales:functions>
        <ley-organica-proteccion-datos-personales:functions>Investigate, analyze and resolve complaints filed by data subjects, as well as those initiated by the Personal Data Protection Authority, in addition to imposing appropriate sanctions</ley-organica-proteccion-datos-personales:functions>
        <ley-organica-proteccion-datos-personales:functions>Issue guidelines for the design and content of the personal data processing policy.</ley-organica-proteccion-datos-personales:functions>
        <ley-organica-proteccion-datos-personales:functions>Keep a statistical record of personal data security breaches and identify possible security measures for each of them.</ley-organica-proteccion-datos-personales:functions>
        <ley-organica-proteccion-datos-personales:functions>Perform or delegate technical audits to the processing of personal data.</ley-organica-proteccion-datos-personales:functions>
        <ley-organica-proteccion-datos-personales:functions>Periodically publish a guide to personal data protection regulations.</ley-organica-proteccion-datos-personales:functions>
        <ley-organica-proteccion-datos-personales:functions>Promote adequate and effective coordination with accountability officers and participate in international and regional initiatives for the protection of personal data protection.</ley-organica-proteccion-datos-personales:functions>
        <ley-organica-proteccion-datos-personales:functions>Promote and encourage the exercise of the right to the protection of personal data, as well as the awareness and understanding of the risks, rules, guarantees and rights of individuals in relation to the processing and use of their personal data, with special emphasis on activities aimed at priority groups such as children and adolescents.</ley-organica-proteccion-datos-personales:functions>
        <ley-organica-proteccion-datos-personales:functions>To dictate standard data protection clauses and verify the content of additional or specific clauses or guarantees.</ley-organica-proteccion-datos-personales:functions>
        <ley-organica-proteccion-datos-personales:functions>To issue general or technical regulations, criteria and other acts necessary for the exercise of its powers and the guarantee of the exercise of the right to the protection of personal data.</ley-organica-proteccion-datos-personales:functions>
        <ley-organica-proteccion-datos-personales:functions>To represent internationally the interests related to the protection of personal data.</ley-organica-proteccion-datos-personales:functions>
        <ley-organica-proteccion-datos-personales:known_as>Data Protection Superintendent</ley-organica-proteccion-datos-personales:known_as>
        <ley-organica-proteccion-datos-personales:requirements_that_must_be_met>Must have at least a fourth level degree and a minimum of 10 years of experience in areas related to the regulation of the Organic Law for the Protection of Personal Data.</ley-organica-proteccion-datos-personales:requirements_that_must_be_met>
        <ley-organica-proteccion-datos-personales:requirements_that_must_be_met>The Personal Data Protection Authority must be a professional in law, information systems, communication or technology.</ley-organica-proteccion-datos-personales:requirements_that_must_be_met>
        <ley-organica-proteccion-datos-personales:revocation>His mandate can only be revoked by impeachment after an impeachment trial conducted by the National Assembly.</ley-organica-proteccion-datos-personales:revocation>
        <ley-organica-proteccion-datos-personales:revocation>Its mandate can only be revoked in accordance with the grounds established in the Ecuadorian laws regulating public service.</ley-organica-proteccion-datos-personales:revocation>
        <ley-organica-proteccion-datos-personales:type_authority>Public</ley-organica-proteccion-datos-personales:type_authority>
        <rdfs:label>personal data protection authority</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_seals -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_seals">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_protection_seals"/>
        <ley-organica-proteccion-datos-personales:is_given_by rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processor"/>
        <ley-organica-proteccion-datos-personales:is_given_by rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"/>
        <ley-organica-proteccion-datos-personales:description>Recognition awarded for having implemented best practices in the processes, thus contributing to promote the holder&apos;s confidence.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">Recognition awarded for having implemented best practices in the processes, thus contributing to promote the holder&apos;s confidence.</rdfs:comment>
        <rdfs:comment xml:lang="es">Recognition awarded for having implemented best practices in the processes, thus contributing to promote the holder&apos;s confidence.</rdfs:comment>
        <rdfs:label>personal data protection seals</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_security_vulnerability -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_security_vulnerability">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_security_vulnerability"/>
        <ley-organica-proteccion-datos-personales:affects_to>Availability of personal data</ley-organica-proteccion-datos-personales:affects_to>
        <ley-organica-proteccion-datos-personales:affects_to>Confidentiality of personal data</ley-organica-proteccion-datos-personales:affects_to>
        <ley-organica-proteccion-datos-personales:affects_to>Integrity of personal data</ley-organica-proteccion-datos-personales:affects_to>
        <ley-organica-proteccion-datos-personales:description>Security incident</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">Security incident</rdfs:comment>
        <rdfs:comment xml:lang="es">Security incident</rdfs:comment>
        <rdfs:label>personal data security vulnerability</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_under_specialized_regulations -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_under_specialized_regulations">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data_under_specialized_regulations"/>
        <ley-organica-proteccion-datos-personales:explanation_of_concept_of_inapplicability>Personal data whose processing is regulated in specialized regulations of equal or higher hierarchy in matters of risk management for natural disasters; and, security and defense of the State, in any of these cases must comply with international standards in the field of human rights and the principles of this Law, and at least with the criteria of legality, proportionality and necessity.</ley-organica-proteccion-datos-personales:explanation_of_concept_of_inapplicability>
        <rdfs:label>personal data under specialized regulations</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#principios -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#principios">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Principles"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Purpose"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#application_favorable_to_the_owner"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#confidentiality"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#conservation"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#independence_of_control"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#juridicity"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#loyalty"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minimization_of_personal_data"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proactive_and_demonstrated_accountability"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proportionality"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#quality"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#relevance_of_personal_data"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#security"/>
        <ley-organica-proteccion-datos-personales:are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#transparency"/>
        <ley-organica-proteccion-datos-personales:description>La Ley Orgnánica de Protección de Datos Personale se regirá por un conjunto de principios, sin perjuicio de otros principios establecidos en la Constitución de la República, los instrumentos internacionales ratificados por el Estado u otras normas jurídicas</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">La Ley Orgnánica de Protección de Datos Personale se regirá por un conjunto de principios, sin perjuicio de otros principios establecidos en la Constitución de la República, los instrumentos internacionales ratificados por el Estado u otras normas jurídicas</rdfs:comment>
        <rdfs:comment xml:lang="es">La Ley Orgnánica de Protección de Datos Personale se regirá por un conjunto de principios, sin perjuicio de otros principios establecidos en la Constitución de la República, los instrumentos internacionales ratificados por el Estado u otras normas jurídicas</rdfs:comment>
        <rdfs:label>principios</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proactive_and_demonstrated_accountability -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proactive_and_demonstrated_accountability">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Proactive_and_demonstrated_accountability"/>
        <ley-organica-proteccion-datos-personales:is_implemented_by rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"/>
        <ley-organica-proteccion-datos-personales:description>The person or entity responsible for handling personal data must take measures in advance to protect that information and personal data, which implies demonstrating that mechanisms and actions have been implemented to ensure that the data are handled securely and in accordance with the Organic Law on Personal Data Protection.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">The person or entity responsible for handling personal data must take measures in advance to protect that information and personal data, which implies demonstrating that mechanisms and actions have been implemented to ensure that the data are handled securely and in accordance with the Organic Law on Personal Data Protection.</rdfs:comment>
        <rdfs:comment xml:lang="es">The person or entity responsible for handling personal data must take measures in advance to protect that information and personal data, which implies demonstrating that mechanisms and actions have been implemented to ensure that the data are handled securely and in accordance with the Organic Law on Personal Data Protection.</rdfs:comment>
        <rdfs:label>proactive and demonstrated accountability</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#processing -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#processing">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Processing"/>
        <ley-organica-proteccion-datos-personales:is_related_to rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processing"/>
        <ley-organica-proteccion-datos-personales:is_related_to rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#scope_of_application"/>
        <ley-organica-proteccion-datos-personales:description>El conjunto de acciones o procedimientos que se aplican a los datos o información con el fin de transformarlos, analizarlos, organizarlos o manipularlos de alguna manera para obtener resultados específicos</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">El conjunto de acciones o procedimientos que se aplican a los datos o información con el fin de transformarlos, analizarlos, organizarlos o manipularlos de alguna manera para obtener resultados específicos</rdfs:comment>
        <rdfs:comment xml:lang="es">El conjunto de acciones o procedimientos que se aplican a los datos o información con el fin de transformarlos, analizarlos, organizarlos o manipularlos de alguna manera para obtener resultados específicos</rdfs:comment>
        <rdfs:label>processing</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#profile_making -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#profile_making">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Profile_making"/>
        <ley-organica-proteccion-datos-personales:data_processing_is_intended_for_individuals>Natural</ley-organica-proteccion-datos-personales:data_processing_is_intended_for_individuals>
        <ley-organica-proteccion-datos-personales:description>Refers to any personal data processing process that aims to evaluate, analyze or predict various aspects of a natural person.</ley-organica-proteccion-datos-personales:description>
        <ley-organica-proteccion-datos-personales:to_determine_behaviors_or_standards_relative_to>Economic situation</ley-organica-proteccion-datos-personales:to_determine_behaviors_or_standards_relative_to>
        <ley-organica-proteccion-datos-personales:to_determine_behaviors_or_standards_relative_to>Health</ley-organica-proteccion-datos-personales:to_determine_behaviors_or_standards_relative_to>
        <ley-organica-proteccion-datos-personales:to_determine_behaviors_or_standards_relative_to>Intereses</ley-organica-proteccion-datos-personales:to_determine_behaviors_or_standards_relative_to>
        <ley-organica-proteccion-datos-personales:to_determine_behaviors_or_standards_relative_to>Location</ley-organica-proteccion-datos-personales:to_determine_behaviors_or_standards_relative_to>
        <ley-organica-proteccion-datos-personales:to_determine_behaviors_or_standards_relative_to>Other similar aspects</ley-organica-proteccion-datos-personales:to_determine_behaviors_or_standards_relative_to>
        <ley-organica-proteccion-datos-personales:to_determine_behaviors_or_standards_relative_to>Personal preferences</ley-organica-proteccion-datos-personales:to_determine_behaviors_or_standards_relative_to>
        <ley-organica-proteccion-datos-personales:to_determine_behaviors_or_standards_relative_to>Physical movement</ley-organica-proteccion-datos-personales:to_determine_behaviors_or_standards_relative_to>
        <ley-organica-proteccion-datos-personales:to_determine_behaviors_or_standards_relative_to>Professional performance</ley-organica-proteccion-datos-personales:to_determine_behaviors_or_standards_relative_to>
        <ley-organica-proteccion-datos-personales:to_determine_behaviors_or_standards_relative_to>Skills</ley-organica-proteccion-datos-personales:to_determine_behaviors_or_standards_relative_to>
        <rdfs:comment xml:lang="en">Refers to any personal data processing process that aims to evaluate, analyze or predict various aspects of a natural person.</rdfs:comment>
        <rdfs:comment xml:lang="es">Refers to any personal data processing process that aims to evaluate, analyze or predict various aspects of a natural person.</rdfs:comment>
        <rdfs:label>profile making</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proportionality -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#proportionality">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Proportionality"/>
        <ley-organica-proteccion-datos-personales:description>It involves ensuring that the way in which personal data is handled is balanced and appropriate in relation to the purposes for which the data was collected and the nature of the information involved</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">It involves ensuring that the way in which personal data is handled is balanced and appropriate in relation to the purposes for which the data was collected and the nature of the information involved</rdfs:comment>
        <rdfs:comment xml:lang="es">It involves ensuring that the way in which personal data is handled is balanced and appropriate in relation to the purposes for which the data was collected and the nature of the information involved</rdfs:comment>
        <rdfs:label>proportionality</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#pseudonymization -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#pseudonymization">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Pseudonymization"/>
        <ley-organica-proteccion-datos-personales:description>The process of processing personal data in such a way that it cannot be directly attributed to a data subject without the use of additional information. This additional information is kept separately and is subject to technical and organizational measures designed to ensure that personal data cannot be linked to an identified or identifiable natural person.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">The process of processing personal data in such a way that it cannot be directly attributed to a data subject without the use of additional information. This additional information is kept separately and is subject to technical and organizational measures designed to ensure that personal data cannot be linked to an identified or identifiable natural person.</rdfs:comment>
        <rdfs:comment xml:lang="es">The process of processing personal data in such a way that it cannot be directly attributed to a data subject without the use of additional information. This additional information is kept separately and is subject to technical and organizational measures designed to ensure that personal data cannot be linked to an identified or identifiable natural person.</rdfs:comment>
        <rdfs:label>pseudonymization</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#quality -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#quality">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Quality"/>
        <ley-organica-proteccion-datos-personales:associated_to rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data"/>
        <ley-organica-proteccion-datos-personales:is_in_charge_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"/>
        <ley-organica-proteccion-datos-personales:description>Personal data needs to be accurate, complete, complete and clear. This means that the data must be accurate and free of errors, accurately reflecting the reality of the person to whom it pertains.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">Personal data needs to be accurate, complete, complete and clear. This means that the data must be accurate and free of errors, accurately reflecting the reality of the person to whom it pertains.</rdfs:comment>
        <rdfs:comment xml:lang="es">Personal data needs to be accurate, complete, complete and clear. This means that the data must be accurate and free of errors, accurately reflecting the reality of the person to whom it pertains.</rdfs:comment>
        <rdfs:label>quality</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#recall_mechanisms -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#recall_mechanisms">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Recall_mechanisms"/>
        <ley-organica-proteccion-datos-personales:son_establecidos_por rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"/>
        <ley-organica-proteccion-datos-personales:description>Means that must be available for an individual to revoke his consent to the processing of his personal data</ley-organica-proteccion-datos-personales:description>
        <ley-organica-proteccion-datos-personales:must_be>Simple procedure, similar to the procedure by which consent was obtained</ley-organica-proteccion-datos-personales:must_be>
        <ley-organica-proteccion-datos-personales:must_guarantee>Effectiveness, i.e., achieving revocation of consent</ley-organica-proteccion-datos-personales:must_guarantee>
        <ley-organica-proteccion-datos-personales:must_guarantee>Efficiency, i.e. that the revocation of consent does not take too much time or effort, both on the part of the data subject and the data controller.</ley-organica-proteccion-datos-personales:must_guarantee>
        <ley-organica-proteccion-datos-personales:must_guarantee>Expeditiousness, i.e., the speed or promptness with which the consent revocation process is conducted</ley-organica-proteccion-datos-personales:must_guarantee>
        <ley-organica-proteccion-datos-personales:must_guarantee>Free of charge, which implies that the consent revocation process should not generate additional costs for the data subject.</ley-organica-proteccion-datos-personales:must_guarantee>
        <rdfs:comment xml:lang="en">Means that must be available for an individual to revoke his consent to the processing of his personal data</rdfs:comment>
        <rdfs:comment xml:lang="es">Means that must be available for an individual to revoke his consent to the processing of his personal data</rdfs:comment>
        <rdfs:label>recall mechanisms</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#recipient -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#recipient">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Recipient"/>
        <ley-organica-proteccion-datos-personales:control_functions>Person who has been notified with personal data</ley-organica-proteccion-datos-personales:control_functions>
        <ley-organica-proteccion-datos-personales:type_of_person>Natural or Legal</ley-organica-proteccion-datos-personales:type_of_person>
        <rdfs:label>recipient</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#relevance_of_personal_data -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#relevance_of_personal_data">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Relevance"/>
        <ley-organica-proteccion-datos-personales:description>That the data collected must be relevant and directly related to the specific purpose for which it is collected.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">That the data collected must be relevant and directly related to the specific purpose for which it is collected.</rdfs:comment>
        <rdfs:comment xml:lang="es">That the data collected must be relevant and directly related to the specific purpose for which it is collected.</rdfs:comment>
        <rdfs:label>relevance of personal data</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Controller"/>
        <ley-organica-proteccion-datos-personales:is_related_to rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#delegate"/>
        <ley-organica-proteccion-datos-personales:is_related_to rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"/>
        <ley-organica-proteccion-datos-personales:must_have_been_complied_with_regard_to_proactive_responsibility rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#principios"/>
        <ley-organica-proteccion-datos-personales:must_have_been_complied_with_regard_to_proactive_responsibility rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#rights"/>
        <ley-organica-proteccion-datos-personales:must_render_accounts_regarding_the_treatment_with rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_owner"/>
        <ley-organica-proteccion-datos-personales:must_render_accounts_regarding_the_treatment_with rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"/>
        <ley-organica-proteccion-datos-personales:accrediting_compliance_with_the_mechanisms>Implementation of certification systems, which are formal processes through which an independent entity evaluates and verifies compliance with the requirements established in standards, regulations or norms related to data protection.</ley-organica-proteccion-datos-personales:accrediting_compliance_with_the_mechanisms>
        <ley-organica-proteccion-datos-personales:accrediting_compliance_with_the_mechanisms>Make use of self- and co-regulatory schemes, i.e. programs or frameworks in which organizations voluntarily commit to comply with certain data protection standards and principles.</ley-organica-proteccion-datos-personales:accrediting_compliance_with_the_mechanisms>
        <ley-organica-proteccion-datos-personales:accrediting_compliance_with_the_mechanisms>Use of best practices, i.e. recommended methods and processes that have proven to be effective in the protection of personal data.</ley-organica-proteccion-datos-personales:accrediting_compliance_with_the_mechanisms>
        <ley-organica-proteccion-datos-personales:accrediting_compliance_with_the_mechanisms>Use of protection codes, which are associated with a set of principles, guidelines and specific rules established by data protection authorities to regulate the handling of personal data in certain sectors or contexts.</ley-organica-proteccion-datos-personales:accrediting_compliance_with_the_mechanisms>
        <ley-organica-proteccion-datos-personales:accrediting_compliance_with_the_mechanisms>Use of standards, i.e., follow guidelines and criteria established by internationally recognized organizations for the handling and protection of personal data.</ley-organica-proteccion-datos-personales:accrediting_compliance_with_the_mechanisms>
        <ley-organica-proteccion-datos-personales:activity_in_respect_to_proactive_and_demonstrated_responsibility>Implementation of mechanisms for the protection of personal data, which implies guaranteeing compliance with the principles, rights and obligations established in the Organic Law for the Protection of Personal Data.</ley-organica-proteccion-datos-personales:activity_in_respect_to_proactive_and_demonstrated_responsibility>
        <ley-organica-proteccion-datos-personales:activity_in_respect_to_proactive_and_demonstrated_responsibility>To demonstrate compliance with these mechanisms and applicable regulations, that is, to have evidence and documents that demonstrate that the mechanisms and applicable regulations are being followed.</ley-organica-proteccion-datos-personales:activity_in_respect_to_proactive_and_demonstrated_responsibility>
        <ley-organica-proteccion-datos-personales:activity_within_opposition_law>The controller shall cease processing the personal data, unless it can demonstrate compelling legitimate grounds justifying the processing which outweigh the interests, rights and freedoms of the data subject, or for the purposes of the lodging, exercise or defense of claims.</ley-organica-proteccion-datos-personales:activity_within_opposition_law>
        <ley-organica-proteccion-datos-personales:activity_within_right_of_access>The person responsible for the processing of personal data must implement adequate means to facilitate the exercise of the right of access by the data subject</ley-organica-proteccion-datos-personales:activity_within_right_of_access>
        <ley-organica-proteccion-datos-personales:activity_within_the_right_of_correction_and_update>The data controller must respond to requests for rectification and updating, and if necessary, inform the recipient of the data so that he/she can also carry out the corresponding update.</ley-organica-proteccion-datos-personales:activity_within_the_right_of_correction_and_update>
        <ley-organica-proteccion-datos-personales:activity_within_the_right_of_deletion>The controller shall implement methods and techniques aimed at deleting, rendering unreadable, or rendering unrecognizable in a definitive and secure manner personal data.</ley-organica-proteccion-datos-personales:activity_within_the_right_of_deletion>
        <ley-organica-proteccion-datos-personales:contact_data>Address of legal domicile</ley-organica-proteccion-datos-personales:contact_data>
        <ley-organica-proteccion-datos-personales:contact_data>E-mail address</ley-organica-proteccion-datos-personales:contact_data>
        <ley-organica-proteccion-datos-personales:contact_data>Names and surnames</ley-organica-proteccion-datos-personales:contact_data>
        <ley-organica-proteccion-datos-personales:contact_data>Telephone number</ley-organica-proteccion-datos-personales:contact_data>
        <ley-organica-proteccion-datos-personales:control_functions>Responsible for deciding on the purpose and processing of personal data</ley-organica-proteccion-datos-personales:control_functions>
        <ley-organica-proteccion-datos-personales:deadline_in_days_for_the_right_of_access rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</ley-organica-proteccion-datos-personales:deadline_in_days_for_the_right_of_access>
        <ley-organica-proteccion-datos-personales:deadline_in_days_for_the_right_to_oppose_opposition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</ley-organica-proteccion-datos-personales:deadline_in_days_for_the_right_to_oppose_opposition>
        <ley-organica-proteccion-datos-personales:delegate_comments>Ensure that the involvement of the personal data protection officer, in all matters relating to personal data protection, is appropriate and timely.</ley-organica-proteccion-datos-personales:delegate_comments>
        <ley-organica-proteccion-datos-personales:delegate_comments>Ensure that the personal data protection officer establishes direct communication with the highest executive and decision-making levels of the data controller.</ley-organica-proteccion-datos-personales:delegate_comments>
        <ley-organica-proteccion-datos-personales:delegate_comments>Facilitate access to the personal data of the processing operations, as well as all the resources and elements necessary to guarantee the correct and free performance of its functions.</ley-organica-proteccion-datos-personales:delegate_comments>
        <ley-organica-proteccion-datos-personales:delegate_comments>They may not dismiss or sanction the personal data protection officer for the proper performance of his or her duties.</ley-organica-proteccion-datos-personales:delegate_comments>
        <ley-organica-proteccion-datos-personales:delegate_comments>Train and update the personal data protection officer on the subject, in accordance with the technical regulations issued by the Personal Data Protection Authority.</ley-organica-proteccion-datos-personales:delegate_comments>
        <ley-organica-proteccion-datos-personales:in_the_event_of_a_challenge_of_data_exaccuracy>The accuracy of the personal data must be verified, so it must be placed in the database, where the challenged information is contained, that it has been the subject of disagreement by the data owner.</ley-organica-proteccion-datos-personales:in_the_event_of_a_challenge_of_data_exaccuracy>
        <ley-organica-proteccion-datos-personales:minor_infractions>Choosing a processor of personal data that does not offer sufficient guarantees to make effective the exercise of the right to the protection of personal data.</ley-organica-proteccion-datos-personales:minor_infractions>
        <ley-organica-proteccion-datos-personales:minor_infractions>Failure to attend, late or unjustified response to requests or complaints from the holder</ley-organica-proteccion-datos-personales:minor_infractions>
        <ley-organica-proteccion-datos-personales:minor_infractions>Failure to comply with the corrective measures ordered by the Personal Data Protection Authority.</ley-organica-proteccion-datos-personales:minor_infractions>
        <ley-organica-proteccion-datos-personales:minor_infractions>Failure to implement data protection by design and by default</ley-organica-proteccion-datos-personales:minor_infractions>
        <ley-organica-proteccion-datos-personales:minor_infractions>Failure to maintain available personal data protection policies related to the processing of personal data</ley-organica-proteccion-datos-personales:minor_infractions>
        <ley-organica-proteccion-datos-personales:nature_of_the_entity>Public or Private</ley-organica-proteccion-datos-personales:nature_of_the_entity>
        <ley-organica-proteccion-datos-personales:obligations>Allowing audits and inspections by accredited auditors</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Comply with any other obligation established by applicable regulations or other Ecuadorian laws.</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Conduct security adequacy assessments prior to the processing of personal data.</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Designate a Data Protection Officer when necessary.</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Develop customized data protection policies</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Ensuring that data controllers comply with regulations and best practices</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Establish confidentiality agreements with personnel and processors.</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Implement administrative, technical and legal measures to guarantee the proper treatment of data</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Integrate data protection from system design onwards</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Maintain the National Registry of Personal Data Protection up to date.</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Notifying the Personal Data Protection Authority and the data owner of violations of the security measures implemented for the processing of personal data in accordance with the procedure established for this purpose.</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Periodically evaluate the effectiveness of the administrative, technical and legal measures adopted.</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Take the necessary technological, physical, administrative, organizational and legal measures to prevent, deter, reduce, mitigate and control identified risks and breaches.</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Treat personal data in accordance with the Organic Law on Personal Data Protection and relevant regulations.</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:obligations>Use risk analysis and management methodologies adapted to the particularities of data processing and the parties involved.</ley-organica-proteccion-datos-personales:obligations>
        <ley-organica-proteccion-datos-personales:serious_infractions>Do not sign contracts that include confidentiality clauses with those who handle personal data.</ley-organica-proteccion-datos-personales:serious_infractions>
        <ley-organica-proteccion-datos-personales:serious_infractions>Failure to allow or cooperate with audits or inspections by an accredited auditor</ley-organica-proteccion-datos-personales:serious_infractions>
        <ley-organica-proteccion-datos-personales:serious_infractions>Failure to comply with corrective measures or insufficient compliance, especially if previous sanctions have been imposed for minor infractions and there is a recidivism.</ley-organica-proteccion-datos-personales:serious_infractions>
        <ley-organica-proteccion-datos-personales:serious_infractions>Failure to conduct impact assessments when necessary</ley-organica-proteccion-datos-personales:serious_infractions>
        <ley-organica-proteccion-datos-personales:serious_infractions>Failure to designate a data protection officer when necessary</ley-organica-proteccion-datos-personales:serious_infractions>
        <ley-organica-proteccion-datos-personales:serious_infractions>Failure to implement measures to prevent and control data security risks</ley-organica-proteccion-datos-personales:serious_infractions>
        <ley-organica-proteccion-datos-personales:serious_infractions>Failure to inform the Data Protection Authority and the Data Controller about security breaches affecting individual rights.</ley-organica-proteccion-datos-personales:serious_infractions>
        <ley-organica-proteccion-datos-personales:serious_infractions>Failure to keep the National Data Protection Registry up to date as required.</ley-organica-proteccion-datos-personales:serious_infractions>
        <ley-organica-proteccion-datos-personales:serious_infractions>Failure to notify the holder of security breaches affecting his rights</ley-organica-proteccion-datos-personales:serious_infractions>
        <ley-organica-proteccion-datos-personales:serious_infractions>Failure to put in place adequate measures to protect personal data as required by law and relevant regulations</ley-organica-proteccion-datos-personales:serious_infractions>
        <ley-organica-proteccion-datos-personales:serious_infractions>Failure to register the required information in the National Data Protection Registry.</ley-organica-proteccion-datos-personales:serious_infractions>
        <ley-organica-proteccion-datos-personales:serious_infractions>Failure to use appropriate methodologies to analyze and manage the risks associated with personal data</ley-organica-proteccion-datos-personales:serious_infractions>
        <ley-organica-proteccion-datos-personales:serious_infractions>Sharing of personal data without following legal requirements and established procedures</ley-organica-proteccion-datos-personales:serious_infractions>
        <ley-organica-proteccion-datos-personales:serious_infractions>Using information or data for purposes other than those initially stated</ley-organica-proteccion-datos-personales:serious_infractions>
        <ley-organica-proteccion-datos-personales:time_of_attention_in_days_for_the_right_of_removal rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">15.0</ley-organica-proteccion-datos-personales:time_of_attention_in_days_for_the_right_of_removal>
        <ley-organica-proteccion-datos-personales:time_of_attention_within_days_for_the_right_of_correction_and_update rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</ley-organica-proteccion-datos-personales:time_of_attention_within_days_for_the_right_of_correction_and_update>
        <ley-organica-proteccion-datos-personales:type_authority>Public</ley-organica-proteccion-datos-personales:type_authority>
        <ley-organica-proteccion-datos-personales:type_of_organism_participation>Alone or together with others</ley-organica-proteccion-datos-personales:type_of_organism_participation>
        <ley-organica-proteccion-datos-personales:type_of_person>Natural or Legal</ley-organica-proteccion-datos-personales:type_of_person>
        <rdfs:label>responsible for treatment</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#revocation_of_consent -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#revocation_of_consent">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Revocation_of_consent"/>
        <ley-organica-proteccion-datos-personales:can_count_on rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#recall_mechanisms"/>
        <ley-organica-proteccion-datos-personales:regarding_treatment rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processing"/>
        <ley-organica-proteccion-datos-personales:justification_for_revocation>No justification required for revocation of consent</ley-organica-proteccion-datos-personales:justification_for_revocation>
        <ley-organica-proteccion-datos-personales:when_it_can_be_produced>At any time, when the holder deems it pertinent</ley-organica-proteccion-datos-personales:when_it_can_be_produced>
        <rdfs:label>revocation of consent</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_not_to_be_object_to_automated_evaluations -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_not_to_be_object_to_automated_evaluations">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_not_to_be_object_to_automated_evaluations"/>
        <ley-organica-proteccion-datos-personales:for_the rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_owner"/>
        <ley-organica-proteccion-datos-personales:is_related_to rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#consent"/>
        <ley-organica-proteccion-datos-personales:right_account_encumbered rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processor"/>
        <ley-organica-proteccion-datos-personales:right_account_encumbered rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"/>
        <ley-organica-proteccion-datos-personales:will_not_be_able_to_deal rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#sensitive_data"/>
        <ley-organica-proteccion-datos-personales:description>The holder has the right not to be subjected to decisions that are based in whole or in part on automated assessments, including profiling, if these decisions have a legal impact on him or her or threaten his or her fundamental rights and freedoms</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">The holder has the right not to be subjected to decisions that are based in whole or in part on automated assessments, including profiling, if these decisions have a legal impact on him or her or threaten his or her fundamental rights and freedoms</rdfs:comment>
        <rdfs:comment xml:lang="es">The holder has the right not to be subjected to decisions that are based in whole or in part on automated assessments, including profiling, if these decisions have a legal impact on him or her or threaten his or her fundamental rights and freedoms</rdfs:comment>
        <rdfs:label>right not to be object to automated evaluations</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_access -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_access">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_of_access"/>
        <ley-organica-proteccion-datos-personales:is_related_to rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_information"/>
        <ley-organica-proteccion-datos-personales:right_account_encumbered rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"/>
        <ley-organica-proteccion-datos-personales:description>The holder has the right to access and obtain free of charge all his personal data, as well as the detailed information in accordance with the right to information, without the need for any justification whatsoever.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">The holder has the right to access and obtain free of charge all his personal data, as well as the detailed information in accordance with the right to information, without the need for any justification whatsoever.</rdfs:comment>
        <rdfs:comment xml:lang="es">The holder has the right to access and obtain free of charge all his personal data, as well as the detailed information in accordance with the right to information, without the need for any justification whatsoever.</rdfs:comment>
        <rdfs:label>right of access</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_deletion -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_deletion">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_of_deletion"/>
        <ley-organica-proteccion-datos-personales:right_account_encumbered rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"/>
        <ley-organica-proteccion-datos-personales:description>The data subject has the right to have his or her personal data deleted by the controller in certain specific cases</ley-organica-proteccion-datos-personales:description>
        <ley-organica-proteccion-datos-personales:when_personal_data_may_be_deleted>Revoke previously given consent or indicate that consent has not been given for one or more specific purposes, without the need to provide any justification</ley-organica-proteccion-datos-personales:when_personal_data_may_be_deleted>
        <ley-organica-proteccion-datos-personales:when_personal_data_may_be_deleted>The personal data have fulfilled the purpose for which they were collected or processed</ley-organica-proteccion-datos-personales:when_personal_data_may_be_deleted>
        <ley-organica-proteccion-datos-personales:when_personal_data_may_be_deleted>The processing affects fundamental rights or individual liberties of the data subject.</ley-organica-proteccion-datos-personales:when_personal_data_may_be_deleted>
        <ley-organica-proteccion-datos-personales:when_personal_data_may_be_deleted>The processing does not comply with the established principles of the Organic Law on Personal Data Protection.</ley-organica-proteccion-datos-personales:when_personal_data_may_be_deleted>
        <ley-organica-proteccion-datos-personales:when_personal_data_may_be_deleted>The processing is not necessary or relevant for the fulfillment of the purpose</ley-organica-proteccion-datos-personales:when_personal_data_may_be_deleted>
        <ley-organica-proteccion-datos-personales:when_personal_data_may_be_deleted>The term of conservation of personal data has expired.</ley-organica-proteccion-datos-personales:when_personal_data_may_be_deleted>
        <ley-organica-proteccion-datos-personales:when_personal_data_may_be_deleted>There is a legal obligation</ley-organica-proteccion-datos-personales:when_personal_data_may_be_deleted>
        <rdfs:comment xml:lang="en">The data subject has the right to have his or her personal data deleted by the controller in certain specific cases</rdfs:comment>
        <rdfs:comment xml:lang="es">The data subject has the right to have his or her personal data deleted by the controller in certain specific cases</rdfs:comment>
        <rdfs:label>right of deletion</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_opposition -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_opposition">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_of_opposition"/>
        <ley-organica-proteccion-datos-personales:right_account_encumbered rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"/>
        <ley-organica-proteccion-datos-personales:deadline_in_days_for_the_right_to_oppose_opposition rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">15.0</ley-organica-proteccion-datos-personales:deadline_in_days_for_the_right_to_oppose_opposition>
        <ley-organica-proteccion-datos-personales:description>The owner has the right to oppose or refuse the processing of his/her personal data under certain scenarios</ley-organica-proteccion-datos-personales:description>
        <ley-organica-proteccion-datos-personales:in_direct_marketing_cases>The data subject can always object to the processing of his personal data for direct marketing, including profiling, in which case the personal data will no longer be processed for this purpose.</ley-organica-proteccion-datos-personales:in_direct_marketing_cases>
        <ley-organica-proteccion-datos-personales:when_it_can_be_opposed_to_treatment>If the Organic Law on Personal Data Protection explicitly permits the type of processing in progress or proposed</ley-organica-proteccion-datos-personales:when_it_can_be_opposed_to_treatment>
        <ley-organica-proteccion-datos-personales:when_it_can_be_opposed_to_treatment>If the data are not publicly available and are not related to matters of public interest required by other Ecuadorian laws</ley-organica-proteccion-datos-personales:when_it_can_be_opposed_to_treatment>
        <ley-organica-proteccion-datos-personales:when_it_can_be_opposed_to_treatment>If the processing of personal data is for the purpose of direct marketing</ley-organica-proteccion-datos-personales:when_it_can_be_opposed_to_treatment>
        <ley-organica-proteccion-datos-personales:when_it_can_be_opposed_to_treatment>If the treatment does not affect the rights of others</ley-organica-proteccion-datos-personales:when_it_can_be_opposed_to_treatment>
        <ley-organica-proteccion-datos-personales:when_it_can_be_opposed_to_treatment>When the consent of the data subject is not necessary for the processing as a consequence of the concurrence of a legitimate interest.</ley-organica-proteccion-datos-personales:when_it_can_be_opposed_to_treatment>
        <rdfs:comment xml:lang="en">The owner has the right to oppose or refuse the processing of his/her personal data under certain scenarios</rdfs:comment>
        <rdfs:comment xml:lang="es">The owner has the right to oppose or refuse the processing of his/her personal data under certain scenarios</rdfs:comment>
        <rdfs:label>right of opposition</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_consult -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_consult">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_consult"/>
        <ley-organica-proteccion-datos-personales:garatize_that>The consultation is free of charge</ley-organica-proteccion-datos-personales:garatize_that>
        <ley-organica-proteccion-datos-personales:garatize_that>The consultation is public</ley-organica-proteccion-datos-personales:garatize_that>
        <ley-organica-proteccion-datos-personales:where_you_can_consult>National Registry of Personal Data Protection</ley-organica-proteccion-datos-personales:where_you_can_consult>
        <rdfs:label>right to consult</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_correction_and_update -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_correction_and_update">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_correction_and_update"/>
        <ley-organica-proteccion-datos-personales:right_account_encumbered rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"/>
        <ley-organica-proteccion-datos-personales:description>The holder has the right to obtain from the data controller the rectification and updating of inaccurate or incomplete personal data.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">The holder has the right to obtain from the data controller the rectification and updating of inaccurate or incomplete personal data.</rdfs:comment>
        <rdfs:comment xml:lang="es">The holder has the right to obtain from the data controller the rectification and updating of inaccurate or incomplete personal data.</rdfs:comment>
        <rdfs:label>right to correction and update</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_digital_education -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_digital_education">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_digital_education"/>
        <ley-organica-proteccion-datos-personales:guaranteeing_digital_education>Higher education system</ley-organica-proteccion-datos-personales:guaranteeing_digital_education>
        <ley-organica-proteccion-datos-personales:guaranteeing_digital_education>The national education system</ley-organica-proteccion-datos-personales:guaranteeing_digital_education>
        <ley-organica-proteccion-datos-personales:inclusiveness_in>People with special educational needs</ley-organica-proteccion-datos-personales:inclusiveness_in>
        <ley-organica-proteccion-datos-personales:inclusiveness_in>Students of all levels</ley-organica-proteccion-datos-personales:inclusiveness_in>
        <ley-organica-proteccion-datos-personales:inclusiveness_in>Teachers or professors</ley-organica-proteccion-datos-personales:inclusiveness_in>
        <ley-organica-proteccion-datos-personales:right_to_access_and_availability>Appropriate, healthy, constructive, safe and responsible use and management of information and communication technologies.</ley-organica-proteccion-datos-personales:right_to_access_and_availability>
        <ley-organica-proteccion-datos-personales:right_to_access_and_availability>Development in Information and Communication Technologies</ley-organica-proteccion-datos-personales:right_to_access_and_availability>
        <ley-organica-proteccion-datos-personales:right_to_access_and_availability>Information and Communication Technologies Training</ley-organica-proteccion-datos-personales:right_to_access_and_availability>
        <ley-organica-proteccion-datos-personales:right_to_access_and_availability>Information and Communication Technology Learning</ley-organica-proteccion-datos-personales:right_to_access_and_availability>
        <ley-organica-proteccion-datos-personales:right_to_access_and_availability>Knowledge of Information and Communication Technologies.</ley-organica-proteccion-datos-personales:right_to_access_and_availability>
        <ley-organica-proteccion-datos-personales:right_to_access_and_availability>Training in Information and Communication Technologies</ley-organica-proteccion-datos-personales:right_to_access_and_availability>
        <rdfs:label>right to digital education</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_information -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_information">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_information"/>
        <ley-organica-proteccion-datos-personales:must_be_aware_of_the_possibility_of_realizing rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#revocation_of_consent"/>
        <ley-organica-proteccion-datos-personales:must_comply_with_the_principles_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#loyalty"/>
        <ley-organica-proteccion-datos-personales:must_comply_with_the_principles_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#transparency"/>
        <ley-organica-proteccion-datos-personales:know_in_the_right_to_information>Any other purpose or additional treatment</ley-organica-proteccion-datos-personales:know_in_the_right_to_information>
        <ley-organica-proteccion-datos-personales:know_in_the_right_to_information>How to exercise your rights of access, deletion, rectification, updating, opposition, cancellation, limitation of processing and not to be subject to automatic decisions.</ley-organica-proteccion-datos-personales:know_in_the_right_to_information>
        <ley-organica-proteccion-datos-personales:know_in_the_right_to_information>Identity and contact details of the personal data protection officer, if applicable</ley-organica-proteccion-datos-personales:know_in_the_right_to_information>
        <ley-organica-proteccion-datos-personales:know_in_the_right_to_information>The different types of treatment</ley-organica-proteccion-datos-personales:know_in_the_right_to_information>
        <ley-organica-proteccion-datos-personales:know_in_the_right_to_information>The existence of a database containing your personal data</ley-organica-proteccion-datos-personales:know_in_the_right_to_information>
        <ley-organica-proteccion-datos-personales:know_in_the_right_to_information>The existence of automated evaluations and decisions, including profiling</ley-organica-proteccion-datos-personales:know_in_the_right_to_information>
        <ley-organica-proteccion-datos-personales:know_in_the_right_to_information>The identity and contact details of the person responsible for processing personal data, including address, telephone number and e-mail address</ley-organica-proteccion-datos-personales:know_in_the_right_to_information>
        <ley-organica-proteccion-datos-personales:know_in_the_right_to_information>The impact of providing incorrect or inaccurate personal data</ley-organica-proteccion-datos-personales:know_in_the_right_to_information>
        <ley-organica-proteccion-datos-personales:know_in_the_right_to_information>The legal basis for the treatment</ley-organica-proteccion-datos-personales:know_in_the_right_to_information>
        <ley-organica-proteccion-datos-personales:know_in_the_right_to_information>The option to revoke consent at any time</ley-organica-proteccion-datos-personales:know_in_the_right_to_information>
        <ley-organica-proteccion-datos-personales:know_in_the_right_to_information>The origin of the personal data if it was not obtained directly from the data subject.</ley-organica-proteccion-datos-personales:know_in_the_right_to_information>
        <ley-organica-proteccion-datos-personales:know_in_the_right_to_information>The period during which the data will be kept</ley-organica-proteccion-datos-personales:know_in_the_right_to_information>
        <ley-organica-proteccion-datos-personales:know_in_the_right_to_information>The possible consequences for the holder if he/she provides or refuses to provide his/her personal data</ley-organica-proteccion-datos-personales:know_in_the_right_to_information>
        <ley-organica-proteccion-datos-personales:know_in_the_right_to_information>Treatment purposes</ley-organica-proteccion-datos-personales:know_in_the_right_to_information>
        <ley-organica-proteccion-datos-personales:know_in_the_right_to_information>Where and how to file complaints with the data controller and the Personal Data Protection Authority</ley-organica-proteccion-datos-personales:know_in_the_right_to_information>
        <rdfs:label>right to information</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_suspension_of_treatment -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_suspension_of_treatment">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_suspension_of_treatment"/>
        <ley-organica-proteccion-datos-personales:right_account_encumbered rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processor"/>
        <ley-organica-proteccion-datos-personales:right_account_encumbered rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"/>
        <ley-organica-proteccion-datos-personales:assumptions_for_processing_the_data_in_the_event_of_a_data_challenge>Claims defense</ley-organica-proteccion-datos-personales:assumptions_for_processing_the_data_in_the_event_of_a_data_challenge>
        <ley-organica-proteccion-datos-personales:assumptions_for_processing_the_data_in_the_event_of_a_data_challenge>Claims exercise</ley-organica-proteccion-datos-personales:assumptions_for_processing_the_data_in_the_event_of_a_data_challenge>
        <ley-organica-proteccion-datos-personales:assumptions_for_processing_the_data_in_the_event_of_a_data_challenge>Formulation of claims</ley-organica-proteccion-datos-personales:assumptions_for_processing_the_data_in_the_event_of_a_data_challenge>
        <ley-organica-proteccion-datos-personales:conditions_for_the_suspension_of_treatment>The controller no longer needs the personal data for the purposes of the processing, but the data subject needs the data for the formulation, exercise or defense of claims</ley-organica-proteccion-datos-personales:conditions_for_the_suspension_of_treatment>
        <ley-organica-proteccion-datos-personales:conditions_for_the_suspension_of_treatment>The processing is unlawful and the data subject opposes the deletion of the personal data and requests instead the limitation of its use.</ley-organica-proteccion-datos-personales:conditions_for_the_suspension_of_treatment>
        <ley-organica-proteccion-datos-personales:conditions_for_the_suspension_of_treatment>When the data subject contests the accuracy of the personal data, while the data controller verifies the accuracy of the personal data</ley-organica-proteccion-datos-personales:conditions_for_the_suspension_of_treatment>
        <ley-organica-proteccion-datos-personales:description>The data subject shall have the right to obtain from the data controller the suspension of data processing, when certain scenarios are met</ley-organica-proteccion-datos-personales:description>
        <ley-organica-proteccion-datos-personales:incurring_the_owner_to_the_personal_data_protection_authority>In the event that the data controller or processor refuses to suspend the processing of the data requested by the data subject</ley-organica-proteccion-datos-personales:incurring_the_owner_to_the_personal_data_protection_authority>
        <rdfs:comment xml:lang="en">The data subject shall have the right to obtain from the data controller the suspension of data processing, when certain scenarios are met</rdfs:comment>
        <rdfs:comment xml:lang="es">The data subject shall have the right to obtain from the data controller the suspension of data processing, when certain scenarios are met</rdfs:comment>
        <rdfs:label>right to suspension of treatment</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#rights -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#rights">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights"/>
        <ley-organica-proteccion-datos-personales:are_constituted_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_not_to_be_object_to_automated_evaluations"/>
        <ley-organica-proteccion-datos-personales:are_constituted_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_access"/>
        <ley-organica-proteccion-datos-personales:are_constituted_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_deletion"/>
        <ley-organica-proteccion-datos-personales:are_constituted_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_of_opposition"/>
        <ley-organica-proteccion-datos-personales:are_constituted_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_consult"/>
        <ley-organica-proteccion-datos-personales:are_constituted_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_correction_and_update"/>
        <ley-organica-proteccion-datos-personales:are_constituted_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_digital_education"/>
        <ley-organica-proteccion-datos-personales:are_constituted_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_information"/>
        <ley-organica-proteccion-datos-personales:are_constituted_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#right_to_suspension_of_treatment"/>
        <ley-organica-proteccion-datos-personales:responsable_de_canalizar_el_ejercicio_de_derechos rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"/>
        <ley-organica-proteccion-datos-personales:description_responsible_for_channeling_exercise_of_rights>It involves consideration of the individuals responsible for ensuring that the rights of the holder are properly exercised.</ley-organica-proteccion-datos-personales:description_responsible_for_channeling_exercise_of_rights>
        <ley-organica-proteccion-datos-personales:irrevocability>The holder&apos;s rights are non-transferable and cannot be waived; therefore, any clause or provision that contradicts this will be considered null and void.</ley-organica-proteccion-datos-personales:irrevocability>
        <ley-organica-proteccion-datos-personales:limitation_on_exercise_of_rights_by_secondary_laws>Regulations or rules complementary to the Personal Data Protection Law may not restrict or limit the rights of the owner.</ley-organica-proteccion-datos-personales:limitation_on_exercise_of_rights_by_secondary_laws>
        <ley-organica-proteccion-datos-personales:responsible_for_channeling_the_exercise_of_rights>Competent judges in accordance with the procedure established in the Organic Law on Personal Data Protection.</ley-organica-proteccion-datos-personales:responsible_for_channeling_the_exercise_of_rights>
        <rdfs:label>rights</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#rights_of_credit_data_owners -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#rights_of_credit_data_owners">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights_of_credit_data_owners"/>
        <ley-organica-proteccion-datos-personales:mechanisms_to_secure_the_right_of_access_of_the_credit_data_holder>Delivery of printouts of the reports so that the owner of the credit data can verify the veracity and accuracy of its content, without being able to use it for credit or commercial purposes.</ley-organica-proteccion-datos-personales:mechanisms_to_secure_the_right_of_access_of_the_credit_data_holder>
        <ley-organica-proteccion-datos-personales:mechanisms_to_secure_the_right_of_access_of_the_credit_data_holder>Direct observation through screens that the credit reference service providers will make available on the holder of credit data</ley-organica-proteccion-datos-personales:mechanisms_to_secure_the_right_of_access_of_the_credit_data_holder>
        <ley-organica-proteccion-datos-personales:right_to_access_by_credit_data_holders>As often as requested by the credit data subject with respect to the information that credit reference service providers have about him/her.</ley-organica-proteccion-datos-personales:right_to_access_by_credit_data_holders>
        <ley-organica-proteccion-datos-personales:right_to_access_by_credit_data_holders>It shall be free of charge</ley-organica-proteccion-datos-personales:right_to_access_by_credit_data_holders>
        <ley-organica-proteccion-datos-personales:right_to_update_correction_or_deletion_of_the_credit_data_holder>The owner of the credit data may demand the right to update, rectify or delete the credit data before the sources of information through a written request.</ley-organica-proteccion-datos-personales:right_to_update_correction_or_deletion_of_the_credit_data_holder>
        <ley-organica-proteccion-datos-personales:rights_of_credit_data_holders>Personal access to the information of which it is the owner of credit data.</ley-organica-proteccion-datos-personales:rights_of_credit_data_holders>
        <ley-organica-proteccion-datos-personales:rights_of_credit_data_holders>That the credit report allows to know clearly and accurately the condition of your credit history.</ley-organica-proteccion-datos-personales:rights_of_credit_data_holders>
        <ley-organica-proteccion-datos-personales:rights_of_credit_data_holders>That the sources of information update, rectify or eliminate, as the case may be, information that is unlawful, false, inaccurate, erroneous, incomplete or outdated.</ley-organica-proteccion-datos-personales:rights_of_credit_data_holders>
        <ley-organica-proteccion-datos-personales:source_of_information_activity_on_the_application>If the credit data review process is initiated, it is necessary to clearly indicate in the reports issued that the information that is the subject of the request is being reviewed at the request of the holder.</ley-organica-proteccion-datos-personales:source_of_information_activity_on_the_application>
        <ley-organica-proteccion-datos-personales:source_of_information_activity_on_the_application>The sources of information must resolve the request within a maximum period of 15 days from its submission, either admitting it or rejecting it with a detailed explanation of the reasons</ley-organica-proteccion-datos-personales:source_of_information_activity_on_the_application>
        <rdfs:label>rights of credit data owners</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#sanciones -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#sanciones">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Sanctions"/>
        <ley-organica-proteccion-datos-personales:are_made_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minor_infractions_penalties"/>
        <ley-organica-proteccion-datos-personales:are_made_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#penalties_for_Serious_Infringements"/>
        <ley-organica-proteccion-datos-personales:will_be_imposed_by rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"/>
        <rdfs:label>sanciones</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#scope_of_application -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#scope_of_application">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Scope_of_application"/>
        <ley-organica-proteccion-datos-personales:scope_of_legislation>The law will apply to the processing of personal data regardless of the medium in which it is stored, whether in automated or non-automated formats. This implies that the law is equally applicable to data stored in automated systems, such as electronic databases, as well as to data that may exist in non-automated formats, such as physical documents or paper files.</ley-organica-proteccion-datos-personales:scope_of_legislation>
        <rdfs:label>scope of application</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#security -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#security">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Security"/>
        <ley-organica-proteccion-datos-personales:responsible_for_implementing_safety_measures rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processor"/>
        <ley-organica-proteccion-datos-personales:responsible_for_implementing_safety_measures rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"/>
        <ley-organica-proteccion-datos-personales:description>Implementation of adequate and necessary measures to protect personal data against risks, threats and vulnerabilities, considering the current state of technology</ley-organica-proteccion-datos-personales:description>
        <ley-organica-proteccion-datos-personales:types_of_safety_measures>Organizational measures, i.e. measures that refer to the internal policies, procedures and structures that an organization implements to protect personal data.</ley-organica-proteccion-datos-personales:types_of_safety_measures>
        <ley-organica-proteccion-datos-personales:types_of_safety_measures>Technical measures, i.e. measures that involve the use of technology to protect personal data, these may include the use of firewalls, data encryption, intrusion detection software, biometric access controls, among others.</ley-organica-proteccion-datos-personales:types_of_safety_measures>
        <ley-organica-proteccion-datos-personales:types_of_safety_measures>Type of measures covering aspects such as physical security of equipment and data centers, risk management, business continuity and security incident response.</ley-organica-proteccion-datos-personales:types_of_safety_measures>
        <rdfs:comment xml:lang="en">Implementation of adequate and necessary measures to protect personal data against risks, threats and vulnerabilities, considering the current state of technology</rdfs:comment>
        <rdfs:comment xml:lang="es">Implementation of adequate and necessary measures to protect personal data against risks, threats and vulnerabilities, considering the current state of technology</rdfs:comment>
        <rdfs:label>security</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#sensitive_data -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#sensitive_data">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Sensitive_data"/>
        <ley-organica-proteccion-datos-personales:shall_at_least_comply_with_the_minimum_with rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minimum_criteria"/>
        <ley-organica-proteccion-datos-personales:data_not_subject_to_processing_according_to_the_right_to_not_be_the_object_of_automated_decisions>Sensitive data of children and adolescents may not be processed unless expressly authorized by the legal representative.</ley-organica-proteccion-datos-personales:data_not_subject_to_processing_according_to_the_right_to_not_be_the_object_of_automated_decisions>
        <ley-organica-proteccion-datos-personales:data_not_subject_to_processing_according_to_the_right_to_not_be_the_object_of_automated_decisions>Sensitive data of the data subject may not be processed without his/her express authorization.</ley-organica-proteccion-datos-personales:data_not_subject_to_processing_according_to_the_right_to_not_be_the_object_of_automated_decisions>
        <ley-organica-proteccion-datos-personales:data_related_to>Cultural identity</ley-organica-proteccion-datos-personales:data_related_to>
        <ley-organica-proteccion-datos-personales:data_related_to>Datos biométricos</ley-organica-proteccion-datos-personales:data_related_to>
        <ley-organica-proteccion-datos-personales:data_related_to>Ethnicity</ley-organica-proteccion-datos-personales:data_related_to>
        <ley-organica-proteccion-datos-personales:data_related_to>Gender Identity</ley-organica-proteccion-datos-personales:data_related_to>
        <ley-organica-proteccion-datos-personales:data_related_to>Genetic data</ley-organica-proteccion-datos-personales:data_related_to>
        <ley-organica-proteccion-datos-personales:data_related_to>Health</ley-organica-proteccion-datos-personales:data_related_to>
        <ley-organica-proteccion-datos-personales:data_related_to>Ideology</ley-organica-proteccion-datos-personales:data_related_to>
        <ley-organica-proteccion-datos-personales:data_related_to>Judicial past</ley-organica-proteccion-datos-personales:data_related_to>
        <ley-organica-proteccion-datos-personales:data_related_to>Migratory status</ley-organica-proteccion-datos-personales:data_related_to>
        <ley-organica-proteccion-datos-personales:data_related_to>Political affiliation</ley-organica-proteccion-datos-personales:data_related_to>
        <ley-organica-proteccion-datos-personales:data_related_to>Religion</ley-organica-proteccion-datos-personales:data_related_to>
        <ley-organica-proteccion-datos-personales:data_related_to>Sexual Orientation</ley-organica-proteccion-datos-personales:data_related_to>
        <ley-organica-proteccion-datos-personales:data_related_to>Stateless persons and refugees in need of international protection</ley-organica-proteccion-datos-personales:data_related_to>
        <ley-organica-proteccion-datos-personales:data_related_to>Those whose improper treatment may give rise to discrimination, infringe or may infringe fundamental rights and freedoms.</ley-organica-proteccion-datos-personales:data_related_to>
        <ley-organica-proteccion-datos-personales:data_subjects_to_treatment_according_to_the_right_to_not_be_the_object_of_automated_decisions>When the processing is necessary to protect an essential public interest, as assessed according to international human rights standards, and meets at least the minimum criteria</ley-organica-proteccion-datos-personales:data_subjects_to_treatment_according_to_the_right_to_not_be_the_object_of_automated_decisions>
        <ley-organica-proteccion-datos-personales:description>Refers to information specific or linked to certain sensitive or particular categories of a person.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">Refers to information specific or linked to certain sensitive or particular categories of a person.</rdfs:comment>
        <rdfs:comment xml:lang="es">Refers to information specific or linked to certain sensitive or particular categories of a person.</rdfs:comment>
        <rdfs:label>sensitive data</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#sensitive_data_processing -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#sensitive_data_processing">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Sensitive_data_processing"/>
        <ley-organica-proteccion-datos-personales:description>The processing of sensitive personal data is prohibited, except in specific situations where it is justified.</ley-organica-proteccion-datos-personales:description>
        <ley-organica-proteccion-datos-personales:sensitive_data_processing_scenarios>The owner has given his/her explicit consent for the processing of his/her personal data, clearly specifying the purposes for which the data is to be processed.</ley-organica-proteccion-datos-personales:sensitive_data_processing_scenarios>
        <ley-organica-proteccion-datos-personales:sensitive_data_processing_scenarios>The processing is necessary for archiving purposes in the public interest, scientific or historical research purposes or statistical purposes.</ley-organica-proteccion-datos-personales:sensitive_data_processing_scenarios>
        <ley-organica-proteccion-datos-personales:sensitive_data_processing_scenarios>The processing is necessary for the performance of obligations and exercise of rights specific to the controller or the data subject in the field of labor law, social security and social protection.</ley-organica-proteccion-datos-personales:sensitive_data_processing_scenarios>
        <ley-organica-proteccion-datos-personales:sensitive_data_processing_scenarios>The processing is necessary to protect the vital interests of the data subject or of another natural person, in the event that the data subject is physically or legally incapable of giving consent.</ley-organica-proteccion-datos-personales:sensitive_data_processing_scenarios>
        <ley-organica-proteccion-datos-personales:sensitive_data_processing_scenarios>The processing relates to personal data that the data subject has manifestly made public</ley-organica-proteccion-datos-personales:sensitive_data_processing_scenarios>
        <ley-organica-proteccion-datos-personales:sensitive_data_processing_scenarios>Treatment is performed by order of a judicial authority.</ley-organica-proteccion-datos-personales:sensitive_data_processing_scenarios>
        <rdfs:comment xml:lang="en">The processing of sensitive personal data is prohibited, except in specific situations where it is justified.</rdfs:comment>
        <rdfs:comment xml:lang="es">The processing of sensitive personal data is prohibited, except in specific situations where it is justified.</rdfs:comment>
        <rdfs:label>sensitive data processing</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#serious_infractions -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#serious_infractions">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Serious_infractions"/>
        <ley-organica-proteccion-datos-personales:committed_by rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_processor"/>
        <ley-organica-proteccion-datos-personales:committed_by rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#personal_data_protection_authority"/>
        <ley-organica-proteccion-datos-personales:committed_by rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#responsible_for_treatment"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#source_accessible_to_the_public -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#source_accessible_to_the_public">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Source_accessible_to_the_public"/>
        <ley-organica-proteccion-datos-personales:description>Databases that can be consulted by any person</ley-organica-proteccion-datos-personales:description>
        <ley-organica-proteccion-datos-personales:has_the_characteristic_of_being>Generalized, i.e. indicates that access is widely available and available to a large audience</ley-organica-proteccion-datos-personales:has_the_characteristic_of_being>
        <ley-organica-proteccion-datos-personales:has_the_characteristic_of_being>Public access</ley-organica-proteccion-datos-personales:has_the_characteristic_of_being>
        <ley-organica-proteccion-datos-personales:has_the_characteristic_of_being>Unconditional, i.e. access is not subject to specific restrictions or conditions, therefore, anyone can access without the need to comply with particular requirements or restrictions.</ley-organica-proteccion-datos-personales:has_the_characteristic_of_being>
        <rdfs:comment xml:lang="en">Databases that can be consulted by any person</rdfs:comment>
        <rdfs:comment xml:lang="es">Databases that can be consulted by any person</rdfs:comment>
        <rdfs:label>source accessible to the public</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#special_personal_data_categories -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#special_personal_data_categories">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Special_personal_data_categories"/>
        <ley-organica-proteccion-datos-personales:special_categories_of_personal_data_are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#data_under_17_years_old"/>
        <ley-organica-proteccion-datos-personales:special_categories_of_personal_data_are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#disabled_owner_data"/>
        <ley-organica-proteccion-datos-personales:special_categories_of_personal_data_are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#health_related_data"/>
        <ley-organica-proteccion-datos-personales:special_categories_of_personal_data_are_composed_of rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#sensitive_data"/>
        <ley-organica-proteccion-datos-personales:description>Refers to sensitive information that requires additional protection due to its sensitive or potentially damaging nature if misused.</ley-organica-proteccion-datos-personales:description>
        <rdfs:comment xml:lang="en">Refers to sensitive information that requires additional protection due to its sensitive or potentially damaging nature if misused.</rdfs:comment>
        <rdfs:comment xml:lang="es">Refers to sensitive information that requires additional protection due to its sensitive or potentially damaging nature if misused.</rdfs:comment>
        <rdfs:label>special personal data categories</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#specialized_subject_data -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#specialized_subject_data">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Specialized_subject_data"/>
        <ley-organica-proteccion-datos-personales:shall_at_least_comply_with_the_minimum_with rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#minimum_criteria"/>
        <ley-organica-proteccion-datos-personales:description>Data subject to specific regulations established by other Ecuadorian or foreign laws.</ley-organica-proteccion-datos-personales:description>
        <ley-organica-proteccion-datos-personales:regulated_treatment_in_specialized_regulations_regarding>Datos en materia de desastres naturales, es decir, eventos catastróficos causados por fenómenos naturales como terremotos, huracanes, inundaciones, incendios forestales, entre otros, que pueden causar daños significativos a la vida, la propiedad y el medio ambiente</ley-organica-proteccion-datos-personales:regulated_treatment_in_specialized_regulations_regarding>
        <ley-organica-proteccion-datos-personales:regulated_treatment_in_specialized_regulations_regarding>Datos en materia de sectores regulados, es decir, áreas de actividad que están sujetas a regulaciones detalladas y específicas establecidas por leyes o normativas sectoriales ecuatoriana</ley-organica-proteccion-datos-personales:regulated_treatment_in_specialized_regulations_regarding>
        <ley-organica-proteccion-datos-personales:regulated_treatment_in_specialized_regulations_regarding>Freedom of expression data, i.e. the fundamental right of individuals to express their opinions, ideas and thoughts without censorship or repression by the State or other entities</ley-organica-proteccion-datos-personales:regulated_treatment_in_specialized_regulations_regarding>
        <ley-organica-proteccion-datos-personales:regulated_treatment_in_specialized_regulations_regarding>National security and state defense data, i.e. activities and policies aimed at protecting the territorial integrity, sovereignty and national interests of a country against internal and external threats, including acts of terrorism, espionage and military aggression.</ley-organica-proteccion-datos-personales:regulated_treatment_in_specialized_regulations_regarding>
        <ley-organica-proteccion-datos-personales:regulated_treatment_in_specialized_regulations_regarding>Personal data provided to administrative or judicial authorities, i.e. personal data that must be provided to government authorities, whether administrative (e.g. government agencies) or judicial (e.g. courts), in compliance with lawful requests supported by law and in the exercise of their lawful powers.</ley-organica-proteccion-datos-personales:regulated_treatment_in_specialized_regulations_regarding>
        <ley-organica-proteccion-datos-personales:regulated_treatment_in_specialized_regulations_regarding>Risk management data, i.e., processes and practices used to identify, assess and mitigate potential risks faced by organizations in their business activities or service delivery.</ley-organica-proteccion-datos-personales:regulated_treatment_in_specialized_regulations_regarding>
        <ley-organica-proteccion-datos-personales:will_be_subject_to>If necessary, compliance with international human rights standards shall be ensured.</ley-organica-proteccion-datos-personales:will_be_subject_to>
        <ley-organica-proteccion-datos-personales:will_be_subject_to>Principles established in specialized regulations</ley-organica-proteccion-datos-personales:will_be_subject_to>
        <ley-organica-proteccion-datos-personales:will_be_subject_to>Principles of the Organic Law for the Protection of Personal Data</ley-organica-proteccion-datos-personales:will_be_subject_to>
        <rdfs:comment xml:lang="en">Data subject to specific regulations established by other Ecuadorian or foreign laws.</rdfs:comment>
        <rdfs:comment xml:lang="es">Data subject to specific regulations established by other Ecuadorian or foreign laws.</rdfs:comment>
        <rdfs:label>specialized subject data</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#successor_right_holder -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#successor_right_holder">
        <rdf:type rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Successor_right_holder"/>
        <ley-organica-proteccion-datos-personales:description>Person or entity legally appointed to represent and exercise the rights and obligations related to the personal data of a deceased individual.</ley-organica-proteccion-datos-personales:description>
        <ley-organica-proteccion-datos-personales:exercise_of_rights_by_the_deceased_owner>To contact the person responsible for the processing of personal data in order to request access, rectification and updating or deletion of the personal data of the deceased person he/she represents.</ley-organica-proteccion-datos-personales:exercise_of_rights_by_the_deceased_owner>
        <rdfs:comment xml:lang="en">Person or entity legally appointed to represent and exercise the rights and obligations related to the personal data of a deceased individual.</rdfs:comment>
        <rdfs:comment xml:lang="es">Person or entity legally appointed to represent and exercise the rights and obligations related to the personal data of a deceased individual.</rdfs:comment>
        <rdfs:label>successor right holder</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#terminología -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#terminología">
