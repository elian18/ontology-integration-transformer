    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Consent">
        <terms:source xml:lang="es">LOPDP, art. 33</terms:source>
        <terms:source xml:lang="es">LOPDP, art. 4</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is the same as dpv:Consent. Bridge with the GDPR: is close to gdprtext:Consent (through dpv:Consent); is close to gdprtext:ConsentActivity (through dpv:Consent); is close to gdprtext:GivenConsent (through dpv:Consent).</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es igual a dpv:Consent. Puente con el GDPR: se parece a gdprtext:Consent (por dpv:Consent); se parece a gdprtext:ConsentActivity (por dpv:Consent); se parece a gdprtext:GivenConsent (por dpv:Consent).</rdfs:comment>
        <rdfs:label>Consent</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#Consent"/>
        <skos:closeMatch rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#ConsentActivity"/>
        <skos:closeMatch rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#GivenConsent"/>
        <skos:exactMatch rdf:resource="https://w3id.org/dpv#Consent"/>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Consent"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
        <owl:annotatedTarget rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#Consent"/>
        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#Consent"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv Consent exactMatch dpv:Consent y GDPRtEXT Consent exactMatch dpv:Consent.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Consent"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
        <owl:annotatedTarget rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#ConsentActivity"/>
        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#Consent"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv Consent exactMatch dpv:Consent y GDPRtEXT ConsentActivity exactMatch dpv:Consent.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Consent"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
