    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_of_access -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_of_access">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights"/>
        <terms:source xml:lang="es">LOPDP, art. 13</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is a kind of dpv:DataSubjectRight; is related to dpv:Access.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es un tipo de dpv:DataSubjectRight; está relacionado con dpv:Access.</rdfs:comment>
        <rdfs:label>Right of access</rdfs:label>
        <skos:broadMatch rdf:resource="https://w3id.org/dpv#DataSubjectRight"/>
        <skos:relatedMatch rdf:resource="https://w3id.org/dpv#Access"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_of_deletion -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_of_deletion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_of_opposition -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_of_opposition">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_consult -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_consult">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_correction_and_update -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_correction_and_update">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights"/>
        <terms:source xml:lang="es">LOPDP, art. 14</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is a kind of dpv:DataSubjectRight.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es un tipo de dpv:DataSubjectRight.</rdfs:comment>
        <rdfs:label>Right to correction and update</rdfs:label>
        <skos:broadMatch rdf:resource="https://w3id.org/dpv#DataSubjectRight"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_digital_education -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_digital_education">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_information -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_information">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_suspension_of_treatment -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Right_to_suspension_of_treatment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Organic_Law_on_Personal_Data_Protection"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights_of_credit_data_owners -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights_of_credit_data_owners">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Rights"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Sanctions -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Sanctions">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Organic_Law_on_Personal_Data_Protection"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Scope_of_application -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Scope_of_application">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Applicability"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Security -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Security">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Principles"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Sensitive_data -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Sensitive_data">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Sensitive_data_processing -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Sensitive_data_processing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Applicability"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Serious_infractions -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Serious_infractions">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Violations"/>
        <terms:source xml:lang="es">LOPDP, art. 68</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is related to dpv:ObligationViolated.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: está relacionado con dpv:ObligationViolated.</rdfs:comment>
        <rdfs:label>Serious infractions</rdfs:label>
        <skos:relatedMatch rdf:resource="https://w3id.org/dpv#ObligationViolated"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Source_accessible_to_the_public -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Source_accessible_to_the_public">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Terminology"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Special_personal_data_categories -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Special_personal_data_categories">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_types"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Specialized_subject_data -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Specialized_subject_data">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Personal_data"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Successor_right_holder -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Successor_right_holder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Owner"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Terminology -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Terminology">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Organic_Law_on_Personal_Data_Protection"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Territorial -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Territorial">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Scope_of_application"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Transparency -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Transparency">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Principles"/>
        <terms:source xml:lang="es">LOPDP, art. 10</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is related to dpv:PrivacyNotice.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: está relacionado con dpv:PrivacyNotice.</rdfs:comment>
        <rdfs:label>Transparency</rdfs:label>
        <skos:relatedMatch rdf:resource="https://w3id.org/dpv#PrivacyNotice"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Turnover -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Turnover">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Terminology"/>
        <terms:source xml:lang="es">LOPDP, art. 73</terms:source>
        <rdfs:label>Turnover</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Violations -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Violations">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Organic_Law_on_Personal_Data_Protection"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#AdequateProtectionLevel -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#AdequateProtectionLevel">
        <terms:source xml:lang="es">LOPDP, art. 56</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is related to dpv:DataProtectionAuthority.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: está relacionado con dpv:DataProtectionAuthority.</rdfs:comment>
        <rdfs:label xml:lang="es">nivel adecuado de protección</rdfs:label>
        <skos:definition xml:lang="es">Estándar requerido para que países u organizaciones puedan recibir datos personales de forma segura.</skos:definition>
        <skos:relatedMatch rdf:resource="https://w3id.org/dpv#DataProtectionAuthority"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#AdministrativeProcedure -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#AdministrativeProcedure">
        <terms:source xml:lang="es">LOPDP, art. 64</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is close to dpv:AuthorisationProcedure; is a kind of dpv:GovernanceProcedures; is related to dpv:ApprovalProcedure.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: se parece a dpv:AuthorisationProcedure; es un tipo de dpv:GovernanceProcedures; está relacionado con dpv:ApprovalProcedure.</rdfs:comment>
        <rdfs:label xml:lang="es">procedimiento administrativo</rdfs:label>
        <skos:broadMatch rdf:resource="https://w3id.org/dpv#GovernanceProcedures"/>
        <skos:closeMatch rdf:resource="https://w3id.org/dpv#AuthorisationProcedure"/>
        <skos:definition xml:lang="es">Proceso formal ante la Autoridad de Protección de Datos cuando un requerimiento previo es negado o no contestado.</skos:definition>
        <skos:relatedMatch rdf:resource="https://w3id.org/dpv#ApprovalProcedure"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#BindingCorporateRules -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#BindingCorporateRules">
        <terms:source xml:lang="es">LOPDP, art. 58</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is a kind of dpv:LegalCompliance; is broader than dpv:ContractualTerms; is related to dpv:FulfilmentOfContractualObligation.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es un tipo de dpv:LegalCompliance; es más general que dpv:ContractualTerms; está relacionado con dpv:FulfilmentOfContractualObligation.</rdfs:comment>
        <rdfs:label xml:lang="es">normas corporativas vinculantes</rdfs:label>
        <skos:broadMatch rdf:resource="https://w3id.org/dpv#LegalCompliance"/>
        <skos:definition xml:lang="es">Reglas de obligatorio cumplimiento para el grupo empresarial que regulan la transferencia internacional de datos.</skos:definition>
        <skos:narrowMatch rdf:resource="https://w3id.org/dpv#ContractualTerms"/>
        <skos:relatedMatch rdf:resource="https://w3id.org/dpv#FulfilmentOfContractualObligation"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#CessationOfTreatment -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#CessationOfTreatment">
        <terms:source xml:lang="es">LOPDP, art. 65</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is broader than dpv:UntilTimeDuration.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es más general que dpv:UntilTimeDuration.</rdfs:comment>
        <rdfs:label xml:lang="es">cese del tratamiento</rdfs:label>
        <skos:definition xml:lang="es">Medida correctiva que consiste en detener el tratamiento de datos bajo condiciones o plazos determinados.</skos:definition>
        <skos:narrowMatch rdf:resource="https://w3id.org/dpv#UntilTimeDuration"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#CodesOfConduct -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#CodesOfConduct">
        <terms:source xml:lang="es">LOPDP, art. 53</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is the same as dpv:CodeOfConduct. Bridge with the GDPR: is close to gdprtext:CodeOfConduct (through dpv:CodeOfConduct).</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es igual a dpv:CodeOfConduct. Puente con el GDPR: se parece a gdprtext:CodeOfConduct (por dpv:CodeOfConduct).</rdfs:comment>
        <rdfs:label xml:lang="es">códigos de conducta</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#CodeOfConduct"/>
        <skos:definition xml:lang="es">Instrumentos sectoriales promovidos para el cumplimiento de la normativa de protección de datos.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/dpv#CodeOfConduct"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/profiles/ecuador-lopdp#CodesOfConduct"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
        <owl:annotatedTarget rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#CodeOfConduct"/>
        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#CodeOfConduct"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv CodesOfConduct exactMatch dpv:CodeOfConduct y GDPRtEXT CodeOfConduct exactMatch dpv:CodeOfConduct.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#ConfidentialityAgreement -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#ConfidentialityAgreement">
        <terms:source xml:lang="es">LOPDP, art. 47</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is the same as dpv:ConfidentialityAgreement. Bridge with the GDPR: is close to gdprtext:ImposeConfidentialityObligationOnPersonnel (through dpv:ConfidentialityAgreement).</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es igual a dpv:ConfidentialityAgreement. Puente con el GDPR: se parece a gdprtext:ImposeConfidentialityObligationOnPersonnel (por dpv:ConfidentialityAgreement).</rdfs:comment>
        <rdfs:label xml:lang="es">contratos de confidencialidad</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#ImposeConfidentialityObligationOnPersonnel"/>
        <skos:definition xml:lang="es">Instrumento legal para garantizar el manejo adecuado de datos personales por parte del personal y encargados.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/dpv#ConfidentialityAgreement"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/profiles/ecuador-lopdp#ConfidentialityAgreement"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
        <owl:annotatedTarget rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#ImposeConfidentialityObligationOnPersonnel"/>
        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#ConfidentialityAgreement"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv ConfidentialityAgreement exactMatch dpv:ConfidentialityAgreement y GDPRtEXT ImposeConfidentialityObligationOnPersonnel exactMatch dpv:ConfidentialityAgreement.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#DataBreachException -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#DataBreachException">
        <terms:source xml:lang="es">LOPDP, art. 46</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is broader than dpv:DataBreachNotice.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es más general que dpv:DataBreachNotice.</rdfs:comment>
        <rdfs:label xml:lang="es">excepciones a la notificación de vulneración</rdfs:label>
        <skos:definition xml:lang="es">Casos específicos donde no es necesario notificar al titular sobre una vulneración de seguridad bajo condiciones demostrables.</skos:definition>
        <skos:narrowMatch rdf:resource="https://w3id.org/dpv#DataBreachNotice"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#DataDeletion -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#DataDeletion">
        <terms:source xml:lang="es">LOPDP, art. 65</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is the same as dpv:Delete; is related to dpv:DataDeletionPolicy.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es igual a dpv:Delete; está relacionado con dpv:DataDeletionPolicy.</rdfs:comment>
        <rdfs:label xml:lang="es">eliminación de los datos</rdfs:label>
        <skos:definition xml:lang="es">Medida correctiva que consiste en suprimir los datos personales objeto de la infracción.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/dpv#Delete"/>
        <skos:relatedMatch rdf:resource="https://w3id.org/dpv#DataDeletionPolicy"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#DataDeletionMethods -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#DataDeletionMethods">
        <terms:source xml:lang="es">LOPDP, art. 15</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is the same as dpv:DataSanitisationTechnique; is broader than dpv:DataRedaction; is related to dpv:DataDeletionPolicy.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es igual a dpv:DataSanitisationTechnique; es más general que dpv:DataRedaction; está relacionado con dpv:DataDeletionPolicy.</rdfs:comment>
        <rdfs:label xml:lang="es">Métodos de eliminación</rdfs:label>
        <skos:definition xml:lang="es">Técnicas para hacer ilegibles o irreconocibles los datos de forma definitiva y segura.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/dpv#DataSanitisationTechnique"/>
        <skos:narrowMatch rdf:resource="https://w3id.org/dpv#DataRedaction"/>
        <skos:relatedMatch rdf:resource="https://w3id.org/dpv#DataDeletionPolicy"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#DataProtectionAudit -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#DataProtectionAudit">
        <terms:source xml:lang="es">LOPDP, art. 58</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is the same as dpv:PersonalDataAudit.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es igual a dpv:PersonalDataAudit.</rdfs:comment>
        <rdfs:label xml:lang="es">auditorías de protección de datos</rdfs:label>
        <skos:definition xml:lang="es">Mecanismo de verificación sobre el cumplimiento de las normas corporativas vinculantes.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/dpv#PersonalDataAudit"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#DataSecurityBreach -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#DataSecurityBreach">
        <terms:source xml:lang="es">LOPDP, art. 4</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is related to dpv:DataBreachRecord.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: está relacionado con dpv:DataBreachRecord.</rdfs:comment>
        <rdfs:label xml:lang="es">Vulneración de la seguridad de los datos personales</rdfs:label>
        <skos:definition xml:lang="es">Incidente de seguridad que afecta la confidencialidad, disponibilidad o integridad de los datos personales.</skos:definition>
        <skos:relatedMatch rdf:resource="https://w3id.org/dpv#DataBreachRecord"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#DirectRequirement -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#DirectRequirement">
        <terms:source xml:lang="es">LOPDP, art. 62</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is close to dpv:RequestRequiresAction.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: se parece a dpv:RequestRequiresAction.</rdfs:comment>
        <rdfs:label xml:lang="es">requerimiento directo</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/dpv#RequestRequiresAction"/>
        <skos:definition xml:lang="es">Acción gratuita que puede ejercer el titular ante el responsable del tratamiento sobre sus derechos.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#DutyOfConfidentiality -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#DutyOfConfidentiality">
        <terms:source xml:lang="es">LOPDP, art. 30</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is related to dpv:ContractConfidentialityClause.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: está relacionado con dpv:ContractConfidentialityClause.</rdfs:comment>
        <rdfs:label xml:lang="es">Deber de confidencialidad</rdfs:label>
        <skos:definition xml:lang="es">Obligación de responsables, encargados y terceras personas en el tratamiento de datos de salud para garantizar su seguridad y complementar el secreto profesional.</skos:definition>
        <skos:relatedMatch rdf:resource="https://w3id.org/dpv#ContractConfidentialityClause"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#ImpactAssessment -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#ImpactAssessment">
        <terms:source xml:lang="es">LOPDP, art. 42</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is the same as dpv:ImpactAssessment. Bridge with the GDPR: is close to gdprtext:FactorsForImpactAssessment (through dpv:ImpactAssessment); is close to gdprtext:ImpactAssessment (through dpv:ImpactAssessment).</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es igual a dpv:ImpactAssessment. Puente con el GDPR: se parece a gdprtext:FactorsForImpactAssessment (por dpv:ImpactAssessment); se parece a gdprtext:ImpactAssessment (por dpv:ImpactAssessment).</rdfs:comment>
        <rdfs:label xml:lang="es">evaluación de impacto del tratamiento de datos personales</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#FactorsForImpactAssessment"/>
        <skos:closeMatch rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#ImpactAssessment"/>
        <skos:definition xml:lang="es">Proceso obligatorio realizado por el responsable para identificar riesgos altos en el tratamiento de datos personales.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/dpv#ImpactAssessment"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/profiles/ecuador-lopdp#ImpactAssessment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
        <owl:annotatedTarget rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#FactorsForImpactAssessment"/>
        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#ImpactAssessment"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv ImpactAssessment exactMatch dpv:ImpactAssessment y GDPRtEXT FactorsForImpactAssessment exactMatch dpv:ImpactAssessment.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/profiles/ecuador-lopdp#ImpactAssessment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
        <owl:annotatedTarget rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#ImpactAssessment"/>
        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#ImpactAssessment"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv ImpactAssessment exactMatch dpv:ImpactAssessment y GDPRtEXT ImpactAssessment exactMatch dpv:ImpactAssessment.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#MinorAutomatedDecisionRight -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#MinorAutomatedDecisionRight">
        <terms:source xml:lang="es">LOPDP, art. 21</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is a kind of dpv:DataSubjectRight; is related to dpv:AutomatedDecisionMaking.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es un tipo de dpv:DataSubjectRight; está relacionado con dpv:AutomatedDecisionMaking.</rdfs:comment>
        <rdfs:label xml:lang="es">Derecho de niñas, niños y adolescentes a no ser objeto de una decisión basada única o parcialmente en valoraciones automatizadas</rdfs:label>
        <skos:broadMatch rdf:resource="https://w3id.org/dpv#DataSubjectRight"/>
        <skos:definition xml:lang="es">Prohibición de tratar datos sensibles o de menores de edad mediante valoraciones automatizadas, salvo autorización expresa o interés público esencial.</skos:definition>
        <skos:relatedMatch rdf:resource="https://w3id.org/dpv#AutomatedDecisionMaking"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#NationalDataProtectionRegistry -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#NationalDataProtectionRegistry">
        <terms:source xml:lang="es">LOPDP, art. 51</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is a kind of dpv:PublicRegisterOfEntities.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es un tipo de dpv:PublicRegisterOfEntities.</rdfs:comment>
        <rdfs:label xml:lang="es">Registro Nacional de protección de datos personales</rdfs:label>
        <skos:broadMatch rdf:resource="https://w3id.org/dpv#PublicRegisterOfEntities"/>
        <skos:definition xml:lang="es">Sistema donde el responsable debe reportar y mantener actualizada la información sobre el tratamiento de datos.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#PersonalDataProtection -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#PersonalDataProtection">
        <terms:source xml:lang="es">LOPDP, art. 1</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is related to dpv:SensitivePersonalData.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: está relacionado con dpv:SensitivePersonalData.</rdfs:comment>
        <rdfs:label xml:lang="es">protección de datos personales</rdfs:label>
        <skos:definition xml:lang="es">Derecho que incluye el acceso y decisión sobre información y datos de carácter personal.</skos:definition>
        <skos:relatedMatch rdf:resource="https://w3id.org/dpv#SensitivePersonalData"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#PrivacyByDefault -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#PrivacyByDefault">
        <terms:source xml:lang="es">LOPDP, art. 39</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is the same as dpv:PrivacyByDefault.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es igual a dpv:PrivacyByDefault.</rdfs:comment>
        <rdfs:label xml:lang="es">protección de datos por defecto</rdfs:label>
        <skos:definition xml:lang="es">Obligación de tratar únicamente los datos personales estrictamente necesarios para cada fin específico.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/dpv#PrivacyByDefault"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#ProportionalityPrinciple -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#ProportionalityPrinciple">
        <terms:source xml:lang="es">LOPDP, art. 71</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is a kind of dpv:Principle.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es un tipo de dpv:Principle.</rdfs:comment>
        <rdfs:label xml:lang="es">principio de proporcionalidad</rdfs:label>
        <skos:broadMatch rdf:resource="https://w3id.org/dpv#Principle"/>
        <skos:definition xml:lang="es">Criterio utilizado para establecer la cuantía de la multa basado en la intencionalidad, reiteración, perjuicio y reincidencia.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#ProvisionalMeasures -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#ProvisionalMeasures">
        <terms:source xml:lang="es">LOPDP, art. 74</terms:source>
        <rdfs:label xml:lang="es">Medidas provisionales o cautelares</rdfs:label>
        <skos:definition xml:lang="es">Medidas de protección o cautelares aplicables por la Autoridad de Protección de Datos Personales según la norma procedimental administrativa.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#Recidivism -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#Recidivism">
        <terms:source xml:lang="es">LOPDP, art. 71</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is related to dpv:RuleViolated.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: está relacionado con dpv:RuleViolated.</rdfs:comment>
        <rdfs:label xml:lang="es">reincidencia</rdfs:label>
        <skos:definition xml:lang="es">Circunstancia donde la infracción precedente es de la misma naturaleza que la que se pretende sancionar.</skos:definition>
        <skos:relatedMatch rdf:resource="https://w3id.org/dpv#RuleViolated"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#RiskReport -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#RiskReport">
        <terms:source xml:lang="es">LOPDP, art. 9</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is close to dpv:RiskAssessment; is a kind of dpv:RiskConcept.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: se parece a dpv:RiskAssessment; es un tipo de dpv:RiskConcept.</rdfs:comment>
        <rdfs:label xml:lang="es">Informe de riesgo</rdfs:label>
        <skos:broadMatch rdf:resource="https://w3id.org/dpv#RiskConcept"/>
        <skos:closeMatch rdf:resource="https://w3id.org/dpv#RiskAssessment"/>
        <skos:definition xml:lang="es">Documento requerido por la Autoridad para verificar amenazas a los derechos de los titulares.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#SelfRegulation -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#SelfRegulation">
        <terms:source xml:lang="es">LOPDP, art. 52</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is a kind of dpv:CertificationSeal.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es un tipo de dpv:CertificationSeal.</rdfs:comment>
        <rdfs:label xml:lang="es">Autorregulación</rdfs:label>
        <skos:broadMatch rdf:resource="https://w3id.org/dpv#CertificationSeal"/>
        <skos:definition xml:lang="es">Facultad voluntaria de adherirse a códigos de conducta y certificaciones sin eximir la responsabilidad legal.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#TechnicalAndLegalMeasures -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#TechnicalAndLegalMeasures">
        <terms:source xml:lang="es">LOPDP, art. 65</terms:source>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is the same as dpv:TechnicalOrganisationalMeasure; is a kind of dpv:LegalMeasure; is a kind of dpv:TechnicalMeasure.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es igual a dpv:TechnicalOrganisationalMeasure; es un tipo de dpv:LegalMeasure; es un tipo de dpv:TechnicalMeasure.</rdfs:comment>
        <rdfs:label xml:lang="es">medidas técnicas, jurídicas, organizativas o administrativas</rdfs:label>
        <skos:broadMatch rdf:resource="https://w3id.org/dpv#LegalMeasure"/>
        <skos:broadMatch rdf:resource="https://w3id.org/dpv#TechnicalMeasure"/>
        <skos:definition xml:lang="es">Imposición de medidas para garantizar un tratamiento adecuado de los datos personales.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/dpv#TechnicalOrganisationalMeasure"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/profiles/ecuador-lopdp#UnfulfilledRegistry -->


    <owl:Class rdf:about="http://www.semanticweb.org/profiles/ecuador-lopdp#UnfulfilledRegistry">
        <rdfs:label xml:lang="es">Registro Único de Responsables y Encargados Incumplidos</rdfs:label>
        <skos:definition xml:lang="es">Registro de responsables y encargados del tratamiento de datos personales que han incurrido en infracciones, con fines sociales, estadísticos, preventivos y de capacitación.</skos:definition>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#access_right001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#access_right001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Right_of_access_in_verification"/>
        <OntologiaLOPDP:can_be_rights_of rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#access_right001"/>
        <OntologiaLOPDP:Consent_in_verification>Must be consented to by the owner</OntologiaLOPDP:Consent_in_verification>
        <OntologiaLOPDP:General_detail>This right states that the owner of the information has the right to access it free of charge and in detail within 15 days.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Informed>It can be an informed consent</OntologiaLOPDP:Informed>
        <OntologiaLOPDP:Not_informed>May be an uninformed consent</OntologiaLOPDP:Not_informed>
        <OntologiaLOPDP:Revoke_consent>It must be possible to revoke the consent at any time, this can be done by the owner of the data.</OntologiaLOPDP:Revoke_consent>
        <OntologiaLOPDP:Updated>Must be updated</OntologiaLOPDP:Updated>
        <OntologiaLOPDP:right_of_access_time>15 days</OntologiaLOPDP:right_of_access_time>
        <rdfs:label>access right001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#addressee_in_verification001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#addressee_in_verification001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Addressee_in_verification"/>
        <OntologiaLOPDP:is_compliant_with_the_following_roles rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#addressee_in_verification001"/>
        <OntologiaLOPDP:Details_of_the_law_details>Information</OntologiaLOPDP:Details_of_the_law_details>
        <OntologiaLOPDP:General_detail>It is the natural or legal person to whom the holder&apos;s data will be sent.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Name>Pedro</OntologiaLOPDP:Name>
        <OntologiaLOPDP:Personal_detail>Person receiving the information</OntologiaLOPDP:Personal_detail>
        <OntologiaLOPDP:Personal_information>Recipient information</OntologiaLOPDP:Personal_information>
        <rdfs:label>addressee in verification001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#administrative001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#administrative001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Administrative"/>
        <OntologiaLOPDP:that_can_be_of_the_type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#administrative001"/>
        <OntologiaLOPDP:Applied>When the measure is applied</OntologiaLOPDP:Applied>
        <OntologiaLOPDP:Cessation_of_treatment>When the corrective action stops</OntologiaLOPDP:Cessation_of_treatment>
        <OntologiaLOPDP:Exceptions>Exceptions applicable to administrative companies</OntologiaLOPDP:Exceptions>
        <OntologiaLOPDP:General_detail>Actions to be taken in administrative cases.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Guidelines>Administrative guidelines</OntologiaLOPDP:Guidelines>
        <OntologiaLOPDP:Guidelines>Guidelines to follow</OntologiaLOPDP:Guidelines>
        <OntologiaLOPDP:Not_applied>When a verification process does not apply</OntologiaLOPDP:Not_applied>
        <OntologiaLOPDP:Regulations>Administrative regulations</OntologiaLOPDP:Regulations>
        <rdfs:label>administrative001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#administrative_or_judicial_authorities001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#administrative_or_judicial_authorities001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Administrative_or_judicial_authorities"/>
        <OntologiaLOPDP:segmented_into_the_following_national_cases rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#administrative_or_judicial_authorities001"/>
        <OntologiaLOPDP:Exceptions>Administrative and legal exemptions are available</OntologiaLOPDP:Exceptions>
        <OntologiaLOPDP:General_detail>In an investigation process, the holder&apos;s data may be used either by a judge or an administrative entity.</OntologiaLOPDP:General_detail>
        <rdfs:label>administrative or judicial authorities001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#admitted_countries001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#admitted_countries001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Admitted_Countries"/>
        <OntologiaLOPDP:where_in_in_the_international_field_you_have_to_have rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#admitted_countries001"/>
        <OntologiaLOPDP:Availability>Information must be available</OntologiaLOPDP:Availability>
        <OntologiaLOPDP:Communicate>The information must be communicated</OntologiaLOPDP:Communicate>
        <OntologiaLOPDP:Correct>The information must be corrected</OntologiaLOPDP:Correct>
        <OntologiaLOPDP:Data_admitted_countries_international_transfer>Admitted countries information</OntologiaLOPDP:Data_admitted_countries_international_transfer>
        <OntologiaLOPDP:General_detail>These are the countries that are allowed to carry out data transfer processes with Ecuador.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Mitigate>The information must be mitigated</OntologiaLOPDP:Mitigate>
        <OntologiaLOPDP:Prevent>Information must be prevented</OntologiaLOPDP:Prevent>
        <OntologiaLOPDP:Transmit>The information must be transmitted</OntologiaLOPDP:Transmit>
        <rdfs:label>admitted countries001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#análisis_de_riesgo_amenazas_y_vulnerabilidades001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#análisis_de_riesgo_amenazas_y_vulnerabilidades001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Risk_analysis_of_threats_and_vulnerabilities"/>
        <OntologiaLOPDP:account_with_actions_as rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#análisis_de_riesgo_amenazas_y_vulnerabilidades001"/>
        <OntologiaLOPDP:General_detail>Es una tarea que debe realizar el responsable y encargado del tratamiento de los datos para evitar la presencia de esta amenazas.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Risk>Riego presente en un análisis de datos</OntologiaLOPDP:Risk>
        <OntologiaLOPDP:Secrecy_of_communications>La transferencia de información debe ser secreta</OntologiaLOPDP:Secrecy_of_communications>
        <OntologiaLOPDP:Threat>Amenaza a los datos</OntologiaLOPDP:Threat>
        <OntologiaLOPDP:Vulnerabilidad>Vulnerabildiad presente en los datos en procesos de transferencia</OntologiaLOPDP:Vulnerabilidad>
        <rdfs:label>análisis de riesgo amenazas y vulnerabilidades001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#applicable_safety_measures001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#applicable_safety_measures001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Applicable_safety_measures"/>
        <OntologiaLOPDP:account_with_actions_as rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#applicable_safety_measures001"/>
        <OntologiaLOPDP:Check>The applicable security measures must control the risk to the data.</OntologiaLOPDP:Check>
        <OntologiaLOPDP:Excess_of_authorization>The applicable security measures must prevent the authorization process in the data.</OntologiaLOPDP:Excess_of_authorization>
        <OntologiaLOPDP:General_detail>Concrete actions that the responsible and in charge must take into consideration at the moment of a change or mishandling of the data of the owner of the information.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Mitigate>The applicable security measures must mitigate the risk to the data.</OntologiaLOPDP:Mitigate>
        <OntologiaLOPDP:Not_authorized>The applicable security measures must prevent unauthorized access to the data.</OntologiaLOPDP:Not_authorized>
        <OntologiaLOPDP:Prevent>The applicable security measures must prevent the risk to the data.</OntologiaLOPDP:Prevent>
        <OntologiaLOPDP:Reduce>The applicable security measures must reduce the risk to the data.</OntologiaLOPDP:Reduce>
        <OntologiaLOPDP:Secrecy_of_communications>The applicable security measures must be governed by the secrecy of data communications.</OntologiaLOPDP:Secrecy_of_communications>
        <OntologiaLOPDP:Stop>The applicable security measures must prevent data compromise</OntologiaLOPDP:Stop>
        <rdfs:label>applicable safety measures001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#authority001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#authority001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_Data_Protection_Authority_in_verification"/>
        <OntologiaLOPDP:is_compliant_with_the_following_roles rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#authority001"/>
        <OntologiaLOPDP:Advise_on_risk_analysis>Gives assistance on specific issues</OntologiaLOPDP:Advise_on_risk_analysis>
        <OntologiaLOPDP:Control_systemized_and_stabilized_control>Follows up on everything</OntologiaLOPDP:Control_systemized_and_stabilized_control>
        <OntologiaLOPDP:Cooperate_with_the_Personal_Data_Protection_Authority>cooperates with the authority</OntologiaLOPDP:Cooperate_with_the_Personal_Data_Protection_Authority>
        <OntologiaLOPDP:Correct>Corrects errors generated by the responsible parties in the information transfer process.</OntologiaLOPDP:Correct>
        <OntologiaLOPDP:Designation_of_the_authority_process>The Personal Data Authority is designated in accordance with the provisions of the Constitution of Ecuador.</OntologiaLOPDP:Designation_of_the_authority_process>
        <OntologiaLOPDP:Details_of_the_law_details>Information on the members of the law</OntologiaLOPDP:Details_of_the_law_details>
        <OntologiaLOPDP:General_detail>He is in charge of supervising that everything is in order and if there is any inconsistency, he solves it.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Mitigate>Mitigates data risks</OntologiaLOPDP:Mitigate>
        <OntologiaLOPDP:Name>Juan</OntologiaLOPDP:Name>
        <OntologiaLOPDP:Personal_detail>It is responsible for the implementation of corrective actions.</OntologiaLOPDP:Personal_detail>
        <OntologiaLOPDP:Personal_information>Authority data</OntologiaLOPDP:Personal_information>
        <OntologiaLOPDP:Prevent>Prevents errors</OntologiaLOPDP:Prevent>
        <OntologiaLOPDP:Sanctioning_administrative_procedure>Performs the corresponding procedure</OntologiaLOPDP:Sanctioning_administrative_procedure>
        <OntologiaLOPDP:Serious>from 10 to 20 unified basic salaries</OntologiaLOPDP:Serious>
        <OntologiaLOPDP:Slight>from 1 to 10 basic unified salaries.</OntologiaLOPDP:Slight>
        <OntologiaLOPDP:Supervise>Supervises the delegate</OntologiaLOPDP:Supervise>
        <OntologiaLOPDP:Transfer_or_international_communication>The Personal Data Authority is responsible for establishing the international transfer and communication processes.</OntologiaLOPDP:Transfer_or_international_communication>
        <OntologiaLOPDP:Very_serious>It is not specified what sanction to take in these cases, more aspects should be considered.</OntologiaLOPDP:Very_serious>
        <rdfs:label>authority001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#authorization_for_international_transfer001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#authorization_for_international_transfer001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Authorization_for_international_transfer"/>
        <OntologiaLOPDP:where_in_in_the_international_field_you_have_to_have rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#authorization_for_international_transfer001"/>
        <OntologiaLOPDP:Excess_of_authorization>When in an international transfer an organization has many privileges</OntologiaLOPDP:Excess_of_authorization>
        <OntologiaLOPDP:General_detail>It is the permission you must have to perform an international data transfer.</OntologiaLOPDP:General_detail>
        <rdfs:label>authorization for international transfer001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#bank_or_stock_bank_data001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#bank_or_stock_bank_data001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Banking_stock_or_stock_market_data"/>
        <OntologiaLOPDP:segmented_into_the_following_international_cases rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#bank_or_stock_bank_data001"/>
        <OntologiaLOPDP:Detail_banking_data_or_stock_market_details>Details of bank or stock exchange data in an international transfer exception</OntologiaLOPDP:Detail_banking_data_or_stock_market_details>
        <OntologiaLOPDP:General_detail>In an international process involving money, the data of the owner of the information may be used.</OntologiaLOPDP:General_detail>
        <rdfs:label>bank or stock bank data001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#banking001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#banking001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Banking"/>
        <OntologiaLOPDP:in_consideration_of_credit_data_is_held rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#banking001"/>
        <OntologiaLOPDP:Access>The holder has access to his bank details</OntologiaLOPDP:Access>
        <OntologiaLOPDP:Correction>Bank details must be able to be rectified</OntologiaLOPDP:Correction>
        <OntologiaLOPDP:Detail_banking_data_or_stock_market_details>The banking data has a banking or stock market detail.</OntologiaLOPDP:Detail_banking_data_or_stock_market_details>
        <OntologiaLOPDP:Disposal>It must be possible to delete bank details</OntologiaLOPDP:Disposal>
        <OntologiaLOPDP:General_detail>Bank type data</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Updated>The data must be up to date</OntologiaLOPDP:Updated>
        <rdfs:label>banking001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#boys_and_girls001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#boys_and_girls001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Boys_and_girls"/>
        <OntologiaLOPDP:and_as_your_age_will_have_to_be_of_your_age rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#boys_and_girls001"/>
        <OntologiaLOPDP:Anonymization>It should be possible to anonymize data on children.</OntologiaLOPDP:Anonymization>
        <OntologiaLOPDP:Correction>Children&apos;s data must be able to be rectified</OntologiaLOPDP:Correction>
        <OntologiaLOPDP:Disposal>Children&apos;s data must be able to be removed</OntologiaLOPDP:Disposal>
        <OntologiaLOPDP:General_detail>They are a special type of owner that needs the explicit consent of their legal representative for the person in charge or owner of the information to make use of them. The age range to be considered as children&apos;s data is from 0 to 11 years old.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Supervision>They need the supervision of their parents or legal guardian in order to make use of this information.</OntologiaLOPDP:Supervision>
        <rdfs:label>boys and girls001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#certifying_entity001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#certifying_entity001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Certifying_entity_in_verification"/>
        <OntologiaLOPDP:account_with_a_certifying_entity rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#certifying_entity001"/>
        <OntologiaLOPDP:Certifying_international_transfer_processes>The information transfer process must be certified.</OntologiaLOPDP:Certifying_international_transfer_processes>
        <OntologiaLOPDP:Conducting_audits>Audits must be carried out by certified entities.</OntologiaLOPDP:Conducting_audits>
        <OntologiaLOPDP:General_detail>It is responsible for accrediting the information transfer processes, it is an entity endorsed by the Authority for the Protection of Personal Data.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Issue_certifications>Certification must be issued when any information transfer process is carried out.</OntologiaLOPDP:Issue_certifications>
        <OntologiaLOPDP:Issue_stamps>Stamps should be issued</OntologiaLOPDP:Issue_stamps>
        <rdfs:label>certifying entity001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#commercial001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#commercial001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Commercial"/>
        <OntologiaLOPDP:in_consideration_of_credit_data_is_held rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#commercial001"/>
        <OntologiaLOPDP:Access>Commercial data must be accessible</OntologiaLOPDP:Access>
        <OntologiaLOPDP:Disposal>It must be possible to delete commercial data</OntologiaLOPDP:Disposal>
        <OntologiaLOPDP:Disposal>It must be possible to rectify commercial data</OntologiaLOPDP:Disposal>
        <OntologiaLOPDP:General_detail>Commercial data to carry out transactions</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Updated>Commercial data must be up to date</OntologiaLOPDP:Updated>
        <rdfs:label>commercial001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Consent_in_verification"/>
        <OntologiaLOPDP:consent_is_emphasized rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento001"/>
        <rdfs:label>consentimiento001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento_autorizado001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento_autorizado001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Authorized_consent"/>
        <OntologiaLOPDP:can_be rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento_autorizado001"/>
        <OntologiaLOPDP:Commercial_use>No se puede hacer uso de los datos del titular a menos este último así lo decida y puede remitir su consentimiento en cualquier momento, no se puede comercializar o transferir a terceros los datos personales de los usuarios</OntologiaLOPDP:Commercial_use>
        <OntologiaLOPDP:Consent_authorized_informed_consent>consentimiento informado ante un hecho</OntologiaLOPDP:Consent_authorized_informed_consent>
        <OntologiaLOPDP:Free_authorized_consent>consentimiento libre para realizar una o más acciones sobre los datos</OntologiaLOPDP:Free_authorized_consent>
        <OntologiaLOPDP:General_detail>El consentimiento autorizado ocurre cuando se le informa al titular de la información sobre el uso que se le va a dar a la misma, además se pide su autorización sobre el uso de esa información.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:General_detail>El consentimiento no autorizado ocurre cuando no se le informa al titular de la información sobre el uso que se le va a dar a la misma, además no se pide su autorización sobre el uso de esa información.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Informed>Informar sobre lo que se va a hacer</OntologiaLOPDP:Informed>
        <OntologiaLOPDP:Not_informed>No informar al titular sobre lo que se va a hacer</OntologiaLOPDP:Not_informed>
        <OntologiaLOPDP:Specific_authorized_consent>consentimiento sobre algo concreto al momento de realizar una transferencia</OntologiaLOPDP:Specific_authorized_consent>
        <OntologiaLOPDP:Unequivocal_authorized_consent>consentimiento inequívo por parte del titular ante alguna acción</OntologiaLOPDP:Unequivocal_authorized_consent>
        <rdfs:label>consentimiento autorizado001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento_no_autorizado001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento_no_autorizado001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Unauthorized_consent"/>
        <OntologiaLOPDP:can_be rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consentimiento_no_autorizado001"/>
        <OntologiaLOPDP:Not_informed>No informar al titular sobre la no autorización del consentimiento</OntologiaLOPDP:Not_informed>
        <OntologiaLOPDP:Reason_for_refusal_of_consent>Detalles del por qué no se autorizó el consentimiento para realizar una transferencia</OntologiaLOPDP:Reason_for_refusal_of_consent>
        <rdfs:label>consentimiento no autorizado001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consultation_right001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consultation_right001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Right_to_consult_in_verification"/>
        <OntologiaLOPDP:can_be_rights_of rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#consultation_right001"/>
        <OntologiaLOPDP:Consent_in_verification>Must be consented to by the owner</OntologiaLOPDP:Consent_in_verification>
        <OntologiaLOPDP:General_detail>This right refers to the obligation that the law has in the event of a request for information by the owner of the information.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Informed>It can be an informed consent</OntologiaLOPDP:Informed>
        <OntologiaLOPDP:Not_informed>May be an uninformed consent</OntologiaLOPDP:Not_informed>
        <OntologiaLOPDP:Revoke_consent>It must be possible to revoke the consent at any time, this can be done by the owner of the data.</OntologiaLOPDP:Revoke_consent>
        <OntologiaLOPDP:Updated>Must be updated</OntologiaLOPDP:Updated>
        <rdfs:label>consultation right001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#continuous_monitoring_for_non-consenting_countries001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#continuous_monitoring_for_non-consenting_countries001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Continuous_control_for_countries_without_consent"/>
        <OntologiaLOPDP:where_in_in_the_international_field_you_have_to_have rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#continuous_monitoring_for_non-consenting_countries001"/>
        <OntologiaLOPDP:Check>A control system must be followed with the information</OntologiaLOPDP:Check>
        <OntologiaLOPDP:Control_systemized_and_stabilized_control>The control must be permanent and systematized.</OntologiaLOPDP:Control_systemized_and_stabilized_control>
        <OntologiaLOPDP:General_detail>In case the country is not in the list of admitted countries, the transfer can be made as long as a continuous control with this country is carried out.</OntologiaLOPDP:General_detail>
        <rdfs:label>continuous monitoring for non consenting countries001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#corrective_actions001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#corrective_actions001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Corrective_measures"/>
        <OntologiaLOPDP:the_verification_covers_aspects_such_as rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#corrective_actions001"/>
        <OntologiaLOPDP:Application>What will be done</OntologiaLOPDP:Application>
        <OntologiaLOPDP:Applied>Corrective action implemented</OntologiaLOPDP:Applied>
        <OntologiaLOPDP:Cessation_of_treatment>When the corrective action stops</OntologiaLOPDP:Cessation_of_treatment>
        <OntologiaLOPDP:Disposal>A corrective action can be eliminated</OntologiaLOPDP:Disposal>
        <OntologiaLOPDP:General_detail>These are actions to be taken in case of misuse of data or information provided by the owner of the information.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Guidelines>Guidelines for corrective action</OntologiaLOPDP:Guidelines>
        <OntologiaLOPDP:Guidelines>What will be followed</OntologiaLOPDP:Guidelines>
        <OntologiaLOPDP:Not_applied>When a corrective action is not implemented</OntologiaLOPDP:Not_applied>
        <OntologiaLOPDP:Regulations>Remedial action regulations</OntologiaLOPDP:Regulations>
        <OntologiaLOPDP:Technical_control>A correct telecommunications service must be provided and the Telecommunications Regulation and Control Agency must check/verify that the measures implemented to share this information are correctly implemented.</OntologiaLOPDP:Technical_control>
        <rdfs:label>corrective actions001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#credit_data001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#credit_data001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Credit_data_in_verification"/>
        <OntologiaLOPDP:that_can_be rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#credit_data001"/>
        <OntologiaLOPDP:Access>Los datos crediticios deben tener un acceso libre para el titular</OntologiaLOPDP:Access>
        <OntologiaLOPDP:Correction>Los datos crediticios deben poderse rectificar</OntologiaLOPDP:Correction>
        <OntologiaLOPDP:Credit_detail_data>Estos datos pueden ser usados en procesos de investigación sin el consentimiento del titular.

Por otro parte los datos crediticios son los datos bursátiles o bancarios del titular que en caso de no se necesarios para una investigación no pueden ser usados por terceros sin el consentimiento explícito del titular de la información.</OntologiaLOPDP:Credit_detail_data>
        <OntologiaLOPDP:Disposal>Los datos crediticios pueden ser eliminados</OntologiaLOPDP:Disposal>
        <OntologiaLOPDP:General_detail>Son datos de carácter bancario que se pueden usar en algún proceso investigativo.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Purpose>Los datos crediticios en general tienen una finalidad de uso en casos de análisis y no pueden ser comunicados o difundos para cualquier otra finalidad o fin.</OntologiaLOPDP:Purpose>
        <OntologiaLOPDP:Updated>Los datos crediticios pueden ser actualizados</OntologiaLOPDP:Updated>
        <rdfs:label>credit data001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#data_people_over_age_001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#data_people_over_age_001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Data_Seniors_data"/>
        <OntologiaLOPDP:and_the_owner_divides_into rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#data_people_over_age_001"/>
        <OntologiaLOPDP:Access>Data must be accessible</OntologiaLOPDP:Access>
        <OntologiaLOPDP:Accidental_or_illegal_destruction_or_communication>Data must not be subject to intentional or accidental destruction.</OntologiaLOPDP:Accidental_or_illegal_destruction_or_communication>
        <OntologiaLOPDP:Advise>The data must be available for consultation</OntologiaLOPDP:Advise>
        <OntologiaLOPDP:Advise_on_risk_analysis>The delegate provides risk analysis advice to the data authority.</OntologiaLOPDP:Advise_on_risk_analysis>
        <OntologiaLOPDP:Alterations>Data are prone to alterations, this should be avoided.</OntologiaLOPDP:Alterations>
        <OntologiaLOPDP:Anonymization>Data must be anonymized</OntologiaLOPDP:Anonymization>
        <OntologiaLOPDP:Audit>Data must be auditable</OntologiaLOPDP:Audit>
        <OntologiaLOPDP:Check>The risks present in the data must be controlled</OntologiaLOPDP:Check>
        <OntologiaLOPDP:Control_systemized_and_stabilized_control>Permanent control of the data must be carried out</OntologiaLOPDP:Control_systemized_and_stabilized_control>
        <OntologiaLOPDP:Cooperate_with_the_Personal_Data_Protection_Authority>The data is subject to cooperation between members of the law enforcement community.</OntologiaLOPDP:Cooperate_with_the_Personal_Data_Protection_Authority>
        <OntologiaLOPDP:Correct>The risks present in the data must be corrected</OntologiaLOPDP:Correct>
        <OntologiaLOPDP:Correction>It must be possible to rectify the data</OntologiaLOPDP:Correction>
        <OntologiaLOPDP:Delegate_functions>Some data are manipulated by the delegate</OntologiaLOPDP:Delegate_functions>
        <OntologiaLOPDP:Details_of_the_law_details>The data are present in the members of the law.</OntologiaLOPDP:Details_of_the_law_details>
        <OntologiaLOPDP:Disposal>It must be possible to delete data</OntologiaLOPDP:Disposal>
        <OntologiaLOPDP:General_detail>These are data subjects over 18 years of age who do not need the permission of another person in order to use their data.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Impact_assessment>The impact of the data must be assessed</OntologiaLOPDP:Impact_assessment>
        <OntologiaLOPDP:Large_scale_treatment>Large-scale data analysis is required</OntologiaLOPDP:Large_scale_treatment>
        <OntologiaLOPDP:Loss>Prevent data loss</OntologiaLOPDP:Loss>
        <OntologiaLOPDP:Mitigate>Data risks must be mitigated</OntologiaLOPDP:Mitigate>
        <OntologiaLOPDP:Mitigate>Mitigating data risks</OntologiaLOPDP:Mitigate>
        <OntologiaLOPDP:Name>Holder&apos;s name</OntologiaLOPDP:Name>
        <OntologiaLOPDP:Name>The name of the owner of the data must be known.</OntologiaLOPDP:Name>
        <OntologiaLOPDP:National_registry_for_the_protection_of_personal_data>Data must be in a national registry</OntologiaLOPDP:National_registry_for_the_protection_of_personal_data>
        <OntologiaLOPDP:Nature>The nature of the data must be known</OntologiaLOPDP:Nature>
        <OntologiaLOPDP:Nature_of_the_data>The nature of the data must be known</OntologiaLOPDP:Nature_of_the_data>
        <OntologiaLOPDP:Organizational>Organizational data exist; they are data from organizations</OntologiaLOPDP:Organizational>
        <OntologiaLOPDP:Personal_data_encryption>The owner of the data has the option to encrypt his data</OntologiaLOPDP:Personal_data_encryption>
        <OntologiaLOPDP:Personal_data_security_details>Data must be secure</OntologiaLOPDP:Personal_data_security_details>
        <OntologiaLOPDP:Personal_detail>The data stores in detail the holder&apos;s information.</OntologiaLOPDP:Personal_detail>
        <OntologiaLOPDP:Personal_information>Personal information of the data subject</OntologiaLOPDP:Personal_information>
        <OntologiaLOPDP:Prevent>Data risks must be prevented</OntologiaLOPDP:Prevent>
        <OntologiaLOPDP:Purpose>The purpose of the data must be defined</OntologiaLOPDP:Purpose>
        <OntologiaLOPDP:Reduce>Reduce data risks</OntologiaLOPDP:Reduce>
        <OntologiaLOPDP:Risk>Data should avoid being subject to risk</OntologiaLOPDP:Risk>
        <OntologiaLOPDP:Sanctioning_administrative_procedure>The manipulated data are subject to an administrative sanctioning process.</OntologiaLOPDP:Sanctioning_administrative_procedure>
        <OntologiaLOPDP:Scope>Data must have a defined scope of use</OntologiaLOPDP:Scope>
        <OntologiaLOPDP:Secrecy_of_communications>Data must be subject to secrecy in communications</OntologiaLOPDP:Secrecy_of_communications>
        <OntologiaLOPDP:Security_notification_of_infringement>The data owner must be notified in the event of a breach of data security.</OntologiaLOPDP:Security_notification_of_infringement>
        <OntologiaLOPDP:Serious>Holder data may be subject to serious infringement</OntologiaLOPDP:Serious>
        <OntologiaLOPDP:Seudonomización>The data must be treated in such a way that it is not known who the owner is in case of loss of data.</OntologiaLOPDP:Seudonomización>
        <OntologiaLOPDP:Slight>Holder&apos;s data may be subject to minor violations.</OntologiaLOPDP:Slight>
        <OntologiaLOPDP:Stop>Preventing data from misuse</OntologiaLOPDP:Stop>
        <OntologiaLOPDP:Supervise>Holder data must be monitored</OntologiaLOPDP:Supervise>
        <OntologiaLOPDP:Supervise>The data are supervised by the data delegate.</OntologiaLOPDP:Supervise>
        <OntologiaLOPDP:Systematic_evaluation>A semantic evaluation must be performed</OntologiaLOPDP:Systematic_evaluation>
        <OntologiaLOPDP:Technical_measurements>Technical measures must be taken with the data</OntologiaLOPDP:Technical_measurements>
        <OntologiaLOPDP:Threat>Data are subject to threats</OntologiaLOPDP:Threat>
        <OntologiaLOPDP:Updated>The data must be up to date</OntologiaLOPDP:Updated>
        <OntologiaLOPDP:Very_serious>The holder&apos;s data may be subject to very serious infringements</OntologiaLOPDP:Very_serious>
        <OntologiaLOPDP:Volume>The volume of data must be known</OntologiaLOPDP:Volume>
        <OntologiaLOPDP:Vulnerabilidad>The data is exposed to vulnerabilities</OntologiaLOPDP:Vulnerabilidad>
        <rdfs:label>data people over age 001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#data_persons_minors001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#data_persons_minors001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Data_persons_minors"/>
        <OntologiaLOPDP:and_the_owner_divides_into rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#data_people_over_age_001"/>
        <OntologiaLOPDP:Access>Children&apos;s data must be accessible</OntologiaLOPDP:Access>
        <OntologiaLOPDP:Anonymization>It must be possible to anonymize the data of minors.</OntologiaLOPDP:Anonymization>
        <OntologiaLOPDP:Correction>Children&apos;s data must be able to be rectified</OntologiaLOPDP:Correction>
        <OntologiaLOPDP:Disposal>It must be possible to delete the data of minors</OntologiaLOPDP:Disposal>
        <OntologiaLOPDP:General_detail>These are data that cannot be used freely by the owner of the information without first having permission or knowing key points about the use of their data.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Updated>Children&apos;s data must be able to be updated</OntologiaLOPDP:Updated>
        <rdfs:label>data persons minors001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#data_protection_mechanisms001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#data_protection_mechanisms001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Data_protection_mechanisms"/>
        <OntologiaLOPDP:account_with_actions_as rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#data_protection_mechanisms001"/>
        <OntologiaLOPDP:Celerity>Data protection mechanisms must be speeded up</OntologiaLOPDP:Celerity>
        <OntologiaLOPDP:Efficiency>Data protection mechanisms must be effective</OntologiaLOPDP:Efficiency>
        <OntologiaLOPDP:Efficiency>Data protection mechanisms must be efficient</OntologiaLOPDP:Efficiency>
        <OntologiaLOPDP:General_detail>Actions that must be taken into account with regard to data so that they are not violated.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Gratuity>Data protection mechanisms must be free of charge</OntologiaLOPDP:Gratuity>
        <rdfs:label>data protection mechanisms001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#deceased_persons_data001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#deceased_persons_data001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Deceased_persons_data"/>
        <OntologiaLOPDP:and_the_owner_divides_into rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#deceased_persons_data001"/>
        <OntologiaLOPDP:Access>They must have optimal access</OntologiaLOPDP:Access>
        <OntologiaLOPDP:Correction>It must be possible to rectify</OntologiaLOPDP:Correction>
        <OntologiaLOPDP:Disposal>It should be possible to eliminate</OntologiaLOPDP:Disposal>
        <OntologiaLOPDP:General_detail>These are data of deceased owners, but the person in charge of them, such as their legal representative, can make use of them.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Updated>Must be up to date</OntologiaLOPDP:Updated>
        <rdfs:label>deceased persons data001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#defense_of_claims001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#defense_of_claims001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Claims_defense"/>
        <OntologiaLOPDP:segmented_into_the_following_international_cases rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#defense_of_claims001"/>
        <OntologiaLOPDP:Claim_defense_details>Detail on defense claims in an international transfer case</OntologiaLOPDP:Claim_defense_details>
        <OntologiaLOPDP:General_detail>This is used when the data is subject to a defense of claims for a particular subject matter.</OntologiaLOPDP:General_detail>
        <rdfs:label>defense of claims001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#delegate001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#delegate001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Personal_data_delegate_in_verification"/>
        <OntologiaLOPDP:is_compliant_with_the_following_roles rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#delegate001"/>
        <OntologiaLOPDP:Advise>Advises the data protection authority</OntologiaLOPDP:Advise>
        <OntologiaLOPDP:Advise_on_risk_analysis>Advises the authority on risk analysis issues.</OntologiaLOPDP:Advise_on_risk_analysis>
        <OntologiaLOPDP:Audit>Assists in audit processes and performs audits</OntologiaLOPDP:Audit>
        <OntologiaLOPDP:Cooperate_with_the_Personal_Data_Protection_Authority>Cooperates with the authority</OntologiaLOPDP:Cooperate_with_the_Personal_Data_Protection_Authority>
        <OntologiaLOPDP:Delegate_functions>Among its functions are:
- Advising the person in charge
- Supervising the Authority
- Advise on risk analysis
- Cooperate with the Authority</OntologiaLOPDP:Delegate_functions>
        <OntologiaLOPDP:Details_of_the_law_details>Information</OntologiaLOPDP:Details_of_the_law_details>
        <OntologiaLOPDP:General_detail>It assists the data processor and data controller in specific cases and monitors them, performs auditing processes and collaborates with the authority to keep the other processes running smoothly.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Name>Antonio</OntologiaLOPDP:Name>
        <OntologiaLOPDP:Nature>The nature of its functions</OntologiaLOPDP:Nature>
        <OntologiaLOPDP:Personal_detail>Helps the authority to fulfill its functions</OntologiaLOPDP:Personal_detail>
        <OntologiaLOPDP:Personal_information>Delegate information</OntologiaLOPDP:Personal_information>
        <OntologiaLOPDP:Purpose>These are the actions to be performed</OntologiaLOPDP:Purpose>
        <OntologiaLOPDP:Scope>Scope of functions</OntologiaLOPDP:Scope>
        <OntologiaLOPDP:Supervise>He/she is in charge of supervising when the manager&apos;s activities require supervision.</OntologiaLOPDP:Supervise>
        <OntologiaLOPDP:Volume>Volume of data handled</OntologiaLOPDP:Volume>
        <rdfs:label>delegate001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#economic001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#economic001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Economic"/>
        <OntologiaLOPDP:in_consideration_of_credit_data_is_held rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#economic001"/>
        <OntologiaLOPDP:Access>Economic data must be accessible</OntologiaLOPDP:Access>
        <OntologiaLOPDP:Correction>It must be possible to rectify economic data</OntologiaLOPDP:Correction>
        <OntologiaLOPDP:Disposal>Economic data must be accessible</OntologiaLOPDP:Disposal>
        <OntologiaLOPDP:General_detail>Momentary data</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Updated>Economic data must be updatable</OntologiaLOPDP:Updated>
        <rdfs:label>economic001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#epidemiological_studies001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#epidemiological_studies001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Epidemiological_studies"/>
        <OntologiaLOPDP:segmented_into_the_following_national_cases rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#epidemiological_studies001"/>
        <OntologiaLOPDP:Anonymization>The holder of the information must have his data anonymized so that a transfer</OntologiaLOPDP:Anonymization>
        <OntologiaLOPDP:Exceptions>Exceptions are available when an epidemiological study is conducted</OntologiaLOPDP:Exceptions>
        <OntologiaLOPDP:General_detail>In a pandemic or epidemic, the holder&apos;s information may be used without his/her consent.</OntologiaLOPDP:General_detail>
        <rdfs:label>epidemiological studies001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#exceptions001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#exceptions001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Exceptions"/>
        <OntologiaLOPDP:and_emphasis_is_on_the_following_exceptions rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#exceptions001"/>
        <OntologiaLOPDP:General_detail>It covers all the exceptions to be considered at the national and international level in the transfer of information.</OntologiaLOPDP:General_detail>
        <rdfs:label>exceptions001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#exceptions_for_transfers_or_international_communications001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#exceptions_for_transfers_or_international_communications001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Exceptions_for_international_transfers_or_communications"/>
        <OntologiaLOPDP:as_to_the_national_and_international_related_to_it_be_held rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#exceptions_for_transfers_or_international_communications001"/>
        <OntologiaLOPDP:Contract>There must be a contract</OntologiaLOPDP:Contract>
        <OntologiaLOPDP:General_detail>These are scenarios in which the owner&apos;s permission is not required to use his or her information.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Informed>Exceptions to international transfer of the holder&apos;s data must be reported.</OntologiaLOPDP:Informed>
        <OntologiaLOPDP:Legal_or_regulatory_obligation>International exceptions must have a legal or regulatory obligation</OntologiaLOPDP:Legal_or_regulatory_obligation>
        <rdfs:label>exceptions for transfers or international communications001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#exceptions_to_consent_for_national_transfer001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#exceptions_to_consent_for_national_transfer001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Exceptions_to_consent_for_national_transfers"/>
        <OntologiaLOPDP:as_to_the_national_and_international_related_to_it_be_held rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#exceptions_to_consent_for_national_transfer001"/>
        <OntologiaLOPDP:Exceptions>There are exceptions for consenting to a domestic transfer of information</OntologiaLOPDP:Exceptions>
        <OntologiaLOPDP:General_detail>These are scenarios in which the approval of the personal data authority is not required to make use of personal data.</OntologiaLOPDP:General_detail>
        <rdfs:label>exceptions to consent for national transfer001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#exceptions_to_rights001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#exceptions_to_rights001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Exceptions_to_the_rights_in_verification"/>
        <OntologiaLOPDP:and_in_exceptional_cases_you_have_to rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#exceptions_to_rights001"/>
        <OntologiaLOPDP:General_detail>It talks about the cases in which the contemplated rights will not be applied and will be obviated.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:exceptions_to_rights>Exceptional cases where rights do not apply</OntologiaLOPDP:exceptions_to_rights>
        <rdfs:label>exceptions to rights001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#financial001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#financial001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Financial"/>
        <OntologiaLOPDP:in_consideration_of_credit_data_is_held rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#financial001"/>
        <OntologiaLOPDP:Access>Financial data must be accessible</OntologiaLOPDP:Access>
        <OntologiaLOPDP:Correction>Financial data must be rectifiable</OntologiaLOPDP:Correction>
        <OntologiaLOPDP:Disposal>It must be possible to delete financial data</OntologiaLOPDP:Disposal>
        <OntologiaLOPDP:General_detail>Momentary data that involves additional information such as account statements.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:General_detail>When the objective is to process the data for specific purposes, whether historical, statistical or scientific.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Updated>It must be possible to update financial data</OntologiaLOPDP:Updated>
        <rdfs:label>financial001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#free_consent001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#free_consent001">
        <OntologiaLOPDP:can_be rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#free_consent001"/>
        <OntologiaLOPDP:Informed>When the owner of the data is notified of its use or transfer</OntologiaLOPDP:Informed>
        <OntologiaLOPDP:Not_informed>When the owner of the data is not informed of the use or transfer of such data.</OntologiaLOPDP:Not_informed>
        <rdfs:label>free consent001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#health_data001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#health_data001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Health_data_in_verification"/>
        <OntologiaLOPDP:that_can_be rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#health_data001"/>
        <OntologiaLOPDP:Access>They must have optimal access</OntologiaLOPDP:Access>
        <OntologiaLOPDP:Anonymization>Data must be anonymized</OntologiaLOPDP:Anonymization>
        <OntologiaLOPDP:Correction>It must be possible to rectify</OntologiaLOPDP:Correction>
        <OntologiaLOPDP:Disposal>It must be possible to delete data</OntologiaLOPDP:Disposal>
        <OntologiaLOPDP:General_detail>They are a type of data of the owner, but can be used by companies or public entities, this in case of an emergency involving the integrity of the owner of the information.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:General_detail>This is data such as criminal history or history of very serious diseases or specific actions that the holder has carried out in breach of a national law or law.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Updated>Must be up to date</OntologiaLOPDP:Updated>
        <rdfs:label>health data001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#holder001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#holder001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Holder_in_verification"/>
        <OntologiaLOPDP:is_compliant_with_the_following_roles rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#holder001"/>
        <OntologiaLOPDP:Contract>The holder is entitled to a contract</OntologiaLOPDP:Contract>
        <OntologiaLOPDP:Details_of_the_law_details>General information</OntologiaLOPDP:Details_of_the_law_details>
        <OntologiaLOPDP:General_detail>It is the person or entity that owns the data.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Informed>The Data Subject must be informed of the status of his or her data at all times and must be informed if his or her data is being misused.</OntologiaLOPDP:Informed>
        <OntologiaLOPDP:Name>Francisco</OntologiaLOPDP:Name>
        <OntologiaLOPDP:Personal_detail>I am the owner of my information</OntologiaLOPDP:Personal_detail>
        <OntologiaLOPDP:Personal_information>Information</OntologiaLOPDP:Personal_information>
        <OntologiaLOPDP:Preservation_time>3O days</OntologiaLOPDP:Preservation_time>
        <OntologiaLOPDP:Request_information_verification>The owner of the data can request the verification of his information to the person in charge or responsible for the treatment of his information without cost and as soon as possible.</OntologiaLOPDP:Request_information_verification>
        <rdfs:label>holder001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#informed_consent001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#informed_consent001">
        <OntologiaLOPDP:can_be rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#informed_consent001"/>
        <OntologiaLOPDP:Informed>When the owner is informed of how his or her data will be used or transferred.</OntologiaLOPDP:Informed>
        <OntologiaLOPDP:Not_informed>When the owner is not informed about how his data will be used or transferred.</OntologiaLOPDP:Not_informed>
        <rdfs:label>informed consent001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#infringements001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#infringements001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Violations_in_verification"/>
        <OntologiaLOPDP:the_verification_covers_aspects_such_as rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#infringements001"/>
        <OntologiaLOPDP:Detail_of_investigation_of_infringements>Detailed information on violations</OntologiaLOPDP:Detail_of_investigation_of_infringements>
        <OntologiaLOPDP:Penalties_for_mild_infractions>In the case of the Data Authority, the range is from 1 to 10 unified basic salaries; other members of the law are not considered.</OntologiaLOPDP:Penalties_for_mild_infractions>
        <OntologiaLOPDP:Penalties_for_serious_infractions>In the case of the Data Authority, the range is 10 to 20 unified basic salaries; the other members of the law are not considered.</OntologiaLOPDP:Penalties_for_serious_infractions>
        <OntologiaLOPDP:Very_serious>Infringements that must be treated specially according to the seriousness of the infringement.</OntologiaLOPDP:Very_serious>
        <OntologiaLOPDP:Violations_in_verification>Fines for non-compliance with the law vary according to the degree of non-compliance.</OntologiaLOPDP:Violations_in_verification>
        <rdfs:label>infringements001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#international_companies001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#international_companies001">
