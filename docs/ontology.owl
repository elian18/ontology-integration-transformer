    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Legal_persons_data">
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is a kind of dpv:NonPersonalData.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: es un tipo de dpv:NonPersonalData.</rdfs:comment>
        <rdfs:label>Legal persons data</rdfs:label>
        <skos:broadMatch rdf:resource="https://w3id.org/dpv#NonPersonalData"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Legal_representative_owner">
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is close to dpv:GuardianOfDataSubject.</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: se parece a dpv:GuardianOfDataSubject.</rdfs:comment>
        <rdfs:label>Legal representative owner</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/dpv#GuardianOfDataSubject"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Members_of_the_personal_data_protection_system">
        <rdfs:comment xml:lang="en">They are all those persons who participate in the Personal Data Protection Law.</rdfs:comment>
        <rdfs:comment xml:lang="es">They are all those persons who participate in the Personal Data Protection Law.</rdfs:comment>
        <rdfs:label>Members of the personal data protection system</rdfs:label>
    </rdf:Description>
