        <owl:annotatedTarget rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#Processor"/>
        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#DataProcessor"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv Data_Processor exactMatch dpv:DataProcessor y GDPRtEXT Processor exactMatch dpv:DataProcessor.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Axiom>
    


