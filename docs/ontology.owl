    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#national_companies001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#national_companies001">
        <rdf:type rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#Domestic_Companies"/>
        <OntologiaLOPDP:where_in_the_national_scope_is_held rdf:resource="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#national_companies001"/>
        <OntologiaLOPDP:General_detail>This aspect considers measures that can be applied to national companies in the event of non-compliance with the proper use of data.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:Minor_infractions_national_public_company>0.1 to 0.7 of the company&apos;s turnover.</OntologiaLOPDP:Minor_infractions_national_public_company>
        <OntologiaLOPDP:National_company_detail>General company information. For example, KFC.</OntologiaLOPDP:National_company_detail>
        <OntologiaLOPDP:Serious_infractions_national_public_company>from 0.7 to 1% of the business volume, it may increase depending on the company&apos;s degree of non-compliance</OntologiaLOPDP:Serious_infractions_national_public_company>
        <rdfs:label>national companies001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#notification001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#notification001">
