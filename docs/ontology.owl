    <!-- http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Anonymized_data -->


    <owl:Class rdf:about="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Anonymized_data">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Inapplicability"/>
        <rdfs:comment xml:lang="en">Correspondences with the DPV: is close to dpv:AnonymisedData. Bridge with the GDPR: is close to gdprtext:AnonymousData (through dpv:AnonymisedData).</rdfs:comment>
        <rdfs:comment xml:lang="es">Correspondencias con el DPV: se parece a dpv:AnonymisedData. Puente con el GDPR: se parece a gdprtext:AnonymousData (por dpv:AnonymisedData).</rdfs:comment>
        <rdfs:label>Anonymized data</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#AnonymousData"/>
        <skos:closeMatch rdf:resource="https://w3id.org/dpv#AnonymisedData"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Anonymized_data"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
        <owl:annotatedTarget rdf:resource="http://purl.org/adaptcentre/openscience/ontologies/GDPRtEXT#AnonymousData"/>
        <ontopriv-gdpr-alignment:chainedBy rdf:resource="https://w3id.org/dpv#AnonymisedData"/>
        <rdfs:comment xml:lang="es">Encadenado por el DPV: OntoPriv Anonymized_data closeMatch dpv:AnonymisedData y GDPRtEXT AnonymousData exactMatch dpv:AnonymisedData.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Axiom>
    


