        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/ley-organica-proteccion-datos-personales#Data_Controller"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
