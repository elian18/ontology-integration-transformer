        <OntologiaLOPDP:Company_detail>Company data</OntologiaLOPDP:Company_detail>
        <OntologiaLOPDP:Corporate_standards>Company standards</OntologiaLOPDP:Corporate_standards>
        <OntologiaLOPDP:General_detail>This subclass refers to what international companies must take into account when making a data transfer, this varies depending on the company.</OntologiaLOPDP:General_detail>
        <OntologiaLOPDP:International_company_data>Information on international companies</OntologiaLOPDP:International_company_data>
        <rdfs:label>international companies001</rdfs:label>
    </owl:NamedIndividual>
    


