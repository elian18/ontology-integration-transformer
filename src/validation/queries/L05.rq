# L05 · ¿En qué plazo debe el responsable atender el derecho de acceso?
# Los plazos del derecho de acceso: onto:deadline_in_days_for_the_right_of_access y op:right_of_access_time.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX dpv:  <https://w3id.org/dpv#>
PREFIX onto: <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#>
PREFIX op:   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#>
SELECT DISTINCT ?concept ?value WHERE {
  { ?concept onto:deadline_in_days_for_the_right_of_access ?value . }
  UNION
  { ?concept op:right_of_access_time ?value . }
}
