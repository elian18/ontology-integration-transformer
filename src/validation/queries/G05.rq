# G05 · ¿Qué categorías de datos personales representa la ontología?
# Los conceptos de la ontología alineados (exactMatch, closeMatch o broadMatch) con dpv:PersonalData
# o con un término que esté debajo (rdfs:subClassOf o skos:broader).
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX dpv:  <https://w3id.org/dpv#>
SELECT DISTINCT ?concept ?match WHERE {
  ?concept (skos:exactMatch|skos:closeMatch|skos:broadMatch) ?match .
  ?match (rdfs:subClassOf|skos:broader)* dpv:PersonalData .
  FILTER(!STRSTARTS(STR(?concept), "https://w3id.org/dpv"))
}
