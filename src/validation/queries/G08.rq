# G08 · ¿De qué artículo de la ley sale cada concepto?
# Los conceptos que citan un artículo de la ley (dct:source con «art.»).
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX dpv:  <https://w3id.org/dpv#>
SELECT DISTINCT ?concept ?source WHERE {
  ?concept dct:source ?source .
  FILTER(isLiteral(?source) && CONTAINS(LCASE(STR(?source)), "art."))
}
