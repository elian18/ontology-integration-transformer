# L06 · ¿En qué plazo debe el responsable notificar una vulneración de seguridad a la Autoridad de Protección de Datos Personales?
# El plazo del aviso de una vulneración (op:Security_notification_of_infringement) de cada op:Notification.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX dpv:  <https://w3id.org/dpv#>
PREFIX onto: <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#>
PREFIX op:   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#>
SELECT DISTINCT ?concept ?value WHERE {
  ?concept a op:Notification ;
           op:Security_notification_of_infringement ?value .
}
