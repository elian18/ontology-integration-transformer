# L09 · ¿Por qué vías se pueden transferir datos personales a otro país?
# Las clases debajo de op:Transfer_or_communication y los conceptos alineados con las bases o las
# garantías de las transferencias del DPV (dpv:DataTransferLegalBasis, dpv:SafeguardForDataTransfer).
# También los conceptos que la base tomó de los artículos que regulan el tema (dct:source: art. 56, 57, 58, 59, 60).
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX dpv:  <https://w3id.org/dpv#>
PREFIX onto: <http://www.semanticweb.org/ley-organica-proteccion-datos-personales#>
PREFIX op:   <http://www.semanticweb.org/franc/ontologies/2023/9/OntologiaLOPDP#>
SELECT DISTINCT ?concept ?label ?match ?source WHERE {
  { ?concept rdfs:subClassOf+ op:Transfer_or_communication . }
  UNION
  { VALUES ?root { dpv:DataTransferLegalBasis dpv:SafeguardForDataTransfer }
    ?concept (skos:exactMatch|skos:closeMatch|skos:broadMatch) ?term . ?term (rdfs:subClassOf|skos:broader)* ?root . }
  UNION
  { ?concept dct:source ?cited .
    FILTER(REGEX(STR(?cited), "art\\. (56|57|58|59|60)$")) }
  OPTIONAL { ?concept rdfs:label ?label }
  OPTIONAL { ?concept (skos:exactMatch|skos:closeMatch|skos:broadMatch) ?match }
  OPTIONAL { ?concept dct:source ?source }
}
